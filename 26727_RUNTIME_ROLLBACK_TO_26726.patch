-     * those bytes through GLFormat.FLOAT_16#getGLType(), which intentionally returns GL_FLOAT for
-     * older FloatBuffer callers that rely on GL converting float32 client values into RGBA16F.
-     * This path is intentionally explicit and fail-closed: exact FLOAT_16 destination, exact
-     * 2-byte/channel payload, GL_HALF_FLOAT client type, and restored texture binding. */
-    public void loadHalfFloatData(ByteBuffer pixels) {
-        if (mFormat.mFormat != GLFormat.DataType.FLOAT_16) {
-            throw new IllegalStateException("26727 half-float client upload requires FLOAT_16 destination");
-        }
-        if (pixels == null) {
-            throw new IllegalStateException("26727 half-float client upload buffer is null");
-        }
-        long expected = (long) mSize.x * (long) mSize.y * (long) mFormat.mChannels * 2L;
-        if (pixels.remaining() != expected) {
-            throw new IllegalStateException("26727 half-float client upload byte contract invalid bytes="
-                    + pixels.remaining() + " expected=" + expected);
-        }
-        int[] previousBinding = new int[1];
-        glGetIntegerv(GL_TEXTURE_BINDING_2D, previousBinding, 0);
-        glBindTexture(GL_TEXTURE_2D, mTextureID);
-        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, mSize.x, mSize.y,
-                mFormat.getGLFormatExternal(), GL_HALF_FLOAT, pixels);
-        checkEglError("26727 glTexSubImage2D GL_HALF_FLOAT");
-        glBindTexture(GL_TEXTURE_2D, previousBinding[0]);
-        checkEglError("26727 half-float restore binding");
-    }
