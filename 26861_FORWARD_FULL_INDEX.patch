+        require(profile.mode == "BURST_ALL_PHASE_SHOT_READ" ||
+            profile.mode.startsWith("CAMERA2_FALLBACK_")) {
+            "IRIS_26861_B_INVALID_NOISE_SOURCE: unsupported/partial RAW fit may not control B"
+        }
+        require((0..3).all { p ->
+            val shot=profile.shot[p]; val read=profile.read[p]
+            shot.isFinite() && shot >= 0f && read.isFinite() && read >= 0f &&
+                (shot > 0f || read > 0f)
+        }) { "IRIS_26861_B_INVALID_NOISE_COEFFICIENT: reject zero or nonfinite variance" }
+    }
+
+    /** IRIS_26861_B_PRIVATE_SENSOR_NOISE_CALIBRATION
+     * Only B NORMAL guide, covariance, rejection and temporal sampling consume
+     * this model. A, DNG, LONG retain the unmodified legacy calibration.
+     * Profile is either measured four-phase burst or explicitly validated
+     * same-physical-frame Camera2 last resort, never a partial zero fit. */
+    private fun bEmpiricalCalibration26861(
+        original: FrameCalibration, profile: GlesIris26860BBurstNoise.Profile,
+        exposureScale: Float,
+    ): FrameCalibration {
+        requireBNoiseAuthority26861(profile)
+        val physicalShot=FloatArray(4)
+        val physicalRead=FloatArray(4)
+        for (phase in 0..3) {
+            val c=canonicalChannelAtPhase(phase)
+            physicalShot[c]=profile.shot[phase].coerceAtLeast(0f)
+            physicalRead[c]=profile.read[phase].coerceAtLeast(0f)
+        }
+        val shot=FloatArray(4) { c -> physicalShot[c]*calculationWhiteBalance[c]*exposureScale }
+        val read=FloatArray(4) { c ->
+            val gain=calculationWhiteBalance[c]*exposureScale
+            physicalRead[c]*gain*gain
+        }
+        val unblockerShot=FloatArray(4) { c ->
+            physicalShot[c]*(sensorWhiteLevel-original.blackLevels[c])
+        }
+        val unblockerRead=FloatArray(4) { c ->
+            val range=sensorWhiteLevel-original.blackLevels[c]
+            physicalRead[c]*range*range
+        }
+        val rgbShot=RawNoiseModel.bayerNoiseModelToRgb(physicalShot).also { rgb ->
+            rgb.indices.forEach { rgb[it]*=exposureScale }
+        }
+        val scale2=exposureScale*exposureScale
+        val rgbRead=RawNoiseModel.bayerNoiseModelToRgb(physicalRead).also { rgb ->
+            rgb.indices.forEach { rgb[it]*=scale2 }
+        }
+        return original.copy(shotNoise=shot,readNoise=read,
+            unblockerShotNoise=unblockerShot,unblockerReadNoise=unblockerRead,
+            cameraRgbShotNoise=rgbShot,cameraRgbReadNoise=rgbRead)
+    }
+
+    private fun bEmpiricalKernelTuning26861(
+        original: BayerKernelTuning, profile: GlesIris26860BBurstNoise.Profile,
+        normalCount: Int,
+    ): BayerKernelTuning {
+        requireBNoiseAuthority26861(profile)
+        var greenVariance=0f;var greenRead=0f
+        var greens=0
+        for (phase in 0..3) {
+            if (canonicalChannelAtPhase(phase) in 1..2) {
+                greenVariance+=profile.shot[phase]*original.referenceSignal+profile.read[phase]
+                greenRead+=profile.read[phase]
+                greens++
+            }
+        }
+        val variance=(greenVariance/greens.coerceAtLeast(1)).coerceAtLeast(1.0e-10f)
+        val snr=(original.referenceSignal/sqrt(variance)).coerceAtLeast(0f)
+        return original.copy(referenceSnr=snr,
+            referenceShadowReadVariance=greenRead/greens.coerceAtLeast(1),
+            baseSpatialScale=MgcSpatialMergeTuning.baseSpatialScale(
+                referenceSnr=snr, frameCount=normalCount, outputMode=outputMode))
+    }
