+        if(r!=VK_SUCCESS){if(error)*error=vkError("vkQueueSubmit",r);return false;}
+        r=vkWaitForFences(device,1,&fence,VK_TRUE,UINT64_MAX);
+        if(r!=VK_SUCCESS){if(error)*error=vkError("vkWaitForFences",r);return false;}
