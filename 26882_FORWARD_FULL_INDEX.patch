@@ -420,11 +420,16 @@ internal object GlesIris26858BNoiseHighlight {
             // physical pixel wide. 26880 multiplied two coverage smoothsteps,
             // rejecting 65% of precisely that clipping even though the CFA
             // phase evidence already showed separate physically clipped colors.
-            // Require a third RGB witness before accepting two-color clipping:
-            // independently clipped yellow/red+green neon with dark blue must
-            // keep its genuine chroma; a fully clipped R/G/B core is conclusive.
+            // IRIS_26882_B_RAWR_OFF_CONTINUOUS_WHITE: two independently
+            // clipped CFA colors can form a genuinely white emitter even if
+            // its third channel is attenuated by the sensor spectrum and WB.
+            // The old 0.35..0.65 third-channel gate discarded such partial
+            // white clips, leaving magenta housings untouched. Keep a THIRD
+            // physical-channel witness, but admit its nonzero low-energy tail
+            // continuously. A red/yellow neon with near-zero blue does not
+            // qualify. Fully unclipped pixels still bypass this shader above.
             vec3 physicalWbRgb=rgb/max(uAmazeWb,vec3(0.0001));
-            float thirdWitness=smoothstep(0.35,0.65,
+            float thirdWitness=smoothstep(0.055,0.28,
                 min(physicalWbRgb.r,min(physicalWbRgb.g,physicalWbRgb.b)));
             float tripleClip=min(colorClip.r,min(colorClip.g,colorClip.b));
             float multiColor=max(tripleClip,inwardCross*thirdWitness);
diff --git a/app/src/main/java/com/unspektrawesome/vulkan/params/RawShaderParameters.kt b/app/src/main/java/com/unspektrawesome/vulkan/params/RawShaderParameters.kt
