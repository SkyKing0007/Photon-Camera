+++ b/app/src/main/java/com/unspektrawesome/vulkan/params/RawShaderParameters.kt
@@ -159,8 +159,19 @@ class RawShaderParameters private constructor(
             captureMetadata: RawCaptureMetadata? = null,
         ): RawShaderParameters {
             require(sensor.hasValidLevels()) { "Sensor black and white levels are invalid" }
-            require(outputDimensions.width <= output.size.width && outputDimensions.height <= output.size.height) {
-                "Output dimensions must not exceed RAW dimensions"
+            // IRIS_26882_SPEKTRA_ROTATED_OUTPUT_CONTRACT: the borrowed Camera2
+            // RAW plane stays unrotated while GeometryShaderParameters rotates
+            // the processing lattice at 90/270 degrees. The successful 26881
+            // code incorrectly compares portrait height to RAW sensor height.
+            // Keep the same pixel-count and axis bounds; accept an axis swap,
+            // not arbitrary oversized output or a cropped substitute.
+            val nativeAxes = outputDimensions.width <= output.size.width &&
+                outputDimensions.height <= output.size.height
+            val quarterTurnAxes = outputDimensions.width <= output.size.height &&
+                outputDimensions.height <= output.size.width
+            require(outputDimensions.width > 0 && outputDimensions.height > 0 &&
+                (nativeAxes || quarterTurnAxes)) {
+                "RAW processing dimensions exceed both native and 90-degree rotated bounds"
             }
             val minimumStride = when (output.format) {
                 RawFormat.RAW_SENSOR -> output.size.width * 2L
