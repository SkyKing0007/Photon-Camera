-    private fun reconstructTrue2x(
-        frames: List<RawStackFrame>,
-        images: List<SafeImage>,
-        evidence: List<True2xFrameEvidence>,
-    ): True2xResult {
-        require(enableSabreSuperRes)
-        require(evidence.isNotEmpty()) { "True2x has no NORMAL Sabre evidence" }
-        val directory = checkNotNull(sabreSuperResTempDir)
-        require(directory.exists() || directory.mkdirs())
-        val outputWidth = Math.multiplyExact(width, 2)
-        val outputHeight = Math.multiplyExact(height, 2)
-        val start = System.nanoTime()
-        val gpuFile = File(directory, "iris26564_true2x_${System.nanoTime()}.rgb16f")
-        val gpuAttempt = runCatching {
-            val phase = runTrue2xGpu(images, evidence, gpuFile, outputWidth, outputHeight)
-            True2xResult(
-                gpuFile.absolutePath, "", outputWidth, outputHeight, "GPU",
-                phase.first, phase.second, elapsedMs(start),
-            )
-        }
-        if (gpuAttempt.isSuccess) return gpuAttempt.getOrThrow()
-        val gpuFailure = gpuAttempt.exceptionOrNull()
-            ?: IllegalStateException("IRIS_26564_TRUE2X_GPU_FALLBACK_CPU unknown GPU failure")
-        PLog.e(
-            SABRE_TAG,
-            "IRIS_26564_TRUE2X_GPU_FALLBACK_CPU reason=${gpuFailure.message}",
-            gpuFailure,
-        )
-        runCatching { gpuFile.delete() }
-        val cpuStart = System.nanoTime()
-        val cpuFile = File(directory, "iris26564_true2x_cpu_${System.nanoTime()}.rgb16f")
-        val phase = runTrue2xCpu(frames, images, evidence, cpuFile, outputWidth, outputHeight)
-        return True2xResult(
-            cpuFile.absolutePath, "", outputWidth, outputHeight, "CPU",
-            phase.first, phase.second, elapsedMs(cpuStart),
-        )
-    }
