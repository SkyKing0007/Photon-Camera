index b8a9050c49398b9fab6cd8cd3e8aad0bc479aa43..c98ab62de46ac492e3660cd2022ded2b20250407 100644
--- a/app/src/main/assets/shaders/motionv2/shadow_cleanup.glsl
+++ b/app/src/main/assets/shaders/motionv2/shadow_cleanup.glsl
@@ -40,0 +41,2 @@ void main() {
+    float yMin=yc;
+    float yMax=yc;
@@ -46,0 +49,2 @@ void main() {
+            yMin=min(yMin,y);
+            yMax=max(yMax,y);
@@ -83,0 +88,14 @@ void main() {
+    /* IRIS_26842_TRUE_FLAT_MOTTLING_CLEANUP
+     * The car-body sample shows low-frequency chroma/luma clouding on genuinely smooth dark paint.
+     * Do not raise denoise globally. Require the entire 5x5 luminance neighborhood to remain flat,
+     * then add only a small cleanup reserve. Foliage, text, rails, seams and coherent microstructure
+     * lose this gate as soon as their local range becomes material. */
+    float localRange=max(yMax-yMin,0.0);
+    float wholeNeighborhoodFlat=1.0-smoothstep(
+            0.010+0.055*yc,
+            0.030+0.145*yc,
+            localRange);
+    float mottleConfidence=lowSignal*flatConfidence*wholeNeighborhoodFlat;
+    chromaMix=clamp(chromaMix+0.07*mottleConfidence,0.0,0.94);
+    lumaMix=clamp(lumaMix+0.09*mottleConfidence,0.0,0.47);
+
diff --git a/app/src/main/java/com/hinnka/mycamera/processor/GlesMgcRawSabreShaders.kt b/app/src/main/java/com/hinnka/mycamera/processor/GlesMgcRawSabreShaders.kt
index a5897468914e92568a5d5093a365c61e376b6b17..17ee9ceb504e635070c0f270cc9a64ebeb9c6cc0 100644
--- a/app/src/main/java/com/hinnka/mycamera/processor/GlesMgcRawSabreShaders.kt
+++ b/app/src/main/java/com/hinnka/mycamera/processor/GlesMgcRawSabreShaders.kt
@@ -5872 +5872,22 @@ internal object GlesMgcRawSabreShaders {
-            float targetMag=preserveHue ? trustedMag : min(srcMag,untrustedFloor);
+
+            /* IRIS_26842_CONTINUOUS_CLIPPED_COLOR_ROLLOFF
+             * 26840 still had a binary confidence cliff: anything short of strict source+small+broad
+             * consensus collapsed almost to neutral. That stripped genuine foliage, ground, rails
+             * and painted material of color exactly where clipping confidence became uncertain.
+             * Keep the successful 26839 source-hue ownership contract, but make magnitude confidence
+             * continuous. The small neighborhood is the primary same-material evidence; broad/donor
+             * evidence may raise saturation confidence but can never rotate hue. */
+            float localHueTrust=sourceHasHue
+                    ? smallSupport*smoothstep(0.80,uDirectionCosThreshold,sourceSmallCos)
+                    : 0.0;
+            float broadHueTrust=sourceHasHue
+                    ? broadSupport*smoothstep(0.72,uDirectionCosThreshold,sourceBroadCos)
+                    : 0.0;
+            float donorMagnitudeTrust=
+                    smoothstep(0.72,uDirectionCosThreshold,donorCos)*
+                    smoothstep(0.65,uCoherenceThreshold,magRatio);
+            float secondaryTrust=max(broadHueTrust,donorMagnitudeTrust);
+            float partialTrust=clamp(localHueTrust*(0.48+0.52*secondaryTrust),0.0,1.0);
+            float localMagnitude=max(untrustedFloor,min(srcMag,max(uNeutralRms,smallMag)));
+            float partialTargetMag=mix(untrustedFloor,localMagnitude,partialTrust);
+            float targetMag=preserveHue ? trustedMag : min(srcMag,partialTargetMag);
@@ -5875,3 +5896,5 @@ internal object GlesMgcRawSabreShaders {
-            /* Direction never rotates in the visible boundary. Warm terminal color enters only
-             * in the deepest core, after saturation has already rolled close to neutral. */
-            float terminal=smoothstep(0.90,0.995,m);
+
+            /* Never turn a still-colored clipped pixel gray/warm merely because broad confidence
+             * is weak. The warm terminal is reserved for a truly hue-less deepest core only. */
+            float sourceHueGone=1.0-smoothstep(0.65*uNeutralRms,1.35*uNeutralRms,srcMag);
+            float terminal=smoothstep(0.94,0.999,m)*sourceHueGone;
