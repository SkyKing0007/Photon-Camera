+            float sourceLuma26751 = luma26751(sourceRgb26751);
+            vec3 sourceNorm26751 = (sourceRgb26751 - vec3(sourceLuma26751)) /
+                max(sourceLuma26751, 0.060);
+            float sourceNormMag26751 = length(sourceNorm26751);
+            float measured26751 = smoothstep(0.992, 0.9995,
+                min326751(validity26751(p)));
+            float highlightSafe26751 = 1.0 - smoothstep(0.78, 0.92,
+                max(sourcePeak26751, cleanedLuma26751));
+
+            vec3 consensusNormSum26751 = vec3(0.0);
+            float consensusWeight26751 = 0.0;
+            float consensusPermission26751 = 0.0;
+            for (int sy26751 = -2; sy26751 <= 2; ++sy26751) {
+                for (int sx26751 = -2; sx26751 <= 2; ++sx26751) {
+                    ivec2 q26751 = clamp(p + ivec2(sx26751, sy26751),
+                        ivec2(0), uImageSize - ivec2(1));
+                    uvec4 seed26751 = imageLoad(uSeed26751, q26751);
+                    float seedPermission26751 = float(seed26751.a) / 65535.0;
+                    if (seedPermission26751 <= 0.0) continue;
+                    vec3 seedRgbValue26751 = seedRgb26751(seed26751);
+                    float seedLuma26751 = luma26751(seedRgbValue26751);
+                    vec3 seedNorm26751 = (seedRgbValue26751 - vec3(seedLuma26751)) /
+                        max(seedLuma26751, 0.060);
+                    float seedNormMag26751 = length(seedNorm26751);
+                    float hueMatch26751 = smoothstep(0.88, 0.975,
+                        hue26751(sourceNorm26751, seedNorm26751));
+                    float relativeLuma26751 = abs(sourceLuma26751 - seedLuma26751) /
+                        max(max(sourceLuma26751, seedLuma26751), 0.060);
+                    float lumaMatch26751 = 1.0 - smoothstep(0.20, 0.46, relativeLuma26751);
+                    float d226751 = float(sx26751 * sx26751 + sy26751 * sy26751);
+                    float spatial26751 = 1.0 / (1.0 + 0.38 * d226751);
+                    float w26751 = seedPermission26751 * hueMatch26751 *
+                        lumaMatch26751 * spatial26751 * smoothstep(0.055, 0.120, seedNormMag26751);
+                    consensusNormSum26751 += seedNorm26751 * w26751;
+                    consensusWeight26751 += w26751;
+                    consensusPermission26751 = max(consensusPermission26751,
+                        seedPermission26751 * hueMatch26751 * lumaMatch26751);
+                }
+            }
+
+            vec3 consensusNorm26751 = consensusWeight26751 > 1.0e-6
+                ? consensusNormSum26751 / consensusWeight26751 : vec3(0.0);
+            float consensusNormMag26751 = length(consensusNorm26751);
+            float seedSupport26751 = smoothstep(0.55, 1.80, consensusWeight26751) *
+                smoothstep(0.55, 0.90, consensusPermission26751);
+            float sourceHueConsensus26751 = smoothstep(0.88, 0.975,
+                hue26751(sourceNorm26751, consensusNorm26751));
+            float sourceCoverage26751 = smoothstep(0.58, 0.84,
+                sourceNormMag26751 / max(consensusNormMag26751, 0.030));
+            float missingAbs26751 = smoothstep(0.020, 0.070,
+                max(consensusNormMag26751 - cleanedNormMag26751, 0.0));
+            float missingRatio26751 = smoothstep(1.14, 1.48,
+                consensusNormMag26751 / max(cleanedNormMag26751, 0.025));
+
+            /* Neutral-polarity / background-hue veto. A neutral glyph may sit inside a saturated
+             * field, but that field cannot become its color owner. Use only four frozen radius-two
+             * source samples so this veto is structural, cheap and independent of restored RGB. */
+            const ivec2 bgDir26751[4] = ivec2[4](
+                ivec2(-2,0), ivec2(2,0), ivec2(0,-2), ivec2(0,2));
+            vec3 bgNormSum26751 = vec3(0.0);
+            float bgWeight26751 = 0.0;
+            for (int i26751 = 0; i26751 < 4; ++i26751) {
+                ivec2 q26751 = clamp(p + bgDir26751[i26751],
+                    ivec2(0), uImageSize - ivec2(1));
+                vec3 qRgb26751 = max(texelFetch(uPhysicalPreVgn, q26751, 0).rgb, vec3(0.0));
+                float qLuma26751 = luma26751(qRgb26751);
+                vec3 qNorm26751 = (qRgb26751 - vec3(qLuma26751)) / max(qLuma26751, 0.060);
+                float qMag26751 = length(qNorm26751);
+                float qMeasured26751 = smoothstep(0.992, 0.9995,
+                    min326751(validity26751(q26751)));
+                float rel26751 = abs(qLuma26751 - sourceLuma26751) /
+                    max(max(qLuma26751, sourceLuma26751), 0.060);
+                float w26751 = qMeasured26751 * smoothstep(0.055, 0.120, qMag26751) *
+                    smoothstep(0.22, 0.52, rel26751);
+                bgNormSum26751 += qNorm26751 * w26751;
+                bgWeight26751 += w26751;
+            }
+            vec3 bgConsensus26751 = bgWeight26751 > 1.0e-6
+                ? bgNormSum26751 / bgWeight26751 : vec3(0.0);
+            float cleanedNeutral26751 = 1.0 - smoothstep(0.030, 0.085, cleanedNormMag26751);
+            float backgroundLeakVeto26751 = cleanedNeutral26751 *
+                smoothstep(0.80, 2.00, bgWeight26751) *
+                smoothstep(0.94, 0.985, hue26751(consensusNorm26751, bgConsensus26751));
+
+            float permission26751 = measured26751 * highlightSafe26751 * seedSupport26751 *
+                sourceHueConsensus26751 * sourceCoverage26751 * missingAbs26751 *
+                missingRatio26751 * (1.0 - backgroundLeakVeto26751);
+
+            vec3 finalChroma26751 = cleanedChroma26751;
+            float protectedMagnitude26751 = float(cleanedPacked26751.a) / 65535.0;
+            if (permission26751 > 0.001 && consensusNormMag26751 > 1.0e-7) {
+                vec3 targetChroma26751 = consensusNorm26751 * cleanedScale26751;
+                float targetScale26751 = 1.0;
+                for (int c26751 = 0; c26751 < 3; ++c26751) {
+                    float cc26751 = targetChroma26751[c26751];
+                    if (cc26751 < -1.0e-7) {
+                        targetScale26751 = min(targetScale26751,
+                            cleanedLuma26751 / max(-cc26751, 1.0e-7));
+                    } else if (cc26751 > 1.0e-7) {
+                        targetScale26751 = min(targetScale26751,
+                            (1.0 - cleanedLuma26751) / cc26751);
+                    }
+                }
+                targetChroma26751 *= clamp(targetScale26751, 0.0, 1.0);
+                float targetMagnitude26751 = length(targetChroma26751);
+                float cleanedMagnitude26751 = length(cleanedChroma26751);
+                if (targetMagnitude26751 > cleanedMagnitude26751 + 1.0e-7) {
+                    finalChroma26751 = mix(cleanedChroma26751, targetChroma26751,
+                        clamp(permission26751, 0.0, 1.0));
+                    if (permission26751 >= 0.50) {
+                        protectedMagnitude26751 = max(protectedMagnitude26751,
+                            length(finalChroma26751));
+                    }
+                }
+            }
+            vec3 outputRgb26751 = clamp(vec3(cleanedLuma26751) + finalChroma26751,
+                vec3(0.0), vec3(1.0));
+            uvec3 outputEncoded26751 = uvec3(round(outputRgb26751 * 65535.0));
+            uint protectionEncoded26751 = uint(round(clamp(protectedMagnitude26751,
+                0.0, 1.0) * 65535.0));
+            imageStore(uOutput26751, p, uvec4(outputEncoded26751, protectionEncoded26751));
         }
     """.trimIndent()
 
