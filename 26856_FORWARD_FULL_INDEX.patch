+    /* IRIS_26599_SHORT_GATE_PROBE
+     * Re-evaluate the exact same mask shader at 64x48 sample points and read only 3 KiB. This
+     * avoids a native-resolution diagnostic allocation/compute pass while exposing which gate is
+     * dominant. The full-resolution final-active count below remains the exact handoff proof.
+     */
+    private fun probeSabreShortGateStages26599(
+        referenceRaw: Int,
+        shortRaw: Int,
+        flow: SabreConvertedAlignment,
+        boundaryGeometry: Int,
+        referenceCalibration: FrameCalibration,
+        shortCalibration: FrameCalibration,
+        exposureRatio: Float,
+    ): String {
+        val probeWidth = 64
+        val probeHeight = 48
+        val maskProbe = createTexture(probeWidth, probeHeight, GLES30.GL_R8, GLES30.GL_NEAREST)
+        val stageProbe = createTexture(probeWidth, probeHeight, GLES30.GL_R8, GLES30.GL_NEAREST)
+        try {
+            renderSabreShortRestoreMask26595(
+                referenceRaw = referenceRaw, shortRaw = shortRaw, flow = flow,
+                boundaryGeometry = boundaryGeometry, referenceCalibration = referenceCalibration,
+                shortCalibration = shortCalibration, exposureRatio = exposureRatio,
+                output = maskProbe, outputGateStage26599 = stageProbe,
+                outputWidth26599 = probeWidth, outputHeight26599 = probeHeight,
+            )
+            val bytes = readR8Mask(
+                stageProbe, "26599 SHORT gate-stage probe",
+                maskWidth = probeWidth, maskHeight = probeHeight,
+            )
+            val terminal = IntArray(8)
+            bytes.forEach { raw ->
+                val encoded = raw.toInt() and 0xff
+                val stage = ((encoded * 7 + 127) / 255).coerceIn(0, 7)
+                terminal[stage]++
+            }
+            val cumulative = IntArray(8)
+            var running = 0
+            for (stage in 7 downTo 0) { running += terminal[stage]; cumulative[stage] = running }
+            return "${probeWidth}x$probeHeight candidate=${cumulative[1]} flow=${cumulative[2]} " +
+                "shortMeasurable=${cumulative[3]} loss=${cumulative[4]} " +
+                "shortHeadroom=${cumulative[5]} radiometry=${cumulative[6]} " +
+                "final=${cumulative[7]} total=${bytes.size}"
+        } finally {
+            releaseOwnedTexture(maskProbe, "26599 SHORT gate mask probe")
+            releaseOwnedTexture(stageProbe, "26599 SHORT gate stage probe")
+        }
+    }
