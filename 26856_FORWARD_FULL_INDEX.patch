+    private fun reconstructHighZoomDetail26718(
+        frames: List<RawStackFrame>,
+        images: List<SafeImage>,
+        evidence: List<True2xFrameEvidence>,
+        nativeVgnGuideTexture: Int,
+    ): HighZoomDetailResult {
+        require(enableHighZoomDetail && !enableSabreSuperRes)
+        require(evidence.isNotEmpty())
+        val directory=checkNotNull(sabreSuperResTempDir)
+        require(directory.exists()||directory.mkdirs())
+        val fullWidth=Math.multiplyExact(width,2)
+        val fullHeight=Math.multiplyExact(height,2)
+        fun roundUp4(value:Int):Int = (value + 3) and -4
+        /* IRIS_26834_UNIVERSAL_HIGH_ZOOM_RECONSTRUCTION_HALO
+         * 26828 left only about eight detail texels per side. At 30x/120x those boundary texels
+         * expand into visible barcode bands. Every high-zoom detail reconstruction now reserves
+         * a target 32-detail-texel halo on every side. Render and gain-map owners reject the outer
+         * 16 texels and finish their transition by 24, so the visible crop begins beyond the
+         * transition. If the sensor lattice cannot provide that geometry, fail closed to native
+         * Sabre/VGN rather than publish reconstruction-edge detail. */
+        val visibleDetailWidth26834=kotlin.math.ceil(fullWidth/highZoomSourceZoom.toDouble()).toInt().coerceAtMost(fullWidth)
+        val visibleDetailHeight26834=kotlin.math.ceil(fullHeight/highZoomSourceZoom.toDouble()).toInt().coerceAtMost(fullHeight)
+        val detailWidth=roundUp4((visibleDetailWidth26834+64).coerceAtMost(fullWidth)).coerceAtLeast(4).coerceAtMost(fullWidth)
+        val detailHeight=roundUp4((visibleDetailHeight26834+64).coerceAtMost(fullHeight)).coerceAtLeast(4).coerceAtMost(fullHeight)
+        require((detailWidth and 3)==0 && (detailHeight and 3)==0)
+        val trustedHaloX26834=0.5f*(detailWidth-visibleDetailWidth26834).toFloat()
+        val trustedHaloY26834=0.5f*(detailHeight-visibleDetailHeight26834).toFloat()
+        require(trustedHaloX26834>=24.0f && trustedHaloY26834>=24.0f) {
+            "26834 high-zoom detail halo insufficient: halo=${trustedHaloX26834},${trustedHaloY26834} zoom=$highZoomSourceZoom"
+        }
+        val originX=(fullWidth-detailWidth)/2
+        val originY=(fullHeight-detailHeight)/2
+        require((originX and 1)==0 && (originY and 1)==0)
+        val output=File(directory,"iris26718_high_zoom_detail_${System.nanoTime()}.r16f")
+        val start=System.nanoTime()
+        return try {
+            val stats=runHighZoomDetailGpu26718(frames,images,evidence,output,nativeVgnGuideTexture,detailWidth,detailHeight,originX,originY,fullWidth,fullHeight)
+            val refined=evidence.filter { it.frameIndex!=0 }
+            val refinePct=if(refined.isEmpty())0f else refined.map{it.refineAcceptedPct}.average().toFloat()
+            HighZoomDetailResult(
+                path = output.absolutePath,
+                width = detailWidth,
+                height = detailHeight,
+                originX = originX,
+                originY = originY,
+                fullWidth = fullWidth,
+                fullHeight = fullHeight,
+                scaleX = 2f,
+                scaleY = 2f,
+                originXF = originX.toFloat(),
+                originYF = originY.toFloat(),
+                sourceZoom = highZoomSourceZoom,
+                activePct = stats.activePct,
+                strongPct = stats.strongPct,
+                refineAcceptedPct = refinePct,
+                frames = evidence.size,
+                reconstructionMs = elapsedMs(start),
+            )
+        } catch(error:Throwable) {
+            runCatching { output.delete() }
+            throw error
+        }
+    }
