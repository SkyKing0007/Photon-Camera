+    private fun logSabreUniversalFusionDecision26651(decision: Int) {
+        val bytes = readR8Mask(decision, "26651 scalar radiance fusion decision", width, height)
+        var normalOwned = 0L
+        var blended = 0L
+        var shortOwned = 0L
+        var geometryRejected = 0L
+        var sourceRejected = 0L
+        var snrRejected = 0L
+        var authoritySum = 0.0
+        var authoritySamples = 0L
+        var colorNotEligible = 0L
+        var colorNormalChromaFallback = 0L
+        var colorConsensusShortOutlier = 0L
+        var colorConsensusShortAgrees = 0L
+        for (raw in bytes) {
+            val v = raw.toInt() and 0xff
+            when {
+                v <= 191 -> {
+                    val colorState = v / 48
+                    val radianceCode = v % 48
+                    val authority = radianceCode / 47.0
+                    authoritySum += authority
+                    authoritySamples++
+                    when {
+                        radianceCode <= 1 -> normalOwned++
+                        radianceCode >= 46 -> shortOwned++
+                        else -> blended++
+                    }
+                    when (colorState) {
+                        0 -> colorNotEligible++
+                        1 -> colorNormalChromaFallback++
+                        2 -> colorConsensusShortOutlier++
+                        else -> colorConsensusShortAgrees++
+                    }
+                }
+                v < 216 -> geometryRejected++
+                v < 233 -> sourceRejected++
+                else -> snrRejected++
+            }
+        }
+        val details =
+            "normalOwned=$normalOwned blended=$blended shortOwned=$shortOwned " +
+                "geometryRejected=$geometryRejected sourceRejected=$sourceRejected snrRejected=$snrRejected " +
+                "meanShortAuthority=${if (authoritySamples > 0) authoritySum / authoritySamples else 0.0} " +
+                "colorNotEligible=$colorNotEligible colorNormalChromaFallback=$colorNormalChromaFallback " +
+                "colorConsensusShortOutlier=$colorConsensusShortOutlier " +
+                "colorConsensusShortAgrees=$colorConsensusShortAgrees " +
+                "radianceAuthority=scalar normalChromaMaster=true shortChromaRequiresLocalConsensus=true continuousColorValidity=true edgeCorrespondence=true sceneSemantic=false spatialFill=false"
+        PLog.i(SABRE_TAG, "IRIS_26651_NORMAL_MASTER_SHORT_FUSION $details")
+        MotionTrace.processingState("IRIS_26651_NORMAL_MASTER_SHORT_FUSION", details)
+    }
