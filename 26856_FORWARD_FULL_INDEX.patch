+    private fun probeSabreShortBoundaryGeometry26600(
+        geometry: Int,
+        gridWidth: Int,
+        gridHeight: Int,
+        label: String,
+    ): Pair<Int, Int> {
+        val geometryMask = createTexture(gridWidth, gridHeight, GLES30.GL_R8, GLES30.GL_NEAREST)
+        val boundaryMask = createTexture(gridWidth, gridHeight, GLES30.GL_R8, GLES30.GL_NEAREST)
+        try {
+            val program = sabreShortBoundaryGeometryProbeProgram26600
+            check(program != 0)
+            GLES30.glUseProgram(program)
+            bindTexture(program, "uGeometry", 0, geometry)
+            uniform2i(program, "uSize", gridWidth, gridHeight)
+            draw(program, gridWidth, gridHeight, intArrayOf(geometryMask, boundaryMask))
+            val geometryBytes = readR8Mask(
+                geometryMask, "$label geometry", maskWidth = gridWidth, maskHeight = gridHeight,
+            )
+            val boundaryBytes = readR8Mask(
+                boundaryMask, "$label boundary", maskWidth = gridWidth, maskHeight = gridHeight,
+            )
+            return Pair(
+                geometryBytes.count { (it.toInt() and 0xff) != 0 },
+                boundaryBytes.count { (it.toInt() and 0xff) != 0 },
+            )
+        } finally {
+            releaseOwnedTexture(geometryMask, "$label geometry probe")
+            releaseOwnedTexture(boundaryMask, "$label boundary probe")
+        }
+    }
