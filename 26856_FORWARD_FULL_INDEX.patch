index 0000000000000000000000000000000000000000..e862dd382f4320e811c8b8776a812912f3fda7c6
--- /dev/null
+++ b/app/src/main/java/com/hinnka/mycamera/processor/GlesIris26856LabDefringe.kt
@@ -0,0 +1,81 @@
+package com.hinnka.mycamera.processor
+
+import android.content.res.AssetManager
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import kotlin.math.abs
+
+/**
+ * IRIS_26856_RAWR_PINNED_LAB_DEFRINGE_GLES_PORT.
+ * Mathematical operations, Gaussian stencil, purple-object veto, and the
+ * packed R32UI half-score + SSBO-reduction sequence follow RAWR
+ * ce767e80bfce2e1641abf7dad6b1bf504d844fd9 exactly.
+ * The sole API adaptation is Vulkan push constants -> GLES3.1 std140 UBO.
+ * A is never a consumer; caller owns all GL resources and synchronizes passes.
+ */
+internal object GlesIris26856LabDefringe {
+    const val OWNER = "IRIS_26856_RAWR_PINNED_LAB_DEFRINGE_GLES_PORT"
+    const val PARAM_BYTES = 128
+    private const val DIR = "iris26856/rawr/lab/"
+    private const val INCLUDE = "#include \"lab_defringe_common.glsl\""
+
+    fun expandedShader(assets: AssetManager, name: String): String {
+        require(name == "lab_defringe_prepare.comp" || name == "lab_defringe_reduce.comp" ||
+                name == "lab_defringe_reconstruct.comp") { "26856 unknown pinned Lab shader" }
+        val shader = assets.open(DIR + name).bufferedReader(Charsets.UTF_8).use { it.readText() }
+        val common = assets.open(DIR + "lab_defringe_common.glsl")
+            .bufferedReader(Charsets.UTF_8).use { it.readText() }
+        require(shader.indexOf(INCLUDE) > 0 && shader.indexOf(INCLUDE) == shader.lastIndexOf(INCLUDE)) {
+            "26856 pinned Lab include count must be exactly one"
+        }
+        return shader.replace(INCLUDE, common)
+    }
+
+    /** Original RAWR calibrated camera RGB -> D50 Lab model, row major. */
+    fun parameters(width: Int, height: Int, strength: Float, cameraToSrgb: FloatArray): ByteBuffer {
+        require(width > 0 && height > 0 && width <= 16384 && height <= 16384)
+        require(strength.isFinite() && strength in 0f..1f)
+        require(cameraToSrgb.size == 9 && cameraToSrgb.all { it.isFinite() }) {
+            "26856 Lab requires finite camera-to-sRGB 3x3 calibration"
+        }
+        val srgbToD50 = doubleArrayOf(
+            .4360747, .3850649, .1430804,
+            .2225045, .7168786, .0606169,
+            .0139322, .0971045, .7141733,
+        )
+        val forward = DoubleArray(9)
+        for (row in 0..2) for (column in 0..2) for (k in 0..2)
+            forward[row * 3 + column] += srgbToD50[row * 3 + k] * cameraToSrgb[k * 3 + column]
+        val inverse = doubleArrayOf(
+            forward[4] * forward[8] - forward[5] * forward[7],
+            forward[2] * forward[7] - forward[1] * forward[8],
+            forward[1] * forward[5] - forward[2] * forward[4],
+            forward[5] * forward[6] - forward[3] * forward[8],
+            forward[0] * forward[8] - forward[2] * forward[6],
+            forward[2] * forward[3] - forward[0] * forward[5],
+            forward[3] * forward[7] - forward[4] * forward[6],
+            forward[1] * forward[6] - forward[0] * forward[7],
+            forward[0] * forward[4] - forward[1] * forward[3],
+        )
+        val determinant = forward[0] * inverse[0] + forward[1] * inverse[3] + forward[2] * inverse[6]
+        require(determinant.isFinite() && abs(determinant) >= 1.0e-10) {
+            "26856 Lab calibration is singular"
+        }
+        val output = ByteBuffer.allocateDirect(PARAM_BYTES).order(ByteOrder.nativeOrder())
+        output.putInt(width).putInt(height)
+        output.putFloat(strength).putFloat(13f)
+        output.putFloat(1f)
+        repeat(3) { output.putInt(0) }
+        for (row in 0..2) {
+            for (col in 0..2) output.putFloat(forward[row * 3 + col].toFloat())
+            output.putFloat(0f)
+        }
+        for (row in 0..2) {
+            for (col in 0..2) output.putFloat((inverse[row * 3 + col] / determinant).toFloat())
+            output.putFloat(0f)
+        }
+        check(output.position() == PARAM_BYTES)
+        output.rewind()
+        return output
+    }
+}
diff --git a/app/src/main/java/com/hinnka/mycamera/processor/GlesIris26856RawrColorContract.kt b/app/src/main/java/com/hinnka/mycamera/processor/GlesIris26856RawrColorContract.kt
new file mode 100644
index 0000000000000000000000000000000000000000..f9a3a6e42ad1331e3ddf24973f2a58aa6c0daabe
--- /dev/null
+++ b/app/src/main/java/com/hinnka/mycamera/processor/GlesIris26856RawrColorContract.kt
@@ -0,0 +1,74 @@
+package com.hinnka.mycamera.processor
+
+import kotlin.math.abs
+
+/**
+ * IRIS_26856_B_ONLY_RAWR_COLOR_DOMAIN_OWNER
+ *
+ * Immutable Camera2 calibration for the pinned RAWR pipeline. The normalized
+ * temporal CFA is sensor-neutral. AMaZE applies relative R/G/B white balance
+ * exactly once, Lab and FCC process that post-WB camera-linear image, and the
+ * final RGB carrier must undo those gains before Iris's already-calibrated
+ * camera-RGB -> display renderer. Do NOT apply the Camera2 matrix twice.
+ *
+ * Rejected calibration never silently becomes identity. Experiment A never
+ * constructs this object and uses the historical 26850 path verbatim.
+ */
+internal object GlesIris26856RawrColorContract {
+    data class Snapshot private constructor(
+        val amazeWhiteBalance: FloatArray,
+        val inverseWhiteBalance: FloatArray,
+        val postWbCameraToSrgb: FloatArray,
+    ) {
+        fun cloneForCapture(): Snapshot = Snapshot(
+            amazeWhiteBalance.copyOf(), inverseWhiteBalance.copyOf(), postWbCameraToSrgb.copyOf(),
+        )
+        companion object {
+            fun create(wb: FloatArray, inverse: FloatArray, ccm: FloatArray) =
+                Snapshot(wb.copyOf(), inverse.copyOf(), ccm.copyOf())
+        }
+    }
+
+    fun freeze(colorGainsRggb: FloatArray, transform: FloatArray,
+               directColorValid: Boolean): Snapshot {
+        require(directColorValid) { "26856 B requires valid shutter-frozen Camera2 color transform" }
+        require(colorGainsRggb.size >= 4 && colorGainsRggb.take(4).all {
+            it.isFinite() && it > 0f
+        }) { "26856 B invalid Camera2 RGGB white-balance gains" }
+        require(transform.size == 9 && transform.all { it.isFinite() }) {
+            "26856 B requires finite 3x3 Camera2 post-WB RGB-to-sRGB matrix"
+        }
+        val green = (colorGainsRggb[1].toDouble() + colorGainsRggb[2].toDouble()) / 2.0
+        require(green.isFinite() && green > 0.0)
+        val wb = floatArrayOf((colorGainsRggb[0] / green).toFloat(), 1f,
+            (colorGainsRggb[3] / green).toFloat())
+        require(wb.all { it.isFinite() && it > 0f && it <= 64f }) {
+            "26856 B cannot reproduce unsupported relative AMaZE white balance"
+        }
+        val m = transform
+        val determinant = m[0].toDouble() * (m[4].toDouble() * m[8] - m[5].toDouble() * m[7]) -
+            m[1].toDouble() * (m[3].toDouble() * m[8] - m[5].toDouble() * m[6]) +
+            m[2].toDouble() * (m[3].toDouble() * m[7] - m[4].toDouble() * m[6])
+        require(determinant.isFinite() && abs(determinant) > 1e-10) {
+            "26856 B singular Camera2 RGB calibration; no identity fallback"
+        }
+        return Snapshot.create(wb, floatArrayOf(1f / wb[0], 1f, 1f / wb[2]), transform)
+    }
+
+    // Apply only after RAWR AMaZE -> calibrated Lab defringe -> FCC x2.
+    // No luminance compression, RGB clipping, gamma or second matrix.
+    val undoAmazeWbToIrisSensorNeutral = """
+        #version 300 es
+        precision highp float;
+        precision highp int;
+        uniform sampler2D uPostRawrRgb;
+        uniform vec3 uInverseAmazeWb;
+        uniform ivec2 uSize;
+        layout(location = 0) out vec4 oIrisSensorNeutralRgb;
+        void main() {
+            ivec2 p = clamp(ivec2(gl_FragCoord.xy), ivec2(0), uSize - ivec2(1));
+            vec4 source = texelFetch(uPostRawrRgb, p, 0);
+            oIrisSensorNeutralRgb = vec4(source.rgb * uInverseAmazeWb, source.a);
+        }
+    """.trimIndent()
+}
diff --git a/app/src/main/java/com/hinnka/mycamera/processor/GlesIris26856RawrFalseColor.kt b/app/src/main/java/com/hinnka/mycamera/processor/GlesIris26856RawrFalseColor.kt
new file mode 100644
index 0000000000000000000000000000000000000000..ad20ec6874d81fe3783cd50190137713d212f809
--- /dev/null
+++ b/app/src/main/java/com/hinnka/mycamera/processor/GlesIris26856RawrFalseColor.kt
@@ -0,0 +1,162 @@
+package com.hinnka.mycamera.processor
+
+/**
+ * IRIS_26856_RAWR_TWO_PASS_FALSE_COLOR_SOURCE.
+ *
+ * Direct GLES 3.0 fragment-stage adaptation of RAWR's pinned 2026-10-18
+ * `native/false_color_correction/shaders/fcc_chroma_median.comp` and
+ * `fcc_reconstruct.comp` (RAWR commit ce767e80bfce2e1641abf7dad6b1bf504d844fd9).
+ * RAWR in turn pins RawTherapee commit 498f623784e33fd9a7077fcd8937fe0734033366.
+ * GPL-3.0-or-later; original provenance/notice must be retained upon shipping.
+ *
+ * One FCC STEP consists of these TWO shader invocations:
+ *    linear RGB -> RG32F median YIQ chroma -> linear RGB reconstruction.
+ * Apply the step twice, serially, after defringe and before tone/color output.
+ * This is NOT a demosaicer and MUST NOT run through legacy VGN chroma-restoration.
+ * GLSL shader compilation, Vulkan/AMaZE integration, exact numerical parity,
+ * GLES full-precision intermediate and device performance remain UNTESTED.
+ */
+internal object GlesIris26856RawrFalseColor {
+    const val owner = "IRIS_26856_RAWR_TWO_PASS_FALSE_COLOR_SOURCE"
+
+    val medianChroma = """
+        #version 300 es
+        precision highp float;
+        precision highp int;
+        uniform sampler2D uRgb;
+        uniform ivec2 uSize;
+        uniform int uNormalizedChroma;
+        layout(location=0) out vec2 oIQ;
+
+        vec2 toIQ(vec3 c) {
+            return vec2(0.596*c.r-0.275*c.g-0.321*c.b,
+                        0.212*c.r-0.523*c.g+0.311*c.b);
+        }
+        vec2 iqAt(int x, int y) {
+            vec3 c = texelFetch(uRgb, ivec2(x, y), 0).rgb;
+            vec2 iq = toIQ(c);
+            if (uNormalizedChroma != 0)
+                iq /= max(dot(c, vec3(0.299, 0.587, 0.114)), 1.0e-4);
+            return iq;
+        }
+        void cswap(inout vec2 a, inout vec2 b) {
+            vec2 lo=min(a,b), hi=max(a,b);
+            a=lo; b=hi;
+        }
+        void middle4of6(vec2 a0, vec2 a1, vec2 a2, vec2 a3,
+                        vec2 a4, vec2 a5, out vec2 r0, out vec2 r1,
+                        out vec2 r2, out vec2 r3) {
+            r0=min(a1,a2);
+            r1=max(a1,a2);
+            vec2 left=min(a0,r1);
+            r1=max(a0,r1);
+            vec2 tmp=min(left,r0);
+            r0=max(left,r0);
+            left=tmp;
+            r3=min(a4,a5);
+            vec2 right=max(a4,a5);
+            r2=min(a3,right);
+            right=max(a3,right);
+            tmp=min(r2,r3);
+            r3=max(r2,r3);
+            r2=max(left,tmp);
+            r1=min(r1,right);
+        }
+        vec2 median7(vec2 a, vec2 b, vec2 c, vec2 d,
+                     vec2 e, vec2 f, vec2 g) {
+            vec2 v0=a,v1=b,v2=c,v3=d,v4=e,v5=f,v6=g;
+            cswap(v0,v5); cswap(v0,v3); cswap(v1,v6); cswap(v2,v4);
+            cswap(v0,v1); cswap(v3,v5); cswap(v2,v6); cswap(v2,v3);
+            cswap(v3,v6); cswap(v4,v5); cswap(v1,v4); cswap(v1,v3);
+            cswap(v3,v4);
+            return v3;
+        }
+        void main() {
+            ivec2 p=ivec2(gl_FragCoord.xy);
+            int W=uSize.x, H=uSize.y;
+            int x=p.x,y=p.y;
+            if (y==0||y==H-1||x==0||x>=W-2) {
+                oIQ=iqAt(x,y);
+                return;
+            }
+            vec2 upL=iqAt(x-1,y-1),midL=iqAt(x-1,y),downL=iqAt(x-1,y+1);
+            vec2 upC=iqAt(x,y-1),midC=iqAt(x,y),downC=iqAt(x,y+1);
+            vec2 upR=iqAt(x+1,y-1),midR=iqAt(x+1,y),downR=iqAt(x+1,y+1);
+            vec2 m0,m1,m2,m3;
+            if ((x&1)==1) {
+                middle4of6(upC,midC,downC,upR,midR,downR,m0,m1,m2,m3);
+                oIQ=median7(upL,midL,downL,m0,m1,m2,m3);
+            } else {
+                middle4of6(upL,midL,downL,upC,midC,downC,m0,m1,m2,m3);
+                oIQ=median7(upR,midR,downR,m0,m1,m2,m3);
+            }
+        }
+    """.trimIndent()
+
+    val reconstructChroma = """
+        #version 300 es
+        precision highp float;
+        precision highp int;
+        uniform sampler2D uRgb;
+        uniform sampler2D uMedianIq;
+        uniform ivec2 uSize;
+        uniform int uNormalizedChroma;
+        uniform float uEdgeSigma;
+        uniform float uChromaBound;
+        layout(location=0) out vec4 oRgb;
+
+        float Yof(vec3 c) { return 0.299*c.r+0.587*c.g+0.114*c.b; }
+        vec3 fromYIQ(float Y, vec2 iq) {
+            return vec3(Y+0.956*iq.x+0.621*iq.y,
+                        Y-0.272*iq.x-0.647*iq.y,
+                        Y-1.105*iq.x+1.702*iq.y);
+        }
+        float boundScale(float Y, vec2 iq, float sourceMaximum) {
+            float upper=max(Y,sourceMaximum)>1.0?
+                1.25*max(Y,sourceMaximum):1.0;
+            vec3 full=fromYIQ(Y,iq);
+            if (all(greaterThanEqual(full,vec3(0.0))) &&
+                all(lessThanEqual(full,vec3(upper)))) return 1.0;
+            float lo=0.0,hi=1.0;
+            for(int i=0;i<4;++i) {
+                float mid=0.5*(lo+hi);
+                vec3 c=fromYIQ(Y,mid*iq);
+                if (all(greaterThanEqual(c,vec3(0.0))) &&
+                    all(lessThanEqual(c,vec3(upper)))) lo=mid;
+                else hi=mid;
+            }
+            return lo;
+        }
+        void main() {
+            ivec2 p=ivec2(gl_FragCoord.xy);
+            vec4 src=texelFetch(uRgb,p,0);
+            if(p.y==0||p.y==uSize.y-1) { oRgb=src; return; }
+            vec2 iq=vec2(0.0);
+            if(p.x==0||p.x==uSize.x-1) {
+                iq=texelFetch(uMedianIq,p,0).rg;
+            } else if(uEdgeSigma>0.0) {
+                float Yc=Yof(src.rgb);
+                float inv2s2=1.0/max(uEdgeSigma*uEdgeSigma,1.0e-8);
+                float wSum=0.0;
+                for(int dy=-1;dy<=1;++dy) for(int dx=-1;dx<=1;++dx) {
+                    ivec2 q=p+ivec2(dx,dy);
+                    float Yn=Yof(texelFetch(uRgb,q,0).rgb);
+                    float d=Yn-Yc;
+                    float w=exp(-d*d*inv2s2);
+                    iq+=w*texelFetch(uMedianIq,q,0).rg;
+                    wSum+=w;
+                }
+                iq/=max(wSum,1.0e-6);
+            } else {
+                for(int dy=-1;dy<=1;++dy) for(int dx=-1;dx<=1;++dx)
+                    iq+=texelFetch(uMedianIq,p+ivec2(dx,dy),0).rg;
+                iq*=1.0/9.0;
+            }
+            float Y=Yof(src.rgb);
+            if(uNormalizedChroma!=0) iq*=max(Y,1.0e-4);
+            if(uChromaBound>0.0)
+                iq*=boundScale(Y,iq,max(src.r,max(src.g,src.b)));
+            oRgb=vec4(fromYIQ(Y,iq),src.a);
+        }
+    """.trimIndent()
+}
