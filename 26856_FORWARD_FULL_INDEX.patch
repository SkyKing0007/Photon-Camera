+    private fun logSabreResolvedRgbStats(
+        buffer: ByteBuffer,
+        finalBlackLevel: FloatArray,
+        demosaicWhiteLevel: Float,
+    ) {
+        require(finalBlackLevel.size == 3)
+        val pixelCount = Math.multiplyExact(width, height)
+        val samplesPerPlane = 4096
+        val sampleStep = max(1, pixelCount / samplesPerPlane)
+        val values = buffer.duplicate().order(ByteOrder.nativeOrder()).asShortBuffer()
+        val minimum = IntArray(3) { 0xffff }
+        val maximum = IntArray(3)
+        val sum = LongArray(3)
+        val count = IntArray(3)
+        val normalizedMax = ArrayList<Float>(samplesPerPlane + 1)
+        var aboveNominalWhite = 0
+        var pixel = 0
+        while (pixel < pixelCount) {
+            var maxNormalized = 0f
+            for (channel in 0 until 3) {
+                val planeOffset = channel * pixelCount
+                val value = values.get(planeOffset + pixel).toInt() and 0xffff
+                minimum[channel] = minOf(minimum[channel], value)
+                maximum[channel] = maxOf(maximum[channel], value)
+                sum[channel] += value.toLong()
+                count[channel]++
+                val normalized = max(
+                    0f,
+                    (value.toFloat() - finalBlackLevel[channel]) /
+                        max(1f, demosaicWhiteLevel - finalBlackLevel[channel]),
+                )
+                maxNormalized = max(maxNormalized, normalized)
+            }
+            normalizedMax += maxNormalized
+            if (maxNormalized > 1f) aboveNominalWhite++
+            pixel += sampleStep
+        }
+        val mean = FloatArray(3) { channel ->
+            if (count[channel] > 0) sum[channel].toFloat() / count[channel].toFloat() else 0f
+        }
+        normalizedMax.sort()
+        fun percentile(fraction: Float): Float {
+            if (normalizedMax.isEmpty()) return Float.NaN
+            val index = ((normalizedMax.size - 1) * fraction).toInt()
+                .coerceIn(0, normalizedMax.size - 1)
+            return normalizedMax[index]
+        }
+        val sampledMax = normalizedMax.lastOrNull() ?: Float.NaN
+        val aboveFraction = if (normalizedMax.isNotEmpty()) {
+            aboveNominalWhite.toFloat() / normalizedMax.size.toFloat()
+        } else Float.NaN
+        val details =
+            "stage=RESOLVE_PRE_NORMALIZED_OUTPUT samples=${normalizedMax.size} step=$sampleStep " +
+                "codeMin=${minimum.contentToString()} codeMax=${maximum.contentToString()} " +
+                "codeMean=${mean.contentToString()} normalizedP95=${percentile(0.95f)} " +
+                "normalizedP99=${percentile(0.99f)} normalizedMax=$sampledMax " +
+                "aboveNominalWhite=$aboveNominalWhite aboveNominalWhiteFraction=$aboveFraction " +
+                "demosaicWhite=$demosaicWhiteLevel"
+        PLog.i(SABRE_TAG, "IRIS_26605_HDR_DOMAIN_STATS $details")
+        MotionTrace.processingState("IRIS_26605_HDR_DOMAIN_STATS", details)
+    }
