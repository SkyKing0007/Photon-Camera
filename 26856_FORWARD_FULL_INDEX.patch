+    /* IRIS_26626_SHORT_COMMON_ACCUMULATOR_CONTRIBUTION_PROOF
+     * Compare a small quarter-resolution normalized proxy before/after the unchanged final SHORT
+     * merge. This proves whether the common Resolve input actually changed; it does not claim that
+     * Resolve or final presentation preserved that change. */
+    private fun measureSabreShortAccumulatorContribution26626(
+        beforeProxy: Int,
+        targetMask: Int,
+        accumulatedColor: Int,
+        accumulatedWeightsGb: Int,
+        probeWidth: Int,
+        probeHeight: Int,
+    ): ShortAccumulatorContribution26626 {
+        val delta = createTexture(
+            probeWidth, probeHeight, GLES30.GL_RGBA8, GLES30.GL_NEAREST,
+        )
+        try {
+            val program = sabreShortAccumulatorDeltaProgram26626
+            check(program != 0) { "26626 SHORT accumulator-delta program missing" }
+            GLES30.glUseProgram(program)
+            bindTexture(program, "uBeforeProxy", 0, beforeProxy)
+            bindTexture(program, "uAccumulatedColor", 1, accumulatedColor)
+            bindTexture(program, "uAccumulatedWeightsGb", 2, accumulatedWeightsGb)
+            bindTexture(program, "uTargetMask", 3, targetMask)
+            uniform2i(program, "uProbeSize", probeWidth, probeHeight)
+            draw(program, probeWidth, probeHeight, intArrayOf(delta))
+
+            val byteCount = Math.multiplyExact(Math.multiplyExact(probeWidth, probeHeight), 4)
+            val buffer = ByteBuffer.allocateDirect(byteCount)
+            bindRenderTargets(intArrayOf(delta), "26626 SHORT accumulator-delta readback")
+            GLES30.glBindBuffer(GLES30.GL_PIXEL_PACK_BUFFER, 0)
+            GLES30.glPixelStorei(GLES30.GL_PACK_ALIGNMENT, 1)
+            GLES30.glReadPixels(
+                0, 0, probeWidth, probeHeight,
+                GLES30.GL_RGBA, GLES30.GL_UNSIGNED_BYTE, buffer,
+            )
+            GLES30.glBindFramebuffer(GLES30.GL_FRAMEBUFFER, 0)
+            checkGlError("26626 SHORT accumulator-delta readback")
+            buffer.rewind()
+            var targetCells = 0
+            var changedCells = 0
+            var maxColor = 0f
+            var maxWeight = 0f
+            var sumColor = 0.0
+            var sumWeight = 0.0
+            repeat(probeWidth * probeHeight) {
+                val target = buffer.get().toInt() and 0xff
+                val changed = buffer.get().toInt() and 0xff
+                val colorScaled = (buffer.get().toInt() and 0xff) / 255f
+                val weightScaled = (buffer.get().toInt() and 0xff) / 255f
+                if (target != 0) {
+                    targetCells++
+                    if (changed != 0) changedCells++
+                    val relativeColor = colorScaled / 64f
+                    val relativeWeight = weightScaled / 64f
+                    maxColor = maxOf(maxColor, relativeColor)
+                    maxWeight = maxOf(maxWeight, relativeWeight)
+                    sumColor += relativeColor.toDouble()
+                    sumWeight += relativeWeight.toDouble()
+                }
+            }
+            val denom = targetCells.coerceAtLeast(1)
+            val result = ShortAccumulatorContribution26626(
+                targetCells = targetCells,
+                changedCells = changedCells,
+                maximumRelativeColorDelta = maxColor,
+                meanRelativeColorDelta = (sumColor / denom).toFloat(),
+                maximumRelativeWeightDelta = maxWeight,
+                meanRelativeWeightDelta = (sumWeight / denom).toFloat(),
+            )
+            val details = "targetProbeCells=${result.targetCells} changedProbeCells=${result.changedCells} " +
+                "maxRelativeColorDelta=${result.maximumRelativeColorDelta} " +
+                "meanRelativeColorDelta=${result.meanRelativeColorDelta} " +
+                "maxRelativeWeightDelta=${result.maximumRelativeWeightDelta} " +
+                "meanRelativeWeightDelta=${result.meanRelativeWeightDelta} " +
+                "commonAccumulatorInputChanged=${result.changedCells > 0} " +
+                "resolveEffective=NOT_DIRECTLY_MEASURED outputPreserved=DEVICE_IMAGE_REQUIRED"
+            PLog.i(SABRE_TAG, "IRIS_26626_SHORT_ACCUMULATOR_CONTRIBUTION $details")
+            MotionTrace.processingState("IRIS_26626_SHORT_ACCUMULATOR_CONTRIBUTION", details)
+            return result
+        } finally {
+            releaseOwnedTexture(delta, "26626 SHORT accumulator-delta")
+        }
+    }
