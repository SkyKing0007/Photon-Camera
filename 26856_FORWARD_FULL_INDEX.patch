+            while (top < fullOutputHeight) {
+                val tileHeight = minOf(TRUE2X_CPU_TILE_HEIGHT, fullOutputHeight - top)
+                var left = 0
+                while (left < fullOutputWidth) {
+                    val tileWidth = minOf(TRUE2X_CPU_TILE_WIDTH, fullOutputWidth - left)
