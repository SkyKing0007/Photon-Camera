+// RAWR ce767e80bfce2e1641abf7dad6b1bf504d844fd9 Lab defringe common.
+// Port change: GLSL ES 3.10 std140 UBO substitutes original Vulkan 128-byte push constant.
+layout(std140, binding = 0) uniform DefringeParameters {
+    uint width;
+    uint height;
+    float strength;
+    float threshold;
+    float edgeMode;
+    uint pad0;
+    uint pad1;
+    uint pad2;
+    vec4 forwardRows[3];
+    vec4 inverseRows[3];
+} pc;
+const vec3 white = vec3(.96422, 1., .82521);
+mat3 cameraToXyzMatrix() {
+    return transpose(mat3(pc.forwardRows[0].xyz, pc.forwardRows[1].xyz, pc.forwardRows[2].xyz));
+}
+mat3 xyzToCameraMatrix() {
+    return transpose(mat3(pc.inverseRows[0].xyz, pc.inverseRows[1].xyz, pc.inverseRows[2].xyz));
+}
+#define cameraToXyz cameraToXyzMatrix()
+#define xyzToCamera xyzToCameraMatrix()
+float labf(float t) { return t > 216. / 24389. ? pow(t, 1. / 3.) : (24389. / 27. * t + 16.) / 116.; }
+float labinv(float t) { return t > 6. / 29. ? t * t * t : 3. * (6. / 29.) * (6. / 29.) * (t - 4. / 29.); }
+vec3 toLab(vec3 rgb) {
+    vec3 v = cameraToXyz * rgb / white;
+    vec3 f = vec3(labf(v.x), labf(v.y), labf(v.z));
+    return vec3(116. * f.y - 16., 500. * (f.x - f.y), 200. * (f.y - f.z));
+}
+vec3 fromLab(vec3 v) {
+    float fy = (v.x + 16.) / 116.;
+    vec3 f = vec3(fy + v.y / 500., fy, fy - v.z / 200.);
+    return xyzToCamera * (white * vec3(labinv(f.x), labinv(f.y), labinv(f.z)));
+}
+float labY(float L) { return labinv((L + 16.) / 116.); }
+float huelabToHuehsv2(float h) {
+    float hr = 0.;
+    if (h >= 0. && h < .6) hr = .11666 * h + .93;
+    else if (h >= .6 && h < 1.4) hr = .1125 * h - .0675;
+    else if (h >= 1.4 && h < 2.) hr = .2666 * h - .2833;
+    else if (h >= 2.) hr = .1489 * h - .04785;
+    else if (h < -2.8) hr = .23419 * h + 1.1557;
+    else if (h < -2.3) hr = .16 * h + .948;
+    else if (h < -.9) hr = .12143 * h + .85928;
+    else if (h < -.1) hr = .2125 * h + .94125;
+    else hr = .1 * h + .93;
+    return hr < 0. ? hr + 1. : (hr > 1. ? hr - 1. : hr);
+}
+float flatCurveHalf(float u) {
+    float t = (.7 - sqrt(max(.49 - .8 * u, 0.))) / .4;
+    return .5 * t * t;
+}
+float hueWeight(vec2 ab) {
+    const float x0 = .668944571, xPeak = .8287775246, x1 = .9908883827, yPeak = .97835991;
+    float hr = huelabToHuehsv2(any(notEqual(ab, vec2(0.))) ? atan(ab.y, ab.x) : 0.);
+    float y = 0.;
+    if (hr > x0 && hr < xPeak) {
+        float u = (hr - x0) / (xPeak - x0);
+        y = yPeak * (u <= .5 ? flatCurveHalf(u) : 1. - flatCurveHalf(1. - u));
+    } else if (hr >= xPeak && hr < x1) {
+        float u = (hr - xPeak) / (x1 - xPeak);
+        y = yPeak * (u <= .5 ? 1. - flatCurveHalf(u) : flatCurveHalf(1. - u));
+    }
+    float c = y - .5;
+    c = c < 0. ? 2. * c : c;
+    return (1. + c) * (1. + c);
+}
+float purpleChroma(vec2 ab) { return min(hueWeight(ab), 1.) * length(ab); }
+const float kPurpleObjectLo = .38, kPurpleObjectHi = .48;
diff --git a/app/src/main/assets/iris26856/rawr/lab/lab_defringe_prepare.comp b/app/src/main/assets/iris26856/rawr/lab/lab_defringe_prepare.comp
new file mode 100644
index 0000000000000000000000000000000000000000..f919c79fc80114986cbde4098a65c70ac86ab7b1
--- /dev/null
+++ b/app/src/main/assets/iris26856/rawr/lab/lab_defringe_prepare.comp
@@ -0,0 +1,55 @@
+#version 310 es
+precision highp float;
+precision highp int;
+precision highp image2D;
+precision highp uimage2D;
+// RAWR ce767e80 pinned shader, same numeric algorithm; Vulkan push-constant -> std140 UBO.
+#include "lab_defringe_common.glsl"
+layout(local_size_x = 16, local_size_y = 16) in;
+layout(binding = 0, rgba16f) uniform readonly image2D src;
+layout(binding = 1, r32ui) uniform writeonly uimage2D dst;
+layout(std430, binding = 3) buffer Stats { float mean; float blocks[]; } stats;
+shared vec2 tile[24 * 24];
+shared vec2 horiz[24 * 16];
+shared float sums[256];
+const float gauss[9] = float[9](.02763055, .06628225, .12383154, .18017382, .20416369, .18017382, .12383154, .06628225, .02763055);
+shared float columns[16];
+void main() {
+    uint lane = gl_LocalInvocationIndex;
+    ivec2 origin = ivec2(gl_WorkGroupID.xy) * 16 - 4;
+    ivec2 maxp = ivec2(pc.width, pc.height) - 1;
+    for (uint i = lane; i < 576u; i += 256u) {
+        ivec2 q = clamp(origin + ivec2(i % 24u, i / 24u), ivec2(0), maxp);
+        tile[i] = toLab(imageLoad(src, q).rgb).yz;
+    }
+    barrier();
+    for (uint i = lane; i < 384u; i += 256u) {
+        uint x = i % 16u, y = i / 16u;
+        vec2 a = vec2(0);
+        for (uint k = 0u; k < 9u; k++) a += gauss[k] * tile[y * 24u + x + k];
+        horiz[i] = a;
+    }
+    barrier();
+    ivec2 local = ivec2(gl_LocalInvocationID.xy), p = ivec2(gl_GlobalInvocationID.xy);
+    vec2 lab = tile[(local.y + 4) * 24 + local.x + 4];
+    vec2 blur = vec2(0);
+    for (int k = 0; k < 9; k++) blur += gauss[k] * horiz[(local.y + k) * 16 + local.x];
+    vec2 delta = lab - blur;
+    float score = min(dot(delta, delta) * hueWeight(lab), 65504.);
+    bool valid = p.x < int(pc.width) && p.y < int(pc.height);
+    sums[lane] = valid ? score : 0.;
+    barrier();
+    if (valid && (p.x & 1) == 0)
+        imageStore(dst, ivec2(p.x / 2, p.y), uvec4(packHalf2x16(vec2(sums[lane], sums[lane + 1u])), 0u, 0u, 0u));
+    if (lane < 16u) {
+        float subtotal = 0.;
+        for (uint j = 0u; j < 16u; j++) subtotal += sums[lane + j * 16u];
+        columns[lane] = subtotal;
+    }
+    barrier();
+    if (lane == 0u) {
+        float total = 0.;
+        for (uint j = 0u; j < 16u; j++) total += columns[j];
+        stats.blocks[gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x] = total;
+    }
+}
diff --git a/app/src/main/assets/iris26856/rawr/lab/lab_defringe_reconstruct.comp b/app/src/main/assets/iris26856/rawr/lab/lab_defringe_reconstruct.comp
new file mode 100644
index 0000000000000000000000000000000000000000..0192531355e1f780f33d5df845aadcbba17283b1
--- /dev/null
+++ b/app/src/main/assets/iris26856/rawr/lab/lab_defringe_reconstruct.comp
@@ -0,0 +1,115 @@
+#version 310 es
+precision highp float;
+precision highp int;
+precision highp image2D;
+precision highp uimage2D;
+// RAWR ce767e80 pinned reconstruction, exact math; Vulkan push-constant -> std140 UBO.
+#include "lab_defringe_common.glsl"
+layout(local_size_x = 16, local_size_y = 16) in;
+layout(binding = 0, r32ui) uniform readonly uimage2D src;
+float scoreAt(ivec2 p) {
+    vec2 v = unpackHalf2x16(imageLoad(src, ivec2(p.x / 2, p.y)).x);
+    return (p.x & 1) == 0 ? v.x : v.y;
+}
+layout(binding = 1, rgba16f) uniform writeonly image2D dst;
+layout(binding = 2, rgba16f) uniform readonly image2D original;
+layout(std430, binding = 3) readonly buffer Stats { float mean; float blocks[]; } stats;
+shared float ls[576], as[576], bs[576], ws[576];
+const int kObjectRadius = 8, kObjectTile = 16 + 2 * kObjectRadius;
+shared float ps[kObjectTile * kObjectTile];
+shared uint groupNeeded;
+shared float maxima[256], columnMax[16], groupMax;
+void main() {
+    uint lane = gl_LocalInvocationIndex;
+    ivec2 p = ivec2(gl_GlobalInvocationID.xy), maxp = ivec2(pc.width, pc.height) - 1;
+    bool valid = p.x < int(pc.width) && p.y < int(pc.height);
+    vec4 orig = imageLoad(original, clamp(p, ivec2(0), maxp));
+    float score = scoreAt(clamp(p, ivec2(0), maxp));
+    float threshold = 5. * pow(pc.threshold / 33., 2.) * stats.mean;
+    bool candidate = valid && pc.strength > 0. && stats.mean > 1e-8 && score > .75 * threshold;
+    if (lane == 0u) groupNeeded = 0u;
+    barrier();
+    if (candidate) atomicOr(groupNeeded, 1u);
+    barrier();
+    if (groupNeeded == 0u) {
+        if (valid) imageStore(dst, p, orig);
+        return;
+    }
+    ivec2 origin = ivec2(gl_WorkGroupID.xy) * 16 - 4;
+    float localMax = 0.;
+    for (uint i = lane; i < 576u; i += 256u) {
+        ivec2 q = clamp(origin + ivec2(i % 24u, i / 24u), ivec2(0), maxp);
+        float Y = (cameraToXyz * imageLoad(original, q).rgb).y;
+        ls[i] = Y;
+        localMax = max(localMax, Y);
+    }
+    maxima[lane] = localMax;
+    barrier();
+    if (lane < 16u) {
+        float value = 0.;
+        for (uint i = 0u; i < 16u; i++) value = max(value, maxima[lane + 16u * i]);
+        columnMax[lane] = value;
+    }
+    barrier();
+    if (lane == 0u) {
+        float value = 0.;
+        for (uint i = 0u; i < 16u; i++) value = max(value, columnMax[i]);
+        groupMax = value;
+        groupNeeded = 0u;
+    }
+    barrier();
+    float centerY = (cameraToXyz * orig.rgb).y;
+    candidate = candidate && (pc.edgeMode <= 0. || groupMax - centerY > .10);
+    if (candidate) atomicOr(groupNeeded, 1u);
+    barrier();
+    if (groupNeeded == 0u) {
+        if (valid) imageStore(dst, p, orig);
+        return;
+    }
+    for (uint i = lane; i < 576u; i += 256u) {
+        ivec2 q = clamp(origin + ivec2(i % 24u, i / 24u), ivec2(0), maxp);
+        vec2 ab = unpackHalf2x16(packHalf2x16(clamp(toLab(imageLoad(original, q).rgb).yz, vec2(-65504.), vec2(65504.))));
+        float w = 1. / max(scoreAt(q) + stats.mean, 1e-8);
+        as[i] = ab.x * w;
+        bs[i] = ab.y * w;
+        ws[i] = w;
+    }
+    ivec2 objectOrigin = ivec2(gl_WorkGroupID.xy) * 16 - kObjectRadius;
+    for (uint i = lane; i < uint(kObjectTile * kObjectTile); i += 256u) {
+        ivec2 q = clamp(objectOrigin + ivec2(int(i) % kObjectTile, int(i) / kObjectTile), ivec2(0), maxp);
+        ps[i] = purpleChroma(toLab(imageLoad(original, q).rgb).yz);
+    }
+    barrier();
+    if (!valid) return;
+    if (!candidate) {
+        imageStore(dst, p, orig);
+        return;
+    }
+    vec3 lab = toLab(orig.rgb);
+    float confidence = smoothstep(.75 * threshold, 1.25 * threshold, score);
+    float maxY = centerY;
+    vec2 sum = vec2(0.);
+    float norm = 0., purpleMass = 0.;
+    ivec2 local = ivec2(gl_LocalInvocationID.xy);
+    for (int y = 0; y < 9; y++)
+        for (int x = 0; x < 9; x++) {
+            int at = (local.y + y) * 24 + local.x + x;
+            sum += vec2(as[at], bs[at]);
+            norm += ws[at];
+            maxY = max(maxY, ls[at]);
+        }
+    float edge = pc.edgeMode > 0. ? smoothstep(.10, .25, maxY - centerY) : 1.;
+    float similar = .5 * purpleChroma(lab.yz);
+    for (int y = 0; y <= 2 * kObjectRadius; y++)
+        for (int x = 0; x <= 2 * kObjectRadius; x++)
+            purpleMass += step(similar, ps[(local.y + y) * kObjectTile + local.x + x]);
+    const float objectArea = float((2 * kObjectRadius + 1) * (2 * kObjectRadius + 1));
+    float purpleShare = purpleMass / objectArea;
+    float object = smoothstep(kPurpleObjectLo, kPurpleObjectHi, purpleShare);
+    float weight = clamp(pc.strength * edge * confidence * (1. - object), 0., 1.);
+    if (weight <= 0.) {
+        imageStore(dst, p, orig);
+        return;
+    }
+    imageStore(dst, p, vec4(clamp(fromLab(vec3(lab.x, mix(lab.yz, sum / norm, weight))), vec3(-60000.), vec3(60000.)), orig.a));
+}
diff --git a/app/src/main/assets/iris26856/rawr/lab/lab_defringe_reduce.comp b/app/src/main/assets/iris26856/rawr/lab/lab_defringe_reduce.comp
new file mode 100644
index 0000000000000000000000000000000000000000..314a39e6ea5a3beb37922ff5fb97edd80044c6a5
--- /dev/null
+++ b/app/src/main/assets/iris26856/rawr/lab/lab_defringe_reduce.comp
@@ -0,0 +1,19 @@
+#version 310 es
+precision highp float;
+precision highp int;
+#include "lab_defringe_common.glsl"
+layout(local_size_x = 256) in;
+layout(std430, binding = 3) buffer Stats { float mean; float blocks[]; } stats;
+shared float sums[256];
+void main() {
+    uint i = gl_LocalInvocationIndex, n = ((pc.width + 15u) / 16u) * ((pc.height + 15u) / 16u);
+    float s = 0.;
+    for (uint j = i; j < n; j += 256u) s += stats.blocks[j];
+    sums[i] = s;
+    barrier();
+    for (uint k = 128u; k > 0u; k >>= 1u) {
+        if (i < k) sums[i] += sums[i + k];
+        barrier();
+    }
+    if (i == 0u) stats.mean = sums[0] / float(pc.width * pc.height);
+}
