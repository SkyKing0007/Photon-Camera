+                "hardBarrierFrontierCells=$hardBarrier openFrontierCells=$openFrontier " +
+                "barrierRawPx=0.50..1.25 equationsUnchanged=true readOnly=true"
+            PLog.i(SABRE_TAG, "IRIS_26626_SHORT_COMPONENT_PROPAGATION_PROOF $details")
+            MotionTrace.processingState("IRIS_26626_SHORT_COMPONENT_PROPAGATION_PROOF", details)
+            return ShortComponentDiagnostics26626(
