+    private fun reconstructTrue2x(
+        frames: List<RawStackFrame>,
+        images: List<SafeImage>,
+        evidence: List<True2xFrameEvidence>,
+        nativeVgnGuideTexture: Int,
+        preserveLinearRgbForDng: Boolean,
+        outputTuningSnr26761: Float,
+    ): True2xResult {
+        require(enableSabreSuperRes)
+        /* IRIS_26758_SR_DIRECT_CFA_ONLY_ROUTER
+         * Super Res is the existing full-frame true-2x GPU direct-CFA reconstruction. Plan B is
+         * not an active backend or fallback. Sabre/VGN remains RGB/chroma/highlight authority.
+         */
+        val route = "backend=DIRECT_CFA_GPU_ONLY normalEvidence=${evidence.size} " +
+            "adaptiveReject=true rgbChromaHighlightOwner=NATIVE_SABRE_VGN"
+        PLog.i(SABRE_TAG, "IRIS_26758_SR_COST_ROUTER $route")
+        MotionTrace.processingState("IRIS_26758_SR_COST_ROUTER", route)
+        return reconstructDirectTrue2x26733(
+            frames, images, evidence, nativeVgnGuideTexture, preserveLinearRgbForDng,
+            outputTuningSnr26761,
+        )
+    }
