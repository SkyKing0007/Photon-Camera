+                uniform1f(edgeFalseColorSuppressor26778Program, "uContrastLo", edgeFalseColor26778.contrastLo)
+                uniform1f(edgeFalseColorSuppressor26778Program, "uContrastHi", edgeFalseColor26778.contrastHi)
+                uniform1f(edgeFalseColorSuppressor26778Program, "uOutlierLo", edgeFalseColor26778.outlierLo)
