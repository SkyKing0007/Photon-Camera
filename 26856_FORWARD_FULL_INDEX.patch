+    private data class ShortEffectiveCoverageStats26606(
+        val nonzeroCells: Int,
+        val strongCells: Int,
+        val totalCells: Int,
+        val maximum: Float,
+        val mean: Float,
+        val retainedBytes: ByteArray? = null,
+    )
+
+    private fun readSabreShortEffectiveCoverage26606(
+        texture: Int,
+        textureWidth: Int,
+        textureHeight: Int,
+        marker: String,
+        retainBytes: Boolean = false,
+    ): ShortEffectiveCoverageStats26606 {
+        val bytes = readR8Mask(
+            texture,
+            marker,
+            maskWidth = textureWidth,
+            maskHeight = textureHeight,
+        )
+        var nonzero = 0
+        var strong = 0
+        var maximum = 0
+        var sum = 0L
+        bytes.forEach { raw ->
+            val value = raw.toInt() and 0xff
+            if (value > 0) nonzero++
+            if (value >= 128) strong++
+            maximum = maxOf(maximum, value)
+            sum += value.toLong()
+        }
+        val total = bytes.size.coerceAtLeast(1)
+        val details = "nonzero=$nonzero strong=$strong total=${bytes.size} " +
+            "max=${maximum / 255f} mean=${sum.toFloat() / (255f * total.toFloat())}"
+        PLog.i(SABRE_TAG, "$marker $details")
+        MotionTrace.processingState(marker, details)
+        return ShortEffectiveCoverageStats26606(
+            nonzeroCells = nonzero,
+            strongCells = strong,
+            totalCells = bytes.size,
+            maximum = maximum / 255f,
+            mean = sum.toFloat() / (255f * total.toFloat()),
+            retainedBytes = if (retainBytes) bytes else null,
+        )
+    }
+
+    /* IRIS_26624_SHORT_COMPONENT_RECOVERY_TELEMETRY
+     * Preserve 26623's device-proven broad-loss proxy while reporting the result after component-owned
+     * effective-loss rescue. A candidate is broad interior only when center + four cardinal neighbors
+     * are NORMAL-loss candidates. Support remains the exact post-source-clip target-accumulator bytes;
+     * this logger never changes weight, mask, CFA, flow, merge, resolve, or GPU lifetime. */
+    private fun logSabreShortBroadLossSupport26623(
+        loss: ByteArray?,
+        support: ByteArray?,
+        textureWidth: Int,
+        textureHeight: Int,
+    ) {
+        if (loss == null || support == null || textureWidth < 3 || textureHeight < 3
+            || loss.size != support.size || loss.size != textureWidth * textureHeight) return
+        var broadInterior = 0
+        var supported = 0
+        for (y in 1 until textureHeight - 1) {
+            val row = y * textureWidth
+            for (x in 1 until textureWidth - 1) {
+                val i = row + x
+                if ((loss[i].toInt() and 0xff) == 0
+                    || (loss[i - 1].toInt() and 0xff) == 0
+                    || (loss[i + 1].toInt() and 0xff) == 0
+                    || (loss[i - textureWidth].toInt() and 0xff) == 0
+                    || (loss[i + textureWidth].toInt() and 0xff) == 0) continue
+                broadInterior++
+                if ((support[i].toInt() and 0xff) > 0) supported++
+            }
+        }
+        val unsupported = (broadInterior - supported).coerceAtLeast(0)
+        val fraction = if (broadInterior > 0) supported.toFloat() / broadInterior.toFloat() else 0f
+        val details = "broadInteriorCells=$broadInterior broadSupportedCells=$supported " +
+            "broadUnsupportedCells=$unsupported broadSupportFraction=$fraction " +
+            "definition=centerPlus4CardinalNormalLoss support=postSourceClipTargetAccumulator " +
+            "componentMembership=literalPlusEffective boundaryProofRequired=true " +
+            "actualAlignedSameCfaShort=true noSpatialFill=true readOnly=true"
+        PLog.i(SABRE_TAG, "IRIS_26624_SHORT_COMPONENT_RECOVERY $details")
+        MotionTrace.processingState("IRIS_26624_SHORT_COMPONENT_RECOVERY", details)
+    }
+
+    /* IRIS_26638_SHORT_COMPONENT_SPATIAL_PROOF
+     * Read-only connected-component telemetry over the already-retained NORMAL-loss and final
+     * post-source-clip SHORT target-accumulator masks. No new GPU readback, no mask mutation,
+     * no lifetime extension beyond the existing retained ByteArrays. */
+    private fun logSabreShortLossComponents26638(
+        loss: ByteArray?,
+        support: ByteArray?,
+        textureWidth: Int,
+        textureHeight: Int,
+    ) {
+        if (loss == null || support == null || textureWidth <= 0 || textureHeight <= 0
+            || loss.size != support.size || loss.size != textureWidth * textureHeight) return
+        data class Component(
+            val cells: Int,
+            val minX: Int,
+            val minY: Int,
+            val maxX: Int,
+            val maxY: Int,
+            val strong: Int,
+            val weak: Int,
+            val zero: Int,
+            val sum: Long,
+        )
+        val visited = BooleanArray(loss.size)
+        val queue = IntArray(loss.size)
+        val components = ArrayList<Component>()
+        for (seed in loss.indices) {
+            if (visited[seed] || (loss[seed].toInt() and 0xff) == 0) continue
+            var head = 0
+            var tail = 0
+            queue[tail++] = seed
+            visited[seed] = true
+            var cells = 0
+            var minX = textureWidth
+            var minY = textureHeight
+            var maxX = -1
+            var maxY = -1
+            var strong = 0
+            var weak = 0
+            var zero = 0
+            var sum = 0L
+            while (head < tail) {
+                val i = queue[head++]
+                val x = i % textureWidth
+                val y = i / textureWidth
+                cells++
+                minX = minOf(minX, x); maxX = maxOf(maxX, x)
+                minY = minOf(minY, y); maxY = maxOf(maxY, y)
+                val value = support[i].toInt() and 0xff
+                sum += value.toLong()
+                when {
+                    value >= 128 -> strong++
+                    value > 0 -> weak++
+                    else -> zero++
+                }
+                if (x > 0) {
+                    val n = i - 1
+                    if (!visited[n] && (loss[n].toInt() and 0xff) > 0) {
+                        visited[n] = true; queue[tail++] = n
+                    }
+                }
+                if (x + 1 < textureWidth) {
+                    val n = i + 1
+                    if (!visited[n] && (loss[n].toInt() and 0xff) > 0) {
+                        visited[n] = true; queue[tail++] = n
+                    }
+                }
+                if (y > 0) {
+                    val n = i - textureWidth
+                    if (!visited[n] && (loss[n].toInt() and 0xff) > 0) {
+                        visited[n] = true; queue[tail++] = n
+                    }
+                }
+                if (y + 1 < textureHeight) {
+                    val n = i + textureWidth
+                    if (!visited[n] && (loss[n].toInt() and 0xff) > 0) {
+                        visited[n] = true; queue[tail++] = n
+                    }
+                }
+            }
+            components.add(Component(cells, minX, minY, maxX, maxY, strong, weak, zero, sum))
+        }
+        components.sortByDescending { it.cells }
+        val reportCount = minOf(8, components.size)
+        for (rank in 0 until reportCount) {
+            val c = components[rank]
+            val supported = c.strong + c.weak
+            val mean = if (c.cells > 0) c.sum.toFloat() / (255f * c.cells.toFloat()) else 0f
+            val details = "rank=${rank + 1} bbox=[${c.minX},${c.minY}]-[${c.maxX},${c.maxY}] " +
+                "targetCells=${c.cells} strong=${c.strong} weak=${c.weak} zero=${c.zero} " +
+                "postSourceClipSupported=$supported postSourceClipUnsupported=${c.zero} " +
+                "meanFinalRescue=$mean connectivity=4 literalOrEffectiveLossComponent=true readOnly=true"
+            PLog.i(SABRE_TAG, "IRIS_26638_SHORT_COMPONENT_SPATIAL_PROOF $details")
+            MotionTrace.processingState("IRIS_26638_SHORT_COMPONENT_SPATIAL_PROOF", details)
+        }
+        val summary = "components=${components.size} reported=$reportCount " +
+            "support=postSourceClipTargetAccumulator bboxDomain=runtimeLossMask " +
+            "newGpuReadback=false"
+        PLog.i(SABRE_TAG, "IRIS_26638_SHORT_COMPONENT_SPATIAL_SUMMARY $summary")
+        MotionTrace.processingState("IRIS_26638_SHORT_COMPONENT_SPATIAL_SUMMARY", summary)
+    }
