+    private fun hasRowFlickerEvidence26720(frame: RawStackFrame): Boolean =
+        frame.role == RawBurstFrameRole.NORMAL && frame.rowFlickerHarmonic > 0 &&
+            frame.rowFlickerStrength.isFinite() && frame.rowFlickerStrength > 0f &&
+            frame.rowFlickerA.isFinite() && frame.rowFlickerB.isFinite()
+
+    private fun highZoomObservationQuality26720(
+        frame: RawStackFrame,
+        reference: RawStackFrame,
+        medianGyro: Float,
+    ): Float {
+        val gyroQuality = if (frame.gyroSampleCount > 0 && frame.gyroShakiness.isFinite() &&
+            frame.gyroShakiness >= 0f && medianGyro.isFinite() && medianGyro > 1.0e-8f) {
+            (medianGyro / max(frame.gyroShakiness, medianGyro)).coerceIn(0.45f, 1f)
+        } else 1f
+        val focusQuality = if (frame.focusDistanceDiopters.isFinite() &&
+            reference.focusDistanceDiopters.isFinite() && frame.focusDistanceDiopters >= 0f &&
+            reference.focusDistanceDiopters >= 0f) {
+            val delta = kotlin.math.abs(frame.focusDistanceDiopters - reference.focusDistanceDiopters)
+            val t = ((delta - 0.04f) / 0.14f).coerceIn(0f, 1f)
+            val smooth = t * t * (3f - 2f * t)
+            (1f - 0.40f * smooth).coerceIn(0.60f, 1f)
+        } else 1f
+        return (gyroQuality * focusQuality).coerceIn(0.35f, 1f)
+    }
