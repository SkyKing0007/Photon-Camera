+            val byteCount = Math.multiplyExact(Math.multiplyExact(gridWidth, gridHeight), 4)
+            val buffer = ByteBuffer.allocateDirect(byteCount)
+            bindRenderTargets(intArrayOf(diagnostic), "26626 SHORT component diagnostic readback")
