+    /* IRIS_26758_PHASE_DIVERSE_DIRECT_CFA_EVIDENCE
+     * The base Sabre merge still consumes every admitted NORMAL. The auxiliary high-resolution
+     * detail sidecar uses at most the strongest two observations per global quarter-pixel phase,
+     * including the immutable reference. This bounds zoom cost without changing capture count or
+     * RGB/chroma/noise ownership. Selection uses only evidence already produced by Sabre.
+     */
+    private fun selectDirectCfaEvidence26758(all: List<True2xFrameEvidence>): List<True2xFrameEvidence> {
+        require(all.isNotEmpty())
+        val reference = all.firstOrNull { it.frameIndex == 0 } ?: all.first()
+        val selected = ArrayList<True2xFrameEvidence>(TRUE2X_JPEG_MAX_EVIDENCE)
+        for (phase in 0 until 4) {
+            val phaseEvidence = all.filter { it.dominantPhaseBin == phase }
+                .sortedWith(compareByDescending<True2xFrameEvidence> { if (it.frameIndex == reference.frameIndex) Float.POSITIVE_INFINITY else it.qualityScore }
+                    .thenBy { it.frameIndex })
+            phaseEvidence.take(TRUE2X_JPEG_EVIDENCE_PER_PHASE).forEach { ev ->
+                if (selected.none { it.frameIndex == ev.frameIndex }) selected += ev
+            }
+        }
+        if (selected.none { it.frameIndex == reference.frameIndex }) {
+            if (selected.size >= TRUE2X_JPEG_MAX_EVIDENCE) selected.removeAt(selected.lastIndex)
+            selected.add(0, reference)
+        }
+        if (selected.size < minOf(4, all.size)) {
+            all.asSequence().filter { ev -> selected.none { it.frameIndex == ev.frameIndex } }
+                .sortedByDescending { it.qualityScore }
+                .take(minOf(4, all.size) - selected.size)
+                .forEach { selected += it }
+        }
+        return selected.take(TRUE2X_JPEG_MAX_EVIDENCE)
+    }
+
+    /* IRIS_26757_EVIDENCE_LIMITED_PLAN_B
+     * Sabre still merges every admitted NORMAL. Plan B is only a scalar detail sidecar, so its
+     * Fourier system uses the smallest phase-diverse evidence basis with redundancy: up to six
+     * observations for <=2x and nine for <=3x. This intentionally replaces 26753's all-NORMAL
+     * Plan-B solve while preserving every frame in the RGB/chroma/noise merge.
+     */
+    private fun planBSupportedScale26757(normalEvidenceCount: Int): Float = when {
+        normalEvidenceCount >= 9 -> 3f
+        normalEvidenceCount >= 4 -> 2f
+        else -> 1f
+    }
+
+    private fun selectPlanBEvidence26757(
+        all: List<True2xFrameEvidence>,
+        requestedScale: Float,
+    ): List<True2xFrameEvidence> {
+        require(all.isNotEmpty())
+        val reference = all.firstOrNull { it.frameIndex == 0 } ?: all.first()
+        val required = if (requestedScale > 2.05f) 9 else 6
+        val target = minOf(all.size, required).coerceAtLeast(minOf(all.size, 4))
+        if (all.size <= target) return all
+        data class Candidate(val ev: True2xFrameEvidence, val px: Float, val py: Float)
+        fun phase(v: Float): Float {
+            val f = v - kotlin.math.floor(v.toDouble()).toFloat()
+            return if (f < 0f) f + 1f else f
+        }
+        val candidates = all.mapNotNull { ev ->
+            val shift = planBGlobalTranslation26753(ev, reference.frameIndex) ?: return@mapNotNull null
+            Candidate(ev, phase(shift.first), phase(shift.second))
+        }.toMutableList()
+        require(candidates.any { it.ev.frameIndex == reference.frameIndex })
+        val selected = ArrayList<Candidate>(target)
+        val ref = candidates.first { it.ev.frameIndex == reference.frameIndex }
+        selected += ref
+        candidates.remove(ref)
+        fun torusDistance2(a: Candidate, b: Candidate): Float {
+            val dx0 = kotlin.math.abs(a.px - b.px)
+            val dy0 = kotlin.math.abs(a.py - b.py)
+            val dx = minOf(dx0, 1f - dx0)
+            val dy = minOf(dy0, 1f - dy0)
+            return dx * dx + dy * dy
+        }
+        while (selected.size < target && candidates.isNotEmpty()) {
+            val best = candidates.maxWithOrNull(compareBy<Candidate> { c ->
+                selected.minOf { torusDistance2(c, it) }
+            }.thenBy { it.ev.qualityScore }.thenBy { -it.ev.frameIndex }) ?: break
+            selected += best
+            candidates.remove(best)
+        }
+        require(selected.size >= minOf(target, 4)) { "26757 insufficient phase-diverse Plan-B evidence" }
+        return selected.map { it.ev }
+    }
+
+    private fun planBMemoryBudgetBytes26753(): Long {
+        /* IRIS_26755_PROCESS_SAFE_TILE_BUDGET
+         * Java maxHeap does not represent Camera2/native/GLES residency. Keep the solver's own
+         * peak bounded to 32 MiB after RAW release and let the existing estimator/workers shrink
+         * further as needed.
+         */
+        return PLAN_B_MAX_MEMORY_BYTES_26753
+    }
+
+    /* IRIS_26755_PLAN_B_RAW_LIFETIME_OWNER
+     * Sabre/VGN has already consumed the full RAW burst before Plan B starts. Stage every admitted
+     * NORMAL observation to an independent immutable cache file, prove the complete population,
+     * then release all original SafeImage/ImageFrame RAW owners before any Fourier allocation.
+     */
+    private data class PlanBRawStage26755(
+        val images: List<SafeImage>,
+        val ownedDiskImages: List<SafeImage>,
+        val stagedBytes: Long,
+        val releasedBytes: Long,
+    ) : AutoCloseable {
+        override fun close() { ownedDiskImages.forEach { runCatching { it.close() } } }
+    }
+
+    private fun processRssBytes26755(): Long = runCatching {
+        File("/proc/self/status").useLines { lines ->
+            val row = lines.firstOrNull { it.startsWith("VmRSS:") } ?: return@useLines -1L
+            val kb = row.substringAfter(':').trim().substringBefore(' ').toLong()
+            kb * 1024L
+        }
+    }.getOrDefault(-1L)
+
+    private fun stagePlanBRawEvidence26755(
+        images: List<SafeImage>,
+        evidence: List<True2xFrameEvidence>,
+    ): PlanBRawStage26755 {
+        val directory = checkNotNull(sabreSuperResTempDir)
+        val indices = evidence.map { it.frameIndex }
+        require(indices.distinct().size == indices.size) { "26755 duplicate Plan-B evidence frame index" }
+        require(indices.all { it in images.indices }) { "26755 Plan-B evidence index outside image list" }
+        val deadlineNs = System.nanoTime() + PLAN_B_RAW_STAGE_MAX_MS_26755 * 1_000_000L
+        val beforeRss = processRssBytes26755()
+        val mapped = images.toMutableList()
+        val owned = ArrayList<SafeImage>(indices.size)
+        var stagedBytes = 0L
+        val releaseBytes = images.filterNot { it.isFileBacked }
+            .sumOf { it.rowStrideBytes.toLong() * it.height.toLong() }
+        PLog.i(SABRE_TAG, "IRIS_26755_PLAN_B_MEMORY_BEFORE_RAW_RELEASE rssBytes=$beforeRss " +
+            "frames=${images.size} admittedNormals=${indices.size} rawOwnedBytes=$releaseBytes")
+        MotionTrace.processingState(
+            "IRIS_26755_PLAN_B_MEMORY_BEFORE_RAW_RELEASE",
+            "rssBytes=$beforeRss frames=${images.size} admittedNormals=${indices.size} rawOwnedBytes=$releaseBytes",
+        )
+        try {
+            indices.forEachIndexed { ordinal, index ->
+                check(System.nanoTime() < deadlineNs) { "26755 RAW staging deadline before frame=$ordinal" }
+                val source = images[index]
+                val file = File(directory, "iris26755_planb_raw_${ordinal}_${source.timestamp}_${System.nanoTime()}.raw16")
+                val staged = source.copyRawBackingTo(file, deadlineNs)
+                require(staged.isFileBacked && file.isFile) { "26755 staged RAW backing missing frame=$ordinal" }
+                val expected = source.rowStrideBytes.toLong() * source.height.toLong()
+                require(file.length() == expected) { "26755 staged RAW byte mismatch frame=$ordinal" }
+                mapped[index] = staged
+                owned += staged
+                stagedBytes += expected
+            }
+            require(owned.size == indices.size) { "26755 staged RAW population changed" }
+            // Only after every admitted NORMAL has an independent proven backing may old owners die.
+            images.forEach { it.close() }
+            val afterRss = processRssBytes26755()
+            PLog.i(SABRE_TAG, "IRIS_26755_PLAN_B_MEMORY_AFTER_RAW_RELEASE rssBytes=$afterRss " +
+                "rssDeltaBytes=${if (beforeRss >= 0L && afterRss >= 0L) beforeRss - afterRss else -1L} " +
+                "stagedBytes=$stagedBytes releasedRawBytes=$releaseBytes diskBackedNormals=${owned.size}")
+            MotionTrace.processingState(
+                "IRIS_26755_PLAN_B_MEMORY_AFTER_RAW_RELEASE",
+                "rssBytes=$afterRss rssDeltaBytes=${if (beforeRss >= 0L && afterRss >= 0L) beforeRss - afterRss else -1L} " +
+                    "stagedBytes=$stagedBytes releasedRawBytes=$releaseBytes diskBackedNormals=${owned.size}",
+            )
+            return PlanBRawStage26755(mapped, owned, stagedBytes, releaseBytes)
+        } catch (t: Throwable) {
+            owned.forEach { runCatching { it.close() } }
+            throw t
+        }
+    }
+
+    private fun planBEstimatedTileBytes26753(
+        frameCount: Int,
+        inputWidth: Int,
+        inputHeight: Int,
+        outputWidth: Int,
+        outputHeight: Int,
+        workers: Int,
+    ): Long {
+        fun fftPlanBytes(n: Int): Long {
+            if (n <= 0 || (n and (n - 1)) == 0) return 0L
+            val target = 2L * n - 1L
+            var power = 1L
+            while (power < target) power = Math.multiplyExact(power, 2L)
+            return (n.toLong() + power) * 8L
+        }
+        val inputPixels = inputWidth.toLong() * inputHeight.toLong()
+        val outputPixels = outputWidth.toLong() * outputHeight.toLong()
+        val observations = frameCount.toLong() * inputPixels * 8L
+        val outputComplex = outputPixels * 8L
+        val mappedLuma = inputPixels * Float.SIZE_BYTES
+        val lines = workers.toLong() * 2L * maxOf(inputWidth, inputHeight, outputWidth, outputHeight) * 8L
+        val solver = 8L * (2L * frameCount) * (2L * frameCount) * java.lang.Double.BYTES
+        val fftPlans = fftPlanBytes(inputWidth) + fftPlanBytes(inputHeight) +
+            fftPlanBytes(outputWidth) + fftPlanBytes(outputHeight)
+        return observations + outputComplex + mappedLuma + lines + solver + fftPlans + PLAN_B_NATIVE_RESERVE_BYTES_26753
+    }
+
+    private fun planBCoreOutputTile26753(
+        frameCount: Int,
+        cropWidth: Int,
+        cropHeight: Int,
+        outputWidth: Int,
+        outputHeight: Int,
+        memoryBudgetBytes: Long,
+    ): Int {
+        for (candidate in PLAN_B_CORE_TILE_CANDIDATES_26753) {
+            val expandedOutW = minOf(outputWidth, candidate + 2 * PLAN_B_OUTPUT_OVERLAP_26753)
+            val expandedOutH = minOf(outputHeight, candidate + 2 * PLAN_B_OUTPUT_OVERLAP_26753)
+            val sourceW = kotlin.math.ceil(expandedOutW.toDouble() * cropWidth / outputWidth).toInt().coerceAtLeast(1)
+            val sourceH = kotlin.math.ceil(expandedOutH.toDouble() * cropHeight / outputHeight).toInt().coerceAtLeast(1)
+            val estimated = planBEstimatedTileBytes26753(frameCount, sourceW, sourceH, expandedOutW, expandedOutH, 1)
+            if (estimated <= memoryBudgetBytes * 3L / 4L) return candidate
+        }
+        throw IllegalStateException(
+            "26753 Plan-B memory preflight failed frames=$frameCount crop=${cropWidth}x$cropHeight " +
+                "output=${outputWidth}x$outputHeight budget=$memoryBudgetBytes",
+        )
+    }
+
+    /* IRIS_26753_IPOL_PLAN_B_RECONSTRUCTION_OWNER
+     * Pure Plan B, crop-first and direct to the lens publication grid. All same-lens NORMAL frames
+     * are retained. Work is streamed as bounded overlapping spatial tiles; no full-frame Fourier
+     * spectra coexist in RAM and there is no second scaler. Each tile performs one direct WLS solve;
+     * robustly detected frame outliers alone may trigger <=5 early-stopping IRLS updates.
+     */
+    private fun reconstructPlanB26753(
+        frames: List<RawStackFrame>,
+        images: List<SafeImage>,
+        evidence: List<True2xFrameEvidence>,
+        nativeVgnGuideTexture: Int,
+        publicationScale: Float,
+    ): PlanBReconstruction26753 {
+        require(publicationScale == 1f || publicationScale == 2f)
+        require(evidence.isNotEmpty())
+        val directory = checkNotNull(sabreSuperResTempDir)
+        require(directory.exists() || directory.mkdirs())
+        require(evidence.all { it.frameIndex in frames.indices && it.frameIndex in images.indices }) {
+            "26753 Plan-B evidence index outside immutable burst"
+        }
+        require(evidence.all { frames[it.frameIndex].role == RawBurstFrameRole.NORMAL }) {
+            "26753 Plan-B evidence must be NORMAL-only"
+        }
+        val reference = evidence.firstOrNull { it.frameIndex == 0 } ?: evidence.first()
+        require(reference.frameIndex == 0) { "26753 Plan-B reference NORMAL frame missing" }
+        val referencePhysicalCameraId = frames[reference.frameIndex].physicalCameraId
+        require(!referencePhysicalCameraId.isNullOrBlank()) { "26754 Plan-B reference physical camera ID missing" }
+        require(evidence.all { frames[it.frameIndex].physicalCameraId == referencePhysicalCameraId }) {
+            "26754 Plan-B cross-physical-camera evidence rejected referencePhysicalCameraId=$referencePhysicalCameraId"
+        }
+        /* Camera2 LENS_STATE is actuator telemetry only. Focus movement is explicitly allowed. */
+        val lensStateTransitions = evidence.map { frames[it.frameIndex].lensState }.filterNotNull().distinct().size
+        require(evidence.size >= 4) { "26753 Plan-B needs >=4 same-lens NORMAL frames, got=${evidence.size}" }
+        val gyroSupportFrames = evidence.count { ev ->
+            val frame = frames[ev.frameIndex]
+            frame.gyroSampleCount > 0 && frame.gyroShakiness.isFinite() && frame.gyroShakiness >= 0f
+        }
+        require(evidence.none { ev ->
+            val frame = frames[ev.frameIndex]
+            frame.gyroSampleCount > 0 && (!frame.gyroShakiness.isFinite() || frame.gyroShakiness < 0f)
+        }) { "26753 Plan-B invalid gyro support metadata" }
+        val translations = evidence.map { ev ->
+            val shift = requireNotNull(planBGlobalTranslation26753(ev, reference.frameIndex)) {
+                "26753 Plan-B translation proof missing frame=${ev.frameIndex}; fixed frame count forbids silent drop"
+            }
+            PlanBTranslation26753(ev, shift.first, shift.second)
+        }
+        require(translations.size == evidence.size) { "26753 fixed Plan-B frame population changed" }
+        val maxShiftX = translations.maxOf { kotlin.math.abs(it.dx) }
+        val maxShiftY = translations.maxOf { kotlin.math.abs(it.dy) }
+        val visibleWidth = kotlin.math.ceil(width / highZoomSourceZoom.toDouble()).toInt().coerceIn(1, width)
+        val visibleHeight = kotlin.math.ceil(height / highZoomSourceZoom.toDouble()).toInt().coerceIn(1, height)
+        val cropWidth = visibleWidth
+        val cropHeight = visibleHeight
+        val cropX = ((width - cropWidth) / 2).coerceAtLeast(0)
+        val cropY = ((height - cropHeight) / 2).coerceAtLeast(0)
+        val requestedModelScale = if (publicationScale > 1.5f) 2f
+            else minOf(highZoomSourceZoom, planBSupportedScale26757(translations.size))
+        require(requestedModelScale >= 1f)
+        val targetOutputWidth = kotlin.math.ceil(cropWidth * requestedModelScale.toDouble()).toInt().coerceAtMost(
+            Math.multiplyExact(width, publicationScale.toInt()),
+        )
+        val targetOutputHeight = kotlin.math.ceil(cropHeight * requestedModelScale.toDouble()).toInt().coerceAtMost(
+            Math.multiplyExact(height, publicationScale.toInt()),
+        )
+        val outputWidth = targetOutputWidth
+        val outputHeight = targetOutputHeight
+        val scaleX = outputWidth.toFloat() / cropWidth.toFloat()
+        val scaleY = outputHeight.toFloat() / cropHeight.toFloat()
+        val startNs = System.nanoTime()
+        val stageDeadlineNs = startNs + PLAN_B_STAGE_MAX_MS_26753 * 1_000_000L
+        val memoryBudgetBytes = planBMemoryBudgetBytes26753()
+        val coreTile = planBCoreOutputTile26753(
+            translations.size, cropWidth, cropHeight, outputWidth, outputHeight, memoryBudgetBytes,
+        )
+        val tilesX = (outputWidth + coreTile - 1) / coreTile
+        val tilesY = (outputHeight + coreTile - 1) / coreTile
