+    /* IRIS_26753_IPOL_PLAN_B_TRANSLATION_VALIDATION
+     * The paper's geometry remains translation-only. Iris optical-flow registration is the pixel
+     * geometry owner. Gyro evidence is used only as independent camera-motion support because the
+     * current RawStackFrame contract has no calibrated per-frame OIS pixel displacement; OIS is
+     * therefore never invented as geometry. A missing translation fails the complete Plan-B solve
+     * instead of silently reducing the user's fixed frame count.
+     */
+    private fun planBGlobalTranslation26753(
+        ev: True2xFrameEvidence,
+        referenceFrameIndex: Int,
+    ): Pair<Float, Float>? {
+        if (ev.frameIndex == referenceFrameIndex) return 0f to 0f
+        val values = ev.flowData.duplicate().order(ByteOrder.nativeOrder()).asShortBuffer()
+        val xs = ArrayList<Float>()
+        val ys = ArrayList<Float>()
+        for (index in 0 until ev.flowWidth * ev.flowHeight) {
+            val confidence = Half.toFloat(values.get(index * 4 + 3))
+            if (!confidence.isFinite() || confidence <= 0.5f) continue
+            val fx = Half.toFloat(values.get(index * 4)) * width.toFloat()
+            val fy = Half.toFloat(values.get(index * 4 + 1)) * height.toFloat()
+            if (fx.isFinite() && fy.isFinite()) {
+                xs += fx
+                ys += fy
+            }
+        }
+        if (xs.size < 16) return null
+        xs.sort(); ys.sort()
+        fun median(v: List<Float>): Float {
+            val n = v.size
+            return if ((n and 1) != 0) v[n / 2] else 0.5f * (v[n / 2 - 1] + v[n / 2])
+        }
+        val mx = median(xs)
+        val my = median(ys)
+        if (!mx.isFinite() || !my.isFinite()) return null
+        return -mx to -my
+    }
+
+    private fun writePlanBLumaFrame26753(
+        image: SafeImage,
+        ev: True2xFrameEvidence,
+        cropX: Int,
+        cropY: Int,
+        cropWidth: Int,
+        cropHeight: Int,
+        output: File,
+    ) {
+        RandomAccessFile(output, "rw").use { it.setLength(cropWidth.toLong() * cropHeight * Float.SIZE_BYTES) }
+        val tileMaxWidth = 512
+        val tileMaxHeight = 128
+        var top = 0
+        while (top < cropHeight) {
+            val tileHeight = minOf(tileMaxHeight, cropHeight - top)
+            var left = 0
+            while (left < cropWidth) {
+                val tileWidth = minOf(tileMaxWidth, cropWidth - left)
+                val globalLeft = cropX + left
+                val globalTop = cropY + top
+                val rawLeft = (globalLeft - 2).coerceAtLeast(0)
+                val rawTop = (globalTop - 2).coerceAtLeast(0)
+                val rawRight = (globalLeft + tileWidth + 2).coerceAtMost(width)
+                val rawBottom = (globalTop + tileHeight + 2).coerceAtMost(height)
+                val rawWidth = rawRight - rawLeft
+                val rawHeight = rawBottom - rawTop
+                val rawRect = intArrayOf(rawLeft, rawTop, rawRight, rawBottom)
+                val covRect = true2xRawScaledRegion(
+                    rawRect, ev.covarianceWidth, ev.covarianceHeight, TRUE2X_EVIDENCE_HALO,
+                )
+                val covLeft = covRect[0]
+                val covTop = covRect[1]
+                val covWidth = covRect[2] - covLeft
+                val covHeight = covRect[3] - covTop
+                readTrue2xRawRegion(image, rawLeft, rawTop, rawWidth, rawHeight).use { raw ->
+                    val covariance = readTrue2xFileRegion(
+                        ev.covarianceFile, ev.covarianceWidth, 4,
+                        covLeft, covTop, covWidth, covHeight, "IRIS26753 Plan-B covariance",
+                    )
+                    try {
+                        check(
+                            IrisTrue2xSrNative.writePlanBLumaTile(
+                                output.absolutePath, cropWidth, cropHeight,
+                                left, top, tileWidth, tileHeight,
+                                cropX, cropY,
+                                raw.buffer, rawLeft, rawTop, rawWidth, rawHeight, raw.rowStrideSamples,
+                                covariance, covLeft, covTop, covWidth, covHeight,
+                                ev.covarianceWidth, ev.covarianceHeight,
+                                width, height, cfaPattern,
+                                ev.calibration.gains, ev.calibration.blackTerms,
+                                floatArrayOf(
+                                    COV_MIN_R, COV_MAX_R - COV_MIN_R,
+                                    COV_MIN_G, COV_MAX_G - COV_MIN_G,
+                                ),
+                                floatArrayOf(COV_MIN_B, COV_MAX_B - COV_MIN_B),
+                                cameraDomainScale, lensShading, lensShadingWidth, lensShadingHeight,
+                            )
+                        ) { "26753 Plan-B luma tile failed frame=${ev.frameIndex} tile=$left,$top" }
+                    } finally {
+                        LargeDirectBuffer.free(covariance)
+                    }
+                }
+                left += tileWidth
+            }
+            top += tileHeight
+        }
+        require(output.length() == cropWidth.toLong() * cropHeight * Float.SIZE_BYTES) {
+            "26753 Plan-B luma carrier size mismatch frame=${ev.frameIndex}"
+        }
+    }
