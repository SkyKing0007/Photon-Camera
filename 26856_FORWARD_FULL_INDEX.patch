+            GLES31.glBindBufferBase(GLES31.GL_SHADER_STORAGE_BUFFER, 0, 0)
+            GLES31.glBindBuffer(GLES31.GL_SHADER_STORAGE_BUFFER, 0)
+            if (buffers.remove(statsBuffer)) GLES31.glDeleteBuffers(1, intArrayOf(statsBuffer), 0)
+        }
+    }
