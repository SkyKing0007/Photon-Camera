@@ -0,0 +1,15 @@
+#version 450
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Writes one tile's AMaZE result into the caller's RGBA16F image, removing the
+// white balance applied for AMaZE so the output is camera-linear like RCD's.
+layout(local_size_x = 16, local_size_y = 16) in;
+#include "amaze_tile.glsl"
+layout(std430, set = 0, binding = 2) readonly buffer TileOutput { vec4 rgb[]; } result;
+layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D outputImage;
+void main() {
+    uvec2 l = gl_GlobalInvocationID.xy;
+    if (l.x >= tile.outWidth || l.y >= tile.outHeight) return;
+    vec3 rgb = result.rgb[TILE_SLOT * kOutPix + l.y * tile.outWidth + l.x].rgb / vec3(tile.wbR, tile.wbG, tile.wbB);
+    imageStore(outputImage, ivec2(tile.outOriginX + l.x, tile.outOriginY + l.y),
+               vec4(rgb * tile.outputScale, tile.outputAlpha));
+}
diff --git a/app/src/main/cpp/iris26856/amaze/shaders/amaze_import.comp b/app/src/main/cpp/iris26856/amaze/shaders/amaze_import.comp
new file mode 100644
index 0000000000000000000000000000000000000000..ee0b82e1835d890da6837d1fa3bea1b8aefb3f1c
--- /dev/null
+++ b/app/src/main/cpp/iris26856/amaze/shaders/amaze_import.comp
@@ -0,0 +1,23 @@
+#version 450
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copies one tile of the CFA into the AMaZE source buffer as f32 bits
+// (amaze.wgsl reads them with sourceIsFloat = 1 and applies WB). Input is either
+// the packed half-resolution RGBA16F image (inputMode 0) or a full-resolution
+// float buffer in the 0..255 working domain (inputMode 1, rcd::NormalizedBayerBufferView).
+layout(local_size_x = 16, local_size_y = 16) in;
+#include "amaze_tile.glsl"
+layout(std430, set = 0, binding = 0) writeonly buffer Source { uint words[]; } source;
+layout(set = 0, binding = 5) uniform sampler2D packedInput;
+layout(std430, set = 0, binding = 7) readonly buffer Normalized { float bayer255[]; } normalizedInput;
+void main() {
+    uvec2 l = gl_GlobalInvocationID.xy;
+    if (l.x >= tile.srcWidth || l.y >= tile.srcHeight) return;
+    ivec2 g = ivec2(tile.srcOriginX + l.x, tile.srcOriginY + l.y);
+    float v;
+    if (tile.inputMode > 0.5) {
+        v = normalizedInput.bayer255[uint(g.y) * uint(tile.inputWidth) + uint(g.x)] * (1.0 / 255.0);
+    } else {
+        v = texelFetch(packedInput, g >> 1, 0)[cfaComponent(g, uint(tile.pattern))];
+    }
+    source.words[TILE_SLOT * kSrcPix + l.y * tile.srcWidth + l.x] = floatBitsToUint(v);
+}
diff --git a/app/src/main/cpp/iris26856/amaze/shaders/amaze_tile.glsl b/app/src/main/cpp/iris26856/amaze/shaders/amaze_tile.glsl
new file mode 100644
index 0000000000000000000000000000000000000000..2d3dac1840b08e9030f7dfb5529ae7a139fc55d5
--- /dev/null
+++ b/app/src/main/cpp/iris26856/amaze/shaders/amaze_tile.glsl
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Tile ABI shared with amaze.wgsl (Params) and src/Pipeline.cpp (TileParams).
+#ifndef RAWR_AMAZE_TILE_GLSL
+#define RAWR_AMAZE_TILE_GLSL
+struct TileParams {
+    uint srcOriginX, srcOriginY, srcWidth, srcHeight;
+    uint outOriginX, outOriginY, outWidth, outHeight;
+    uint cfa00, cfa10, cfa01, cfa11;
+    float blackR, blackG0, blackG1, blackB;
+    float white, wbR, wbG, wbB;
+    float color00, color01, color02, color10;
+    float color11, color12, color20, color21;
+    float color22, sourceIsFloat, outputScale, outputAlpha;
+    float inputMode, inputWidth, pattern, reserved;  // amaze.wgsl: highlight_reconstruction, _pad3
+};
+// One dispatch covers a batch of tiles; workgroup z selects the tile and its slot.
+layout(std430, set = 0, binding = 1) readonly buffer TileParamsBatch { TileParams tiles[]; };
+#define tile tiles[gl_WorkGroupID.z]
+#define TILE_SLOT gl_WorkGroupID.z
+// Per-tile slot sizes, shared with amaze.wgsl (SRC_PIX / OUT_PIX).
+const uint kSrcPix = 25600u;
+const uint kOutPix = 16384u;
+
+// Packed {R,G1,G2,B} component at raw position p for BayerPattern (rcd_common.glsl).
+int cfaComponent(ivec2 p, uint pattern) {
+    int x = p.x & 1, y = p.y & 1;
+    if (pattern == 0u) return y == 0 ? (x == 0 ? 0 : 1) : (x == 0 ? 2 : 3);  // RGGB
+    if (pattern == 1u) return y == 0 ? (x == 0 ? 1 : 0) : (x == 0 ? 3 : 2);  // GRBG
+    if (pattern == 2u) return y == 0 ? (x == 0 ? 2 : 3) : (x == 0 ? 0 : 1);  // GBRG
+    return y == 0 ? (x == 0 ? 3 : 2) : (x == 0 ? 1 : 0);                        // BGGR
+}
+#endif
diff --git a/app/src/main/cpp/iris26856/amaze/src/AmazeGlVulkanJni.cpp b/app/src/main/cpp/iris26856/amaze/src/AmazeGlVulkanJni.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..17538a9a24304cf3bbe8933528e3b2564fb76cd7
--- /dev/null
+++ b/app/src/main/cpp/iris26856/amaze/src/AmazeGlVulkanJni.cpp
@@ -0,0 +1,277 @@
+// IRIS_26856_B_ONLY_GL_VULKAN_AMAZE_JNI_OWNER
+// Single GL-thread ownership boundary. No CPU pixel mapping or fallback.
+#include "amaze/Amaze.hpp"
+#include "amaze/CommandSubmissionOwner.hpp"
+#include "amaze/ExternalFenceSync.hpp"
+#include "amaze/HardwareBufferImport.hpp"
+#include "amaze/PinnedSpirvAssets.hpp"
+#include "amaze/VulkanDeviceOwner.hpp"
+
+#include <jni.h>
+#include <android/asset_manager_jni.h>
+#include <android/api-level.h>
+#include <android/hardware_buffer.h>
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GLES3/gl3.h>
+#include <GLES2/gl2ext.h>
+#include <array>
+#include <cmath>
+#include <utility>
+#include <memory>
+#include <stdexcept>
+#include <string>
+
+namespace {
+using namespace amaze;
+struct ScopedAHB {
+    AHardwareBuffer* buffer = nullptr;
+    ~ScopedAHB() { if (buffer) AHardwareBuffer_release(buffer); }
+    ScopedAHB(const ScopedAHB&) = delete;
+    ScopedAHB& operator=(const ScopedAHB&) = delete;
+    ScopedAHB() = default;
+    ScopedAHB(ScopedAHB&& from) noexcept : buffer(from.buffer) { from.buffer = nullptr; }
+    ScopedAHB& operator=(ScopedAHB&& from) noexcept {
+        if (this != &from) {
+            if (buffer) AHardwareBuffer_release(buffer);
+            buffer = from.buffer; from.buffer = nullptr;
+        }
+        return *this;
+    }
+    AHardwareBuffer* get() const noexcept { return buffer; }
+};
+ScopedAHB createAhb(uint32_t w, uint32_t h, bool storage) {
+    if (android_get_device_api_level() < 29)
+        throw std::runtime_error("26856 Vulkan AHB usage requires Android API 29+");
+    AHardwareBuffer_Desc desc{};
+    desc.width = w; desc.height = h; desc.layers = 1;
+    desc.format = AHARDWAREBUFFER_FORMAT_R16G16B16A16_FLOAT;
+    desc.usage = AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE |
+                 AHARDWAREBUFFER_USAGE_GPU_COLOR_OUTPUT |
+                 (storage ? AHARDWAREBUFFER_USAGE_GPU_DATA_BUFFER : 0ull);
+    // AHardwareBuffer_isSupported is API 29 and unavailable when this app's
+    // native minSdk is API 26. The API-26 allocation is the authoritative
+    // capability/availability check, and does not require a second AHB.
+    // Keep the existing runtime API 29 guard, exact RGBA16F descriptor,
+    // GPU-only ownership, and fail-closed behavior on allocation failure.
+    ScopedAHB owned;
+    if (AHardwareBuffer_allocate(&desc, &owned.buffer) != 0 || !owned.buffer)
+        throw std::runtime_error("26856 exact RGBA16F AHB allocation unsupported or failed");
+    return owned;
+}
+// AHardwareBuffer is already refcounted; use a move-only scope wrapper.
+struct ScopeVkSemaphore {
+    VkDevice device = VK_NULL_HANDLE;
+    VkSemaphore semaphore = VK_NULL_HANDLE;
+    ScopeVkSemaphore(VkDevice d, VkSemaphore s) : device(d), semaphore(s) {}
+    ~ScopeVkSemaphore() { if (semaphore) vkDestroySemaphore(device, semaphore, nullptr); }
+    ScopeVkSemaphore(const ScopeVkSemaphore&) = delete;
+    ScopeVkSemaphore& operator=(const ScopeVkSemaphore&) = delete;
+};
+void imageBarrier(VkCommandBuffer cmd, VkImage image,
+                  VkImageLayout oldLayout, VkImageLayout newLayout,
+                  uint32_t from, uint32_t to,
+                  VkAccessFlags sourceAccess, VkAccessFlags targetAccess,
+                  VkPipelineStageFlags sourceStage, VkPipelineStageFlags targetStage) {
+    VkImageMemoryBarrier b{};
+    b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+    b.oldLayout = oldLayout;
+    b.newLayout = newLayout;
+    b.srcQueueFamilyIndex = from;
+    b.dstQueueFamilyIndex = to;
+    b.srcAccessMask = sourceAccess;
+    b.dstAccessMask = targetAccess;
+    b.image = image;
+    b.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    vkCmdPipelineBarrier(cmd, sourceStage, targetStage, 0, 0, nullptr, 0, nullptr, 1, &b);
+}
+struct GlBufferImage final {
+    EGLDisplay display = EGL_NO_DISPLAY;
+    EGLImageKHR image = EGL_NO_IMAGE_KHR;
+    GLuint texture = 0;
+    PFNEGLDESTROYIMAGEKHRPROC destroyImage = nullptr;
+    GlBufferImage(AHardwareBuffer* ahb) {
+        display = eglGetCurrentDisplay();
+        if (display == EGL_NO_DISPLAY || eglGetCurrentContext() == EGL_NO_CONTEXT)
+            throw std::runtime_error("26856 AHB->GL requires current EGL context");
+        auto getClient = reinterpret_cast<PFNEGLGETNATIVECLIENTBUFFERANDROIDPROC>(
+            eglGetProcAddress("eglGetNativeClientBufferANDROID"));
+        auto createImage = reinterpret_cast<PFNEGLCREATEIMAGEKHRPROC>(
+            eglGetProcAddress("eglCreateImageKHR"));
+        destroyImage = reinterpret_cast<PFNEGLDESTROYIMAGEKHRPROC>(
+            eglGetProcAddress("eglDestroyImageKHR"));
+        auto targetImage = reinterpret_cast<PFNGLEGLIMAGETARGETTEXTURE2DOESPROC>(
+            eglGetProcAddress("glEGLImageTargetTexture2DOES"));
+        if (!getClient || !createImage || !destroyImage || !targetImage)
+            throw std::runtime_error("26856 AHB->GL EGLImage import functions unavailable");
+        EGLClientBuffer client = getClient(ahb);
+        if (!client) throw std::runtime_error("26856 AHB->GL client buffer invalid");
+        const EGLint attrs[] = {EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE};
+        image = createImage(display, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID, client, attrs);
+        if (image == EGL_NO_IMAGE_KHR)
+            throw std::runtime_error("26856 AHB->GL EGLImage creation failed");
+        GLint former = 0;
+        glGetIntegerv(GL_TEXTURE_BINDING_2D, &former);
+        try {
+            glGenTextures(1, &texture);
+            if (!texture) throw std::runtime_error("26856 AHB->GL texture allocation failed");
+            glBindTexture(GL_TEXTURE_2D, texture);
+            targetImage(GL_TEXTURE_2D, image);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+            if (glGetError() != GL_NO_ERROR)
+                throw std::runtime_error("26856 AHB->GL EGLImage texture binding failed");
+            glBindTexture(GL_TEXTURE_2D, static_cast<GLuint>(former));
+        } catch (...) {
+            glBindTexture(GL_TEXTURE_2D, static_cast<GLuint>(former));
+            if (texture) { glDeleteTextures(1, &texture); texture = 0; }
+            if (image != EGL_NO_IMAGE_KHR) { destroyImage(display, image); image = EGL_NO_IMAGE_KHR; }
+            throw;
+        }
+    }
+    ~GlBufferImage() {
+        if (texture) glDeleteTextures(1, &texture);
+        if (image != EGL_NO_IMAGE_KHR && destroyImage) destroyImage(display, image);
+    }
+    GlBufferImage(const GlBufferImage&) = delete;
+    GlBufferImage& operator=(const GlBufferImage&) = delete;
+};
+void blitTexture(GLuint source, GLuint destination, uint32_t width, uint32_t height) {
+    GLint previousRead = 0, previousDraw = 0;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &previousRead);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &previousDraw);
+    // glBlitFramebuffer obeys GL_SCISSOR_TEST. A user-visible crop or an
+    // inherited thumbnail scissor must never truncate the camera-linear CFA
+    // input or AMaZE RGB result. Restore the caller's state on every exit.
+    const GLboolean previousScissor = glIsEnabled(GL_SCISSOR_TEST);
+    if (previousScissor) glDisable(GL_SCISSOR_TEST);
+    GLuint fbos[2]{};
+    glGenFramebuffers(2, fbos);
+    if (!fbos[0] || !fbos[1]) {
+        glDeleteFramebuffers(2, fbos);
+        if (previousScissor) glEnable(GL_SCISSOR_TEST);
+        throw std::runtime_error("26856 GL copy framebuffer allocation failed");
+    }
+    bool good = false;
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, fbos[0]);
+    glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                           GL_TEXTURE_2D, source, 0);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, fbos[1]);
+    glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                           GL_TEXTURE_2D, destination, 0);
+    if (glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE &&
+        glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE) {
+        glReadBuffer(GL_COLOR_ATTACHMENT0);
+        const GLenum drawAttachment = GL_COLOR_ATTACHMENT0;
+        glDrawBuffers(1, &drawAttachment);
+        glBlitFramebuffer(0, 0, width, height, 0, 0, width, height, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        good = glGetError() == GL_NO_ERROR;
+    }
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(previousRead));
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, static_cast<GLuint>(previousDraw));
+    glDeleteFramebuffers(2, fbos);
+    if (previousScissor) glEnable(GL_SCISSOR_TEST);
+    if (!good) throw std::runtime_error("26856 RGBA16F GPU framebuffer copy failed");
+}
+void runAmazeGlFrame(AAssetManager* assets, GLuint packedGlTexture, GLuint outputGlTexture,
+                     uint32_t width, uint32_t height, BayerPattern pattern,
+                     const std::array<float,3>& gains) {
+    if (!assets || !packedGlTexture || !outputGlTexture || packedGlTexture == outputGlTexture ||
+        width < 32u || height < 32u || (width & 1u) || (height & 1u) ||
+        width > 16384u || height > 16384u)
+        throw std::runtime_error("26856 B invalid AMaZE frame geometry/texture ownership");
+    for (float gain : gains) if (!(gain > 0.0f) || !std::isfinite(gain))
+        throw std::runtime_error("26856 B invalid white balance");
+    VulkanDeviceOwner device;
+    const VulkanContext ctx = device.context();
+    ScopedAHB inputAhb = createAhb(width / 2, height / 2, false);
+    ScopedAHB outputAhb = createAhb(width, height, true);
+    HardwareBufferImport input(ctx.physicalDevice, ctx.device, inputAhb.get(), width / 2, height / 2,
+                               VK_IMAGE_USAGE_SAMPLED_BIT);
+    HardwareBufferImport output(ctx.physicalDevice, ctx.device, outputAhb.get(), width, height,
+                                VK_IMAGE_USAGE_STORAGE_BIT);
+    CommandSubmissionOwner commands(ctx.physicalDevice, ctx.device, device.queue(), ctx.queueFamilyIndex);
+    // Images were newly created with UNDEFINED layout. Initialize and transfer
+    // ownership BEFORE GLES writes packed temporal CFA; changing from UNDEFINED
+    // after GLES writes would discard that CFA and is forbidden.
+    commands.execute([&](VkCommandBuffer cmd) {
+        for (VkImage image : {input.image(), output.image()})
+            imageBarrier(cmd, image, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL,
+                         ctx.queueFamilyIndex, VK_QUEUE_FAMILY_FOREIGN_EXT,
+                         0, 0, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT);
+    });
+    GlBufferImage glIn(inputAhb.get());
+    GlBufferImage glOut(outputAhb.get());
+    blitTexture(packedGlTexture, glIn.texture, width/2, height/2);
+    ScopedNativeFd glCfaFence = createCurrentGlReleaseFence();
+    ScopeVkSemaphore acquire(ctx.device, importGlFenceToVulkan(ctx.device, std::move(glCfaFence)));
+    ScopeVkSemaphore release(ctx.device, createGlExportableSemaphore(ctx.device));
+    PipelineConfig cfg{};
+    cfg.width = width; cfg.height = height; cfg.pattern = pattern;
+    cfg.inputMode = InputMode::PackedCfaRgba16fImage;
+    cfg.tileSlots = 16;
+    auto provider = makePinnedSpirvProvider(assets);
+    AmazePipeline pipeline(ctx, std::move(provider), cfg);
+    PackedCfaImageView packed{};
+    packed.image = input.image(); packed.view = input.view();
+    packed.width = width/2; packed.height = height/2;
+    packed.rawWidth = width; packed.rawHeight = height; packed.pattern = pattern;
+    packed.format = VK_FORMAT_R16G16B16A16_SFLOAT;
+    packed.layout = VK_IMAGE_LAYOUT_GENERAL;
+    LinearRgbImage rgb{};
+    rgb.image = output.image(); rgb.view = output.view();
+    rgb.width = width; rgb.height = height;
+    rgb.format = VK_FORMAT_R16G16B16A16_SFLOAT;
+    rgb.layout = VK_IMAGE_LAYOUT_GENERAL;
+    commands.execute([&](VkCommandBuffer cmd) {
+        imageBarrier(cmd, input.image(), VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL,
+                     VK_QUEUE_FAMILY_FOREIGN_EXT, ctx.queueFamilyIndex, 0,
+                     VK_ACCESS_SHADER_READ_BIT, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                     VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT);
+        imageBarrier(cmd, output.image(), VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL,
+                     VK_QUEUE_FAMILY_FOREIGN_EXT, ctx.queueFamilyIndex, 0,
+                     VK_ACCESS_SHADER_WRITE_BIT, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                     VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT);
+        pipeline.record(cmd, packed, rgb, gains);
+        imageBarrier(cmd, input.image(), VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL,
+                     ctx.queueFamilyIndex, VK_QUEUE_FAMILY_FOREIGN_EXT,
+                     VK_ACCESS_SHADER_READ_BIT, 0, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                     VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT);
+        imageBarrier(cmd, output.image(), VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL,
+                     ctx.queueFamilyIndex, VK_QUEUE_FAMILY_FOREIGN_EXT,
+                     VK_ACCESS_SHADER_WRITE_BIT, 0, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                     VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT);
+    }, acquire.semaphore, release.semaphore);
+    ScopedNativeFd gpuRgbFence = exportVulkanFenceToGl(ctx.device, release.semaphore);
+    waitCurrentGlOnVulkanFence(std::move(gpuRgbFence));
+    blitTexture(glOut.texture, outputGlTexture, width, height);
+    glFlush();
+    // Current GL frame still owns glOut; completion is mandatory before AHB
+    // import destructors can reclaim the backing allocations.
+    glFinish();
+}
+} // namespace
+extern "C" JNIEXPORT void JNICALL
+Java_com_hinnka_mycamera_processor_GlesIris26856AmazeNative_nativeExecute(
+        JNIEnv* env, jclass, jobject javaAssets, jint packedTexture, jint outputTexture,
+        jint width, jint height, jint bayerPattern, jfloatArray whiteBalance) {
+    try {
+        if (!javaAssets || !whiteBalance || env->GetArrayLength(whiteBalance) != 3 ||
+            bayerPattern < 0 || bayerPattern > 3)
+            throw std::runtime_error("26856 JNI: invalid AssetManager or Bayer/WB values");
+        AAssetManager* assets = AAssetManager_fromJava(env, javaAssets);
+        if (!assets) throw std::runtime_error("26856 JNI: inaccessible Android assets");
+        std::array<float,3> gains{};
+        env->GetFloatArrayRegion(whiteBalance, 0, 3, gains.data());
+        if (env->ExceptionCheck()) return;
+        runAmazeGlFrame(assets, static_cast<GLuint>(packedTexture),
+                        static_cast<GLuint>(outputTexture),
+                        static_cast<uint32_t>(width), static_cast<uint32_t>(height),
+                        static_cast<amaze::BayerPattern>(bayerPattern), gains);
+    } catch (const std::exception& error) {
+        jclass klass = env->FindClass("java/lang/IllegalStateException");
+        if (klass) env->ThrowNew(klass, error.what());
+    }
+}
diff --git a/app/src/main/cpp/iris26856/amaze/src/CommandSubmissionOwner.cpp b/app/src/main/cpp/iris26856/amaze/src/CommandSubmissionOwner.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..436c5f49de04caca30797c200f4ec12362e5bd9b
--- /dev/null
+++ b/app/src/main/cpp/iris26856/amaze/src/CommandSubmissionOwner.cpp
@@ -0,0 +1,106 @@
+// IRIS_26856_VULKAN_COMMAND_SUBMISSION_OWNER
+#include "amaze/CommandSubmissionOwner.hpp"
+#include <stdexcept>
+#include <vector>
+
+namespace amaze {
+namespace {
+void check(VkResult result, const char* reason) {
+    if (result != VK_SUCCESS) throw std::runtime_error(reason);
+}
+}
+CommandSubmissionOwner::CommandSubmissionOwner(VkPhysicalDevice physical,
+        VkDevice device, VkQueue queue, uint32_t familyIndex)
+        : device_(device), queue_(queue) {
+    if (!physical || !device_ || !queue_)
+        throw std::runtime_error("AMaZE submission: missing Vulkan owner");
+    uint32_t count = 0;
+    vkGetPhysicalDeviceQueueFamilyProperties(physical, &count, nullptr);
+    if (familyIndex >= count) throw std::runtime_error("AMaZE submission: queue family out of bounds");
+    // Query full array to avoid writing past a single VkQueueFamilyProperties.
+    // Vulkan queue-family lists can have multiple entries.
+    std::vector<VkQueueFamilyProperties> families(count);
+    vkGetPhysicalDeviceQueueFamilyProperties(physical, &count, families.data());
+    if (familyIndex >= count || !(families[familyIndex].queueFlags & VK_QUEUE_COMPUTE_BIT))
+        throw std::runtime_error("AMaZE submission: queue family lacks compute");
+    try {
+        VkCommandPoolCreateInfo pci{};
+        pci.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
+        pci.queueFamilyIndex = familyIndex;
+        pci.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+        check(vkCreateCommandPool(device_, &pci, nullptr, &pool_), "AMaZE submission: command pool");
+        VkCommandBufferAllocateInfo ai{};
+        ai.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
+        ai.commandPool = pool_;
+        ai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+        ai.commandBufferCount = 1;
+        check(vkAllocateCommandBuffers(device_, &ai, &command_), "AMaZE submission: command allocation");
+        VkFenceCreateInfo fi{};
+        fi.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+        check(vkCreateFence(device_, &fi, nullptr, &fence_), "AMaZE submission: fence");
+    } catch (...) {
+        if (fence_) vkDestroyFence(device_, fence_, nullptr);
+        if (pool_) vkDestroyCommandPool(device_, pool_, nullptr);
+        throw;
+    }
+}
+CommandSubmissionOwner::~CommandSubmissionOwner() {
+    // A failed fence wait leaves completion unknown. Never free the command
+    // pool while GPU work may still reference it. A device-lost result can
+    // prevent a successful idle wait; in that case retain driver-owned state
+    // instead of manufacturing a completed fence (device owner tears down).
+    if (submitted_ && queue_) {
+        const VkResult idle = vkQueueWaitIdle(queue_);
+        if (idle != VK_SUCCESS) return; // fail closed: driver-owned handles remain
+        submitted_ = false;
+    }
+    if (fence_) vkDestroyFence(device_, fence_, nullptr);
+    if (pool_) vkDestroyCommandPool(device_, pool_, nullptr);
+}
+void CommandSubmissionOwner::execute(const std::function<void(VkCommandBuffer)>& record,
+                                     VkSemaphore glAcquire, VkSemaphore glRelease) {
+    if (!record) throw std::runtime_error("AMaZE submission: missing record callback");
+    if (poisoned_ || submitted_) throw std::runtime_error("AMaZE submission: unresolved prior GPU work");
+    check(vkResetCommandBuffer(command_, 0), "AMaZE submission: command reset");
+    VkCommandBufferBeginInfo bi{};
+    bi.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+    bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    check(vkBeginCommandBuffer(command_, &bi), "AMaZE submission: begin");
+    try { record(command_); }
+    catch (...) {
+        // Nothing was submitted: safe to reset before a later attempt.
+        vkResetCommandBuffer(command_, 0);
+        throw;
+    }
+    check(vkEndCommandBuffer(command_), "AMaZE submission: end");
+    check(vkResetFences(device_, 1, &fence_), "AMaZE submission: fence reset");
+    VkSubmitInfo si{};
+    si.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+    si.commandBufferCount = 1;
+    si.pCommandBuffers = &command_;
+    const VkPipelineStageFlags waitStage = VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT;
+    if (glAcquire != VK_NULL_HANDLE) {
+        si.waitSemaphoreCount = 1;
+        si.pWaitSemaphores = &glAcquire;
+        si.pWaitDstStageMask = &waitStage;
+    }
+    if (glRelease != VK_NULL_HANDLE) {
+        si.signalSemaphoreCount = 1;
+        si.pSignalSemaphores = &glRelease;
+    }
+    const VkResult submitResult = vkQueueSubmit(queue_, 1, &si, fence_);
+    if (submitResult != VK_SUCCESS) {
+        poisoned_ = true;
+        throw std::runtime_error("AMaZE submission: failed Vulkan queue submit");
+    }
+    submitted_ = true;
+    const VkResult waited = vkWaitForFences(device_, 1, &fence_, VK_TRUE, UINT64_MAX);
+    if (waited != VK_SUCCESS) {
+        // Do not reuse the command buffer or release GPU resources after a
+        // failed wait. Destructor must settle the queue before destroying it.
+        poisoned_ = true;
+        throw std::runtime_error("AMaZE submission: GPU fence wait failed; queue ownership unresolved");
+    }
+    submitted_ = false;
+}
+} // namespace amaze
diff --git a/app/src/main/cpp/iris26856/amaze/src/ExternalFenceSync.cpp b/app/src/main/cpp/iris26856/amaze/src/ExternalFenceSync.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2a0e1b782d8737dc776821e5af089c1f8ee876bf
--- /dev/null
+++ b/app/src/main/cpp/iris26856/amaze/src/ExternalFenceSync.cpp
@@ -0,0 +1,121 @@
+// IRIS_26856_B_ONLY_EGL_VULKAN_NATIVE_FENCE_OWNER
+#include "amaze/ExternalFenceSync.hpp"
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GLES3/gl3.h>
+#include <unistd.h>
+#include <cstring>
+#include <stdexcept>
+#include <utility>
+
+namespace amaze {
+namespace {
+struct EglSyncFunctions {
+    PFNEGLCREATESYNCKHRPROC create;
+    PFNEGLDESTROYSYNCKHRPROC destroy;
+    PFNEGLDUPNATIVEFENCEFDANDROIDPROC dup;
+    PFNEGLWAITSYNCKHRPROC wait;
+};
+EglSyncFunctions requireEglFenceFunctions(EGLDisplay display) {
+    if (display == EGL_NO_DISPLAY || eglGetCurrentContext() == EGL_NO_CONTEXT)
+        throw std::runtime_error("26856 GL/Vulkan: no current EGL context");
+    const char* extensions = eglQueryString(display, EGL_EXTENSIONS);
+    if (!extensions || !std::strstr(extensions, "EGL_ANDROID_native_fence_sync") ||
+        !std::strstr(extensions, "EGL_KHR_fence_sync") ||
+        !std::strstr(extensions, "EGL_KHR_wait_sync"))
+        throw std::runtime_error("26856 GL/Vulkan: required native fence extensions absent");
+    EglSyncFunctions f{};
+    f.create = reinterpret_cast<PFNEGLCREATESYNCKHRPROC>(eglGetProcAddress("eglCreateSyncKHR"));
+    f.destroy = reinterpret_cast<PFNEGLDESTROYSYNCKHRPROC>(eglGetProcAddress("eglDestroySyncKHR"));
+    f.dup = reinterpret_cast<PFNEGLDUPNATIVEFENCEFDANDROIDPROC>(eglGetProcAddress("eglDupNativeFenceFDANDROID"));
+    f.wait = reinterpret_cast<PFNEGLWAITSYNCKHRPROC>(eglGetProcAddress("eglWaitSyncKHR"));
+    if (!f.create || !f.destroy || !f.dup || !f.wait)
+        throw std::runtime_error("26856 GL/Vulkan: native EGL fence functions unavailable");
+    return f;
+}
+}
+ScopedNativeFd::~ScopedNativeFd() { if (fd_ >= 0) ::close(fd_); }
+ScopedNativeFd::ScopedNativeFd(ScopedNativeFd&& other) noexcept : fd_(other.release()) {}
+ScopedNativeFd& ScopedNativeFd::operator=(ScopedNativeFd&& other) noexcept {
+    if (this != &other) { if (fd_ >= 0) ::close(fd_); fd_ = other.release(); }
+    return *this;
+}
+int ScopedNativeFd::release() noexcept { const int old = fd_; fd_ = -1; return old; }
+
+ScopedNativeFd createCurrentGlReleaseFence() {
+    EGLDisplay display = eglGetCurrentDisplay();
+    auto f = requireEglFenceFunctions(display);
+    const EGLint attrs[] = {EGL_NONE};
+    EGLSyncKHR sync = f.create(display, EGL_SYNC_NATIVE_FENCE_ANDROID, attrs);
+    if (sync == EGL_NO_SYNC_KHR)
+        throw std::runtime_error("26856 GL/Vulkan: cannot create GLES release fence");
+    glFlush();
+    const int fd = f.dup(display, sync);
+    f.destroy(display, sync);
+    if (fd < 0) throw std::runtime_error("26856 GL/Vulkan: cannot duplicate GLES fence fd");
+    return ScopedNativeFd(fd);
+}
+VkSemaphore importGlFenceToVulkan(VkDevice device, ScopedNativeFd&& fence) {
+    if (!device || fence.get() < 0)
+        throw std::runtime_error("26856 GL/Vulkan: invalid GL fence import");
+    auto importer = reinterpret_cast<PFN_vkImportSemaphoreFdKHR>(
+        vkGetDeviceProcAddr(device, "vkImportSemaphoreFdKHR"));
+    if (!importer) throw std::runtime_error("26856 GL/Vulkan: missing semaphore FD importer");
+    VkSemaphoreCreateInfo ci{};
+    ci.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO;
+    VkSemaphore sem = VK_NULL_HANDLE;
+    if (vkCreateSemaphore(device, &ci, nullptr, &sem) != VK_SUCCESS)
+        throw std::runtime_error("26856 GL/Vulkan: cannot allocate import semaphore");
+    VkImportSemaphoreFdInfoKHR ii{};
+    ii.sType = VK_STRUCTURE_TYPE_IMPORT_SEMAPHORE_FD_INFO_KHR;
+    ii.semaphore = sem;
+    ii.flags = VK_SEMAPHORE_IMPORT_TEMPORARY_BIT;
+    ii.handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT;
+    ii.fd = fence.get();
+    if (importer(device, &ii) != VK_SUCCESS) {
+        vkDestroySemaphore(device, sem, nullptr);
+        throw std::runtime_error("26856 GL/Vulkan: GL fence FD import failed");
+    }
+    fence.release();  // Vulkan takes ownership of the imported fd on success.
+    return sem;
+}
+VkSemaphore createGlExportableSemaphore(VkDevice device) {
+    VkExportSemaphoreCreateInfo exportInfo{};
+    exportInfo.sType = VK_STRUCTURE_TYPE_EXPORT_SEMAPHORE_CREATE_INFO;
+    exportInfo.handleTypes = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT;
+    VkSemaphoreCreateInfo ci{};
+    ci.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO;
+    ci.pNext = &exportInfo;
+    VkSemaphore s = VK_NULL_HANDLE;
+    if (vkCreateSemaphore(device, &ci, nullptr, &s) != VK_SUCCESS)
+        throw std::runtime_error("26856 GL/Vulkan: exportable fence semaphore creation failed");
+    return s;
+}
+ScopedNativeFd exportVulkanFenceToGl(VkDevice device, VkSemaphore semaphore) {
+    if (!device || !semaphore) throw std::runtime_error("26856 GL/Vulkan: missing Vulkan signal");
+    auto exporter = reinterpret_cast<PFN_vkGetSemaphoreFdKHR>(
+        vkGetDeviceProcAddr(device, "vkGetSemaphoreFdKHR"));
+    if (!exporter) throw std::runtime_error("26856 GL/Vulkan: missing semaphore FD exporter");
+    VkSemaphoreGetFdInfoKHR info{};
+    info.sType = VK_STRUCTURE_TYPE_SEMAPHORE_GET_FD_INFO_KHR;
+    info.semaphore = semaphore;
+    info.handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT;
+    int fd = -1;
+    if (exporter(device, &info, &fd) != VK_SUCCESS || fd < 0)
+        throw std::runtime_error("26856 GL/Vulkan: Vulkan signal fd export failed");
+    return ScopedNativeFd(fd);
+}
+void waitCurrentGlOnVulkanFence(ScopedNativeFd&& fence) {
+    if (fence.get() < 0) throw std::runtime_error("26856 GL/Vulkan: missing RGB completion fd");
+    EGLDisplay display = eglGetCurrentDisplay();
+    auto f = requireEglFenceFunctions(display);
+    const EGLint attrs[] = {EGL_SYNC_NATIVE_FENCE_FD_ANDROID, fence.get(), EGL_NONE};
+    EGLSyncKHR sync = f.create(display, EGL_SYNC_NATIVE_FENCE_ANDROID, attrs);
+    if (sync == EGL_NO_SYNC_KHR)
+        throw std::runtime_error("26856 GL/Vulkan: cannot import Vulkan completion fd");
+    fence.release(); // EGL takes ownership after successful native-fence import.
+    const EGLBoolean ok = f.wait(display, sync, 0);
+    f.destroy(display, sync);
+    if (ok != EGL_TRUE) throw std::runtime_error("26856 GL/Vulkan: GLES wait on Vulkan fence failed");
+}
+} // namespace amaze
diff --git a/app/src/main/cpp/iris26856/amaze/src/HardwareBufferImport.cpp b/app/src/main/cpp/iris26856/amaze/src/HardwareBufferImport.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9594d3ac053eed5fb5bd6507d851d45c92312c11
--- /dev/null
+++ b/app/src/main/cpp/iris26856/amaze/src/HardwareBufferImport.cpp
@@ -0,0 +1,129 @@
+// IRIS_26856_PINNED_VULKAN_AHB_IMPORT_OWNER
+// Import an existing Iris RGBA16F AHardwareBuffer; never CPU-lock or copy it.
+#include "amaze/HardwareBufferImport.hpp"
+#include <stdexcept>
+
+namespace amaze {
+namespace {
+void requireVk(VkResult result, const char* message) {
+    if (result != VK_SUCCESS) throw std::runtime_error(message);
+}
+}
+HardwareBufferImport::HardwareBufferImport(VkPhysicalDevice physical, VkDevice device,
+        AHardwareBuffer* buffer, uint32_t width, uint32_t height, VkImageUsageFlags usage)
+        : device_(device) {
+    if (!physical || !device || !buffer || !width || !height)
+        throw std::runtime_error("AMaZE AHB import: invalid owner or dimensions");
+    AHardwareBuffer_Desc desc{};
+    AHardwareBuffer_describe(buffer, &desc);
+    if (desc.width != width || desc.height != height || desc.layers != 1 ||
+        desc.format != AHARDWAREBUFFER_FORMAT_R16G16B16A16_FLOAT)
+        throw std::runtime_error("AMaZE AHB import: incompatible RGBA16F allocation");
+    // Input and output have different Vulkan roles. Never reuse a sampled-only
+    // import as a storage output, or claim an unsupported image usage.
+    const bool sampledInput = usage == VK_IMAGE_USAGE_SAMPLED_BIT;
+    const bool storageOutput = usage == VK_IMAGE_USAGE_STORAGE_BIT;
+    if (!sampledInput && !storageOutput)
+        throw std::runtime_error("AMaZE AHB import: only sampled CFA or storage RGB permitted");
+    if (!(desc.usage & AHARDWAREBUFFER_USAGE_GPU_COLOR_OUTPUT))
+        throw std::runtime_error("AMaZE AHB import: requires GLES color-output allocation");
+    if (sampledInput && !(desc.usage & AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE))
+        throw std::runtime_error("AMaZE AHB import: CFA lacks sampled usage");
+    if (storageOutput && !(desc.usage & AHARDWAREBUFFER_USAGE_GPU_DATA_BUFFER))
+        throw std::runtime_error("AMaZE AHB import: RGB output lacks Vulkan STORAGE_IMAGE allocation usage");
+    auto getProperties = reinterpret_cast<PFN_vkGetAndroidHardwareBufferPropertiesANDROID>(
+        vkGetDeviceProcAddr(device, "vkGetAndroidHardwareBufferPropertiesANDROID"));
+    if (!getProperties) throw std::runtime_error("AMaZE AHB import: missing Vulkan Android extension");
+    VkAndroidHardwareBufferFormatPropertiesANDROID format{};
+    format.sType = VK_STRUCTURE_TYPE_ANDROID_HARDWARE_BUFFER_FORMAT_PROPERTIES_ANDROID;
+    VkAndroidHardwareBufferPropertiesANDROID props{};
+    props.sType = VK_STRUCTURE_TYPE_ANDROID_HARDWARE_BUFFER_PROPERTIES_ANDROID;
+    props.pNext = &format;
+    requireVk(getProperties(device, buffer, &props), "AMaZE AHB import: properties failed");
+    if (format.format != VK_FORMAT_R16G16B16A16_SFLOAT || !props.allocationSize)
+        throw std::runtime_error("AMaZE AHB import: non-RGBA16F Vulkan format");
+    if (sampledInput && !(format.formatFeatures & VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT))
+        throw std::runtime_error("AMaZE AHB import: RGBA16F is not Vulkan sampleable");
+    if (storageOutput && !(format.formatFeatures & VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT))
+        throw std::runtime_error("AMaZE AHB import: RGBA16F is not Vulkan storage-writable");
+    // External AHB memory may require a dedicated allocation. Reject any
+    // unsupported alias instead of letting a driver silently reinterpret it.
+    AHardwareBuffer_acquire(buffer);
+    buffer_ = buffer;
+    try {
+        VkExternalMemoryImageCreateInfo external{};
+        external.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO;
+        external.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_ANDROID_HARDWARE_BUFFER_BIT_ANDROID;
+        VkImageCreateInfo imageInfo{};
+        imageInfo.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+        imageInfo.pNext = &external;
+        imageInfo.imageType = VK_IMAGE_TYPE_2D;
+        imageInfo.format = VK_FORMAT_R16G16B16A16_SFLOAT;
+        imageInfo.extent = {width, height, 1};
+        imageInfo.mipLevels = 1;
+        imageInfo.arrayLayers = 1;
+        imageInfo.samples = VK_SAMPLE_COUNT_1_BIT;
+        imageInfo.tiling = VK_IMAGE_TILING_OPTIMAL;
+        imageInfo.usage = usage;
+        imageInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+        imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        requireVk(vkCreateImage(device_, &imageInfo, nullptr, &image_), "AMaZE AHB import: image failed");
+        // VK_ANDROID_external_memory_android_hardware_buffer: an image backed by an
+        // imported AHB is not yet bound here. vkGetImageMemoryRequirements is
+        // forbidden before binding; props.memoryTypeBits from the imported AHB
+        // is the authoritative memory-type mask for this dedicated allocation.
+        uint32_t type = UINT32_MAX;
+        const uint32_t compatible = props.memoryTypeBits;
+        VkPhysicalDeviceMemoryProperties memProps{};
+        vkGetPhysicalDeviceMemoryProperties(physical, &memProps);
+        for (uint32_t i = 0; i < memProps.memoryTypeCount; ++i) {
+            if (!(compatible & (1u << i))) continue;
+            if (memProps.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) {
+                type = i;
+                break;
+            }
+        }
+        // Non-device-local memory is legal only when the GPU exposes no
+        // device-local compatible type for the imported allocation.
+        if (type == UINT32_MAX) for (uint32_t i = 0; i < memProps.memoryTypeCount; ++i)
+            if (compatible & (1u << i)) { type = i; break; }
+        if (type == UINT32_MAX) throw std::runtime_error("AMaZE AHB import: no memory type");
+        VkImportAndroidHardwareBufferInfoANDROID imported{};
+        imported.sType = VK_STRUCTURE_TYPE_IMPORT_ANDROID_HARDWARE_BUFFER_INFO_ANDROID;
+        imported.buffer = buffer_;
+        VkMemoryDedicatedAllocateInfo dedicated{};
+        dedicated.sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO;
+        dedicated.pNext = &imported;
+        dedicated.image = image_;
+        VkMemoryAllocateInfo alloc{};
+        alloc.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+        alloc.pNext = &dedicated;
+        alloc.allocationSize = props.allocationSize;
+        alloc.memoryTypeIndex = type;
+        requireVk(vkAllocateMemory(device_, &alloc, nullptr, &memory_), "AMaZE AHB import: memory failed");
+        requireVk(vkBindImageMemory(device_, image_, memory_, 0), "AMaZE AHB import: bind failed");
+        VkImageViewCreateInfo viewInfo{};
+        viewInfo.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+        viewInfo.image = image_;
+        viewInfo.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        viewInfo.format = imageInfo.format;
+        viewInfo.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+        requireVk(vkCreateImageView(device_, &viewInfo, nullptr, &view_), "AMaZE AHB import: view failed");
+    } catch (...) {
+        if (view_) vkDestroyImageView(device_, view_, nullptr);
+        if (image_) vkDestroyImage(device_, image_, nullptr);
+        if (memory_) vkFreeMemory(device_, memory_, nullptr);
+        AHardwareBuffer_release(buffer_);
+        view_ = VK_NULL_HANDLE; image_ = VK_NULL_HANDLE;
+        memory_ = VK_NULL_HANDLE; buffer_ = nullptr;
+        throw;
+    }
+}
+HardwareBufferImport::~HardwareBufferImport() {
+    // Contract: owner must wait for all GPU work before destroying this object.
+    if (view_) vkDestroyImageView(device_, view_, nullptr);
+    if (image_) vkDestroyImage(device_, image_, nullptr);
+    if (memory_) vkFreeMemory(device_, memory_, nullptr);
+    if (buffer_) AHardwareBuffer_release(buffer_);
+}
+} // namespace amaze
diff --git a/app/src/main/cpp/iris26856/amaze/src/PinnedSpirvAssets.cpp b/app/src/main/cpp/iris26856/amaze/src/PinnedSpirvAssets.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..31392b227548aab06fbfb60f72f7f29b82375120
--- /dev/null
+++ b/app/src/main/cpp/iris26856/amaze/src/PinnedSpirvAssets.cpp
@@ -0,0 +1,57 @@
+// IRIS_26856_PINNED_19_SHADER_ASSET_OWNER
+#include "amaze/PinnedSpirvAssets.hpp"
+#include <array>
+#include <cstring>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace amaze {
+namespace {
+constexpr std::array<const char*, 19> kShaderNames = {{
+    "amaze_import.comp", "amaze_gradients.wgsl", "amaze_candidates.wgsl",
+    "amaze_choose.wgsl", "amaze_cddiff.wgsl", "amaze_weights.wgsl",
+    "amaze_nyquist.wgsl", "amaze_nyquist_vote.wgsl", "amaze_area.wgsl",
+    "amaze_hvwt_seq.wgsl", "amaze_green.wgsl", "amaze_refine.wgsl",
+    "amaze_diagonal.wgsl", "amaze_pmwt_seq.wgsl", "amaze_rbint.wgsl",
+    "amaze_correct.wgsl", "amaze_chroma.wgsl", "amaze_finish.wgsl",
+    "amaze_export.comp"
+}};
+constexpr uint32_t kSpirvMagic = 0x07230203;
+constexpr size_t kMinWords = 5;
+constexpr size_t kMaxShaderBytes = 2 * 1024 * 1024;
+}
+ShaderProvider makePinnedSpirvProvider(AAssetManager* assets) {
+    if (!assets) throw std::invalid_argument("26856 AMaZE: missing AAssetManager");
+    return [assets](std::string_view requested) -> std::vector<uint32_t> {
+        size_t index = kShaderNames.size();
+        for (size_t i = 0; i < kShaderNames.size(); ++i) {
+            if (requested == kShaderNames[i]) { index = i; break; }
+        }
+        if (index == kShaderNames.size())
+            throw std::runtime_error("26856 AMaZE: unknown shader name (no fallback)");
+        const std::string stem(kShaderNames[index], std::strchr(kShaderNames[index], '.') - kShaderNames[index]);
+        const std::string path = "iris26856/rawr/amaze/spv/" + stem + ".spv";
+        using AssetPtr = std::unique_ptr<AAsset, decltype(&AAsset_close)>;
+        AssetPtr asset(AAssetManager_open(assets, path.c_str(), AASSET_MODE_STREAMING), &AAsset_close);
+        if (!asset) throw std::runtime_error("26856 AMaZE: pinned shader asset not found: " + path);
+        const off64_t length = AAsset_getLength64(asset.get());
+        if (length < static_cast<off64_t>(kMinWords * 4) ||
+            length > static_cast<off64_t>(kMaxShaderBytes) || (length & 3))
+            throw std::runtime_error("26856 AMaZE: invalid SPIR-V asset size: " + path);
+        std::vector<uint32_t> words(static_cast<size_t>(length) / 4);
+        auto* ptr = reinterpret_cast<unsigned char*>(words.data());
+        size_t bytesRead = 0;
+        while (bytesRead < static_cast<size_t>(length)) {
+            const int n = AAsset_read(asset.get(), ptr + bytesRead,
+                                      static_cast<size_t>(length) - bytesRead);
+            if (n <= 0) throw std::runtime_error("26856 AMaZE: truncated shader asset: " + path);
+            bytesRead += static_cast<size_t>(n);
+        }
+        if (words[0] != kSpirvMagic)
+            throw std::runtime_error("26856 AMaZE: invalid SPIR-V magic: " + path);
+        return words;
+    };
+}
+} // namespace amaze
diff --git a/app/src/main/cpp/iris26856/amaze/src/Pipeline.cpp b/app/src/main/cpp/iris26856/amaze/src/Pipeline.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2df73aa06ab12d2dd0ccf855d054b1c28de16da2
--- /dev/null
+++ b/app/src/main/cpp/iris26856/amaze/src/Pipeline.cpp
@@ -0,0 +1,539 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Vulkan host for the AMaZE GPU port (Emil Martinec; optimizations Ingo Weyrich).
+// Provenance and credits: shaders/amaze.wgsl and ../NOTICE.md.
+#include "amaze/Amaze.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace amaze {
+namespace {
+
+void check(VkResult r, const char* what) {
+    if (r != VK_SUCCESS) throw std::runtime_error(what);
+}
+
+uint32_t memoryType(VkPhysicalDevice pd, uint32_t bits, VkMemoryPropertyFlags flags) {
+    VkPhysicalDeviceMemoryProperties m{};
+    vkGetPhysicalDeviceMemoryProperties(pd, &m);
+    for (uint32_t i = 0; i < m.memoryTypeCount; ++i)
+        if ((bits & (1u << i)) && (m.memoryTypes[i].propertyFlags & flags) == flags) return i;
+    throw std::runtime_error("AMaZE: no compatible Vulkan memory type");
+}
+
+// librtprocess amaze.cc tiling: ts = 160 with a 16 px margin, stepping ts - 32.
+constexpr int kTile = 160;
+constexpr int kMargin = 16;
+constexpr int kStep = kTile - 2 * kMargin;
+constexpr uint32_t kLocal = 16;   // @workgroup_size(16,16) everywhere
+// Per-tile slot sizes and scalar scratch channels; must match amaze.wgsl
+// (SRC_PIX, OUT_PIX, CHANNELS) and amaze_tile.glsl.
+constexpr VkDeviceSize kSrcPix = VkDeviceSize(kTile) * kTile;
+constexpr VkDeviceSize kOutPix = VkDeviceSize(kStep) * kStep;
+constexpr VkDeviceSize kChannels = 34;
+
+// Recorded in this order; must match tools/build_spv.sh. Import first, export last.
+constexpr std::array<const char*, 19> kPasses = {
+    "amaze_import",   "amaze_gradients", "amaze_candidates", "amaze_choose",       "amaze_cddiff",
+    "amaze_weights",  "amaze_nyquist",   "amaze_nyquist_vote", "amaze_area",       "amaze_hvwt_seq",
+    "amaze_green",    "amaze_refine",    "amaze_diagonal",   "amaze_pmwt_seq",     "amaze_rbint",
+    "amaze_correct",  "amaze_chroma",    "amaze_finish",     "amaze_export"};
+// Serial-chain passes: choose runs one invocation per (row|column, parity) in
+// workgroups of 64; the row-sequential refinements run as one workgroup per tile.
+// Every pass is one dispatch per tile batch, with workgroup z selecting the tile.
+constexpr size_t kChoosePass = 3, kHvwtPass = 9, kPmwtPass = 13;
+constexpr uint32_t kChooseLocal = 64;
+static_assert(kTile <= 256, "row-sequential passes use one lane per tile column");
+// GLSL passes use "main"; naga keeps the WGSL entry point name.
+bool isGlsl(size_t pass) { return pass == 0 || pass + 1 == kPasses.size(); }
+// amaze_finish and amaze_export cover the tile's output region, the rest its source.
+bool coversOutput(size_t pass) { return pass + 2 >= kPasses.size(); }
+
+// Mirrors amaze.wgsl Params / amaze_tile.glsl TileParams.
+struct TileParams {
+    uint32_t srcOriginX, srcOriginY, srcWidth, srcHeight;
+    uint32_t outOriginX, outOriginY, outWidth, outHeight;
+    uint32_t cfa00, cfa10, cfa01, cfa11;
+    float blackR, blackG0, blackG1, blackB;
+    float white, wbR, wbG, wbB;
+    float color[9];
+    float sourceIsFloat, outputScale, outputAlpha;
+    float inputMode, inputWidth, pattern, reserved;
+};
+static_assert(sizeof(TileParams) == 144, "AMaZE tile ABI changed");
+
+struct Tile {
+    uint32_t srcX, srcY, srcW, srcH, outX, outY, outW, outH;
+};
+
+std::vector<Tile> tileGrid(uint32_t width, uint32_t height) {
+    auto axis = [](uint32_t n) {
+        std::vector<std::array<uint32_t, 4>> spans;  // src start, src size, out start, out size
+        for (int t = -kMargin; t + kMargin < int(n); t += kStep) {
+            const int s0 = std::max(t, 0), s1 = std::min(t + kTile, int(n));
+            const int o0 = std::max(t + kMargin, 0), o1 = std::min(t + kTile - kMargin, int(n));
+            spans.push_back({uint32_t(s0), uint32_t(s1 - s0), uint32_t(o0), uint32_t(o1 - o0)});
+        }
+        return spans;
+    };
+    std::vector<Tile> tiles;
+    for (const auto& y : axis(height))
+        for (const auto& x : axis(width)) tiles.push_back({x[0], y[0], x[1], y[1], x[2], y[2], x[3], y[3]});
+    return tiles;
+}
+
+// Colour (0 R, 1 G, 2 B) at (x&1, y&1) for a BayerPattern code.
+std::array<uint32_t, 4> cfaColours(BayerPattern p) {
+    switch (p) {
+        case BayerPattern::RGGB: return {0, 1, 1, 2};
+        case BayerPattern::GRBG: return {1, 0, 2, 1};
+        case BayerPattern::GBRG: return {1, 2, 0, 1};
+        default: return {2, 1, 1, 0};
+    }
+}
+
+struct OwnedBuffer {
+    VkBuffer buffer = VK_NULL_HANDLE;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    VkDeviceSize size = 0;
+    uint64_t allocationBytes = 0;
+};
+struct OwnedImage {
+    VkImage image = VK_NULL_HANDLE;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    VkImageView view = VK_NULL_HANDLE;
+    uint64_t allocationBytes = 0;
+};
+
+}  // namespace
+
+struct AmazePipeline::Impl {
+    VulkanContext ctx{};
+    ShaderProvider shaders;
+    PipelineConfig cfg{};
+    std::function<void()> passBoundary;
+    std::function<VkCommandBuffer()> commandBoundary;
+
+    std::vector<Tile> tiles;
+    uint32_t batchTiles = 0;          // tiles per dispatch (slots)
+    VkDeviceSize batchParamStride = 0;  // aligned bytes per batch of TileParams
+
+    VkDescriptorSetLayout setLayout = VK_NULL_HANDLE;
+    VkPipelineLayout pipelineLayout = VK_NULL_HANDLE;
+    VkDescriptorPool descriptorPool = VK_NULL_HANDLE;
+    std::array<VkShaderModule, kPasses.size()> modules{};
+    std::array<VkPipeline, kPasses.size()> pipelines{};
+    VkSampler packedSampler = VK_NULL_HANDLE;
+
+    // Slot-strided tile buffers shared by one batch (the bulk of the footprint).
+    OwnedBuffer source, result, scratch;
+    VkDescriptorSet set = VK_NULL_HANDLE;
+    OwnedBuffer params;
+    void* paramsMapped = nullptr;
+    // Binding placeholders for the input the configured mode does not read.
+    OwnedImage dummyPacked;
+    OwnedBuffer dummyNormalized;
+    bool dummyLayoutReady = false;
+
+    uint64_t liveBytes = 0;
+    uint64_t peakBytes = 0;
+
+    Impl(VulkanContext c, ShaderProvider sp, PipelineConfig pc) : ctx(c), shaders(std::move(sp)), cfg(pc) {
+        const char* why = nullptr;
+        if (!AmazePipeline::validateConfig(cfg, &why))
+            throw std::runtime_error(std::string("AMaZE configuration invalid: ") + (why ? why : "unknown"));
+        if (ctx.physicalDevice == VK_NULL_HANDLE || ctx.device == VK_NULL_HANDLE)
+            throw std::runtime_error("AMaZE VulkanContext requires physicalDevice and device");
+        if (!shaders) throw std::runtime_error("AMaZE ShaderProvider is empty");
+        tiles = tileGrid(cfg.width, cfg.height);
+        try {
+            createResources();
+        } catch (...) {
+            cleanup();
+            throw;
+        }
+    }
+    ~Impl() { cleanup(); }
+
+    OwnedBuffer makeBuffer(VkDeviceSize bytes, VkBufferUsageFlags usage, VkMemoryPropertyFlags flags) {
+        OwnedBuffer o{};
+        o.size = bytes;
+        VkBufferCreateInfo bi{};
+        bi.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+        bi.size = bytes;
+        bi.usage = usage;
+        bi.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+        check(vkCreateBuffer(ctx.device, &bi, ctx.allocator, &o.buffer), "AMaZE vkCreateBuffer failed");
+        VkMemoryRequirements mr{};
+        vkGetBufferMemoryRequirements(ctx.device, o.buffer, &mr);
+        VkMemoryAllocateInfo ai{};
+        ai.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+        ai.allocationSize = mr.size;
+        ai.memoryTypeIndex = memoryType(ctx.physicalDevice, mr.memoryTypeBits, flags);
+        check(vkAllocateMemory(ctx.device, &ai, ctx.allocator, &o.memory), "AMaZE vkAllocateMemory failed");
+        check(vkBindBufferMemory(ctx.device, o.buffer, o.memory, 0), "AMaZE vkBindBufferMemory failed");
+        o.allocationBytes = mr.size;
+        liveBytes += mr.size;
+        peakBytes = std::max(peakBytes, liveBytes);
+        return o;
+    }
+    OwnedImage makeDummyImage() {
+        OwnedImage o{};
+        VkImageCreateInfo ci{};
+        ci.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+        ci.imageType = VK_IMAGE_TYPE_2D;
+        ci.format = VK_FORMAT_R16G16B16A16_SFLOAT;
+        ci.extent = {1, 1, 1};
+        ci.mipLevels = ci.arrayLayers = 1;
+        ci.samples = VK_SAMPLE_COUNT_1_BIT;
+        ci.tiling = VK_IMAGE_TILING_OPTIMAL;
+        ci.usage = VK_IMAGE_USAGE_SAMPLED_BIT;
+        ci.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        check(vkCreateImage(ctx.device, &ci, ctx.allocator, &o.image), "AMaZE vkCreateImage failed");
+        VkMemoryRequirements mr{};
+        vkGetImageMemoryRequirements(ctx.device, o.image, &mr);
+        VkMemoryAllocateInfo ai{};
+        ai.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+        ai.allocationSize = mr.size;
+        ai.memoryTypeIndex = memoryType(ctx.physicalDevice, mr.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+        check(vkAllocateMemory(ctx.device, &ai, ctx.allocator, &o.memory), "AMaZE vkAllocateMemory(image) failed");
+        check(vkBindImageMemory(ctx.device, o.image, o.memory, 0), "AMaZE vkBindImageMemory failed");
+        VkImageViewCreateInfo vi{};
+        vi.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+        vi.image = o.image;
+        vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        vi.format = ci.format;
+        vi.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+        check(vkCreateImageView(ctx.device, &vi, ctx.allocator, &o.view), "AMaZE vkCreateImageView failed");
+        o.allocationBytes = mr.size;
+        liveBytes += mr.size;
+        peakBytes = std::max(peakBytes, liveBytes);
+        return o;
+    }
+    void destroy(OwnedImage& o) {
+        if (o.view) vkDestroyImageView(ctx.device, o.view, ctx.allocator);
+        if (o.image) vkDestroyImage(ctx.device, o.image, ctx.allocator);
+        if (o.memory) vkFreeMemory(ctx.device, o.memory, ctx.allocator);
+        liveBytes -= o.allocationBytes;
+        o = {};
+    }
+    void destroy(OwnedBuffer& o) {
+        if (o.buffer) vkDestroyBuffer(ctx.device, o.buffer, ctx.allocator);
+        if (o.memory) vkFreeMemory(ctx.device, o.memory, ctx.allocator);
+        liveBytes -= o.allocationBytes;
+        o = {};
+    }
+
+    void createResources() {
+        VkPhysicalDeviceProperties props{};
+        vkGetPhysicalDeviceProperties(ctx.physicalDevice, &props);
+        batchTiles = std::min<uint32_t>(cfg.tileSlots, uint32_t(tiles.size()));
+        const VkDeviceSize align = std::max<VkDeviceSize>(props.limits.minStorageBufferOffsetAlignment, 16);
+        batchParamStride = (sizeof(TileParams) * batchTiles + align - 1) / align * align;
+        const VkDeviceSize batches = (tiles.size() + batchTiles - 1) / batchTiles;
+        params = makeBuffer(batchParamStride * batches, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+                            VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+        check(vkMapMemory(ctx.device, params.memory, 0, VK_WHOLE_SIZE, 0, &paramsMapped), "AMaZE map params failed");
+
+        VkSamplerCreateInfo si{};
+        si.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO;
+        si.magFilter = si.minFilter = VK_FILTER_NEAREST;
+        si.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+        si.addressModeU = si.addressModeV = si.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+        check(vkCreateSampler(ctx.device, &si, ctx.allocator, &packedSampler), "AMaZE vkCreateSampler failed");
+        if (cfg.inputMode == InputMode::NormalizedFloatBuffer)
+            dummyPacked = makeDummyImage();
+        else
+            dummyNormalized = makeBuffer(16, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+
+        // One layout for every pass; each module declares the subset it uses.
+        std::array<VkDescriptorSetLayoutBinding, 7> b{};
+        b[0] = {0, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr};          // source
+        b[1] = {1, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr};  // batch params
+        b[2] = {2, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr};          // tile results
+        b[3] = {3, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr};          // scratch
+        b[4] = {5, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr};  // packed CFA
+        b[5] = {6, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr};           // output
+        b[6] = {7, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr};          // float CFA
+        VkDescriptorSetLayoutCreateInfo sl{};
+        sl.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
+        sl.bindingCount = uint32_t(b.size());
+        sl.pBindings = b.data();
+        check(vkCreateDescriptorSetLayout(ctx.device, &sl, ctx.allocator, &setLayout), "AMaZE set layout failed");
+        VkPipelineLayoutCreateInfo pl{};
+        pl.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+        pl.setLayoutCount = 1;
+        pl.pSetLayouts = &setLayout;
+        check(vkCreatePipelineLayout(ctx.device, &pl, ctx.allocator, &pipelineLayout), "AMaZE pipeline layout failed");
+
+        std::array<VkDescriptorPoolSize, 4> ps{{{VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 4},
+                                                {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC, 1},
+                                                {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1},
+                                                {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 1}}};
+        VkDescriptorPoolCreateInfo dpi{};
+        dpi.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+        dpi.maxSets = 1;
+        dpi.poolSizeCount = uint32_t(ps.size());
+        dpi.pPoolSizes = ps.data();
+        check(vkCreateDescriptorPool(ctx.device, &dpi, ctx.allocator, &descriptorPool), "AMaZE descriptor pool failed");
+
+        ensureScratch();
+        VkDescriptorSetAllocateInfo dai{};
+        dai.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+        dai.descriptorPool = descriptorPool;
+        dai.descriptorSetCount = 1;
+        dai.pSetLayouts = &setLayout;
+        check(vkAllocateDescriptorSets(ctx.device, &dai, &set), "AMaZE descriptor set allocation failed");
+
+        for (size_t i = 0; i < kPasses.size(); ++i) {
+            const std::string name = std::string(kPasses[i]) + (isGlsl(i) ? ".comp" : ".wgsl");
+            auto words = shaders(name);
+            if (words.empty()) throw std::runtime_error("AMaZE empty SPIR-V: " + name);
+            VkShaderModuleCreateInfo sm{};
+            sm.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+            sm.codeSize = words.size() * sizeof(uint32_t);
+            sm.pCode = words.data();
+            check(vkCreateShaderModule(ctx.device, &sm, ctx.allocator, &modules[i]), "AMaZE shader module failed");
+            VkComputePipelineCreateInfo ci{};
+            ci.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO;
+            ci.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+            ci.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+            ci.stage.module = modules[i];
+            ci.stage.pName = isGlsl(i) ? "main" : kPasses[i];
+            ci.layout = pipelineLayout;
+            check(vkCreateComputePipelines(ctx.device, ctx.pipelineCache, 1, &ci, ctx.allocator, &pipelines[i]),
+                  ("AMaZE compute pipeline failed: " + name).c_str());
+        }
+    }
+
+    // Slot-strided tile buffers for one batch (the bulk of the footprint).
+    void ensureScratch() {
+        if (source.buffer) return;
+        const VkDeviceSize n = batchTiles;
+        source = makeBuffer(n * kSrcPix * 4, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+        result = makeBuffer(n * kOutPix * 16, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+        scratch = makeBuffer(n * kChannels * kSrcPix * 4, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+                             VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    }
+    void releaseScratch() noexcept {
+        destroy(scratch);
+        destroy(result);
+        destroy(source);
+    }
+
+    void cleanup() noexcept {
+        if (ctx.device == VK_NULL_HANDLE) return;
+        for (auto& p : pipelines)
+            if (p) vkDestroyPipeline(ctx.device, p, ctx.allocator), p = VK_NULL_HANDLE;
+        for (auto& m : modules)
+            if (m) vkDestroyShaderModule(ctx.device, m, ctx.allocator), m = VK_NULL_HANDLE;
+        if (descriptorPool)
+            vkDestroyDescriptorPool(ctx.device, descriptorPool, ctx.allocator), descriptorPool = VK_NULL_HANDLE;
+        if (pipelineLayout)
+            vkDestroyPipelineLayout(ctx.device, pipelineLayout, ctx.allocator), pipelineLayout = VK_NULL_HANDLE;
+        if (setLayout) vkDestroyDescriptorSetLayout(ctx.device, setLayout, ctx.allocator), setLayout = VK_NULL_HANDLE;
+        if (packedSampler) vkDestroySampler(ctx.device, packedSampler, ctx.allocator), packedSampler = VK_NULL_HANDLE;
+        releaseScratch();
+        set = VK_NULL_HANDLE;
+        destroy(dummyPacked);
+        destroy(dummyNormalized);
+        if (paramsMapped) vkUnmapMemory(ctx.device, params.memory), paramsMapped = nullptr;
+        destroy(params);
+    }
+
+    void writeParams(const std::array<float, 3>& wb) {
+        const float inputMode = float(static_cast<uint32_t>(cfg.inputMode));
+        const auto colours = cfaColours(cfg.pattern);
+        for (size_t i = 0; i < tiles.size(); ++i) {
+            const Tile& t = tiles[i];
+            TileParams p{};
+            p.srcOriginX = t.srcX, p.srcOriginY = t.srcY, p.srcWidth = t.srcW, p.srcHeight = t.srcH;
+            p.outOriginX = t.outX, p.outOriginY = t.outY, p.outWidth = t.outW, p.outHeight = t.outH;
+            p.cfa00 = colours[0], p.cfa10 = colours[1], p.cfa01 = colours[2], p.cfa11 = colours[3];
+            p.white = 1.0f;
+            p.wbR = wb[0], p.wbG = wb[1], p.wbB = wb[2];
+            p.color[0] = p.color[4] = p.color[8] = 1.0f;
+            p.sourceIsFloat = 1.0f;
+            p.outputScale = cfg.outputScale;
+            p.outputAlpha = cfg.outputAlpha;
+            p.inputMode = inputMode;
+            p.inputWidth = float(cfg.width);
+            p.pattern = float(static_cast<uint32_t>(cfg.pattern));
+            const VkDeviceSize offset = (i / batchTiles) * batchParamStride + (i % batchTiles) * sizeof(TileParams);
+            std::memcpy(static_cast<char*>(paramsMapped) + offset, &p, sizeof(p));
+        }
+    }
+
+    // packedView == VK_NULL_HANDLE selects the float buffer input.
+    void bindBatch(VkImageView packedView, VkImageLayout packedLayout, const BufferView& floatInput,
+                   const LinearRgbImage& out) {
+        VkDescriptorBufferInfo src{source.buffer, 0, VK_WHOLE_SIZE};
+        VkDescriptorBufferInfo prm{params.buffer, 0, sizeof(TileParams) * batchTiles};
+        VkDescriptorBufferInfo res{result.buffer, 0, VK_WHOLE_SIZE};
+        VkDescriptorBufferInfo scr{scratch.buffer, 0, VK_WHOLE_SIZE};
+        VkDescriptorImageInfo packed{packedSampler, packedView ? packedView : dummyPacked.view,
+                                     packedView ? packedLayout : VK_IMAGE_LAYOUT_GENERAL};
+        VkDescriptorBufferInfo cfa{floatInput.buffer ? floatInput.buffer : dummyNormalized.buffer,
+                                   floatInput.buffer ? floatInput.offset : 0,
+                                   floatInput.buffer ? floatInput.range : VK_WHOLE_SIZE};
+        VkDescriptorImageInfo target{VK_NULL_HANDLE, out.view, VK_IMAGE_LAYOUT_GENERAL};
+        std::array<VkWriteDescriptorSet, 7> w{};
+        const std::array<uint32_t, 7> bindings{0, 1, 2, 3, 5, 6, 7};
+        for (uint32_t i = 0; i < w.size(); ++i) {
+            w[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+            w[i].dstSet = set;
+            w[i].dstBinding = bindings[i];
+            w[i].descriptorCount = 1;
+            w[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+        }
+        w[0].pBufferInfo = &src;
+        w[1].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC;
+        w[1].pBufferInfo = &prm;
+        w[2].pBufferInfo = &res;
+        w[3].pBufferInfo = &scr;
+        w[4].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+        w[4].pImageInfo = &packed;
+        w[5].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+        w[5].pImageInfo = &target;
+        w[6].pBufferInfo = &cfa;
+        vkUpdateDescriptorSets(ctx.device, uint32_t(w.size()), w.data(), 0, nullptr);
+    }
+
+    static void computeBarrier(VkCommandBuffer cmd) {
+        VkMemoryBarrier mb{};
+        mb.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+        mb.srcAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+        mb.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+        vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &mb,
+                             0, nullptr, 0, nullptr);
+    }
+
+    void record(VkCommandBuffer cmd, const PackedCfaImageView& in, const LinearRgbImage& out,
+                const std::array<float, 3>& wb) {
+        if (cmd == VK_NULL_HANDLE) throw std::runtime_error("AMaZE command buffer is null");
+        if (cfg.inputMode != InputMode::PackedCfaRgba16fImage)
+            throw std::runtime_error("AMaZE pipeline not configured for packed CFA input");
+        if (in.rawWidth != cfg.width || in.rawHeight != cfg.height || in.pattern != cfg.pattern)
+            throw std::runtime_error("AMaZE packed CFA raw dimensions/pattern mismatch");
+        if (in.width != cfg.width / 2u || in.height != cfg.height / 2u)
+            throw std::runtime_error("AMaZE packed CFA dimensions must be rawWidth/2 x rawHeight/2");
+        if (in.image == VK_NULL_HANDLE || in.view == VK_NULL_HANDLE)
+            throw std::runtime_error("AMaZE packed CFA image/view is null");
+        if (in.format != VK_FORMAT_R16G16B16A16_SFLOAT) throw std::runtime_error("AMaZE packed CFA must be RGBA16F");
+        if (in.layout != VK_IMAGE_LAYOUT_GENERAL) throw std::runtime_error("AMaZE packed CFA must be GENERAL");
+        recordTiles(cmd, in.view, in.layout, {}, out, wb);
+    }
+
+    void record(VkCommandBuffer cmd, const NormalizedBayerBufferView& in, const LinearRgbImage& out,
+                const std::array<float, 3>& wb) {
+        if (cmd == VK_NULL_HANDLE) throw std::runtime_error("AMaZE command buffer is null");
+        if (cfg.inputMode != InputMode::NormalizedFloatBuffer)
+            throw std::runtime_error("AMaZE pipeline not configured for normalized buffer input");
+        if (in.width != cfg.width || in.height != cfg.height || in.pattern != cfg.pattern)
+            throw std::runtime_error("AMaZE normalized input mismatch");
+        if (in.buffer.buffer == VK_NULL_HANDLE) throw std::runtime_error("AMaZE normalized input buffer is null");
+        const VkDeviceSize needed = VkDeviceSize(cfg.width) * cfg.height * sizeof(float);
+        BufferView view = in.buffer;
+        if (view.range == VK_WHOLE_SIZE) view.range = needed;
+        if (view.range < needed) throw std::runtime_error("AMaZE normalized input buffer is too small");
+        recordTiles(cmd, VK_NULL_HANDLE, VK_IMAGE_LAYOUT_GENERAL, view, out, wb);
+    }
+
+    void recordTiles(VkCommandBuffer cmd, VkImageView packedView, VkImageLayout packedLayout, const BufferView& floatInput,
+                     const LinearRgbImage& out, const std::array<float, 3>& wb) {
+        if (out.image == VK_NULL_HANDLE || out.view == VK_NULL_HANDLE)
+            throw std::runtime_error("AMaZE output image/view is null");
+        if (out.width != cfg.width || out.height != cfg.height)
+            throw std::runtime_error("AMaZE output dimensions do not match pipeline");
+        if (out.format != VK_FORMAT_R16G16B16A16_SFLOAT) throw std::runtime_error("AMaZE output must be RGBA16F");
+        if (out.layout != VK_IMAGE_LAYOUT_GENERAL) throw std::runtime_error("AMaZE output must be GENERAL");
+        for (float g : wb)
+            if (!std::isfinite(g) || !(g > 0.0f)) throw std::runtime_error("AMaZE white balance must be finite > 0");
+        if (dummyPacked.image && !dummyLayoutReady) {
+            VkImageMemoryBarrier b{};
+            b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+            b.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+            b.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+            b.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+            b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+            b.image = dummyPacked.image;
+            b.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+            vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 0,
+                                 nullptr, 0, nullptr, 1, &b);
+            dummyLayoutReady = true;
+        }
+        writeParams(wb);
+        bindBatch(packedView, packedLayout, floatInput, out);
+        computeBarrier(cmd);  // covers scratch reuse after a preceding frame
+        for (size_t first = 0; first < tiles.size(); first += batchTiles) {
+            const uint32_t count = uint32_t(std::min<size_t>(batchTiles, tiles.size() - first));
+            // Each dispatch covers the batch's largest tile; shaders bound-check per tile.
+            uint32_t srcW = 0, srcH = 0, outW = 0, outH = 0;
+            for (size_t k = 0; k < count; ++k) {
+                const Tile& t = tiles[first + k];
+                srcW = std::max(srcW, t.srcW), srcH = std::max(srcH, t.srcH);
+                outW = std::max(outW, t.outW), outH = std::max(outH, t.outH);
+            }
+            const uint32_t offset = uint32_t((first / batchTiles) * batchParamStride);
+            vkCmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, pipelineLayout, 0, 1, &set, 1, &offset);
+            for (size_t pass = 0; pass < kPasses.size(); ++pass) {
+                vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, pipelines[pass]);
+                if (pass == kChoosePass) {
+                    vkCmdDispatch(cmd, (2 * (srcW + srcH) + kChooseLocal - 1) / kChooseLocal, 1, count);
+                } else if (pass == kHvwtPass || pass == kPmwtPass) {
+                    vkCmdDispatch(cmd, 1, 1, count);
+                } else {
+                    const uint32_t w = coversOutput(pass) ? outW : srcW;
+                    const uint32_t h = coversOutput(pass) ? outH : srcH;
+                    vkCmdDispatch(cmd, (w + kLocal - 1) / kLocal, (h + kLocal - 1) / kLocal, count);
+                }
+                computeBarrier(cmd);
+            }
+            if (commandBoundary)
+                cmd = commandBoundary();
+            else if (passBoundary)
+                passBoundary();
+        }
+    }
+};
+
+bool AmazePipeline::validateConfig(const PipelineConfig& c, const char** reason) noexcept {
+    const char* why = nullptr;
+    if (c.width < 32u || c.height < 32u)
+        why = "AMaZE requires width and height >= 32";
+    else if (c.inputMode == InputMode::PackedCfaRgba16fImage && ((c.width & 1u) || (c.height & 1u)))
+        why = "AMaZE packed CFA input requires even raw dimensions";
+    else if (c.tileSlots == 0u)
+        why = "AMaZE requires at least one tile slot";
+    else if (!std::isfinite(c.outputScale) || !std::isfinite(c.outputAlpha))
+        why = "outputScale and outputAlpha must be finite";
+    if (reason) *reason = why;
+    return why == nullptr;
+}
+
+AmazePipeline::AmazePipeline(VulkanContext c, ShaderProvider s, PipelineConfig p)
+    : impl_(std::make_unique<Impl>(c, std::move(s), p)) {}
+AmazePipeline::~AmazePipeline() = default;
+void AmazePipeline::record(VkCommandBuffer c, const PackedCfaImageView& i, const LinearRgbImage& o,
+                           const std::array<float, 3>& wb) {
+    impl_->record(c, i, o, wb);
+}
+void AmazePipeline::record(VkCommandBuffer c, const NormalizedBayerBufferView& i, const LinearRgbImage& o,
+                           const std::array<float, 3>& wb) {
+    impl_->record(c, i, o, wb);
+}
+void AmazePipeline::setPassBoundary(std::function<void()> boundary) { impl_->passBoundary = std::move(boundary); }
+void AmazePipeline::setCommandBoundary(std::function<VkCommandBuffer()> boundary) {
+    impl_->commandBoundary = std::move(boundary);
+}
+const PipelineConfig& AmazePipeline::config() const { return impl_->cfg; }
+uint64_t AmazePipeline::currentAllocatedBytes() const { return impl_->liveBytes; }
+uint64_t AmazePipeline::peakAllocatedBytes() const { return impl_->peakBytes; }
+
+}  // namespace amaze
