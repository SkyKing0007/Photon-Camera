+    private fun validateHighZoomRgb32f26721(
+        file: File,
+        width: Int,
+        height: Int,
+    ): HighZoomRgb32fValidation26721 {
+        val expectedSamples = width.toLong() * height.toLong() * 3L
+        val expectedBytes = expectedSamples * Float.SIZE_BYTES
+        require(file.isFile && file.length() == expectedBytes) {
+            "26721 RGB32F carrier size=${if (file.isFile) file.length() else -1L} expected=$expectedBytes"
+        }
+        val chunk = allocateTrue2xHostBuffer(1024 * 1024, "IRIS26721 RGB32F validation")
+        var samples = 0L
+        var positiveSamples = 0L
+        var maxSignal = 0f
+        try {
+            RandomAccessFile(file, "r").channel.use { channel ->
+                while (samples < expectedSamples) {
+                    val remainingBytes = ((expectedSamples - samples) * Float.SIZE_BYTES)
+                        .coerceAtMost(chunk.capacity().toLong()).toInt()
+                    require((remainingBytes % Float.SIZE_BYTES) == 0)
+                    chunk.clear()
+                    chunk.limit(remainingBytes)
+                    while (chunk.hasRemaining()) {
+                        val read = channel.read(chunk)
+                        require(read > 0) { "26721 truncated RGB32F carrier at sample=$samples" }
+                    }
+                    chunk.flip()
+                    val values = chunk.duplicate().order(ByteOrder.nativeOrder()).asFloatBuffer()
+                    while (values.hasRemaining()) {
+                        val value = values.get()
+                        require(value.isFinite()) { "26721 non-finite RGB32F carrier sample=$samples value=$value" }
+                        if (value > 0f) {
+                            positiveSamples++
+                            if (value > maxSignal) maxSignal = value
+                        }
+                        samples++
+                    }
+                }
+            }
+        } finally {
+            LargeDirectBuffer.free(chunk)
+        }
+        require(samples == expectedSamples) { "26721 RGB32F sample count=$samples expected=$expectedSamples" }
+        require(positiveSamples > 0L && maxSignal > 0f) {
+            "26721 RGB32F carrier has no positive image energy"
+        }
+        return HighZoomRgb32fValidation26721(samples, positiveSamples, maxSignal)
+    }
