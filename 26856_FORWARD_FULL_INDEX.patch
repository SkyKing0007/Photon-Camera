+        GLES30.glUseProgram(sabreClipZoneGaussianProgram26834)
+        bindTexture(sabreClipZoneGaussianProgram26834, "uInput", 0, source)
+        uniform2i(sabreClipZoneGaussianProgram26834, "uSize", w, h)
+        uniform2i(sabreClipZoneGaussianProgram26834, "uDirection", if (horizontal) 1 else 0, if (horizontal) 0 else 1)
+        uniform1i(sabreClipZoneGaussianProgram26834, "uRadius", radius)
+        uniform1fv(sabreClipZoneGaussianProgram26834, "uKernel", kernel)
+        uniform1f(sabreClipZoneGaussianProgram26834, "uGain", gain)
+        uniform1i(sabreClipZoneGaussianProgram26834, "uClamp01", if (clamp01) 1 else 0)
+        draw(sabreClipZoneGaussianProgram26834, w, h, intArrayOf(target))
+    }
