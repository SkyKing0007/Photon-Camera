+    private fun renderSabreNormalDngMerge(
+        raw: Int,
+        flow: SabreConvertedAlignment,
+        covariance: Int,
+        weight: Int,
+        calibration: FrameCalibration,
+        accumulator: Int,
+        useFrameWeight: Boolean,
+        sourceWhiteNormalized: Float,
+        dngOptions26786: IrisMotionSettings.DngOptions.Snapshot,
+    ) {
+        if (sabreNormalDngMergeProgram == 0) {
+            /* IRIS_26791_NEUTRAL_ONLY_DNG_ACCUMULATOR_LIFECYCLE
+             * Night JPEG can require the literal NORMAL DNG accumulator for neutral censorship
+             * even when DNG export is disabled. Link the already-proven accumulator shader lazily;
+             * this does not enable DNG publication or alter NORMAL/LONG reconstruction ownership. */
+            sabreNormalDngMergeProgram = linkProgram(
+                GlesMgcRawSabreShaders26850.normalDngMerge,
+                "iris_26545_sabre_normal_dng_merge",
+            )
+        }
+        check(sabreNormalDngMergeProgram != 0 && accumulator != 0)
+        val program = sabreNormalDngMergeProgram
+        GLES30.glUseProgram(program)
+        bindTexture(program, "uRaw", 0, raw)
+        bindTexture(program, "uFlow", 1, flow.texture)
+        bindTexture(program, "uCovariance", 2, covariance)
+        bindTexture(program, "uRejection", 3, weight)
+        uniformSabreFlowScaleOffset(program, flow)
+        uniform2i(program, "uRawSize", width, height)
+        uniform4f(
+            program,
+            "uFrameBorderPadded",
+            SABRE_SAMPLE_BORDER_PIXELS / width,
+            SABRE_SAMPLE_BORDER_PIXELS / height,
+            1f - SABRE_SAMPLE_BORDER_PIXELS / width,
+            1f - SABRE_SAMPLE_BORDER_PIXELS / height,
+        )
+        uniform1i(program, "uCfaPattern", cfaPattern)
+        uniform1i(program, "uUseFrameWeight", if (useFrameWeight) 1 else 0)
+        uniform4fv(program, "uPhaseGains", calibration.bayerPhaseGains)
+        uniform4fv(program, "uPhaseBlackTerms", calibration.bayerPhaseBlackTerms)
+        uniform1f(program, "uSourceWhiteNormalized", sourceWhiteNormalized.coerceAtLeast(1.0e-5f))
+        uniform1i(program, "uDngLcaEnabled26786", if (dngOptions26786.lcaEnabled) 1 else 0)
+        uniform2f(program, "uDngLcaKrKb26786", dngOptions26786.kR, dngOptions26786.kB)
+        uniform1i(program, "uDngQuadHeadroom26786", if (dngOptions26786.quadScopedHeadroom) 1 else 0)
+        uniform1i(program, "uDngEdgeDeAlias26786", if (dngOptions26786.edgeDeAlias) 1 else 0)
+        uniform4f(
+            program,
+            "uCovRangeRg",
+            COV_MIN_R,
+            COV_MAX_R - COV_MIN_R,
+            COV_MIN_G,
+            COV_MAX_G - COV_MIN_G,
+        )
+        uniform2f(program, "uCovRangeB", COV_MIN_B, COV_MAX_B - COV_MIN_B)
+        GLES30.glEnable(GLES30.GL_BLEND)
+        try {
+            GLES30.glBlendEquation(GLES30.GL_FUNC_ADD)
+            GLES30.glBlendFunc(GLES30.GL_ONE, GLES30.GL_ONE)
+            draw(
+                program,
+                width,
+                height,
+                intArrayOf(accumulator),
+                preserveBlend = true,
+            )
+        } finally {
+            GLES30.glDisable(GLES30.GL_BLEND)
+        }
+    }
