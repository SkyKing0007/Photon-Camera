+    /* IRIS_26720_HIGH_ZOOM_DIRECT_CFA_RGB_GPU
+     * Compact ROI variant of the proven true2x GPU writer. It reconstructs camera-linear RGB
+     * directly from all admitted NORMAL CFA observations at supported 2x density. The native
+     * Sabre/VGN carrier remains the local guide/fallback in highZoomRgbProtect26720.
+     */
+    private fun runHighZoomRgbGpu26720(
+        frames: List<RawStackFrame>,
+        images: List<SafeImage>,
+        evidence: List<True2xFrameEvidence>,
+        outputFile: File,
+        nativeVgnGuideTexture: Int,
+        outputWidth: Int,
+        outputHeight: Int,
+        originX: Int,
+        originY: Int,
+        fullOutputWidth: Int,
+        fullOutputHeight: Int,
+    ): HighZoomRgbStats {
+        if (highZoomRgbMergeProgram26720 == 0) {
+            highZoomRgbMergeProgram26720 = linkProgram(
+                GlesMgcRawSabreShaders26850.highZoomRgbMerge26720, "iris_26720_high_zoom_rgb_merge",
+            )
+        }
+        if (true2xResolveProgram26564 == 0) {
+            true2xResolveProgram26564 = linkProgram(
+                GlesMgcRawSabreShaders26850.true2xResolve26564, "iris_26564_true2x_resolve",
+            )
+        }
+        if (highZoomRgbProtectProgram26720 == 0) {
+            highZoomRgbProtectProgram26720 = linkProgram(
+                GlesMgcRawSabreShaders26850.highZoomRgbProtect26724, "iris_26724_high_zoom_rgb_protect",
+            )
+        }
+        require(nativeVgnGuideTexture != 0) { "26720 high-zoom RGB requires native Sabre/VGN guide" }
+        require(evidence.isNotEmpty())
+        val normalGyro = frames.filter { it.role == RawBurstFrameRole.NORMAL && it.gyroSampleCount > 0 &&
+            it.gyroShakiness.isFinite() && it.gyroShakiness >= 0f }.map { it.gyroShakiness }.sorted()
