+    /**
+     * IRIS_26545_SABRE_MEASURED_SUPPORT
+     * Reproduce the current Sabre global mean of 256 / accumulated-green-weight-Q8.
+     * The value is transported as the merged-noise coefficient scale and therefore reflects
+     * the frames Sabre actually trusted, rather than the nominal burst length.
+     */
+    private fun readSabreResidualNoiseSupport(
+        accumulatedWeightsGb: Int,
+    ): SabreResidualNoiseSupport {
+        val reducedWidth = ceilDiv(width, 4)
+        val reducedHeight = ceilDiv(height, 4)
+        val reduced = createTexture(
+            reducedWidth,
+            reducedHeight,
+            GLES30.GL_RG16F,
+            GLES30.GL_NEAREST,
+        )
+        try {
+            GLES30.glUseProgram(sabreReciprocalGreenWeightProgram)
+            bindTexture(
+                sabreReciprocalGreenWeightProgram,
+                "uAccumulatedWeightsGb",
+                0,
+                accumulatedWeightsGb,
+            )
+            uniform2i(sabreReciprocalGreenWeightProgram, "uInputSize", width, height)
+            draw(
+                sabreReciprocalGreenWeightProgram,
+                reducedWidth,
+                reducedHeight,
+                intArrayOf(reduced),
+            )
+
+            val blockCount = Math.multiplyExact(reducedWidth, reducedHeight)
+            val valueCount = Math.multiplyExact(blockCount, 2)
+            val readback = ByteBuffer.allocateDirect(
+                Math.multiplyExact(valueCount, Short.SIZE_BYTES),
+            ).order(ByteOrder.nativeOrder())
+            bindRenderTargets(intArrayOf(reduced), "Iris Sabre reciprocal green-weight readback")
+            GLES30.glBindBuffer(GLES30.GL_PIXEL_PACK_BUFFER, 0)
+            GLES30.glPixelStorei(GLES30.GL_PACK_ALIGNMENT, 1)
+            GLES30.glReadPixels(
+                0,
+                0,
+                reducedWidth,
+                reducedHeight,
+                GLES30.GL_RG,
+                GLES30.GL_HALF_FLOAT,
+                readback,
+            )
+            GLES30.glBindFramebuffer(GLES30.GL_FRAMEBUFFER, 0)
+            checkGlError("read Iris Sabre reciprocal green weights")
+
+            val values = readback.asShortBuffer()
+            val blockReciprocalSum = DoubleArray(blockCount)
+            val blockSampleCount = DoubleArray(blockCount)
+            var reciprocalSum = 0.0
+            var sampleCount = 0.0
+            for (index in 0 until blockCount) {
+                val localSum = Half.toFloat(values.get(index * 2)).toDouble()
+                val localCount = Half.toFloat(values.get(index * 2 + 1)).toDouble()
+                check(localSum.isFinite() && localCount.isFinite() && localSum > 0.0 && localCount > 0.0) {
+                    "Iris Sabre local support invalid at block=$index sum=$localSum count=$localCount"
+                }
+                blockReciprocalSum[index] = localSum
+                blockSampleCount[index] = localCount
+                reciprocalSum += localSum
+                sampleCount += localCount
+            }
+            check(
+                reciprocalSum.isFinite() && sampleCount.isFinite() &&
+                    reciprocalSum > 0.0 && sampleCount > 0.0
+            ) {
+                "Iris Sabre accumulated green weights produced an invalid merge factor: " +
+                    "sum=$reciprocalSum count=$sampleCount"
+            }
+            val globalScale = (reciprocalSum / sampleCount).toFloat()
+            check(globalScale.isFinite() && globalScale > 0f)
+
+            /* IRIS_26634_LOCAL_RESIDUAL_NOISE_SUPPORT
+             * Convert each exact 4x4 reciprocal-weight average into a multiplier relative to the
+             * already-proven global 26545 variance scale. Clamp to 0.75..1.0 so local evidence may
+             * only reduce residual denoise by at most 25%; low-support blocks retain exact 26633
+             * strength. This cannot create a stronger denoise decision than 26633.
+             */
+            val localStrengthQ8 = ShortArray(blockCount) { index ->
+                val localScale = (blockReciprocalSum[index] / blockSampleCount[index]).toFloat()
+                val boundedRelative = (localScale / globalScale).coerceIn(0.75f, 1.0f)
+                (boundedRelative * 256f + 0.5f).toInt().coerceIn(192, 256).toShort()
+            }
+            return SabreResidualNoiseSupport(
+                globalScale = globalScale,
+                strengthMap = MgcSpatialStrengthMap(
+                    width = reducedWidth,
+                    height = reducedHeight,
+                    q8 = localStrengthQ8,
+                ),
+            )
+        } finally {
+            releaseOwnedTexture(reduced, "Iris Sabre reciprocal green-weight reduction")
+        }
+    }
