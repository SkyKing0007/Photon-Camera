+    private fun logSabreUniversalFusionRadiance26651(
+        normalMean: Int,
+        fusedMean: Int,
+        decision: Int,
+    ): ByteArray {
+        val program = sabreUniversalFusionTelemetryProgram26651
+        check(program != 0)
+        val probeWidth = 64
+        val probeHeight = 48
+        val probe = createTexture(probeWidth, probeHeight, GLES30.GL_RGBA16F, GLES30.GL_NEAREST)
+        val readback = ByteBuffer.allocateDirect(probeWidth * probeHeight * 4 * Short.SIZE_BYTES)
+            .order(ByteOrder.nativeOrder())
+        val shortAuthority = ByteArray(probeWidth * probeHeight)
+        try {
+            GLES30.glUseProgram(program)
+            bindTexture(program, "uNormalMean", 0, normalMean)
+            bindTexture(program, "uFusedMean", 1, fusedMean)
+            bindTexture(program, "uDecision", 2, decision)
+            uniform2i(program, "uProbeSize", probeWidth, probeHeight)
+            draw(program, probeWidth, probeHeight, intArrayOf(probe))
+            GlesGpuScheduler.memoryBarrier()
+            bindRenderTargets(intArrayOf(probe), "26651 fusion radiance/weight telemetry")
+            GLES30.glBindBuffer(GLES30.GL_PIXEL_PACK_BUFFER, 0)
+            GLES30.glPixelStorei(GLES30.GL_PACK_ALIGNMENT, 1)
+            GLES30.glReadPixels(
+                0, 0, probeWidth, probeHeight,
+                GLES30.GL_RGBA, GLES30.GL_HALF_FLOAT, readback,
+            )
+            GLES30.glBindFramebuffer(GLES30.GL_FRAMEBUFFER, 0)
+            checkGlError("26651 fusion radiance/weight telemetry readback")
+            val half = readback.asShortBuffer()
+            var normalSum = 0.0
+            var shortSum = 0.0
+            var fusedSum = 0.0
+            var shortWeightSum = 0.0
+            var allCount = 0
+            var validCount = 0
+            var activeCount = 0
+            var normalOwned = 0
+            var blended = 0
+            var shortOwned = 0
+            var geometryRejected = 0
+            var sourceRejected = 0
+            var snrRejected = 0
+            for (index in 0 until probeWidth * probeHeight) {
+                val normal = Half.toFloat(half.get(index * 4)).toDouble()
+                val short = Half.toFloat(half.get(index * 4 + 1)).toDouble()
+                val shortWeight = Half.toFloat(half.get(index * 4 + 2)).toDouble().coerceIn(0.0, 1.0)
+                val decisionNorm = Half.toFloat(half.get(index * 4 + 3)).toDouble()
+                if (!normal.isFinite() || !short.isFinite() || !shortWeight.isFinite() || !decisionNorm.isFinite()) continue
+                val packed = (decisionNorm * 255.0).roundToInt().coerceIn(0, 255)
+                normalSum += normal
+                shortWeightSum += shortWeight
+                fusedSum += (1.0 - shortWeight) * normal + shortWeight * short
+                allCount++
+                when {
+                    packed <= 191 -> {
+                        validCount++
+                        val radianceCode = packed % 48
+                        when {
+                            radianceCode <= 1 -> normalOwned++
+                            radianceCode >= 46 -> shortOwned++
+                            else -> blended++
+                        }
+                    }
+                    packed < 216 -> geometryRejected++
+                    packed < 233 -> sourceRejected++
+                    else -> snrRejected++
+                }
+                if (shortWeight > 0.005) {
+                    shortAuthority[index] = 1
+                    shortSum += short
+                    activeCount++
+                }
+            }
+            val meanShortWeight = if (allCount > 0) shortWeightSum / allCount else Double.NaN
+            val details =
+                "samples=$allCount sampleGrid=${probeWidth}x${probeHeight} fullFrameReadback=false " +
+                    "sampledValid=$validCount sampledNormalOwned=$normalOwned sampledBlended=$blended sampledShortOwned=$shortOwned " +
+                    "sampledGeometryRejected=$geometryRejected sampledSourceRejected=$sourceRejected sampledSnrRejected=$snrRejected " +
+                    "activeShortSamples=$activeCount " +
+                    "normalRadianceMean=${if (allCount > 0) normalSum / allCount else Double.NaN} " +
+                    "normalizedShortRadianceMean=${if (activeCount > 0) shortSum / activeCount else Double.NaN} " +
+                    "fusedRadianceMean=${if (allCount > 0) fusedSum / allCount else Double.NaN} " +
+                    "normalFinalWeightMean=${if (meanShortWeight.isFinite()) 1.0 - meanShortWeight else Double.NaN} " +
+                    "shortFinalWeightMean=$meanShortWeight productionFusionUnchanged=true " +
+                    "confidenceSemantics=FINAL_PHYSICAL_RADIOMETRIC_WEIGHT"
+            PLog.i(SABRE_TAG, "IRIS_26706_FUSION_DECISION_SAMPLE $details")
+            MotionTrace.processingState("IRIS_26706_FUSION_DECISION_SAMPLE", details)
+            PLog.i(SABRE_TAG, "IRIS_26708_COMPACT_SHORT_AUTHORITY width=$probeWidth height=$probeHeight active=$activeCount")
+            return shortAuthority
+        } finally {
+            releaseOwnedTexture(probe, "26651 fusion radiance/weight telemetry")
+        }
+    }
