+                                            uniform1i(program,"uRowFlickerHarmonic",frame26758.rowFlickerHarmonic)
+                                            uniform2f(program,"uRowFlickerAB",frame26758.rowFlickerA,frame26758.rowFlickerB)
+                                            uniform1f(program,"uRowFlickerStrength",frame26758.rowFlickerStrength.coerceIn(0f,1f))
+                                        } else {
+                                            uniform1i(program,"uRowFlickerHarmonic",0); uniform2f(program,"uRowFlickerAB",0f,0f); uniform1f(program,"uRowFlickerStrength",0f)
+                                        }
+                                        GLES30.glEnable(GLES30.GL_BLEND); GLES30.glBlendEquation(GLES30.GL_FUNC_ADD); GLES30.glBlendFunc(GLES30.GL_ONE,GLES30.GL_ONE)
+                                        draw(program,tileWidth,tileHeight,intArrayOf(temporal,phase),preserveBlend=true)
+                                        GLES30.glDisable(GLES30.GL_BLEND)
+                                    } finally {
+                                        releaseOwnedTexture(rawTexture,"IRIS26718 raw band"); releaseOwnedTexture(flowTexture,"IRIS26718 flow band"); releaseOwnedTexture(covTexture,"IRIS26718 covariance band"); releaseOwnedTexture(rejectionTexture,"IRIS26718 rejection band")
+                                    }
+                                } finally { LargeDirectBuffer.free(rejection); LargeDirectBuffer.free(cov) }
+                            }
+                        }
+                        val detail=createTexture(tileWidth,tileHeight,GLES30.GL_RGBA16F,GLES30.GL_NEAREST)
+                        val program=highZoomDetailResolveProgram26718
+                        GLES30.glUseProgram(program)
+                        bindTexture(program,"uTemporalLumaStats",0,temporal)
+                        bindTexture(program,"uPhaseOccupancy",1,phase)
+                        bindTexture(program,"uNativeVgnGuide",2,nativeVgnGuideTexture)
+                        uniform2i(program,"uOutputOrigin",globalLeft,globalTop)
+                        uniform2i(program,"uOutputFullSize",fullOutputWidth,fullOutputHeight)
+                        uniform2i(program,"uGuideSize",width,height)
+                        draw(program,tileWidth,tileHeight,intArrayOf(detail))
+                        writeHighZoomDetailTile26718(out,detail,localLeft,localTop,tileWidth,tileHeight,detailWidth,phaseHistogram,reasonHistogram)
+                        checkGlError("IRIS26718 high-zoom scalar tile")
+                    } finally { releaseTexturesFrom(tileStart) }
+                    localLeft += tileWidth
+                }
+                localTop += tileHeight
+                GlesGpuScheduler.yieldToUiRenderer()
+            }
+        }
+        val pixels=detailWidth.toLong()*detailHeight.toLong()
+        require(phaseHistogram.sum()==pixels) { "26718 phase proof incomplete" }
+        require(reasonHistogram.sum()==pixels) { "26718 reason proof incomplete" }
+        val active=reasonHistogram[1]+reasonHistogram[2]
+        val strong=reasonHistogram[2]
+        val activePct=(100.0*active.toDouble()/pixels.toDouble()).toFloat()
+        val strongPct=(100.0*strong.toDouble()/pixels.toDouble()).toFloat()
+        val proof="pixels=$pixels active=$active activePct=$activePct strong=$strong strongPct=$strongPct " +
+            "phase0=${phaseHistogram[0]} phase1=${phaseHistogram[1]} phase2=${phaseHistogram[2]} " +
+            "phase3=${phaseHistogram[3]} phase4=${phaseHistogram[4]} temporalRejected=${reasonHistogram[3]} " +
+            "sourceClipOrSupportRejected=${reasonHistogram[4]} agreementRejected=${reasonHistogram[5]} phaseRejected=${reasonHistogram[6]} " +
+            "signalRejected=${reasonHistogram[7]} rgbOwner=NATIVE_SABRE_VGN directHighResRgb=false detailOwner=NORMAL_SCALAR_2X_LUMA_ROI"
+        PLog.i(SABRE_TAG,"IRIS_26718_HIGH_ZOOM_DETAIL_PROOF $proof")
+        MotionTrace.processingState("IRIS_26718_HIGH_ZOOM_DETAIL_PROOF",proof)
+        return HighZoomDetailStats(activePct,strongPct)
+    }
