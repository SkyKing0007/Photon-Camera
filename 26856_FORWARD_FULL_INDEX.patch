+    private fun logSabreExtendedHdrProbe26605(stage: String, source: Int) {
+        val program = sabreExtendedHdrTelemetryProbeProgram
+        if (program == 0 || source == 0) return
+        val probeWidth = 64
+        val probeHeight = 48
+        val probe = createTexture(
+            probeWidth, probeHeight, GLES30.GL_RGBA16F, GLES30.GL_NEAREST,
+        )
+        val readback = ByteBuffer.allocateDirect(
+            Math.multiplyExact(Math.multiplyExact(probeWidth, probeHeight), 4 * Short.SIZE_BYTES),
+        ).order(ByteOrder.nativeOrder())
+        try {
+            GLES30.glUseProgram(program)
+            bindTexture(program, "uHdr", 0, source)
+            uniform2i(program, "uProbeSize", probeWidth, probeHeight)
+            draw(program, probeWidth, probeHeight, intArrayOf(probe))
+            GlesGpuScheduler.memoryBarrier()
+            bindRenderTargets(intArrayOf(probe), "26605 extended HDR telemetry probe")
+            GLES30.glBindBuffer(GLES30.GL_PIXEL_PACK_BUFFER, 0)
+            GLES30.glPixelStorei(GLES30.GL_PACK_ALIGNMENT, 1)
+            GLES30.glReadPixels(
+                0, 0, probeWidth, probeHeight,
+                GLES30.GL_RGBA, GLES30.GL_HALF_FLOAT, readback,
+            )
+            GLES30.glBindFramebuffer(GLES30.GL_FRAMEBUFFER, 0)
+            checkGlError("26605 extended HDR telemetry readback")
+            val half = readback.asShortBuffer()
+            val samples = ArrayList<Float>(probeWidth * probeHeight)
+            var aboveOne = 0
+            var plateauNearOne = 0
+            for (index in 0 until probeWidth * probeHeight) {
+                val r = Half.toFloat(half.get(index * 4))
+                val g = Half.toFloat(half.get(index * 4 + 1))
+                val b = Half.toFloat(half.get(index * 4 + 2))
+                val value = max(r, max(g, b))
+                if (!value.isFinite()) continue
+                samples += value
+                if (value > 1f) aboveOne++
+                if (value in 0.995f..1.005f) plateauNearOne++
+            }
+            samples.sort()
+            fun percentile(fraction: Float): Float {
+                if (samples.isEmpty()) return Float.NaN
+                val index = ((samples.size - 1) * fraction).toInt()
+                    .coerceIn(0, samples.size - 1)
+                return samples[index]
+            }
+            val count = samples.size
+            val details =
+                "stage=$stage samples=$count probe=${probeWidth}x$probeHeight sparse=true " +
+                    "p95=${percentile(0.95f)} p99=${percentile(0.99f)} " +
+                    "max=${samples.lastOrNull() ?: Float.NaN} countAbove1=$aboveOne " +
+                    "fractionAbove1=${if (count > 0) aboveOne.toFloat() / count else Float.NaN} " +
+                    "plateauNear1Fraction=${if (count > 0) plateauNearOne.toFloat() / count else Float.NaN}"
+            PLog.i(SABRE_TAG, "IRIS_26605_HDR_DOMAIN_STATS $details")
+            MotionTrace.processingState("IRIS_26605_HDR_DOMAIN_STATS", details)
+        } finally {
+            releaseOwnedTexture(probe, "26605 extended HDR telemetry probe")
+        }
+    }
