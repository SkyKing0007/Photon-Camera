+    private fun gaussianKernel26834(sigmaIn: Float): Pair<FloatArray, Int> {
+        val sigma = sigmaIn.coerceIn(0.25f, 20f)
+        val radius = kotlin.math.ceil(3.0 * sigma.toDouble()).toInt().coerceIn(1, 30)
+        val k = FloatArray(61)
+        var sum = 0.0
+        for (i in -radius..radius) {
+            val v = kotlin.math.exp(-0.5 * (i.toDouble() / sigma.toDouble()) * (i.toDouble() / sigma.toDouble()))
+            k[i + 30] = v.toFloat(); sum += v
+        }
+        for (i in k.indices) k[i] = (k[i] / sum.toFloat())
+        return k to radius
+    }
