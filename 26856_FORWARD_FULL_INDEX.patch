+    private fun createSabreShortProtection26602(
+        boundaryGeometry: ShortBoundaryGeometry26600,
+        frameWeight: Int,
+        normalCoverage: Int,
+    ): ShortProtection26602 {
+        require(frameWeight != 0 && normalCoverage != 0)
+        val gridWidth = boundaryGeometry.gridWidth
+        val gridHeight = boundaryGeometry.gridHeight
+        val protectionA = createTexture(gridWidth, gridHeight, GLES30.GL_R8, GLES30.GL_LINEAR)
+        val protectionB = createTexture(gridWidth, gridHeight, GLES30.GL_R8, GLES30.GL_LINEAR)
+        val seedProgram = sabreShortProtectionSeedProgram26602
+        check(seedProgram != 0) { "26602 SHORT Sabre protection seed program is unavailable" }
+        GLES30.glUseProgram(seedProgram)
+        bindTexture(seedProgram, "uBoundaryGeometry", 0, boundaryGeometry.texture)
+        bindTexture(seedProgram, "uFrameWeight", 1, frameWeight)
+        bindTexture(seedProgram, "uNormalCoverage", 2, normalCoverage)
+        uniform2i(seedProgram, "uGridSize", gridWidth, gridHeight)
+        draw(seedProgram, gridWidth, gridHeight, intArrayOf(protectionA))
+        val seedCells = countSabreShortProtectionCells26602(
+            protectionA,
+            gridWidth,
+            gridHeight,
+            "26602 SHORT Sabre protection seed",
+        )
+
+        val propagationProgram = sabreShortProtectionPropagateProgram26602
+        check(propagationProgram != 0) { "26602 SHORT Sabre protection propagation program is unavailable" }
+        val passes = Math.addExact(gridWidth, gridHeight)
+        var current = protectionA
+        repeat(passes) { pass ->
+            val output = if ((pass and 1) == 0) protectionB else protectionA
+            GLES30.glUseProgram(propagationProgram)
+            bindTexture(propagationProgram, "uCurrent", 0, current)
+            bindTexture(propagationProgram, "uBoundaryGeometry", 1, boundaryGeometry.texture)
+            uniform2i(propagationProgram, "uGridSize", gridWidth, gridHeight)
+            uniform2i(propagationProgram, "uRawSize", width, height)
+            uniform1f(propagationProgram, "uConsensusPixels", 2.0f)
+            draw(propagationProgram, gridWidth, gridHeight, intArrayOf(output))
+            current = output
+        }
+        val finalCells = countSabreShortProtectionCells26602(
+            current,
+            gridWidth,
+            gridHeight,
+            "26602 SHORT Sabre protection final",
+        )
+        val unused = if (current == protectionA) protectionB else protectionA
+        releaseOwnedTexture(unused, "26602 SHORT Sabre protection ping-pong")
+        return ShortProtection26602(
+            texture = current,
+            seedCells = seedCells,
+            finalCells = finalCells,
+            passes = passes,
+        )
+    }
