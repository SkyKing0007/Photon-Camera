+    private fun writeHighZoomDetailTile26718(
+        output: RandomAccessFile,
+        texture: Int,
+        left: Int,
+        top: Int,
+        tileWidth: Int,
+        tileHeight: Int,
+        fullOutputWidth: Int,
+        phaseHistogram: LongArray,
+        reasonHistogram: LongArray,
+    ) {
+        val rg = allocateTrue2xHostBuffer(
+            Math.multiplyExact(Math.multiplyExact(tileWidth, tileHeight), 4 * Short.SIZE_BYTES),
+            "IRIS26718 high-zoom RGBA16F readback",
+        )
+        val detail = allocateTrue2xHostBuffer(
+            Math.multiplyExact(Math.multiplyExact(tileWidth, tileHeight), Short.SIZE_BYTES),
+            "IRIS26718 high-zoom R16F pack",
+        )
+        try {
+            bindRenderTargets(intArrayOf(texture), "IRIS26718 high-zoom detail framebuffer")
+            GLES30.glBindBuffer(GLES30.GL_PIXEL_PACK_BUFFER, 0)
+            GLES30.glPixelStorei(GLES30.GL_PACK_ALIGNMENT, 1)
+            rg.clear()
+            GLES30.glReadPixels(0, 0, tileWidth, tileHeight, GLES30.GL_RGBA, GLES30.GL_HALF_FLOAT, rg)
+            GLES30.glBindFramebuffer(GLES30.GL_FRAMEBUFFER, 0)
+            checkGlError("IRIS26718 high-zoom detail readback")
+            val rgShort = rg.duplicate().order(ByteOrder.nativeOrder()).asShortBuffer()
+            val detailShort = detail.duplicate().order(ByteOrder.nativeOrder()).asShortBuffer()
+            for (index in 0 until tileWidth * tileHeight) {
+                detailShort.put(index, rgShort.get(index * 4))
+                val diagnostic = Half.toFloat(rgShort.get(index * 4 + 1)).toInt()
+                require(diagnostic in 0..39) { "26718 invalid high-zoom diagnostic=$diagnostic" }
+                phaseHistogram[(diagnostic / 8).coerceIn(0, 4)]++
+                reasonHistogram[diagnostic % 8]++
+            }
+            detail.position(0)
+            writeTrue2xTileRows(
+                output, detail, left, top, tileWidth, tileHeight,
+                fullOutputWidth, Short.SIZE_BYTES,
+            )
+        } finally {
+            LargeDirectBuffer.free(detail)
+            LargeDirectBuffer.free(rg)
+        }
+    }
