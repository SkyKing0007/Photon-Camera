+            ) { "26778/26782 edge false-color stats out of range gate=$gate blendPass1=$blendPass1 blendPass2=$blendPass2 coherent=$coherent clippedNeutral=$clippedNeutral pixels=$pixels" }
+            return intArrayOf(gate, blendPass1, blendPass2, coherent, clippedNeutral)
+        } finally {
+            if (mapped) {
+                GLES31.glBindBuffer(GLES31.GL_SHADER_STORAGE_BUFFER, statsBuffer)
+                GLES31.glUnmapBuffer(GLES31.GL_SHADER_STORAGE_BUFFER)
