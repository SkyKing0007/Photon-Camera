+        bindTexture(normalizeRgbProgram, "uGbWeights", 1, opponentWeightAccumulator)
+        bindTexture(normalizeRgbProgram, "uLensShading", 2, lensShadingTexture)
+        uniform2i(
+            normalizeRgbProgram,
+            "uAccumulatorSize",
+            outputCore.width,
+            outputCore.height,
+        )
+        uniform2i(normalizeRgbProgram, "uTargetOrigin", targetLeft, targetTop)
+        uniform2i(
+            normalizeRgbProgram,
+            "uOutputOrigin",
