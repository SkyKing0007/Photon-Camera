+    /* IRIS_26721_HIGH_ZOOM_RGB32F_TRANSFER_OWNER
+     * The established Motion V2 cross-context transport is FLOAT32/RGBA32F (26700).
+     * Keep every inherited true-2x RGB16F publication path unchanged; only the >=20x compact
+     * direct-CFA carrier converts the already-rendered RGBA16F tile to a persisted RGB32F file.
+     * This prevents packed binary16 bytes from being interpreted by GLTexture as GL_FLOAT.
+     */
+    private fun writeHighZoomRgb32fTile26721(
+        output: RandomAccessFile,
+        texture: Int,
+        left: Int,
+        top: Int,
+        tileWidth: Int,
+        tileHeight: Int,
+        fullOutputWidth: Int,
+        label: String,
+        phaseHistogram: LongArray,
+        reasonHistogram: LongArray,
+        fullOutputHeight: Int,
+    ) {
+        val rgba = allocateTrue2xHostBuffer(
+            Math.multiplyExact(Math.multiplyExact(tileWidth, tileHeight), 4 * Float.SIZE_BYTES),
+            "$label RGBA32F readback",
+        )
+        val rgb = allocateTrue2xHostBuffer(
+            Math.multiplyExact(Math.multiplyExact(tileWidth, tileHeight), HIGH_ZOOM_RGB32F_BYTES_PER_PIXEL),
+            "$label RGB32F pack",
+        )
+        try {
+            bindRenderTargets(intArrayOf(texture), "$label framebuffer")
+            GLES30.glBindBuffer(GLES30.GL_PIXEL_PACK_BUFFER, 0)
+            GLES30.glPixelStorei(GLES30.GL_PACK_ALIGNMENT, Float.SIZE_BYTES)
+            rgba.clear()
+            /* Exact established 26700 transport boundary: floating render target -> GL_FLOAT CPU carrier. */
+            GLES30.glReadPixels(
+                0, 0, tileWidth, tileHeight,
+                GLES30.GL_RGBA, GLES30.GL_FLOAT, rgba,
+            )
+            checkGlError("$label RGBA32F readback")
+            GLES30.glBindFramebuffer(GLES30.GL_FRAMEBUFFER, 0)
+            val rgbaFloat = rgba.duplicate().order(ByteOrder.nativeOrder()).asFloatBuffer()
+            val rgbFloat = rgb.duplicate().order(ByteOrder.nativeOrder()).asFloatBuffer()
+            for (index in 0 until tileWidth * tileHeight) {
+                val r = rgbaFloat.get(index * 4)
+                val g = rgbaFloat.get(index * 4 + 1)
+                val b = rgbaFloat.get(index * 4 + 2)
+                require(r.isFinite() && g.isFinite() && b.isFinite()) {
+                    "26721 non-finite high-zoom RGB32F sample index=$index rgb=$r,$g,$b"
+                }
+                rgbFloat.put(index * 3, r)
+                rgbFloat.put(index * 3 + 1, g)
+                rgbFloat.put(index * 3 + 2, b)
+                val diagnosticFloat = rgbaFloat.get(index * 4 + 3)
+                require(diagnosticFloat.isFinite()) { "26721 non-finite high-zoom diagnostic index=$index" }
+                val diagnostic = diagnosticFloat.roundToInt()
+                require(diagnostic in 0..39) { "26721 invalid high-zoom diagnostic code=$diagnostic" }
+                val phaseCount = (diagnostic / 8).coerceIn(0, 4)
+                val reasonClass = diagnostic % 8
+                phaseHistogram[phaseCount]++
+                reasonHistogram[reasonClass]++
+            }
+            rgb.position(0)
+            writeTrue2xTileRows(
+                output, rgb, left, top, tileWidth, tileHeight,
+                fullOutputWidth, HIGH_ZOOM_RGB32F_BYTES_PER_PIXEL,
+            )
+        } finally {
+            GLES30.glPixelStorei(GLES30.GL_PACK_ALIGNMENT, 1)
+            LargeDirectBuffer.free(rgb)
+            LargeDirectBuffer.free(rgba)
+        }
+    }
