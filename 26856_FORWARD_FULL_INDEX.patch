+    private fun createSabreShortBoundaryGeometry26600(
+        referenceRaw: Int,
+        shortRaw: Int,
+        flow: SabreConvertedAlignment,
+        referenceCalibration: FrameCalibration,
+        shortCalibration: FrameCalibration,
+        exposureRatio: Float,
+    ): ShortBoundaryGeometry26600 {
+        val flowSpec = checkNotNull(textureSpecs[flow.texture]) {
+            "26600 SHORT boundary geometry requires owned Sabre flow"
+        }
+        val gridWidth = flowSpec.width
+        val gridHeight = flowSpec.height
+        require(gridWidth > 0 && gridHeight > 0)
+        val geometryA = createTexture(gridWidth, gridHeight, GLES30.GL_RGBA16F, GLES30.GL_LINEAR)
+        val geometryB = createTexture(gridWidth, gridHeight, GLES30.GL_RGBA16F, GLES30.GL_LINEAR)
+        val seedProgram = sabreShortBoundaryGeometrySeedProgram26600
+        check(seedProgram != 0)
+        GLES30.glUseProgram(seedProgram)
+        bindTexture(seedProgram, "uFlow", 0, flow.texture)
+        bindTexture(seedProgram, "uReferenceRaw", 1, referenceRaw)
+        bindTexture(seedProgram, "uShortRaw", 2, shortRaw)
+        uniform2i(seedProgram, "uGridSize", gridWidth, gridHeight)
+        uniform2i(seedProgram, "uRawSize", width, height)
+        uniformSabreFlowScaleOffset(seedProgram, flow)
+        uniform4fv(seedProgram, "uReferenceBlackByPhase", positionalBlackLevels26587(referenceCalibration))
+        uniform4fv(seedProgram, "uShortBlackByPhase", positionalBlackLevels26587(shortCalibration))
+        uniform1f(seedProgram, "uWhiteLevel", sensorWhiteLevel)
+        uniform1f(seedProgram, "uExposureRatio", exposureRatio)
+        uniform1f(seedProgram, "uRegionFloor", 0.70f)
+        uniform1f(seedProgram, "uBoundaryCeiling", 0.90f)
+        uniform1f(seedProgram, "uShortHeadroomThreshold", 0.90f)
+        uniform1f(seedProgram, "uConsensusPixels", 2.0f)
+        uniform1f(seedProgram, "uConsistencyThreshold", 0.05f)
+        draw(seedProgram, gridWidth, gridHeight, intArrayOf(geometryA))
+        val seedProbe = probeSabreShortBoundaryGeometry26600(
+            geometryA, gridWidth, gridHeight, "26600 SHORT boundary seed",
+        )
+
+        val propagationProgram = sabreShortBoundaryGeometryPropagateProgram26600
+        check(propagationProgram != 0)
+        val passes = Math.addExact(gridWidth, gridHeight)
+        var current = geometryA
+        repeat(passes) { pass ->
+            val output = if ((pass and 1) == 0) geometryB else geometryA
+            GLES30.glUseProgram(propagationProgram)
+            bindTexture(propagationProgram, "uCurrent", 0, current)
+            bindTexture(propagationProgram, "uReferenceRaw", 1, referenceRaw)
+            uniform2i(propagationProgram, "uGridSize", gridWidth, gridHeight)
+            uniform2i(propagationProgram, "uRawSize", width, height)
+            uniformSabreFlowScaleOffset(propagationProgram, flow)
+            uniform4fv(
+                propagationProgram, "uReferenceBlackByPhase",
+                positionalBlackLevels26587(referenceCalibration),
+            )
+            uniform1f(propagationProgram, "uWhiteLevel", sensorWhiteLevel)
+            uniform1f(propagationProgram, "uRegionFloor", 0.70f)
+            uniform1f(propagationProgram, "uConsensusPixels", 2.0f)
+            draw(propagationProgram, gridWidth, gridHeight, intArrayOf(output))
+            current = output
+        }
+        val finalProbe = probeSabreShortBoundaryGeometry26600(
+            current, gridWidth, gridHeight, "26600 SHORT boundary final",
+        )
+        return ShortBoundaryGeometry26600(
+            texture = current,
+            gridWidth = gridWidth,
+            gridHeight = gridHeight,
+            passes = passes,
+            seedGeometryCells = seedProbe.first,
+            seedBoundaryCells = seedProbe.second,
+            finalGeometryCells = finalProbe.first,
+            finalBoundaryCells = finalProbe.second,
+        )
+    }
