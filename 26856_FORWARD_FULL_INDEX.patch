+    private fun createSabreShortComponentTrust26607(
+        referenceRaw: Int,
+        shortRaw: Int,
+        flow: SabreConvertedAlignment,
+        referenceCalibration: FrameCalibration,
+        shortCalibration: FrameCalibration,
+        exposureRatio: Float,
+        fallbackAffine: ShortFallbackAffine26625,
+    ): ShortComponentTrust26607 {
+        val flowSpec = checkNotNull(textureSpecs[flow.texture]) {
+            "26607 SHORT component trust requires owned Sabre flow"
+        }
+        val gridWidth = flowSpec.width
+        val gridHeight = flowSpec.height
+        val anchorTexture = createTexture(
+            gridWidth, gridHeight, GLES30.GL_RGBA16F, GLES30.GL_NEAREST,
+        )
+        val trustA = createTexture(gridWidth, gridHeight, GLES30.GL_R8, GLES30.GL_LINEAR)
+        val trustB = createTexture(gridWidth, gridHeight, GLES30.GL_R8, GLES30.GL_LINEAR)
+        val anchorProgram = sabreShortComponentAnchorProgram26607
+        check(anchorProgram != 0)
+        GLES30.glUseProgram(anchorProgram)
+        bindTexture(anchorProgram, "uFlow", 0, flow.texture)
+        bindTexture(anchorProgram, "uReferenceRaw", 1, referenceRaw)
+        bindTexture(anchorProgram, "uShortRaw", 2, shortRaw)
+        uniform2i(anchorProgram, "uGridSize", gridWidth, gridHeight)
+        uniform2i(anchorProgram, "uRawSize", width, height)
+        uniformSabreFlowScaleOffset(anchorProgram, flow)
+        uniform4fv(
+            anchorProgram, "uReferenceBlackByPhase",
+            positionalBlackLevels26587(referenceCalibration),
+        )
+        uniform4fv(
+            anchorProgram, "uShortBlackByPhase",
+            positionalBlackLevels26587(shortCalibration),
+        )
+        uniform1f(anchorProgram, "uWhiteLevel", sensorWhiteLevel)
+        uniform1f(anchorProgram, "uExposureRatio", exposureRatio)
+        uniform1f(anchorProgram, "uSourceClippingPoint", sabreShadowLongSourceClippingPoint())
+        uniform1f(anchorProgram, "uComponentFloor", 0.55f)
+        uniform1f(anchorProgram, "uComponentFull", 0.75f)
+        uniform1f(anchorProgram, "uBoundaryCeiling", 0.90f)
+        uniform1f(anchorProgram, "uConsistencyLow", 0.03f)
+        uniform1f(anchorProgram, "uConsistencyHigh", 0.08f)
+        uniform1f(anchorProgram, "uFallbackAffineValid", if (fallbackAffine.valid) 1f else 0f)
+        uniform3f(
+            anchorProgram, "uFallbackFlowX",
+            fallbackAffine.flowX[0], fallbackAffine.flowX[1], fallbackAffine.flowX[2],
+        )
+        uniform3f(
+            anchorProgram, "uFallbackFlowY",
+            fallbackAffine.flowY[0], fallbackAffine.flowY[1], fallbackAffine.flowY[2],
+        )
+        draw(anchorProgram, gridWidth, gridHeight, intArrayOf(anchorTexture))
+
+        clearSabreSingleChannelTexture26606(
+            trustA, gridWidth, gridHeight, "26607 SHORT component trust A clear",
+        )
+        clearSabreSingleChannelTexture26606(
+            trustB, gridWidth, gridHeight, "26607 SHORT component trust B clear",
+        )
+        val propagationProgram = sabreShortComponentPropagateProgram26607
+        check(propagationProgram != 0)
+        val seedProbe = createTexture(gridWidth, gridHeight, GLES30.GL_R8, GLES30.GL_NEAREST)
+        try {
+            /* Zero-current pass extracts exact anchor.w without permitting propagation. */
+            GLES30.glUseProgram(propagationProgram)
+            bindTexture(propagationProgram, "uAnchor", 0, anchorTexture)
+            bindTexture(propagationProgram, "uCurrent", 1, trustA)
+            uniform2i(propagationProgram, "uGridSize", gridWidth, gridHeight)
+            uniform2i(propagationProgram, "uRawSize", width, height)
+            draw(propagationProgram, gridWidth, gridHeight, intArrayOf(seedProbe))
+            val seedCells = countSabreTrustCells26606(
+                seedProbe, gridWidth, gridHeight, "26607 SHORT boundary anchor probe",
+            )
+
+            val passes = Math.addExact(gridWidth, gridHeight)
+            var current = trustA
+            repeat(passes) { pass ->
+                val output = if ((pass and 1) == 0) trustB else trustA
+                GLES30.glUseProgram(propagationProgram)
+                bindTexture(propagationProgram, "uAnchor", 0, anchorTexture)
+                bindTexture(propagationProgram, "uCurrent", 1, current)
+                uniform2i(propagationProgram, "uGridSize", gridWidth, gridHeight)
+                uniform2i(propagationProgram, "uRawSize", width, height)
+                draw(propagationProgram, gridWidth, gridHeight, intArrayOf(output))
+                current = output
+            }
+            val finalCells = countSabreTrustCells26606(
+                current, gridWidth, gridHeight, "26607 SHORT component final probe",
+            )
+            val diagnostics26626 = measureSabreShortComponentDiagnostics26626(
+                anchorTexture, current, gridWidth, gridHeight,
+            )
+            val effectiveFlowTexture = createTexture(
+                gridWidth, gridHeight, GLES30.GL_RGBA16F, GLES30.GL_LINEAR,
+            )
+            val fallbackUsage = createTexture(
+                gridWidth, gridHeight, GLES30.GL_R8, GLES30.GL_NEAREST,
+            )
+            val effectiveFlowProgram = sabreShortComponentEffectiveFlowProgram26625
+            check(effectiveFlowProgram != 0)
+            GLES30.glUseProgram(effectiveFlowProgram)
+            bindTexture(effectiveFlowProgram, "uFlow", 0, flow.texture)
+            bindTexture(effectiveFlowProgram, "uAnchor", 1, anchorTexture)
+            bindTexture(effectiveFlowProgram, "uTrust", 2, current)
+            uniform2i(effectiveFlowProgram, "uGridSize", gridWidth, gridHeight)
+            draw(
+                effectiveFlowProgram, gridWidth, gridHeight,
+                intArrayOf(effectiveFlowTexture, fallbackUsage),
+            )
+            val fallbackTrustedCells = countSabreTrustCells26606(
+                fallbackUsage, gridWidth, gridHeight, "26625 SHORT fallback geometry usage",
+            )
+            releaseOwnedTexture(fallbackUsage, "26625 SHORT fallback geometry usage")
+            releaseOwnedTexture(anchorTexture, "26625 SHORT component geometry metadata")
+            val spare = if (current == trustA) trustB else trustA
+            releaseOwnedTexture(spare, "26607 SHORT component spare trust")
+            val effectiveFlow = SabreConvertedAlignment(
+                effectiveFlowTexture, flow.scaleX, flow.scaleY, flow.offsetX, flow.offsetY,
+            )
+            return ShortComponentTrust26607(
+                current, effectiveFlow, seedCells, finalCells, fallbackTrustedCells,
