+            var hardBarrier = 0
+            var openFrontier = 0
+            repeat(gridWidth * gridHeight) {
+                if ((buffer.get().toInt() and 0xff) != 0) membership++
+                if ((buffer.get().toInt() and 0xff) != 0) untrusted++
+                if ((buffer.get().toInt() and 0xff) != 0) hardBarrier++
+                if ((buffer.get().toInt() and 0xff) != 0) openFrontier++
