+    /* IRIS_26678_RAW_ROW_FLICKER_OBSERVER
+     * Four horizontal blocks must agree on the same row harmonic, and that harmonic must drift
+     * consistently across physical frames. This rejects ordinary static walls/shelves/horizons:
+     * static structure can have a row Fourier component, but it does not acquire coherent phase
+     * motion across successive equal-exposure RAWs. No semantic scene labels are used. */
+    private void sampleMotion26678RawFlickerEvidence(@NonNull Image image,
+            @NonNull java.nio.ByteBuffer buffer, int rowStride, int pixelStride,
+            int width, int height, int whiteLevel,
+            @NonNull android.hardware.camera2.params.BlackLevelPattern blackPattern) {
+        if (!isZslMode() || image.getTimestamp() <= 0L || pixelStride < 2
+                || rowStride <= 0 || width < 32 || height < 32) return;
+        try {
+            int top = 2;
+            int bottom = height - 2;
+            if (PhotonCamera.getSettings().aspect169 && width > height) {
+                int cropHeight = width * 9 / 16;
+                if (cropHeight > 0 && cropHeight < height) {
+                    int offset = (height - cropHeight) / 2;
+                    offset -= offset % 2;
+                    top = Math.max(2, offset + 2);
+                    bottom = Math.min(height - 2, offset + cropHeight - 2);
+                }
+            }
+            int usableHeight = bottom - top;
+            if (usableHeight < 24) return;
+            int stepX = Math.max(4, width / 48);
+            int stepY = Math.max(4, usableHeight / 36);
+            for (int block = 0; block < MOTION_26678_FLICKER_BLOCKS; block++) {
+                java.util.Arrays.fill(mMotion26678BlockSums[block], 0.0);
+                java.util.Arrays.fill(mMotion26678BlockCounts[block], 0);
+                java.util.Arrays.fill(mMotion26678BlockProfiles[block], 0.0);
+                mMotion26678ValidBlock[block] = false;
+            }
+            java.util.Arrays.fill(mMotion26678GlobalProfile, 0.0);
+            int rows = 0;
+            final double signalFloor = 1.0 / 1024.0;
+            for (int y = top; y < bottom && rows < MOTION_26678_FLICKER_MAX_ROWS; y += stepY) {
+                for (int x = 2; x < width - 2; x += stepX) {
+                    int block = Math.min(MOTION_26678_FLICKER_BLOCKS - 1,
+                            Math.max(0, x * MOTION_26678_FLICKER_BLOCKS / Math.max(1, width)));
+                    double quad = 0.0;
+                    int quadCount = 0;
+                    for (int dy = 0; dy < 2; dy++) {
+                        for (int dx = 0; dx < 2; dx++) {
+                            int sx = x + dx, sy = y + dy;
+                            int index = sy * rowStride + sx * pixelStride;
+                            if (index < 0 || index + 1 >= buffer.limit()) continue;
+                            int raw = buffer.getShort(index) & 0xffff;
+                            int black = blackPattern.getOffsetForIndex(sx & 1, sy & 1);
+                            int span = Math.max(1, whiteLevel - black);
+                            float signal = motion26368Clamp01((raw - black) / (float) span);
+                            quad += signal;
+                            quadCount++;
+                        }
+                    }
+                    if (quadCount > 0) {
+                        double mean = quad / quadCount;
+                        mMotion26678BlockSums[block][rows] += mean;
+                        mMotion26678BlockCounts[block][rows]++;
+                    }
+                }
+                rows++;
+            }
+            if (rows < MOTION_26678_FLICKER_MIN_ROWS) return;
+
+            int validBlocks = 0;
+            for (int block = 0; block < MOTION_26678_FLICKER_BLOCKS; block++) {
+                double mean = 0.0;
+                int validRows = 0;
+                for (int row = 0; row < rows; row++) {
+                    if (mMotion26678BlockCounts[block][row] <= 0) continue;
+                    mMotion26678BlockProfiles[block][row] = Math.log(
+                            mMotion26678BlockSums[block][row] / mMotion26678BlockCounts[block][row]
+                                    + signalFloor);
+                    mean += mMotion26678BlockProfiles[block][row];
+                    validRows++;
+                }
+                if (validRows < MOTION_26678_FLICKER_MIN_ROWS) continue;
+                mean /= validRows;
+                for (int row = 0; row < rows; row++) mMotion26678BlockProfiles[block][row] -= mean;
+                motion26678RemoveLinearTrend(mMotion26678BlockProfiles[block], rows);
+                mMotion26678ValidBlock[block] = true;
+                validBlocks++;
+            }
+            if (validBlocks < 3) return;
+
+            for (int row = 0; row < rows; row++) {
+                double sum = 0.0;
+                int n = 0;
+                for (int block = 0; block < MOTION_26678_FLICKER_BLOCKS; block++) {
+                    if (!mMotion26678ValidBlock[block]) continue;
+                    sum += mMotion26678BlockProfiles[block][row];
+                    n++;
+                }
+                mMotion26678GlobalProfile[row] = n > 0 ? sum / n : 0.0;
+            }
+            motion26678RemoveLinearTrend(mMotion26678GlobalProfile, rows);
+
+            int bestHarmonic = 0;
+            float bestA = 0.0f, bestB = 0.0f, bestAmplitude = 0.0f;
+            for (int harmonic = 1; harmonic <= MOTION_26678_FLICKER_MAX_HARMONIC; harmonic++) {
+                motion26678FitHarmonic(mMotion26678GlobalProfile, rows, harmonic,
+                        mMotion26678FitScratch);
+                if (mMotion26678FitScratch[2] > bestAmplitude) {
+                    bestHarmonic = harmonic;
+                    bestA = mMotion26678FitScratch[0];
+                    bestB = mMotion26678FitScratch[1];
+                    bestAmplitude = mMotion26678FitScratch[2];
+                }
+            }
+            if (bestHarmonic <= 0) return;
+            float bestPhase = (float) Math.atan2(bestB, bestA);
+            int coherentBlocks = 0;
+            for (int block = 0; block < MOTION_26678_FLICKER_BLOCKS; block++) {
+                if (!mMotion26678ValidBlock[block]) continue;
+                motion26678FitHarmonic(mMotion26678BlockProfiles[block], rows, bestHarmonic,
+                        mMotion26678FitScratch);
+                if (mMotion26678FitScratch[2] < MOTION_26678_FLICKER_BLOCK_MIN_LOG_AMPLITUDE) continue;
+                float phase = (float) Math.atan2(mMotion26678FitScratch[1], mMotion26678FitScratch[0]);
+                if (Math.abs(motion26678WrapPhase(phase - bestPhase)) <= 0.75f) coherentBlocks++;
+            }
+
+            long exposureNs = mMotionUnifiedExposureNs;
+            int iso = mMotionUnifiedIso;
+            synchronized (mZslBufferLock) {
+                TotalCaptureResult exact = mZslResultMap.get(image.getTimestamp());
+                if (exact != null) {
+                    Long e = exact.get(CaptureResult.SENSOR_EXPOSURE_TIME);
+                    Integer s = exact.get(CaptureResult.SENSOR_SENSITIVITY);
+                    if (e != null && e > 0L) exposureNs = e;
+                    if (s != null && s > 0) iso = s;
+                }
+            }
+            final long generation = mIris26548CameraHealthGeneration;
+            boolean stateChanged = false;
+            boolean nowActive;
+            float strength;
+            synchronized (mMotion26678FlickerLock) {
+                boolean generationChanged = generation != mMotion26678DetectorGeneration;
+                boolean exposureChanged = false;
+                if (!generationChanged && exposureNs > 0L && mMotion26678DetectorExposureNs > 0L) {
+                    long tolerance = Math.max(100_000L, mMotion26678DetectorExposureNs / 8L);
+                    int isoTolerance = Math.max(2, Math.max(1, mMotion26678DetectorIso) / 10);
+                    exposureChanged = Math.abs(exposureNs - mMotion26678DetectorExposureNs) > tolerance
+                            || (iso > 0 && mMotion26678DetectorIso > 0
+                                    && Math.abs(iso - mMotion26678DetectorIso) > isoTolerance);
+                }
+                if (generationChanged || exposureChanged) {
+                    motion26678ResetDetectorLocked(generation, exposureNs, iso);
+                } else {
+                    if (exposureNs > 0L) mMotion26678DetectorExposureNs = exposureNs;
+                    if (iso > 0) mMotion26678DetectorIso = iso;
+                }
+
+                boolean risk = exposureNs <= 0L || exposureNs < MOTION_26678_MAX_EXPOSURE_NS;
+                boolean coherent = risk
+                        && bestAmplitude >= MOTION_26678_FLICKER_MIN_LOG_AMPLITUDE
+                        && coherentBlocks >= 3;
+                if (coherent && mMotion26678PreviousHarmonic == bestHarmonic
+                        && Float.isFinite(mMotion26678PreviousPhase)
+                        && mMotion26678PreviousAmplitude >= MOTION_26678_FLICKER_MIN_LOG_AMPLITUDE) {
+                    float delta = motion26678WrapPhase(bestPhase - mMotion26678PreviousPhase);
+                    float absDelta = Math.abs(delta);
+                    int direction = delta > 0.0f ? 1 : (delta < 0.0f ? -1 : 0);
+                    boolean drifting = absDelta >= MOTION_26678_FLICKER_PHASE_DRIFT_MIN
+                            && absDelta <= MOTION_26678_FLICKER_PHASE_DRIFT_MAX;
+                    boolean directionStable = mMotion26678PreviousPhaseDirection == 0
+                            || direction == mMotion26678PreviousPhaseDirection;
+                    if (drifting && direction != 0 && directionStable) {
+                        mMotion26678StableDriftFrames++;
+                        mMotion26678PreviousPhaseDirection = direction;
+                    } else if (absDelta < MOTION_26678_FLICKER_PHASE_DRIFT_MIN) {
+                        mMotion26678StableDriftFrames = Math.max(0,
+                                mMotion26678StableDriftFrames - 1);
+                    } else {
+                        mMotion26678StableDriftFrames = 0;
+                        mMotion26678PreviousPhaseDirection = 0;
+                    }
+                } else if (!coherent) {
+                    mMotion26678StableDriftFrames = Math.max(0, mMotion26678StableDriftFrames - 1);
+                    if (mMotion26678StableDriftFrames == 0) mMotion26678PreviousPhaseDirection = 0;
+                }
+                if (coherent) {
+                    mMotion26678PreviousHarmonic = bestHarmonic;
+                    mMotion26678PreviousPhase = bestPhase;
+                    mMotion26678PreviousAmplitude = bestAmplitude;
+                } else {
+                    mMotion26678PreviousHarmonic = 0;
+                    mMotion26678PreviousPhase = Float.NaN;
+                    mMotion26678PreviousAmplitude = 0.0f;
+                }
+                boolean wasActive = mMotion26678FlickerActive;
+                nowActive = coherent && mMotion26678StableDriftFrames >= 2;
+                mMotion26678FlickerActive = nowActive;
+                mMotion26678ActiveHarmonic = nowActive ? bestHarmonic : 0;
+                strength = nowActive
+                        ? Math.min(1.0f, (mMotion26678StableDriftFrames - 1) / 3.0f)
+                        : 0.0f;
+                motion26678StoreEvidenceLocked(image.getTimestamp(), bestHarmonic,
+                        coherentBlocks, bestA, bestB, bestAmplitude, strength);
+                stateChanged = wasActive != nowActive;
+            }
+            if (stateChanged) {
+                Log.i(TAG, "IRIS_26678_ROW_FLICKER_STATE active=" + nowActive
+                        + " timestamp=" + image.getTimestamp()
+                        + " harmonic=" + bestHarmonic
+                        + " amplitude=" + bestAmplitude
+                        + " coherentBlocks=" + coherentBlocks
+                        + " exposureNs=" + exposureNs
+                        + " iso=" + iso
+                        + " halAeUnchanged=true");
+            }
+        } catch (Throwable t) {
+            Log.w(TAG, "IRIS_26678 row flicker sampling skipped: "
+                    + t.getClass().getSimpleName());
+        }
+    }
