+    private long motion26678ChooseStructuralReferenceTimestamp(@NonNull List<ImageFrame> frames,
+            @NonNull java.util.Set<Long> correctedTimestamps) {
+        if (frames.isEmpty()) return -1L;
+        long fallback = frames.get(frames.size() - 1).timestamp;
+        if (!mMotion26678FlickerActive || correctedTimestamps.isEmpty()) return fallback;
+        float bestPenalty = Float.POSITIVE_INFINITY;
+        long bestTimestamp = -1L;
+        for (ImageFrame frame : frames) {
+            if (frame == null || !correctedTimestamps.contains(frame.timestamp)) continue;
+            float penalty = motion26678ExactFlickerPenalty(frame.timestamp);
+            if (!Float.isFinite(penalty)) continue;
+            if (penalty < bestPenalty - 1.0e-6f
+                    || (Math.abs(penalty - bestPenalty) <= 1.0e-6f
+                            && frame.timestamp > bestTimestamp)) {
+                bestPenalty = penalty;
+                bestTimestamp = frame.timestamp;
+            }
+        }
+        return bestTimestamp > 0L ? bestTimestamp : fallback;
+    }
