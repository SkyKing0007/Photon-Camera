+    private void motion26678StoreEvidenceLocked(long timestampNs, int harmonic,
+            int coherentBlocks, float a, float b, float amplitude, float strength) {
+        int slot = mMotion26678FlickerWriteIndex % MOTION_26678_FLICKER_HISTORY;
+        mMotion26678FlickerTimestampNs[slot] = timestampNs;
+        mMotion26678FlickerHarmonic[slot] = harmonic;
+        mMotion26678FlickerCoherentBlocks[slot] = coherentBlocks;
+        mMotion26678FlickerA[slot] = a;
+        mMotion26678FlickerB[slot] = b;
