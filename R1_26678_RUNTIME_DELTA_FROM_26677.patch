+    private static void motion26678FitHarmonic(double[] values, int count, int harmonic,
+            @NonNull float[] out) {
+        double a = 0.0, b = 0.0;
+        final double scale = 2.0 / Math.max(1, count);
+        for (int i = 0; i < count; i++) {
+            double phase = 2.0 * Math.PI * harmonic * (i + 0.5) / count;
+            a += values[i] * Math.cos(phase);
+            b += values[i] * Math.sin(phase);
+        }
+        a *= scale;
+        b *= scale;
+        out[0] = (float) a;
+        out[1] = (float) b;
+        out[2] = (float) Math.sqrt(a * a + b * b);
+    }
