+        for (int i = 0; i < count; i++) {
+            double x = i - center;
+            sumX2 += x * x;
+            sumXV += x * (values[i] - mean);
+        }
+        double slope = sumX2 > 0.0 ? sumXV / sumX2 : 0.0;
+        for (int i = 0; i < count; i++) values[i] -= mean + slope * (i - center);
+    }
