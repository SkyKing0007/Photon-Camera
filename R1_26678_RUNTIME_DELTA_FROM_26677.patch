+    private boolean motion26678FindEvidenceLocked(long timestampNs, boolean allowRecent,
+            boolean retroactiveCaptureStrength, float[] out) {
+        if (out == null || out.length < 4 || !mMotion26678FlickerActive
+                || mMotion26678ActiveHarmonic <= 0) return false;
+        int best = -1;
+        long bestAge = Long.MAX_VALUE;
+        for (int i = 0; i < MOTION_26678_FLICKER_HISTORY; i++) {
+            long ts = mMotion26678FlickerTimestampNs[i];
+            if (ts <= 0L) continue;
+            if (ts == timestampNs) {
+                best = i;
+                bestAge = 0L;
+                break;
+            }
+            if (!allowRecent) continue;
+            long age = timestampNs - ts;
+            if (age >= 0L && age <= MOTION_26678_PREVIEW_EVIDENCE_MAX_AGE_NS && age < bestAge) {
+                best = i;
+                bestAge = age;
+            }
+        }
+        if (best < 0
+                || mMotion26678FlickerHarmonic[best] != mMotion26678ActiveHarmonic
+                || mMotion26678FlickerCoherentBlocks[best] < 3
+                || mMotion26678FlickerAmplitude[best] < MOTION_26678_FLICKER_MIN_LOG_AMPLITUDE) {
+            return false;
+        }
+        out[0] = mMotion26678FlickerHarmonic[best];
+        out[1] = mMotion26678FlickerA[best];
+        out[2] = mMotion26678FlickerB[best];
+        out[3] = retroactiveCaptureStrength ? 1.0f : mMotion26678FlickerStrength[best];
+        return out[3] > 0.0f;
+    }
