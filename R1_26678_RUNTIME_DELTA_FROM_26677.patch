+    /* Active preview path consumes this only after the existing 26662/26667 WYSIWYG owner. */
+    public boolean getMotion26678PreviewFlicker(long sensorTimestampNs, @NonNull float[] out) {
+        if (!isZslMode() || sensorTimestampNs <= 0L || out.length < 4) return false;
+        synchronized (mMotion26678FlickerLock) {
+            boolean ok = motion26678FindEvidenceLocked(sensorTimestampNs, true, false, out);
+            if (!ok) {
+                out[0] = out[1] = out[2] = out[3] = 0.0f;
+            }
+            return ok;
+        }
+    }
+
+    private float motion26678ExactFlickerPenalty(long timestampNs) {
+        synchronized (mMotion26678FlickerLock) {
+            if (!mMotion26678FlickerActive || mMotion26678ActiveHarmonic <= 0) return Float.NaN;
+            for (int i = 0; i < MOTION_26678_FLICKER_HISTORY; i++) {
+                if (mMotion26678FlickerTimestampNs[i] == timestampNs
+                        && mMotion26678FlickerHarmonic[i] == mMotion26678ActiveHarmonic
+                        && mMotion26678FlickerCoherentBlocks[i] >= 3) {
+                    return mMotion26678FlickerAmplitude[i];
+                }
+            }
+        }
+        return Float.NaN;
+    }
+
+    /* IRIS_26678_NORMAL_ROW_ILLUMINATION_NORMALIZATION
+     * Apply only to the copied NORMAL RAW backing after physical-frame ownership is frozen. The
+     * white-anchored rational map is CFA-neutral, preserves black/white endpoints, and never changes
+     * SHORT/LONG, HAL exposure, DNG source ownership, frame count, timestamps, or merge geometry. */
+    private boolean applyMotion26678NormalRowFlickerCorrection(@NonNull ImageFrame frame) {
+        if (frame.motionV2FrameRole != ImageFrame.MotionV2FrameRole.NORMAL
+                || frame.buffer == null || frame.timestamp <= 0L
+                || !frame.motionV2BlackLevelValid || !frame.motionV2WhiteLevelValid) return false;
+        float[] evidence = new float[4];
+        synchronized (mMotion26678FlickerLock) {
+            if (!motion26678FindEvidenceLocked(frame.timestamp, false, true, evidence)) return false;
+        }
+        int width = frame.width;
+        int height = frame.height;
+        int rowStride;
+        int pixelStride = 2;
+        float blackScale = 1.0f;
+        float whiteScale = 1.0f;
+        if (frame.motionV2PlaneTransformedByBinning) {
+            rowStride = width * 2;
+            blackScale = 4.0f;
+            whiteScale = 4.0f;
+        } else if (frame.motionV2PlaneFormat == ImageFormat.RAW10) {
+            rowStride = width * 2;
+        } else {
+            rowStride = frame.motionV2PlaneRowStrideBytes;
+            pixelStride = frame.motionV2PlanePixelStrideBytes;
+        }
+        if (width <= 0 || height <= 0 || rowStride <= 0 || pixelStride < 2) return false;
+        java.nio.ByteBuffer data = frame.buffer.duplicate().order(java.nio.ByteOrder.nativeOrder());
+        if (data.limit() < rowStride || frame.motionV2WhiteLevel <= 0) return false;
+        int harmonic = Math.max(1, Math.round(evidence[0]));
+        float coeffA = evidence[1], coeffB = evidence[2], strength = evidence[3];
+        final double twoPi = 2.0 * Math.PI;
+        boolean changed = false;
+        for (int y = 0; y < height; y++) {
+            double phase = twoPi * harmonic * (y + 0.5) / Math.max(1, height);
+            float logMod = (float) (coeffA * Math.cos(phase) + coeffB * Math.sin(phase));
+            logMod = Math.max(-MOTION_26678_FLICKER_MAX_LOG_CORRECTION,
+                    Math.min(MOTION_26678_FLICKER_MAX_LOG_CORRECTION, logMod));
+            float gain = (float) Math.exp(-logMod * strength);
+            if (Math.abs(gain - 1.0f) < 0.001f) continue;
+            int rowBase = y * rowStride;
+            for (int x = 0; x < width; x++) {
+                int index = rowBase + x * pixelStride;
+                if (index < 0 || index + 1 >= data.limit()) break;
+                int raw = data.getShort(index) & 0xffff;
+                int phaseIndex = ((y & 1) << 1) | (x & 1);
+                float black = frame.motionV2BlackLevel[phaseIndex] * blackScale;
+                float white = Math.min(65535.0f, frame.motionV2WhiteLevel * whiteScale);
+                float span = Math.max(1.0f, white - black);
+                float norm = Math.max(0.0f, Math.min(1.0f, (raw - black) / span));
+                float denominator = 1.0f + (gain - 1.0f) * norm;
+                float mapped = denominator > 1.0e-6f ? gain * norm / denominator : norm;
+                int corrected = Math.round(black + Math.max(0.0f, Math.min(1.0f, mapped)) * span);
+                corrected = Math.max(0, Math.min(65535, corrected));
+                data.putShort(index, (short) (corrected & 0xffff));
+            }
+            changed = true;
+        }
+        return changed;
+    }
