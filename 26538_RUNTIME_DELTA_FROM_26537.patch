+package com.particlesdevs.photoncamera.processing.opengl.postpipeline;
+
+import android.graphics.Point;
+
+import com.particlesdevs.photoncamera.processing.opengl.GLDrawParams;
+import com.particlesdevs.photoncamera.processing.opengl.GLFormat;
+import com.particlesdevs.photoncamera.processing.opengl.GLTexture;
+import com.particlesdevs.photoncamera.processing.opengl.nodes.Node;
+import com.particlesdevs.photoncamera.util.Log;
+
+import java.nio.ByteBuffer;
+
+import static android.opengl.GLES20.GL_CLAMP_TO_EDGE;
+import static android.opengl.GLES20.GL_LINEAR;
+import static android.opengl.GLES20.GL_NEAREST;
+
+/**
+ * IRIS_26538_NIGHT_RGBA16F_TWO_BUFFER_INPUT
+ * Dedicated Night post input. MGC already returns full-resolution camera-linear RGBA16F, so Night
+ * uploads that carrier directly and allocates only the main1/main2 half-float ping-pong pair used
+ * by every active Night node. It intentionally does not allocate Motion's FLOAT32 upload texture
+ * plus main3. No Bayer/RCD/demosaic or legacy Photon Night processing exists in this route.
+ */
+public final class IrisNightRgbInput extends Node {
+    public IrisNightRgbInput() { super("", "IrisNightRgbInput"); }
+    @Override public void Compile() {}
+
+    @Override
+    public void Run() {
+        PostPipeline pipeline = (PostPipeline) basePipeline;
+        if (!basePipeline.mParameters.irisNightActive || basePipeline.mParameters.motionV2Active)
+            throw new IllegalStateException("26538 dedicated Night RGB input used outside Night");
+        ByteBuffer source = pipeline.irisNightRgba16f;
+        if (source == null)
+            throw new IllegalStateException("26538 Night RGBA16F carrier is null");
+
+        Point raw = basePipeline.mParameters.rawSize;
+        long expected = (long) raw.x * (long) raw.y * 4L * 2L;
+        if (raw.x <= 0 || raw.y <= 0 || source.capacity() < expected)
+            throw new IllegalStateException("26538 Night RGBA16F carrier too small bytes="
+                    + source.capacity() + " expectedAtLeast=" + expected);
+
+        ByteBuffer view = source.duplicate();
+        view.position(0);
+        GLFormat rgba16f = new GLFormat(GLFormat.DataType.FLOAT_16, 4);
+        WorkingTexture = new GLTexture(raw, rgba16f, view, GL_NEAREST, GL_CLAMP_TO_EDGE);
+
+        GLFormat work = new GLFormat(GLFormat.DataType.FLOAT_16, GLDrawParams.WorkDim);
+        basePipeline.main1 = new GLTexture(raw, work, null, GL_LINEAR, GL_CLAMP_TO_EDGE);
+        basePipeline.main2 = new GLTexture(raw, work, null, GL_LINEAR, GL_CLAMP_TO_EDGE);
+        basePipeline.main3 = null;
+        basePipeline.texnum = 0;
+        glProg.closed = true;
+
+        Log.i(Name, "IRIS_26538_NIGHT_RGBA16F_TWO_BUFFER_INPUT"
+                + " carrier=fullResCameraLinearRGBA16F"
+                + " main1=true main2=true main3=false"
+                + " float32Expansion=false rcd=false demosaic=false photonNight=false"
+                + " bytes=" + expected);
+    }
+}
