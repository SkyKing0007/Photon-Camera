+        final float high = 1.0f - iris26623Smoothstep(0.52f, 0.78f, y);
+        final float w = iris26582Clamp(low * high, 0.0f, 1.0f);
+        final float darker = y * y;
+        return y + (darker - y) * (0.25f * w);
+    }
