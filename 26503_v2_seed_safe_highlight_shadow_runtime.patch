 uniform sampler2D InputBuffer;
 uniform float displayGain;
+uniform float shadowRecoveryStrength;
+uniform float shadowFloorStop;
 out vec3 Output;
 
 /* IRIS_26477_POST_WRONSKI_DISPLAY_BOUNDARY */
+/* IRIS_26503_EVIDENCE_BASED_STACK_AWARE_SHADOW_RECOVERY
+ * motionV2DisplayGain remains the one large-scale exposure authority.  The
+ * additional term is deliberately local: it is at most ten percent, scales all
+ * channels together, stops at the measured dark floor, and fades completely out
+ * before midtones.  It therefore cannot become a second global exposure owner or
+ * invent chroma in unsupported black-level noise.
+ */
+float luminance(vec3 c) {
+    return dot(c, vec3(0.2126, 0.7152, 0.0722));
+}
+vec3 recoverSupportedShadow(vec3 displayed, vec3 sensorRgb) {
+    displayed = max(displayed, vec3(0.0));
+    sensorRgb = max(sensorRgb, vec3(0.0));
+    float sensorY = max(luminance(sensorRgb), 0.0);
+    float displayedY = max(luminance(displayed), 0.0);
+    if (sensorY <= 1.0e-8 || shadowRecoveryStrength <= 0.0) return displayed;
+    /* Floor ownership stays in the pre-display sensor-linear domain so a large
+     * displayGain cannot turn unsupported black-level noise into "recoverable"
+     * signal merely by making it numerically brighter. */
+    float floorWidth = max(0.006, 1.5 * shadowFloorStop);
+    float floorGate = smoothstep(shadowFloorStop, shadowFloorStop + floorWidth, sensorY);
+    float shadowGate = 1.0 - smoothstep(0.12, 0.30, displayedY);
+    float scale = 1.0 + clamp(shadowRecoveryStrength, 0.0, 0.10) * floorGate * shadowGate;
+    return displayed * scale;
+}
 void main() {
     ivec2 p = ivec2(gl_FragCoord.xy);
     vec3 c = max(texelFetch(InputBuffer, p, 0).rgb, vec3(0.0));
-    Output = c * max(displayGain, 1.0);
+    vec3 displayed = c * max(displayGain, 1.0);
+    Output = recoverSupportedShadow(displayed, c);
 }
