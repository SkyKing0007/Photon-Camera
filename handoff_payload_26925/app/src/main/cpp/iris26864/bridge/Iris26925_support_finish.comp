#version 450
// IRIS_26925_B_ON_FINAL_PER_COLOR_INDEPENDENT_RAW_SUPPORT.
// Inputs: sums and squared sums of ORIGINAL-frame, per-channel acceptance;
// never an optimization-step count or the total frozen NORMAL burst count.
layout(local_size_x=16,local_size_y=16) in;
layout(set=0,binding=0,rgba16f) uniform image2D hrEstimate;
layout(set=0,binding=1,rgba32f) readonly uniform image2D sumTrusted;
layout(set=0,binding=2,rgba32f) readonly uniform image2D squaredTrusted;
layout(push_constant) uniform Push {int outW,outH,frames,pad;}p;
void main(){
    ivec2 q=ivec2(gl_GlobalInvocationID.xy);
    if(q.x>=p.outW||q.y>=p.outH)return;
    vec4 original=imageLoad(hrEstimate,q);
    vec3 sw=imageLoad(sumTrusted,q).rgb;
    vec3 ss=imageLoad(squaredTrusted,q).rgb;
    vec3 n=vec3(0.0);
    for(int c=0;c<3;++c)
        if(sw[c]>0.0&&ss[c]>0.0)
            n[c]=clamp(sw[c]*sw[c]/ss[c],1.0,float(p.frames));
    // Conservative across all CFA channels, including missing red or blue.
    float safe=min(n.r,min(n.g,n.b));
    if(isnan(safe)||isinf(safe))safe=0.0;
    imageStore(hrEstimate,q,vec4(original.rgb,safe));
}
