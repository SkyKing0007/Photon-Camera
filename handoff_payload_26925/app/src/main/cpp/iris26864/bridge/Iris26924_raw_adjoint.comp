#version 450
// IRIS_26924_B_ONLY_ORIGINAL_RAW_LKR_STYLE_MODEL. Unlike 26923's nine
// HR-fused-image passes, these evaluate the same Bayer RAW forward operator
// and its bilinear transpose against each immutable original frame.
layout(local_size_x=16,local_size_y=16) in;
layout(set=0,binding=0,r32f) readonly uniform image2D residual;
layout(set=0,binding=1,r32f) readonly uniform image2D weights;
layout(set=0,binding=2,rg32f) readonly uniform image2D tileFlow;
layout(set=0,binding=3,r8ui) readonly uniform uimage2D validI;
layout(set=0,binding=4,rgba32f) uniform image2D gradient;
layout(set=0,binding=5,rgba32f) uniform image2D coverage;
layout(set=0,binding=6,r32f) readonly uniform image2D rawVariance;
layout(push_constant) uniform Push {int rawW,rawH,tileSize,cfa,reference,supportOnly;}p;

int bayerCfa(ivec2 q,int cfa) {
    int x=(q.x ^ ((cfa==1||cfa==3)?1:0)) & 1;
    int y=(q.y ^ ((cfa==2||cfa==3)?1:0)) & 1;
    return (x==0&&y==0)?0:((x==1&&y==1)?2:1);
}
// The pinned Wronski tile flow maps reference into companion RAW sensor grid.
// We use the *same* spatial interpolation for U and the explicit U^T gather.
bool flowAt(vec2 ref, out vec2 f) {
    precise vec2 x=(ref+vec2(0.5))/float(p.tileSize)-vec2(0.5);
    ivec2 b=ivec2(floor(x));vec2 a=fract(x);
    vec2 total=vec2(0.0);float weight=0.0;
    for(int dy=0;dy<2;dy++)for(int dx=0;dx<2;dx++){
        ivec2 t=clamp(b+ivec2(dx,dy),ivec2(0),imageSize(tileFlow)-1);
        if(imageLoad(validI,t).x==0u)continue;
        float w=(dx==0?1.0-a.x:a.x)*(dy==0?1.0-a.y:a.y);
        total+=w*imageLoad(tileFlow,t).xy;weight+=w;
    }
    if(!(weight>0.000001)) {f=vec2(0.0);return false;}
    f=total/weight;return all(lessThan(abs(f),vec2(128.0)));
}
// Solve q=r+flow(r) for reference r with bounded fixed-point iteration.
// Identical geometry is called from both the forward and adjoint shaders.
bool refForRaw(ivec2 q,out vec2 r) {
    r=vec2(q);
    if(p.reference!=0)return true;
    vec2 f;
    for(int it=0;it<3;it++){
        if(!flowAt(r,f))return false;
        r=vec2(q)-f;
    }
    if(!flowAt(r,f))return false;
    return length(r+f-vec2(q))<0.65;
}
// Each source pixel integrates the corresponding four 2x subpixel centres.
// The bilinear basis is the same in the forward image prediction and adjoint.
vec2 subSample(vec2 r,int sx,int sy){
    return 2.0*r+vec2(0.5)+vec2(float(sx)-0.5,float(sy)-0.5);
}
float basis(ivec2 z,vec2 h) {
    vec2 d=abs(h-vec2(z));
    return max(1.0-d.x,0.0)*max(1.0-d.y,0.0);
}

void main(){
    ivec2 o=ivec2(gl_GlobalInvocationID.xy),hrSize=imageSize(gradient);
    if(any(greaterThanEqual(o,hrSize)))return;
    vec2 r0=(vec2(o)-vec2(0.5))*0.5;
    vec2 f=vec2(0.0);
    if(p.reference==0 && !flowAt(r0,f))return;
    ivec2 guess=ivec2(floor(r0+f));
    vec3 g=vec3(0.0),v=vec3(0.0);
    // Per-original-frame Bayer channel evidence. A single frame's multiple
    // interpolated sensor taps are correlated spatially and count ONCE.
    vec3 accepted=vec3(0.0),available=vec3(0.0);
    // Strict U^T: gather only sample sites whose same four-subpixel
    // integration kernel actually overlaps this exact HR pixel.
    for(int dy=-2;dy<=2;dy++)for(int dx=-2;dx<=2;dx++) {
        ivec2 q=guess+ivec2(dx,dy);
        if(any(lessThan(q,ivec2(0)))||q.x>=p.rawW||q.y>=p.rawH)continue;
        float w=imageLoad(weights,q).x;
        if(w<=0.0)continue;
        vec2 r;
        if(!refForRaw(q,r))continue;
        float a=0.0;
        for(int sy=0;sy<2;sy++)for(int sx=0;sx<2;sx++)
            a+=0.25*basis(o,subSample(r,sx,sy));
        if(a<=0.0)continue;
        int c=bayerCfa(q,p.cfa);
        g[c]+=a*imageLoad(residual,q).x;
        v[c]+=a*a*w;
        // Weight pass emitted precision = confidence / physical variance.
        // Undo precision for per-frame acceptance; the cap makes this a
        // conservative lower bound, never invented accepted RAW frames.
        float variance=imageLoad(rawVariance,q).x;
        float confidence=clamp(w*max(variance,0.0),0.0,1.0);
        accepted[c]+=a*confidence;
        available[c]+=a;
    }
    // Each HR invocation writes exactly its own pixel, avoiding GPU float
    // atomics and preserving deterministic frame-order accumulation.
    if(p.supportOnly!=0){
        // Per-COLOR evidence after the ninth fresh RAW image update.  A
        // frame contributes at most once/channel despite multiple taps.
        vec3 trust=clamp(accepted/max(available,vec3(1e-9)),vec3(0),vec3(1));
        trust*=step(vec3(1e-9),available);
        imageStore(gradient,o,imageLoad(gradient,o)+vec4(trust,0.0));
        imageStore(coverage,o,imageLoad(coverage,o)+vec4(trust*trust,0.0));
    }else{
        imageStore(gradient,o,imageLoad(gradient,o)+vec4(g,0.0));
        imageStore(coverage,o,imageLoad(coverage,o)+vec4(v,0.0));
    }
}
