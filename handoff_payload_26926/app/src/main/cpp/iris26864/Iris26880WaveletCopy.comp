#version 450
// Exact 26880 Vulkan post-wavelet copy: preserves pre-white-balance linear
// AMaZE RGB. Both views must be RGBA16F, GENERAL, distinct image ownership.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set=0,binding=0,rgba16f) readonly uniform image2D denoisedRgb;
layout(set=0,binding=1,rgba16f) coherent uniform image2D irisRgb;
layout(push_constant) uniform Params { uint width; uint height; } params;
void main() {
  uvec2 q=gl_GlobalInvocationID.xy;
  if(q.x>=params.width||q.y>=params.height)return;
  ivec2 p=ivec2(q);
  vec3 denoised=imageLoad(denoisedRgb,p).rgb;
  // Native RAWR wavelet is allowed to alter chroma ONLY; its fixed alpha=1
  // must never erase genuine local original-RAW temporal support.
  float originalRawConfidence=imageLoad(irisRgb,p).a;
  imageStore(irisRgb,p,vec4(denoised,originalRawConfidence));
}
