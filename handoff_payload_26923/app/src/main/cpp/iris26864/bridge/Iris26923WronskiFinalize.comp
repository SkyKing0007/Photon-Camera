#version 450

// RAWR parity scalar trace ABI. Normal production shaders compile this out.
#ifdef RAWR_PARITY_TRACE
layout(std430, set = 0, binding = 31) buffer RawrTraceBuffer {
    uint writeCount;
    uint droppedCount;
    uint _tracePad0;
    uint _tracePad1;
    uvec4 cfg0;
    ivec4 cfg1;
    uvec4 meta[];
}
rawrTrace;
const uint RAWR_TRACE_STAGE = 7u;
bool rawrTraceMatch(ivec2 q) {
    if (rawrTrace.cfg0.x == 0u) return false;
    if (rawrTrace.cfg0.y != 0u && rawrTrace.cfg0.y != RAWR_TRACE_STAGE) return false;
    int tx = int(rawrTrace.cfg0.z), ty = int(rawrTrace.cfg0.w);
    return (tx < 0 || q.x == tx) && (ty < 0 || q.y == ty);
}
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {
    if (!rawrTraceMatch(q)) return;
    uint i = atomicAdd(rawrTrace.writeCount, 1u);
    uint cap = uint(max(rawrTrace.cfg1.x, 0));
    if (i >= cap) {
        atomicAdd(rawrTrace.droppedCount, 1u);
        return;
    }
    uint b = i * 2u;
    rawrTrace.meta[b] = uvec4(RAWR_TRACE_STAGE, checkpoint, uint(q.x), uint(q.y));
    rawrTrace.meta[b + 1u] = uvec4(aux, floatBitsToUint(v.x), floatBitsToUint(v.y), floatBitsToUint(v.z));
}
#else
void rawrTrace4(uint checkpoint, ivec2 q, uint aux, vec4 v) {}
#endif
void rawrTrace1(uint checkpoint, ivec2 q, uint aux, float x) { rawrTrace4(checkpoint, q, aux, vec4(x, 0, 0, 0)); }
uint rawrHalfBitsRte(float v) {
    uint f = floatBitsToUint(v), sign = (f >> 16u) & 0x8000u, a = f & 0x7fffffffu;
    uint mant = a & 0x007fffffu, exp = (a >> 23u) & 0xffu;
    if (exp == 0xffu) {
        uint hm = mant >> 13u;
        if (mant != 0u && hm == 0u) hm = 1u;
        return sign | 0x7c00u | hm;
    }
    int he = int(exp) - 112;
    if (he <= 0) {
        if (he < -10) return sign;
        uint sig = mant | 0x00800000u, shift = uint(14 - he);
        uint q = sig >> shift, rem = sig & ((1u << shift) - 1u), mid = 1u << (shift - 1u);
        if (rem > mid || (rem == mid && (q & 1u) != 0u)) q++;
        return sign | q;
    }
    if (he >= 31) return sign | 0x7c00u;
    uint q = mant >> 13u, rem = mant & 0x1fffu;
    if (rem > 0x1000u || (rem == 0x1000u && (q & 1u) != 0u)) q++;
    if (q == 0x400u) {
        q = 0u;
        he++;
        if (he >= 31) return sign | 0x7c00u;
    }
    return sign | (uint(he) << 10u) | q;
}
float rawrHalfBitsToFloat(uint h) {
    uint sign = (h & 0x8000u) << 16u, exp = (h >> 10u) & 31u, mant = h & 0x3ffu;
    if (exp == 0u) {
        if (mant == 0u) return uintBitsToFloat(sign);
        int p = findMSB(mant);
        return uintBitsToFloat(sign | (uint(p + 103) << 23u) | ((mant - (1u << uint(p))) << uint(23 - p)));
    }
    if (exp == 31u) return uintBitsToFloat(sign | 0x7f800000u | (mant << 13u));
    return uintBitsToFloat(sign | ((exp + 112u) << 23u) | (mant << 13u));
}
float rawrRoundHalfRte(float v) { return rawrHalfBitsToFloat(rawrHalfBitsRte(v)); }
vec4 rawrRoundHalfRte(vec4 v) {
    return vec4(rawrRoundHalfRte(v.x), rawrRoundHalfRte(v.y), rawrRoundHalfRte(v.z), rawrRoundHalfRte(v.w));
}
float rawrDivF32(float af, float bf) {
    uint ab = floatBitsToUint(af), bb = floatBitsToUint(bf);
    uint amag = ab & 0x7fffffffu, bmag = bb & 0x7fffffffu;
    if (amag == 0u || bmag == 0u) return af / bf;
    uint ae = (ab >> 23) & 255u, be = (bb >> 23) & 255u;
    if (ae == 0u || be == 0u || ae == 255u || be == 255u) return af / bf;
    uint am = 0x800000u | (ab & 0x7fffffu), bm = 0x800000u | (bb & 0x7fffffu);
    int e = int(ae) - int(be) + 127;
    uint q, rem;
    int steps;
    if (am >= bm) {
        q = 1u;
        rem = am - bm;
        steps = 23;
    } else {
        q = 0u;
        rem = am;
        steps = 24;
        e--;
    }
    for (int j = 0; j < 24; j++) {
        if (j >= steps) break;
        rem <<= 1;
        q <<= 1;
        if (rem >= bm) {
            rem -= bm;
            q |= 1u;
        }
    }
    uint twice = rem << 1;
    bool up = (twice > bm) || (twice == bm && ((q & 1u) != 0u));
    if (up) {
        q++;
        if (q == 0x1000000u) {
            q >>= 1;
            e++;
        }
    }
    if (e <= 0 || e >= 255) return af / bf;
    return uintBitsToFloat(((ab ^ bb) & 0x80000000u) | (uint(e) << 23) | (q & 0x7fffffu));
}
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, rgba32f) readonly uniform image2D sumI;
layout(set = 0, binding = 1, rgba32f) readonly uniform image2D weightI;
layout(set = 0, binding = 2, rgba16f) writeonly uniform image2D outI;
layout(push_constant) uniform P { int yBase; }
p;
void main() {
    ivec2 lq = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(lq, imageSize(sumI)))) return;
    ivec2 q = ivec2(lq.x, lq.y + p.yBase);
    rawrTrace4(1u, q, 0u, vec4(gl_GlobalInvocationID.xy, 0, 0));
    if (any(greaterThanEqual(q, imageSize(outI)))) return;
    vec3 s = imageLoad(sumI, lq).xyz, w = imageLoad(weightI, lq).xyz;
    precise float r = w.x > 1e-12 ? rawrDivF32(s.x, w.x) : 0.0;
    precise float g = w.y > 1e-12 ? rawrDivF32(s.y, w.y) : 0.0;
    precise float b = w.z > 1e-12 ? rawrDivF32(s.z, w.z) : 0.0;
    vec3 rgb = vec3(r, g, b);
    // IRIS_26923_B_SR_ON_NINE_BOUNDED_HR_UPDATES.
    // All data targets are the ORIGINAL, noise-/motion-weighted Wronski
    // 15-frame high-resolution sums, NOT independently synthesized texture.
    // Unlike RawLens LK-R, this conservative hybrid does NOT re-warp every
    // original LR RAW sample through a new forward model. It projects the
    // already-aligned fused HR data towards sensor-evidenced local detail.
    // Never change RGB channel ratios: updates are multiplicative and chromaticity-neutral.
    const vec3 lumWeights = vec3(0.25, 0.5, 0.25);
    float baselineY = dot(rgb, lumWeights);
    float nearSum = 0.0;
    float nearMass = 0.0;
    ivec2 extent = imageSize(sumI);
    for (int d = 0; d < 4; ++d) {
        ivec2 off = d == 0 ? ivec2(1,0) : d == 1 ? ivec2(-1,0)
                  : d == 2 ? ivec2(0,1) : ivec2(0,-1);
        ivec2 z = clamp(lq + off, ivec2(0), extent-1);
        vec3 ww = imageLoad(weightI,z).xyz;
        if (min(ww.r,min(ww.g,ww.b)) <= 1e-8) continue;
        vec3 sumNear = imageLoad(sumI,z).xyz;
        vec3 targetNear = sumNear / max(ww,vec3(1e-8));
        nearSum += dot(targetNear,lumWeights);
        nearMass += 1.0;
    }
    float chromaBalance = min(w.r,min(w.g,w.b)) / max(max(w.r,max(w.g,w.b)),1e-8);
    if (nearMass >= 3.0 && chromaBalance > 0.04 && baselineY > 0.006 &&
        baselineY < 0.94 && min(rgb.r,min(rgb.g,rgb.b)) > 0.003) {
        float localContrast = baselineY - nearSum/nearMass;
        // A wide enough luma response must be present in the fused 15-frame
        // data before any detail is retained. Limit the update to <1% white.
        float detailFloor = 0.0009 + 0.001*sqrt(max(baselineY,0.0));
        float measuredDetail = sign(localContrast)*max(abs(localContrast)-detailFloor,0.0);
        float bounded = clamp(measuredDetail,-0.008,0.008);
        float support = smoothstep(0.04,0.30,chromaBalance);
        // 3 reconstruction iterations x 3 HR gradient updates. The immutable
        // target is the input weighted burst data; no extra 50MP attachment,
        // no extra raw frame collection and no inter-pixel write hazards.
        for (int t = 0; t < 3; ++t) {
            for (int step = 0; step < 3; ++step) {
                float currentY = dot(rgb,lumWeights);
                float dataResidual = baselineY - currentY;
                float update = support*(0.20*dataResidual+0.045*bounded);
                // A shared multiplicative luminance correction preserves
                // raw RGB chromaticity under subsequent per-channel white
                // balance; adding the same RGB amount would not do so.
                rgb *= max(currentY+update,1e-6)/max(currentY,1e-6);
            }
        }
    }
    imageStore(outI, q, rawrRoundHalfRte(vec4(rgb, 1)));
    rawrTrace1(250u, q, 0u, 1.0);
}
