-    if(denominator<=1.0e-7 || geometricMass<=1.0e-7) {
-        return vec2(0.0,0.0);
-    }
-    return vec2(
-            numerator/denominator,
-            clamp(denominator/geometricMass,0.0,1.0));
-}
