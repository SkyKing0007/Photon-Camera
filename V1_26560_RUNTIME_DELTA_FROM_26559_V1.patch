-            if (frame.flowBounds == MgcSpatialRgbFlowBounds.Zero) {
-                frame
-            } else {
-                bindRenderTargets(
-                    intArrayOf(frame.alignmentTexture),
-                    "MGC RGB alignment bounds frame ${frame.imageIndex}",
-                )
-                GLES30.glPixelStorei(GLES30.GL_PACK_ALIGNMENT, Float.SIZE_BYTES)
