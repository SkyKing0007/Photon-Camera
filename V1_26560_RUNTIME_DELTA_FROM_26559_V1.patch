-    /* IRIS_26532_MEMORY_SAFE_STREAMED_2X
-     * Stream one already-normalized 2x RGB16 band while it is resident. No full 2x RGB texture
-     * survives the band. Detail is one signed-log-luma Q8 byte/pixel; optional DNG evidence is
-     * tightly packed little-endian RGB16.
-     */
-    private fun streamIris26532SuperResBand(
-        texture: Int,
-        band: MgcSpatialRgbTile,
-        detailOut: BufferedOutputStream,
-        linearRawOut: BufferedOutputStream?,
-    ) {
-        val w = band.outputCore.width
-        val h = band.outputCore.height
-        require(w == outputWidth && (h and 1) == 0)
-        val bytes = w.toLong() * h * 4L * 2L
-        val buffer = LargeDirectBuffer.allocate(bytes, "IRIS26532 streamed RGB16 band")
-            ?.order(ByteOrder.nativeOrder()) ?: error("Unable to allocate IRIS 26532 RGB16 band")
-        try {
-            bindRenderTargets(intArrayOf(texture), "IRIS 26532 streamed 2x RGB16 readback")
-            GLES30.glReadBuffer(GLES30.GL_COLOR_ATTACHMENT0)
-            GLES30.glPixelStorei(GLES30.GL_PACK_ALIGNMENT, 8)
-            buffer.position(0)
-            GLES30.glReadPixels(
-                0, 0, w, h,
-                GLES30.GL_RGBA_INTEGER, GLES30.GL_UNSIGNED_SHORT, buffer,
-            )
-            GLES30.glBindFramebuffer(GLES30.GL_FRAMEBUFFER, 0)
-            GLES30.glPixelStorei(GLES30.GL_PACK_ALIGNMENT, 1)
-            checkGlError("IRIS 26532 streamed RGB16 band readback")
-            val samples = buffer.duplicate().order(ByteOrder.nativeOrder()).asShortBuffer()
-            val rawRow = linearRawOut?.let { ByteArray(w * 3 * 2) }
-            val detailRow0 = ByteArray(w)
-            val detailRow1 = ByteArray(w)
-            val detailLum = FloatArray(4)
-            val detailCoords = IntArray(4)
-            val invLn2 = (1.0 / ln(2.0)).toFloat()
-            val logRange = 0.75f
-            var y = 0
-            while (y < h) {
-                if (rawRow != null) {
-                    for (yy in 0..1) {
-                        var o = 0
-                        val row = y + yy
-                        for (x in 0 until w) {
-                            val base = (row * w + x) * 4
-                            for (c in 0..2) {
-                                val q = samples.get(base + c).toInt() and 0xffff
-                                rawRow[o++] = (q and 0xff).toByte()
-                                rawRow[o++] = ((q ushr 8) and 0xff).toByte()
-                            }
-                        }
-                        linearRawOut?.write(rawRow)
-                    }
-                }
-                var x = 0
-                while (x < w) {
-                    detailCoords[0] = (y * w + x) * 4
-                    detailCoords[1] = (y * w + x + 1) * 4
-                    detailCoords[2] = ((y + 1) * w + x) * 4
-                    detailCoords[3] = ((y + 1) * w + x + 1) * 4
-                    for (k in 0..3) {
-                        val base = detailCoords[k]
-                        val r = (samples.get(base).toInt() and 0xffff).toFloat()
-                        val g = (samples.get(base + 1).toInt() and 0xffff).toFloat()
-                        val b = (samples.get(base + 2).toInt() and 0xffff).toFloat()
-                        detailLum[k] = 0.25f * r + 0.50f * g + 0.25f * b
-                    }
-                    val mean = max((detailLum[0] + detailLum[1] + detailLum[2] + detailLum[3]) * 0.25f, 1f)
-                    for (k in 0..3) {
-                        val safe = max(detailLum[k], 1f)
-                        val log2Detail = (ln((safe / mean).toDouble()).toFloat() * invLn2)
-                            .coerceIn(-logRange, logRange)
-                        val code = round(
-                            ((log2Detail / logRange) * 0.5f + 0.5f)
-                                .coerceIn(0f, 1f) * 255f
-                        ).toInt().coerceIn(0, 255).toByte()
-                        when (k) {
-                            0 -> detailRow0[x] = code
-                            1 -> detailRow0[x + 1] = code
-                            2 -> detailRow1[x] = code
-                            else -> detailRow1[x + 1] = code
-                        }
-                    }
-                    x += 2
-                }
-                detailOut.write(detailRow0)
-                detailOut.write(detailRow1)
-                y += 2
-            }
-        } finally {
-            LargeDirectBuffer.free(buffer)
-        }
-    }
