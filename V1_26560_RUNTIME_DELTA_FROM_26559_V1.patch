-                GLES30.GL_FRAMEBUFFER,
-                GLES30.GL_COLOR_ATTACHMENT0 + index,
-                GLES30.GL_TEXTURE_2D,
-                0,
-                0,
-            )
-        }
-        renderTargetAttachmentCount = targets.size
