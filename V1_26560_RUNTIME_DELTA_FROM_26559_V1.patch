-        bindTexture(upsampleAlignmentProgram, "uCurrent", 1, current.texture)
-        bindTexture(upsampleAlignmentProgram, "uInitialAlignment", 2, initial.texture)
-        uniform2i(
-            upsampleAlignmentProgram,
-            "uImageSize",
-            reference.width,
-            reference.height,
