-    /* IRIS_26543_BANDED_FIGURE7_REGION_OWNER
-     * For streamed reconstruction, compute only the RAW/2 covariance cells touched by this
-     * source band. Figure-7 cell q needs RAW support [2q-2, 2q+3], so the upload rectangle is
-     * expanded from the covariance cell rectangle rather than assuming the 3x3 merge halo is
-     * sufficient. This keeps covariance residency bounded independently of frame count.
-     */
-    private fun figure7CovarianceRegion(source: MgcSpatialRgbRect): MgcSpatialRgbRect {
-        val expandedLeft = max(0, source.left - FIGURE7_BANDED_COV_RAW_MARGIN)
-        val expandedTop = max(0, source.top - FIGURE7_BANDED_COV_RAW_MARGIN)
-        val expandedRight = minOf(width, source.right + FIGURE7_BANDED_COV_RAW_MARGIN)
-        val expandedBottom = minOf(height, source.bottom + FIGURE7_BANDED_COV_RAW_MARGIN)
-        val left = (expandedLeft / 2).coerceIn(0, covarianceWidth - 1)
-        val top = (expandedTop / 2).coerceIn(0, covarianceHeight - 1)
-        val right = ceilDiv(expandedRight, 2).coerceIn(left + 1, covarianceWidth)
-        val bottom = ceilDiv(expandedBottom, 2).coerceIn(top + 1, covarianceHeight)
-        return MgcSpatialRgbRect(left, top, right, bottom)
-    }
-
-    private fun figure7RawSupportRegion(covariance: MgcSpatialRgbRect): MgcSpatialRgbRect {
-        val left = max(0, covariance.left * 2 - FIGURE7_COV_RAW_NEGATIVE_SUPPORT)
-        val top = max(0, covariance.top * 2 - FIGURE7_COV_RAW_NEGATIVE_SUPPORT)
-        val right = minOf(width, covariance.right * 2 + FIGURE7_COV_RAW_POSITIVE_SUPPORT)
-        val bottom = minOf(height, covariance.bottom * 2 + FIGURE7_COV_RAW_POSITIVE_SUPPORT)
-        return MgcSpatialRgbRect(left, top, right, bottom)
-    }
-
-    private fun unionRawRegions(a: MgcSpatialRgbRect, b: MgcSpatialRgbRect): MgcSpatialRgbRect =
-        MgcSpatialRgbRect(
-            left = minOf(a.left, b.left),
-            top = minOf(a.top, b.top),
-            right = maxOf(a.right, b.right),
-            bottom = maxOf(a.bottom, b.bottom),
-        )
