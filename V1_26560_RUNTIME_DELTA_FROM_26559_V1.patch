-    private fun queueTextureSsboPack(
-        texture: Int,
-        textureWidth: Int,
-        textureHeight: Int,
-        encoding: StrengthReadbackEncoding,
-        storage: PixelPackBuffer,
-        program: Int,
-        label: String,
-        atlasLayout: MgcSpatialStrengthAtlasLayout?,
