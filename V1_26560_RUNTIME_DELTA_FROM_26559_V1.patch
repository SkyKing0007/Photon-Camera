-     * unit weight; only auxiliary green/luma weights are reduced. Existing per-pixel rejection
-     * remains multiplicative, so motion can only reduce auxiliary contribution further.
-     */
-    private fun iris26530TargetEffectiveLumaFrames(globalZoom: Float): Float {
-        if (!globalZoom.isFinite() || globalZoom < 8f) return 0f
-        if (globalZoom <= 50f) return 7f
-        val t = ((globalZoom - 50f) / 70f).coerceIn(0f, 1f)
-        return 7f + 2f * (t * t * (3f - 2f * t))
-    }
