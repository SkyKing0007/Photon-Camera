-                        "MGC RGB alignment frame ${frame.imageIndex} contains non-finite flow"
-                    }
-                    minimumX = minOf(minimumX, x)
-                    minimumY = minOf(minimumY, y)
-                    maximumX = maxOf(maximumX, x)
-                    maximumY = maxOf(maximumY, y)
-                }
-                val bounds = MgcSpatialRgbFlowBounds(
-                    minX = minimumX,
-                    minY = minimumY,
-                    maxX = maximumX,
-                    maxY = maximumY,
