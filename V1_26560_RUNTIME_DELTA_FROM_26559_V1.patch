-
-int componentIndex(ivec2 p) {
-    return ((p.y & 1) << 1) | (p.x & 1);
-}
-
-int componentColor(int c) {
-    if (cfaPattern == 0) {        // RGGB
-        if (c == 0) return 0;
-        if (c == 3) return 2;
-        return 1;
-    } else if (cfaPattern == 1) { // GRBG
-        if (c == 1) return 0;
-        if (c == 2) return 2;
-        return 1;
-    } else if (cfaPattern == 2) { // GBRG
-        if (c == 2) return 0;
-        if (c == 1) return 2;
-        return 1;
-    }                             // BGGR
-    if (c == 3) return 0;
-    if (c == 0) return 2;
-    return 1;
-}
-
