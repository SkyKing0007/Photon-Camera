-                TAG,
-                "MGC R8 readback label=$label size=${maskWidth}x$maskHeight " +
-                    "bytes=$byteCount bind=${bindNs / 1_000_000L}ms " +
-                    "readCall=${readCallNs / 1_000_000L}ms " +
-                    "cpuCopy=${elapsedMs(copyStartNs)}ms total=${elapsedMs(totalStartNs)}ms",
