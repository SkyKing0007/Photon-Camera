-                    0,
-                    0,
-                    bayerAlignmentWidth,
-                    bayerAlignmentHeight,
-                    GLES30.GL_RGBA,
-                    GLES30.GL_FLOAT,
-                    readback,
-                )
-                GLES30.glBindFramebuffer(GLES30.GL_FRAMEBUFFER, 0)
