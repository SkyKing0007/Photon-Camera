-    private fun iris26530AuxiliaryLumaScale(
-        frameCount: Int,
-        targetEffectiveFrames: Float,
-    ): Float {
-        if (frameCount <= 1 || targetEffectiveFrames >= frameCount.toFloat()) return 1f
-        val target = targetEffectiveFrames.coerceIn(1f, frameCount.toFloat())
-        val auxiliaries = (frameCount - 1).toFloat()
-        var lo = 0f
-        var hi = 1f
-        repeat(40) {
-            val beta = 0.5f * (lo + hi)
-            val sum = 1f + auxiliaries * beta
-            val sumSquares = 1f + auxiliaries * beta * beta
-            val neff = sum * sum / sumSquares
-            if (neff < target) lo = beta else hi = beta
-        }
-        return 0.5f * (lo + hi)
-    }
