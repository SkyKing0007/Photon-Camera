-    if (c == 0) return ivec2(0,0);
-    if (c == 1) return ivec2(1,0);
-    if (c == 2) return ivec2(0,1);
-    return ivec2(1,1);
-}
-
-float getComponent(vec4 v, int c) {
-    if (c == 0) return v.r;
-    if (c == 1) return v.g;
-    if (c == 2) return v.b;
-    return v.a;
-}
-
