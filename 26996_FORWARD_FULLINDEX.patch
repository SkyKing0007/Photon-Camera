+// RawLens 2.4.58 rawdn_estimate_noise + the original noise_jni recordSample
+// contract. Only original C ON RAW16 reference bytes reach this entry point.
+extern "C" JNIEXPORT jboolean JNICALL Java_com_hinnka_mycamera_processor_Iris26985CLkrNative_nativeRecordRawNoise(
+    JNIEnv* env, jclass, jstring path, jfloat iso, jfloat analogIso, jlong captureId,
+    jobject raw, jint w, jint h, jint stride, jint cfa, jfloatArray black, jfloat white) {
+  if (!path || !raw || !black || env->GetArrayLength(black)!=4 || w<64 || h<64 ||
+      stride<w || cfa<0 || cfa>3 || captureId<=0 || !std::isfinite(white) || white<=0 ||
+      !std::isfinite(iso) || iso<=0 || !std::isfinite(analogIso) || analogIso<0) return JNI_FALSE;
+  const auto* data=static_cast<const uint16_t*>(env->GetDirectBufferAddress(raw));
+  const jlong needed=(jlong(h)-1)*stride*2+jlong(w)*2;
+  if (!data || needed>env->GetDirectBufferCapacity(raw)) return JNI_FALSE;
+  float bk[4],a=0,b=0;
+  env->GetFloatArrayRegion(black,0,4,bk);
+  if(env->ExceptionCheck()) return JNI_FALSE;
+  for(float v:bk) if(!std::isfinite(v) || v<0 || v>=white) return JNI_FALSE;
+  const char* chars=env->GetStringUTFChars(path,nullptr);
+  if(!chars) return JNI_FALSE;
+  std::string store(chars);
+  env->ReleaseStringUTFChars(path,chars);
+  try {
+    const int bins=iris26996_noise::rawdn_estimate_noise(data,size_t(stride),w,h,cfa,bk,white,&a,&b);
+    const rawlens_noise::Sample shot{iso,a,b,bins,analogIso,static_cast<uint64_t>(captureId)};
+    return rawlens_noise::valid(shot) && rawlens_noise::recordSample(store,shot) ? JNI_TRUE : JNI_FALSE;
+  } catch (...) { return JNI_FALSE; }
+}
