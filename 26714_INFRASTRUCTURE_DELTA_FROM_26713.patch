+          ! find . -type f -name '*.apk' | grep -q .
+      - name: Build exact 26714 candidate from successful 26713 compiled authority
+        shell: bash
+        env:
+          GITHUB_TOKEN: ${{ github.token }}
+        run: |
+          set -euo pipefail
+          bash build_26714_normalized_handheld_highlight.sh
+      - name: Verify exact 26714 APK exists before artifact upload
+        shell: bash
+        run: |
+          set -euo pipefail
+          test -f IrisCamera-0.9726714-26714-normalized-handheld-highlight-debug.apk
+          test "$(find . -maxdepth 1 -type f -name 'IrisCamera-*.apk' | wc -l)" -eq 1
+          grep -F 'IrisCamera-0.9726714-26714-normalized-handheld-highlight-debug.apk' build_26714_normalized_handheld_highlight_outputs/26714_APK.sha256
+      - name: Upload 26714 proof and APK
