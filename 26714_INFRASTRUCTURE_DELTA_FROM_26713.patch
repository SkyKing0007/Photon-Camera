+for t in ['IRIS_26714_SHUTTER_HAL_REBASE','recipeRebasedToCurrentHal=true','desiredEnergy = iris26713CurrentHalEnergy * Math.pow(2.0, desiredOffsetEv)','mMotion26709HalBaselineEnergy = iris26713CurrentHalEnergy']:
+ assert t in cap,t
