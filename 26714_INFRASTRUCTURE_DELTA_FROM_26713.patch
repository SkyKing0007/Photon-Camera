+          bash -n build_26714_normalized_handheld_highlight.sh
+          python3 -S - <<'PY'
+          from pathlib import Path
+          for n in ['transform_26714.py','validate_26714.py','verify_26714_authority.py','verify_26714_patches.py','verify_26714_regressions.py','verify_26714_shaders.py','verify_26714_infrastructure.py']:
+              compile(Path(n).read_text(),n,'exec')
