#version 450
// IRIS_26924_B_ONLY_ORIGINAL_RAW_LKR_STYLE_MODEL. Unlike 26923's nine
// HR-fused-image passes, these evaluate the same Bayer RAW forward operator
// and its bilinear transpose against each immutable original frame.
layout(local_size_x=16,local_size_y=16) in;
layout(set=0,binding=0,rgba16f) uniform image2D hrEstimate;
layout(set=0,binding=1,rgba32f) readonly uniform image2D gradient;
layout(set=0,binding=2,rgba32f) readonly uniform image2D coverage;
layout(push_constant) uniform Push {
  int frames,outW,outH;
  float stepScale,minEvidence,maxLuma,maxChroma;
}p;
void main(){
    ivec2 q=ivec2(gl_GlobalInvocationID.xy);
    if(q.x>=p.outW||q.y>=p.outH)return;
    vec4 z=imageLoad(hrEstimate,q);
    vec3 g=imageLoad(gradient,q).rgb,v=imageLoad(coverage,q).rgb;
    // Differentiable data step, per Bayer channel. When little phase support
    // exists, retain the original Wronski estimate, not hallucinated color.
    vec3 supported=step(vec3(p.minEvidence),v);
    vec3 delta=-p.stepScale*g/max(v+vec3(10.0),vec3(1e-8))*supported;
    vec3 yw=vec3(0.25,0.50,0.25);
    float dL=clamp(dot(delta,yw),-p.maxLuma,p.maxLuma);
    vec3 dChr=delta-vec3(dot(delta,yw));
    // Higher chroma evidence is needed than luminance. Preserve existing
    // high-frequency color without injecting unsupported cyan/yellow moire.
    float reliable=min(v.r,min(v.g,v.b))/max(max(v.r,max(v.g,v.b)),1e-8);
    float colorPermit=smoothstep(0.15,0.55,reliable);
    dChr=clamp(dChr,vec3(-p.maxChroma),vec3(p.maxChroma))*colorPermit;
    vec3 corrected=clamp(z.rgb+vec3(dL)+dChr,vec3(0.0),vec3(1.5));
    // No flattened white shoulders or change of physical border metadata.
    if(any(isnan(corrected))||any(isinf(corrected)))return;
    imageStore(hrEstimate,q,vec4(corrected,z.a));
}
