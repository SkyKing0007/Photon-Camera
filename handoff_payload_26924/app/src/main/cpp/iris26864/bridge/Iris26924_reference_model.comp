#version 450
// IRIS_26924_B_ONLY_ORIGINAL_RAW_LKR_STYLE_MODEL. Unlike 26923's nine
// HR-fused-image passes, these evaluate the same Bayer RAW forward operator
// and its bilinear transpose against each immutable original frame.
layout(local_size_x=16,local_size_y=16) in;
layout(set=0,binding=0,rgba16f) readonly uniform image2D hrEstimate;
layout(set=0,binding=1,r32f) writeonly uniform image2D predictedReference;
layout(push_constant) uniform Push {int rawW,rawH,cfa;}p;
int bayerCfa(ivec2 q,int cfa){
    int x=(q.x ^ ((cfa==1||cfa==3)?1:0)) & 1;
    int y=(q.y ^ ((cfa==2||cfa==3)?1:0)) & 1;
    return (x==0&&y==0)?0:((x==1&&y==1)?2:1);
}
void main(){
    ivec2 q=ivec2(gl_GlobalInvocationID.xy);
    if(q.x>=p.rawW||q.y>=p.rawH)return;
    ivec2 s=q*2;int c=bayerCfa(q,p.cfa);
    vec4 a=imageLoad(hrEstimate,s),b=imageLoad(hrEstimate,s+ivec2(1,0));
    vec4 d=imageLoad(hrEstimate,s+ivec2(0,1)),e=imageLoad(hrEstimate,s+ivec2(1));
    imageStore(predictedReference,q,vec4(0.25*(a[c]+b[c]+d[c]+e[c])));
}
