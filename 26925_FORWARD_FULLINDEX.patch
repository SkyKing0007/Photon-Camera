+namespace {
+constexpr std::uint32_t kIris26925CacheSlots = 16u;
+VkBufferImageCopy cacheRegion(VkDeviceSize offset, VkExtent2D extent) {
+    VkBufferImageCopy r{};
+    r.bufferOffset = offset;
+    r.bufferRowLength = 0u;
+    r.bufferImageHeight = 0u;
+    r.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT,0u,0u,1u};
+    r.imageExtent = {extent.width,extent.height,1u};
+    return r;
+}
+void cacheBarrier(VkCommandBuffer c, VkPipelineStageFlags src, VkAccessFlags reads,
+                  VkPipelineStageFlags dst, VkAccessFlags writes) {
+    VkMemoryBarrier b{};b.sType=VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+    b.srcAccessMask=reads;b.dstAccessMask=writes;
+    vkCmdPipelineBarrier(c,src,dst,0u,1u,&b,0u,nullptr,0u,nullptr);
+}
+}
+void MultiframeRecorder::record26925CacheFlow(VkCommandBuffer c, std::uint32_t slot) const {
+    if(slot>=kIris26925CacheSlots)throw std::out_of_range("26925 cached flow slot");
+    const auto& f=arena_.image("tile_flow_l3");
+    const auto& v=arena_.image("tile_valid");
+    if(f.extent.width!=v.extent.width||f.extent.height!=v.extent.height)
+        throw std::logic_error("26925 flow and validity atlas mismatch");
+    const auto& fb=arena_.buffer("iris26925_flow_cache");
+    const auto& vb=arena_.buffer("iris26925_valid_cache");
+    const VkDeviceSize pixels=VkDeviceSize(f.extent.width)*f.extent.height;
+    const VkDeviceSize fs=pixels*8u,vs=(pixels+3u)&~VkDeviceSize(3u);
+    if(fb.bytes<(slot+1u)*fs||vb.bytes<(slot+1u)*vs)
+        throw std::logic_error("26925 cached alignment buffer bounds");
+    cacheBarrier(c,VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,VK_ACCESS_SHADER_WRITE_BIT,
+                 VK_PIPELINE_STAGE_TRANSFER_BIT,VK_ACCESS_TRANSFER_READ_BIT);
+    const auto fregion=cacheRegion(slot*fs,{f.extent.width,f.extent.height});
+    const auto vregion=cacheRegion(slot*vs,{v.extent.width,v.extent.height});
+    vkCmdCopyImageToBuffer(c,f.image,VK_IMAGE_LAYOUT_GENERAL,fb.buffer,1u,&fregion);
+    vkCmdCopyImageToBuffer(c,v.image,VK_IMAGE_LAYOUT_GENERAL,vb.buffer,1u,&vregion);
+    cacheBarrier(c,VK_PIPELINE_STAGE_TRANSFER_BIT,VK_ACCESS_TRANSFER_WRITE_BIT,
+                 VK_PIPELINE_STAGE_TRANSFER_BIT,VK_ACCESS_TRANSFER_READ_BIT);
+}
+void MultiframeRecorder::record26925RestoreFlow(VkCommandBuffer c, std::uint32_t slot) const {
+    if(slot>=kIris26925CacheSlots)throw std::out_of_range("26925 cached flow slot");
+    const auto& f=arena_.image("tile_flow_l3");
+    const auto& v=arena_.image("tile_valid");
+    const auto& fb=arena_.buffer("iris26925_flow_cache");
+    const auto& vb=arena_.buffer("iris26925_valid_cache");
+    const VkDeviceSize pixels=VkDeviceSize(f.extent.width)*f.extent.height;
+    const VkDeviceSize fs=pixels*8u,vs=(pixels+3u)&~VkDeviceSize(3u);
+    if(fb.bytes<(slot+1u)*fs||vb.bytes<(slot+1u)*vs)
+        throw std::logic_error("26925 restored alignment buffer bounds");
+    cacheBarrier(c,VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,VK_ACCESS_SHADER_WRITE_BIT,
+                 VK_PIPELINE_STAGE_TRANSFER_BIT,VK_ACCESS_TRANSFER_WRITE_BIT);
+    const auto fregion=cacheRegion(slot*fs,{f.extent.width,f.extent.height});
+    const auto vregion=cacheRegion(slot*vs,{v.extent.width,v.extent.height});
+    vkCmdCopyBufferToImage(c,fb.buffer,f.image,VK_IMAGE_LAYOUT_GENERAL,1u,&fregion);
+    vkCmdCopyBufferToImage(c,vb.buffer,v.image,VK_IMAGE_LAYOUT_GENERAL,1u,&vregion);
+    cacheBarrier(c,VK_PIPELINE_STAGE_TRANSFER_BIT,VK_ACCESS_TRANSFER_WRITE_BIT,
+                 VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                 VK_ACCESS_SHADER_READ_BIT|VK_ACCESS_SHADER_WRITE_BIT);
+}
