-            ivec2(-2, -2), ivec2( 2, -2),
-            ivec2(-2,  2), ivec2( 2,  2),
-            ivec2(-4,  0), ivec2( 4,  0),
-            ivec2( 0, -4), ivec2( 0,  4)
