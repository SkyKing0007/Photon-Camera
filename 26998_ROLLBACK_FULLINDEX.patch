-                }
-            }
-        } finally {
-            GLES30.glBindBuffer(GLES30.GL_PIXEL_PACK_BUFFER, 0)
-            GLES30.glDeleteBuffers(1, intArrayOf(readback.buffer), 0)
-            buffers.remove(readback.buffer)
-        }
-    }
