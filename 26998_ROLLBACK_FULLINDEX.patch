-    fun originX(planeIndex: Int): Int {
-        require(planeIndex in 0 until planeCount)
-        return (planeIndex % columns) * planeWidth
-    }
-
-    fun originY(planeIndex: Int): Int {
-        require(planeIndex in 0 until planeCount)
-        return (planeIndex / columns) * planeHeight
-    }
