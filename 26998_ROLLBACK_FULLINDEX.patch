-            for (tap in taps.indices) {
-                val weight = taps[tap].toDouble()
-                real += weight * cos(omega * tap)
-                imag -= weight * sin(omega * tap)
-            }
-            (real * real + imag * imag).toFloat()
-        }
-
-        operator fun get(freq: Int): Float = power[freq]
-    }
-
