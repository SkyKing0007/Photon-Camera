-        uniform2f(
-            convertAlignmentProgram,
-            "uFlowNormalizationSize",
-            ceilDiv(width, 2).toFloat(),
-            ceilDiv(height, 2).toFloat(),
-        )
-        draw(
-            convertAlignmentProgram,
-            outputWidth,
-            outputHeight,
-            intArrayOf(output),
