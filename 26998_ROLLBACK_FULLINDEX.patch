-        uniform highp isampler2D uInput;
-        uniform ivec2 uInputMax;
-        layout(location = 0) out ivec4 oOut;
-
-        int sqrshrn7(int v) {
-            return clamp((v + 64) >> 7, -32768, 32767);
-        }
-
-        int fetchY(int x, int y) {
-            return texelFetch(uInput, ivec2(x, clamp(y, 0, uInputMax.y)), 0).r;
-        }
