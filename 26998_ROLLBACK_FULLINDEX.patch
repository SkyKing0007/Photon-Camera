-            int sum =
-                -3 * fetchY(p.x, by - 3) +
-                -7 * fetchY(p.x, by - 2) +
-                17 * fetchY(p.x, by - 1) +
-                57 * fetchY(p.x, by) +
-                57 * fetchY(p.x, by + 1) +
-                17 * fetchY(p.x, by + 2) +
-                -7 * fetchY(p.x, by + 3) +
