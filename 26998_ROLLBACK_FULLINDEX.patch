-
-        const int NEIGHBOR_COUNT = 12;
-        const int CARDINAL_COUNT = 4;
-        const ivec2 SAME_CFA_OFFSETS[NEIGHBOR_COUNT] = ivec2[NEIGHBOR_COUNT](
