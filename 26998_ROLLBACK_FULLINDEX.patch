-
-        val reconHalo = GlesMgcChromaDenoiseShaders.RECON_HALO
-        val blf0Halo = GlesMgcChromaDenoiseShaders.BLF0_HALO
-        val recon = scratch.allocate(
-            GLES30.GL_RGBA16I, width + 2 * reconHalo, height + 2 * reconHalo, "MGC chroma recon",
