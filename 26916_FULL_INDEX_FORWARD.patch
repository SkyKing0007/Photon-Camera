@@ -76,8 +77,24 @@ void main(){
     if(abs(delta)<0.0001)return;
     vec3 result=rotateHueWithoutTone(src,lab,delta);
     if(any(lessThan(result,vec3(-0.000005)))||any(isnan(result))||any(isinf(result))){
-        result=rotateHueWithoutTone(src,lab,0.5*delta);
-        if(any(lessThan(result,vec3(-0.000005)))||any(isnan(result))||any(isinf(result)))return;
+        // The old full/half/identity decision introduced an abrupt color step
+        // at the Display-P3 boundary. Instead find the greatest feasible hue
+        // angle continuously, without rotating outside positive P3 or changing
+        // source luminance/chroma merely to force a target into gamut.
+        float lo=0.0;
+        float hi=1.0;
+        for(int i=0;i<12;i++){
+            float mid=0.5*(lo+hi);
+            vec3 trial=rotateHueWithoutTone(src,lab,delta*mid);
+            bool valid=all(greaterThanEqual(trial,vec3(-0.000005)))
+                    && !any(isnan(trial)) && !any(isinf(trial));
+            if(valid)lo=mid;
+            else hi=mid;
+        }
+        if(lo<0.0002442)return;
+        result=rotateHueWithoutTone(src,lab,delta*lo);
+        if(any(isnan(result))||any(isinf(result))||any(lessThan(result,vec3(-0.000005))))return;
     }
+    // Numerical negative epsilon only, not a chroma desaturation stage.
     Output=max(result,vec3(0.0));
 }
