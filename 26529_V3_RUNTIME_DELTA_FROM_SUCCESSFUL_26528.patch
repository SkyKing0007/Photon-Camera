+    }
+
+    private fun bindImage(unit: Int, texture: Int, access: Int) {
+        GLES31.glBindImageTexture(unit, texture, 0, false, 0, access, GLES30.GL_RGBA16UI)
+    }
+
+    private fun clearImages() {
+        for (unit in 0..2) {
