+    private static float iris26583ProjectedOutputPeak(float sourceGuide, float gain, float sceneWhite,
+                                                        boolean finalHighlightAuthority) {
+        float postGuide = Math.max(0.0f, sourceGuide) * Math.max(gain, 1.0e-6f);
+        float mapped = finalHighlightAuthority
+                ? Iris26983COnRender.iris26591MapHeadroom(postGuide, sceneWhite)
+                : Iris26983COnRender.iris26582MapHeadroom(postGuide, sceneWhite);
+        return clamp(mapped * OUTPUT_EXPOSURE_SCALE, 0.0f, 1.0f);
+    }
