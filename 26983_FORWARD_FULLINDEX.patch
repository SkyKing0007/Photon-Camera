+    vec3 d=a-b;return sqrt(dot(d,d)/3.0);
+}
+vec3 iris26903ApplyJin(ivec2 op,vec3 nativeP3){
+    vec2 f=(vec2(op)+vec2(0.5))*vec2(uNightBJinSize)/vec2(uOutputSize)-vec2(0.5);
+    f=clamp(f,vec2(0.0),vec2(uNightBJinSize)-vec2(1.0));
+    ivec2 lo=ivec2(floor(f)),hi=min(lo+ivec2(1),uNightBJinSize-ivec2(1));
+    vec2 t=fract(f);
+    ivec2 q0=lo,q1=ivec2(hi.x,lo.y),q2=ivec2(lo.x,hi.y),q3=hi;
+    vec3 d0=iris26903JinResidual(q0),d1=iris26903JinResidual(q1);
+    vec3 d2=iris26903JinResidual(q2),d3=iris26903JinResidual(q3);
+    vec3 bil=mix(mix(d0,d1,t.x),mix(d2,d3,t.x),t.y);
+    float y=irisLuma(nativeP3);
+    float nativeEdge=max(abs(dFdx(y)),abs(dFdy(y)));
+    vec3 g0=iris26903JinGuide(q0),g1=iris26903JinGuide(q1);
+    vec3 g2=iris26903JinGuide(q2),g3=iris26903JinGuide(q3);
+    float span=max(max(iris26903JinColorDistance(g0,g1),
+                       iris26903JinColorDistance(g0,g2)),
+                   max(max(iris26903JinColorDistance(g0,g3),
+                           iris26903JinColorDistance(g1,g2)),
+                       max(iris26903JinColorDistance(g1,g3),
+                           iris26903JinColorDistance(g2,g3))));
+    float gate=max(smoothstep(0.025,0.120,nativeEdge),
+                   smoothstep(0.060,0.200,span));
+    vec3 reduced=bil;
+    if(gate>0.0001){
+        ivec2 center=clamp(ivec2(floor(f+vec2(0.5))),ivec2(0),uNightBJinSize-ivec2(1));
+        vec3 sum=vec3(0.0);float weight=0.0;
+        for(int yy=-1;yy<=1;yy++)for(int xx=-1;xx<=1;xx++){
+            ivec2 q=center+ivec2(xx,yy);
+            if(any(lessThan(q,ivec2(0)))||any(greaterThanEqual(q,uNightBJinSize)))continue;
+            vec2 dist=vec2(q)-f;
+            vec3 compatDiff=nativeP3-iris26903JinGuide(q);
+            float wd=1.0/(1.0+dot(dist,dist));
+            float wc=1.0/(1.0+80.0*dot(compatDiff,compatDiff)/3.0);
+            float w=wd*wc;
+            sum+=w*iris26903JinResidual(q);weight+=w;
+        }
+        if(weight>1.0e-8){
+            vec3 mean=sum/weight;
+            for(int c=0;c<3;c++){
+                float before=bil[c],now=mean[c];
+                if(before!=0.0&&abs(now)<abs(before))
+                    reduced[c]=before*now<=0.0?0.0:now;
+            }
+        }
+    }
+    vec3 rr=mix(bil,reduced,gate);
+    rr=clamp(rr,-abs(bil),abs(bil));
+    return clamp(nativeP3+rr,vec3(0.0),vec3(1.0));
+}
+vec3 iris26903P3Decode(vec3 encoded){
+    return vec3(encoded.r<=0.04045?encoded.r/12.92:pow((encoded.r+0.055)/1.055,2.4),
+                encoded.g<=0.04045?encoded.g/12.92:pow((encoded.g+0.055)/1.055,2.4),
+                encoded.b<=0.04045?encoded.b/12.92:pow((encoded.b+0.055)/1.055,2.4));
+}
+uint irisByte(float x){return uint(clamp(floor(clamp(x,0.0,1.0)*255.0+0.5),0.0,255.0));}
+void main(){
+    ivec2 local=ivec2(gl_FragCoord.xy);
+    if(local.x>=uOutputSize.x||local.y>=uBandH)return;
+    ivec2 op=ivec2(local.x,uBandTop+local.y);
+    vec2 trueSource=irisOutputToSource(op);
+    vec3 hdr=irisSamplePreRender(trueSource);
+    float localMapped=irisLocalToneMappedGuide(trueSource);
+    vec3 sdr=irisHeadroom(hdr,localMapped);
+    uint gainCode=0u;
+    if(uGenerateGain!=0){
+        const float off=0.015625;float safeMax=max(uGainMax,1.001);
+        float contentMax=clamp(uGainContentMax,1.0,safeMax);
+        float ratio;
+        if(uMotionHdrHandoff!=0){
+            /* IRIS_26922_B_SRON_MATCHED_HDR_SDR_QUOTIENT
+             * 26921's hdrEntry=.65/hdrFullEntry=.85 hard source-domain
+             * gate left almost every 50MP gain pixel at unity and fractured
+             * cloud contours. Derive the numerator from the *same* HDR signal
+             * used to render this SDR pixel, mapped into the matched display
+             * exposure domain before dividing by its actual post-tone SDR.
+             * Keep a smooth highlight-only eligibility rather than either
+             * a global lift or a sparse binary cloud mask. This preserves
+             * black/shadow SDR at 1x and smooth spatial continuity.
+             */
+            vec3 hp=irisClampNonnegative(hdr);
+            float sourceY=max(irisLuma(hp),0.0);
+            float sourceGuide=max(sourceY,irisPeak(hp));
+            float sdrY=max(irisLuma(irisClampNonnegative(sdr)),0.0);
+            float requested=max(uDisplayGain,1.0e-6)*0.80;
+            float hdrTargetY=sourceY*requested;
+            float matchedRatio=clamp((hdrTargetY+off)/(sdrY+off),1.0,contentMax);
+            float highlightEligibility=smoothstep(0.12,0.58,sourceGuide);
+            ratio=clamp(exp2(log2(max(matchedRatio,1.0))*highlightEligibility),1.0,contentMax);
+        }else{
+            float hdrY=max(irisLuma(irisClampNonnegative(hdr)),0.0);
+            float sdrY=max(irisLuma(irisClampNonnegative(sdr)),0.0);
+            ratio=clamp((hdrY+off)/(sdrY+off),1.0,contentMax);
+        }
+        float code=clamp(log2(ratio)/max(log2(safeMax),1.0e-6),0.0,1.0);
+        gainCode=irisByte(code);
+    }
+    vec3 encoded=vec3(irisGamma(sdr.r),irisGamma(sdr.g),irisGamma(sdr.b));
+    if(uBWatermarkEnabled!=0){
+        float wmW=float(uOutputSize.x)*0.115;
+        float wmH=wmW*uBWatermarkAspect.y/uBWatermarkAspect.x;
+        float margin=max(2.0,float(min(uOutputSize.x,uOutputSize.y))*0.025);
+        vec2 leftTop=vec2(float(uOutputSize.x)-margin-wmW,float(uOutputSize.y)-margin-wmH);
+        vec2 xy=vec2(op);
+        if(xy.x>=leftTop.x&&xy.x<=leftTop.x+wmW&&
+           xy.y>=leftTop.y&&xy.y<=leftTop.y+wmH){
+            vec2 uv=(xy-leftTop)/vec2(wmW,wmH);
+            vec4 wm=texture(uBWatermark,uv);
+            if(wm.a>0.0)encoded=mix(encoded,iris26876WatermarkP3(wm.rgb),wm.a);
+        }
+    }
+    if(uNightBJinEnabled!=0){
+        vec3 nativeEncoded=encoded;
+        encoded=iris26903ApplyJin(op,encoded);
+        if(uGenerateGain!=0){
+            /* Preserve the old linear HDR target after Jin moves the SDR.
+             * This is identical in intent to existing IrisNightUltraHdr rebase. */
+            const float off=0.015625;
+            float safeMax=max(uGainMax,1.001);
+            float contentMax=clamp(uGainContentMax,1.0,safeMax);
+            float oldRatio=exp2((float(gainCode)/255.0)*log2(safeMax));
+            float pre=max(irisLuma(iris26903P3Decode(nativeEncoded)),0.0);
+            float fin=max(irisLuma(iris26903P3Decode(encoded)),0.0);
+            float newRatio=clamp(oldRatio*(pre+off)/(fin+off),1.0,contentMax);
+            gainCode=irisByte(log2(newRatio)/max(log2(safeMax),1.0e-6));
+        }
+    }
+    uvec4 outv=uvec4(irisByte(encoded.r),irisByte(encoded.g),irisByte(encoded.b),gainCode);
+    oBFinalP3Gain=vec4(outv)/255.0;
+}
diff --git a/app/src/main/assets/shaders/iris26983/con_post/addwatermark_rotate.glsl b/app/src/main/assets/shaders/iris26983/con_post/addwatermark_rotate.glsl
