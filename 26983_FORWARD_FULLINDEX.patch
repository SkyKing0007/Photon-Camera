+        } finally {
+            if (!unlockCpu()) {
+                Log.e(TAG, "IRIS_26826_SHARED_RGBA16F_FALLBACK_UNLOCK_FAILED");
+            }
+        }
+    }
+
+    @Override
+    public void close() {
