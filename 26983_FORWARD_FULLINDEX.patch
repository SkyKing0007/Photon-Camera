+    private val iris26876DerivedGuideShader = """#version 300 es
+        precision highp float;
+        precision highp sampler2D;
+        uniform sampler2D uTwoXLinear;
+        uniform sampler2D uTwoXOriginalClip;
+        uniform ivec2 uOneXExtent;
