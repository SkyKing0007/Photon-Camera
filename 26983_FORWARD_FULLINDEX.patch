index 0000000000000000000000000000000000000000..06157bde44aaf1c897b6aa29f9b3bb2c5df0c3df
--- /dev/null
+++ b/app/src/main/assets/shaders/iris26983/con_fused_final_p3_gain.frag
@@ -0,0 +1,591 @@
+#version 310 es
+precision highp float;
+precision highp int;
+precision highp usampler2D;
+/* IRIS_26571_TRUE2X_PUBLICATION_COMPUTE */
+/* IRIS_26876_B_FINAL_RENDER_TO_EGL_AHB_COLOR_ATTACHMENT
+ * The GPU target is an EGLImage-backed AHardwareBuffer (RGBA_8888),
+ * bound to GL_COLOR_ATTACHMENT0 on a complete FBO. Output is normalized
+ * P3 RGB + full-res gain code in A; no rgba8ui imageStore incompatibility.
+ * CPU writer locks the buffer only after GL completion and SSBO checks.
+ */
+layout(binding=0) uniform highp sampler2D uSource;
+uniform highp sampler2D uLocalToneLogMap;
+layout(location=0) out vec4 oBFinalP3Gain;
+layout(std430,binding=1) readonly buffer IrisGammaLut { float gammaLut[]; };
+layout(std430,binding=2) readonly buffer IrisAcr3Curve { float acr3Curve[]; };
+/* IRIS_26876_B_GPU_DCP_WATERMARK_FULL_PROFILE */
+layout(std430,binding=3) readonly buffer Iris26876BFirstDcp { float irisBFirstDcp[]; };
+layout(std430,binding=4) readonly buffer Iris26876BSecondDcp { float irisBSecondDcp[]; };
+uniform ivec3 uBFirstDcpDims;
+uniform ivec3 uBSecondDcpDims;
+uniform int uBWatermarkEnabled;
+uniform sampler2D uBWatermark;
+uniform vec2 uBWatermarkAspect;
+
+uniform ivec2 uSrcOrigin;
+uniform ivec2 uSrcSize;
+uniform ivec2 uTrueSize;
+uniform ivec2 uOutputSize;
+uniform ivec2 uRawSize;
+uniform ivec2 uCropSize;
+uniform int uRotation;
+uniform int uMirror;
+uniform int uBandTop;
+uniform int uBandH;
+uniform int uGenerateGain;
+uniform float uResidualZoom;
+uniform float uDisplayGain;
+uniform float uExposureEv;
+uniform float uShadows;
+uniform float uContrast;
+uniform float uSaturation;
+// 26932 B SR ON body tone retains its original Night policy.
+uniform int uIris26932BOnTone;
+// 26948 B-only SDR/UHDR headroom also covers frozen Night B when routed here.
+uniform int uIris26948BUniversalSdrEnabled;
+uniform float uSceneWhite;
+uniform float uBodyToneStrength;
+uniform int uMotionHdrHandoff;
+uniform int uAcr3Enabled;
+uniform int uLocalToneLogEnabled;
+uniform ivec2 uLocalToneLogSize;
+uniform ivec2 uLocalToneLogSourceSize;
+uniform float uGainMax;
+uniform float uGainContentMax;
+uniform vec3 uSensorRow0;
+uniform vec3 uSensorRow1;
+uniform vec3 uSensorRow2;
+uniform vec3 uDisplayRow0;
+uniform vec3 uDisplayRow1;
+uniform vec3 uDisplayRow2;
+/* IRIS_26903_NIGHT_B_ONLY_JIN_TRUE2X: 512 learned residual/reference textures. */
+uniform int uNightBJinEnabled;
+uniform ivec2 uNightBJinSize;
+uniform highp sampler2D uNightBJinReference;
+uniform highp sampler2D uNightBJinResidual;
+
+
+/* IRIS_26876_B_EXACT_CLIP_PREINTERPOLATION_DEV
+ * Include after #version 310 es and precision declarations into the B-only
+ * final native renderer, before sample/appearance/tone and JPEG encode.
+ * This MUST be evaluated per integer 2x CFA result texel BEFORE the
+ * output/crop/rotation bilinear interpolation, matching the successful
+ * 26875 CPU file pass ordering, not after bilinear image sampling.
+ *
+ * uBOriginal2x rgba16f contains Wronski post-AMaZE scene-linear camera RGB
+ * and exact binary 2x sensor clip in alpha. uBFinal1x rgba16f contains the
+ * FINAL corrected 1x guide RGB plus original reference 1x mask in alpha.
+ * No mask inference from saturated RGB colors or merged DCP/tone output.
+ */
+layout(binding=6) uniform highp sampler2D uBOriginal2x;
+layout(binding=7) uniform highp sampler2D uBFinal1x;
+layout(std430,binding=5) buffer Iris26876BInvalid { uint irisBInvalidCount; };
+uniform ivec2 uBTrueSize;
+uniform ivec2 uBGuideSize;
+uniform vec3 uBWhiteBalance;
+uniform float uBYFloor;
+
+bool irisBFinite3(vec3 v){return !any(isnan(v))&&!any(isinf(v));}
+vec4 irisBGuideAt(ivec2 p){
+    ivec2 q=clamp(p,ivec2(0),uBGuideSize-ivec2(1));
+    return texelFetch(uBFinal1x,q,0);
+}
+vec4 irisBGuideBilinear(ivec2 p){
+    vec2 f=(vec2(p)+vec2(0.5))*vec2(uBGuideSize)/vec2(uBTrueSize)-vec2(0.5);
+    f=clamp(f,vec2(0.0),vec2(uBGuideSize)-vec2(1.0));
+    ivec2 lo=ivec2(floor(f));
+    ivec2 hi=min(lo+ivec2(1),uBGuideSize-ivec2(1));
+    vec2 t=fract(f);
+    vec4 a=irisBGuideAt(lo);
+    vec4 b=irisBGuideAt(ivec2(hi.x,lo.y));
+    vec4 c=irisBGuideAt(ivec2(lo.x,hi.y));
+    vec4 d=irisBGuideAt(hi);
+    return mix(mix(a,b,t.x),mix(c,d,t.x),t.y);
+}
+vec3 irisBHalfRound(vec3 v){
+    vec2 a=unpackHalf2x16(packHalf2x16(v.rg));
+    vec2 b=unpackHalf2x16(packHalf2x16(vec2(v.b,0.0)));
+    return vec3(a,b.x);
+}
+vec3 irisBCorrectOne2x(ivec2 p){
+    ivec2 q=clamp(p,ivec2(0),uBTrueSize-ivec2(1));
+    vec4 physical=texelFetch(uBOriginal2x,q,0);
+    vec4 guide=irisBGuideBilinear(q);
+    if(!irisBFinite3(physical.rgb)||!irisBFinite3(guide.rgb)||
+       any(lessThanEqual(uBWhiteBalance,vec3(0.0)))||
+       !irisBFinite3(uBWhiteBalance)||!(uBYFloor>0.0)||
+       isnan(physical.a)||isinf(physical.a)||
+       !(physical.a==0.0||physical.a==1.0)||
+       isnan(guide.a)||isinf(guide.a)){
+        atomicAdd(irisBInvalidCount,1u);
+        return vec3(0.0);
+    }
+    float mask=max(clamp(guide.a,0.0,1.0),physical.a);
+    if(!(mask>0.0))return physical.rgb;
+    vec3 srcWb=physical.rgb*uBWhiteBalance;
+    vec3 guideWb=guide.rgb*uBWhiteBalance;
+    float ySrc=dot(srcWb,vec3(0.25,0.50,0.25));
+    float yGuide=dot(guideWb,vec3(0.25,0.50,0.25));
+    float ys=max(ySrc,uBYFloor),yg=max(yGuide,uBYFloor);
+    vec2 cSrc=vec2(srcWb.r-srcWb.g,srcWb.b-srcWb.g)/ys;
+    vec2 cGuide=vec2(guideWb.r-guideWb.g,guideWb.b-guideWb.g)/yg;
+    vec2 c=mix(cSrc,cGuide,mask);
+    vec2 rgBg=c*ys;
+    float g=ySrc-0.25*(rgBg.x+rgBg.y);
+    vec3 fixedRgb=max(vec3(g+rgBg.x,g,g+rgBg.y)/uBWhiteBalance,vec3(0.0));
+    if(!irisBFinite3(fixedRgb))atomicAdd(irisBInvalidCount,1u);
+    return irisBHalfRound(fixedRgb);
+}
+vec3 irisBSampleCorrectedBilinear(vec2 pos){
+    vec2 f=clamp(pos,vec2(0.0),vec2(uBTrueSize)-vec2(1.0));
+    ivec2 lo=ivec2(floor(f));
+    ivec2 hi=min(lo+ivec2(1),uBTrueSize-ivec2(1));
+    vec2 t=fract(f);
+    vec3 a=irisBCorrectOne2x(lo);
+    vec3 b=irisBCorrectOne2x(ivec2(hi.x,lo.y));
+    vec3 c=irisBCorrectOne2x(ivec2(lo.x,hi.y));
+    vec3 d=irisBCorrectOne2x(hi);
+    return mix(mix(a,b,t.x),mix(c,d,t.x),t.y);
+}
+
+float irisLuma(vec3 c){return dot(c,vec3(0.22897456,0.69173852,0.07928691));}
+float irisPeak(vec3 c){return max(c.r,max(c.g,c.b));}
