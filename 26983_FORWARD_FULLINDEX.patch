+        buffer = null;
+        if (hb == null) return;
+        if (cpuLocked) {
+            try { unlockCpuNative(hb); } catch (Throwable ignored) {}
+            cpuLocked = false;
+        }
+        try { hb.close(); } catch (Throwable ignored) {}
+    }
