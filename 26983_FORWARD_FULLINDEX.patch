+uniform int iris26961BOffNeutralIndoor;
+uniform int iris26961BOffColorSpacingEnabled;
+float iris26961BOffWarmHighlightGuide(float oldGuide,vec3 sourceRgb){
+    float y=max(oldGuide,0.0);
+    if(iris26961BOffColorSpacingEnabled==0 || iris26961BOffNeutralIndoor!=0 || y<=0.82)return y;
+    vec3 c=max(sourceRgb,vec3(0.0));
+    float peak=max3(c);
+    if(peak<=1.0e-7)return y;
+    float small=min(c.r,min(c.g,c.b));
+    float warm=(max(c.r,c.g)-c.b)/peak;
+    float chroma=(peak-small)/peak;
+    float weight=smoothstep(0.08,0.28,warm)*smoothstep(0.08,0.24,chroma);
+    float excess=y-0.82;
+    float spaced=0.82+0.30*(1.0-exp(-excess/0.30));
+    return mix(y,spaced,weight);
