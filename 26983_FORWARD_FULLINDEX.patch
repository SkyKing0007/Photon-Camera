+    /** Explicit C ON output owner, including DNG-only bypass. */
+    public void runIris26983COnBatch(CameraCharacteristics characteristics, MotionBatch batch,
+            int rawSaverAtShutter, int expectedNormals,
+            com.particlesdevs.photoncamera.processing.processor.IrisMotionSettings.Snapshot tone,
+            float clipYFloor, boolean highlightCompression, boolean watermark, boolean aspect169, boolean energySaving) {
+        /* IRIS_26486_SERIALIZED_LEGACY_METADATA_COMPATIBILITY
+         * These globals are written only here, on the one serialized processing lane.
