+
+/* IRIS_26816_FALSE_COLOR_MAGNITUDE_TELEMETRY_RETIRED */
+/* IRIS_26822_SINGLE_OWNER_FALSE_COLOR_ATTENUATION
+ * One and only one downstream false-color RGB mutation owner.
+ *
+ * The R8 input now carries continuous evidence only. 26797/26798/26799/26803 neighbor-material
+ * estimates remain historical detector code but are no longer invoked as RGB writers. Neighbor
+ * pixels may decide confidence that the CENTER chroma is unsupported; they may never donate a
+ * replacement hue. Correction therefore preserves Display-P3 luminance and the center chroma
+ * direction exactly while attenuating only its magnitude toward neutral.
+ *
+ * Safety invariant:
+ *   corrected = Y + centerChroma * keepFactor, 0 <= keepFactor <= 1
+ * so this owner cannot create cyan/yellow/green/magenta/peach or rotate an existing hue.
+ */
+float iris26822FalseColorConfidence(ivec2 outputXY){
+    if(iris26799ConnectedEnabled==0)return 0.0;
+    ivec2 msz=textureSize(iris26799ConnectedMask,0);
+    ivec2 mp=clamp(outputXY,ivec2(0),msz-ivec2(1));
+    return clamp(texelFetch(iris26799ConnectedMask,mp,0).r,0.0,1.0);
+}
+vec3 iris26822ApplySingleOwnerFalseColor(ivec2 outputXY,vec3 rgb){
+    float confidence=iris26822FalseColorConfidence(outputXY);
+    if(confidence<=1.0e-7)return rgb;
+    rgb=max(rgb,vec3(0.0));
+    float y=max(luminance(rgb),0.0);
+    vec3 centerChroma=rgb-vec3(y);
+    float chromaMagnitude=length(centerChroma);
+    if(chromaMagnitude<=1.0e-8)return rgb;
+
+    /* Continuous confidence only: no connected flood, no display-brightness authority override,
+     * no material-target hue, no direct 0.92 bypass, and no hard class-to-strength transition. */
+    float attenuation=smoothstep(0.04,0.94,confidence);
+    float keepFactor=1.0-attenuation;
+    vec3 corrected=vec3(y)+centerChroma*keepFactor;
+    return max(corrected,vec3(0.0));
