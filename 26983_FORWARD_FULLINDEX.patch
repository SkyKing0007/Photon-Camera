+    /* IRIS_26591_VIEWFINDER_BODY_FREEZE_FINAL_TAIL_SPLIT
+     * Preserve the exact 26590 meter map (logShape 6 and successful meter targets) so the
+     * new final highlight shoulder cannot feed back into body/viewfinder brightness. Final
+     * highlight decisions and motionv2/render.glsl alone use the 26591 logShape-3 transfer.
+     *
+     * IRIS_26586_VIEWFINDER_TONE_AUTHORITY_SPLIT
+     * Viewfinder/body exposure is solved against the exact successful 26584 structured-tone
+     * baseline (64-bin P90, 0.965 target). Only after displayGain is final may the 26585
+     * P98/0.945 structured-highlight owner allocate extra upper-tail headroom. This prevents
+     * stronger highlight compression from feeding back into exposure and brightening the body.
+     */
+    private ToneDecision iris26586ViewfinderMeterToneDecision(float gain) {
+        return iris26586ToneDecision(gain, false);
+    }
