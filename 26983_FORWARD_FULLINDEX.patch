+precision highp float;
+precision mediump sampler2D;
+
+uniform sampler2D InputBuffer;
+uniform float sceneWhite;
+uniform float outputExposureScale;
+uniform float irisOutputZoom;
+/* IRIS_26718_FINAL_SAMPLE_HIGH_ZOOM_DETAIL */
+uniform sampler2D iris26718HighZoomDetail;
+uniform int iris26718HighZoomDetailEnabled;
+uniform vec2 iris26752PlanBDetailScale;
+uniform vec2 iris26752PlanBDetailOrigin;
+uniform int iris26592MotionHdrHandoff;
+uniform int iris26906BVisualToneEnabled;
+// B/SR-OFF only; never B ON, A, A+B or Night.
+uniform int iris26932BOffSdrLiftEnabled;
+uniform int iris26941BOffHdrqLowZoom;
+// Set only by a frozen Experiment B snapshot, never A/A+B.
+uniform int iris26948BUniversalSdrEnabled;
+uniform int iris26954BOffNight26940Sdr;
+uniform int iris26951BOffHdrqSdrHighlightProtect;
