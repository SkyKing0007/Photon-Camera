+    float lumaWeight=1.0-smoothstep(0.08,0.34,lumaDelta);
+    float chromaWeight=0.18+0.82*(1.0-smoothstep(0.08,0.30,cm));
+    float w=lumaWeight*chromaWeight;
+    sum+=c*w;wsum+=w;
