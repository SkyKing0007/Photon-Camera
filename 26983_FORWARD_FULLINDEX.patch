+
+/* IRIS_26718_HIGH_ZOOM_DETAIL_SAMPLE
+ * The sidecar is a centered subset of the global true-2x sensor lattice. It carries only signed
+ * log2 luminance detail; zero and out-of-bounds are exact no-ops.
+ */
+float iris26718HighZoomLogDetail(vec2 sourcePixel){
+    if(iris26718HighZoomDetailEnabled==0)return 0.0;
+    /* IRIS_26752_IPOL_PLAN_B_NONINTEGER_SAMPLE
+     * Preserve the paper's arbitrary continuous output lattice instead of snapping Plan B to
+     * the retired fixed true-2x direct-CFA lattice. */
+    vec2 local=sourcePixel*iris26752PlanBDetailScale-iris26752PlanBDetailOrigin;
+    ivec2 sz=textureSize(iris26718HighZoomDetail,0);
+    if(any(lessThan(local,vec2(0.0)))||any(greaterThan(local,vec2(sz)-vec2(1.0))))return 0.0;
+    /* IRIS_26834_UNIVERSAL_HIGH_ZOOM_VISIBLE_CROP_GUARD
+     * High-zoom detail is never trusted near its reconstruction boundary. The producer reserves
+     * a 32-texel target halo per side; keep the outer 16 texels at exact native Sabre/VGN and
+     * transition only from 16..24. Thus a visible 30x/120x crop cannot magnify edge uncertainty
+     * into barcode stripes. This rule is zoom-independent for every high-zoom detail route. */
+    vec2 edgeDistance=min(local,vec2(sz)-vec2(1.0)-local);
+    float minEdge=min(edgeDistance.x,edgeDistance.y);
+    if(minEdge<=16.0)return 0.0;
+    float trustedInterior=smoothstep(16.0,24.0,minEdge);
+    vec2 uv=(local+vec2(0.5))/vec2(sz);
+    return clamp(texture(iris26718HighZoomDetail,uv).r,-0.56,0.56)*trustedInterior;
+}
+
+/* IRIS_26952_B_ONLY_BRIGHT_RIM_OVERSHOOT_GUARD
+ * Suppress a strictly positive, isolated bright ridge when a real dark/bright
+ * boundary is present.  Use one-sided samples in the *source* (before any
+ * tone curve) so a bright sky pixel only compares to its bright-side sky
+ * plateau, never to foliage.  No RGB/chroma mixing or blur, no A/A+B change.
+ * The actual rendered SDR texture remains the gainmap's exact denominator.
+ * At most 2.5% source-guide correction; real white plateaus are unchanged.
+ */
+float iris26952SourceGuide(vec3 v){
+    vec3 p=max(v,vec3(0.0));
+    return max(max3(p),luminance(p));
+}
+float iris26952GuideAt(ivec2 p,ivec2 size){
+    return iris26952SourceGuide(texelFetch(InputBuffer,clamp(p,ivec2(0),size-ivec2(1)),0).rgb);
+}
+vec3 iris26952ConstrainRim(ivec2 pixel,vec3 rgb){
+    if(iris26954BOffNight26940Sdr!=0 || iris26948BUniversalSdrEnabled==0 || iris26592MotionHdrHandoff==0 || irisOutputZoom>1.00001)
+        return rgb;
+    float peak=iris26952SourceGuide(rgb);
+    if(peak<=0.60)return rgb;
+    ivec2 size=textureSize(InputBuffer,0);
+    if(any(lessThan(pixel,ivec2(3))) || any(greaterThanEqual(pixel,size-ivec2(3))))return rgb;
+    float limited=peak;
+    for(int axis=0;axis<4;axis++){
+        ivec2 d=axis==0?ivec2(1,0):(axis==1?ivec2(0,1):(axis==2?ivec2(1,1):ivec2(1,-1)));
+        for(int side=-1;side<=1;side+=2){
+            ivec2 u=d*side;
+            float bright1=iris26952GuideAt(pixel+u,size);
+            float bright2=iris26952GuideAt(pixel+2*u,size);
+            float dark1=iris26952GuideAt(pixel-u,size);
+            float dark2=iris26952GuideAt(pixel-2*u,size);
+            float plateau=max(bright1,bright2);
+            float dark=max(dark1,dark2);
+            float edgeContrast=max(plateau-dark,0.0);
+            float plateauDelta=abs(bright1-bright2);
+            // Demand a bright-side plateau, a steep actual boundary and
+            // center-only positive overshoot.  This cannot flatten a genuine
+            // broad white subject or change a smooth sky gradient.
+            if(edgeContrast>0.15*max(plateau,0.05) && plateauDelta<0.075*max(plateau,0.05) &&
+               peak>plateau+0.006*max(peak,0.05)){
+                float cap=plateau+0.003*peak;
+                limited=min(limited,cap);
+            }
+        }
+    }
+    return rgb*(max(peak*0.975,limited)/max(peak,1.0e-6));
+}
+
+void main() {
+    ivec2 xy=ivec2(gl_FragCoord.xy);
+    ivec2 sourceSize=textureSize(InputBuffer,0);
+    ivec2 sourceXY=xy;
