+                    -length(iris26796NormalizedChroma(iris26796SampleCalibratedP3(p-vec2(1.0,0.0)))),
+                 length(iris26796NormalizedChroma(iris26796SampleCalibratedP3(p+vec2(0.0,1.0))))
