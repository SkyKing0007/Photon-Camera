+    float lowGate=smoothstep(0.055,0.180,y);
+    float highGate=1.0-smoothstep(0.500,0.760,y);
+    float bodyWeight=clamp(lowGate*highGate,0.0,1.0);
+    return mix(y,y*y,0.24*strength*bodyWeight);
+}
+
+/* IRIS_26770_MIDTONE_PRESENTATION_TRIM_GAINMAP_MIRROR
+ * Exact pointwise mirror of render.glsl so the UHDR quotient uses the published SDR appearance
+ * as its denominator. HDR target ownership is unchanged. */
+/* IRIS_26783_SDR_BODY_CONTRAST_UHDR_REBASE
+ * Strengthen only the finished SDR body's pointwise luminance separation. Exact black/deep-shadow
+ * identity extends through 0.10 and upper/highlight identity remains from 0.78. The gain-map shader
+ * carries this exact same function, so the decoded UHDR target remains owned by the frozen matched
+ * HDR intent while the SDR denominator changes. */
+float iris26770MidtonePresentationTrim(float mappedGuide){
+    float y=max(mappedGuide,0.0);
+    float low=smoothstep(0.10,0.24,y);
+    float high=1.0-smoothstep(0.50,0.78,y);
+    float w=clamp(low*high,0.0,1.0);
+    return mix(y,y*y,clamp(iris26792SdrBodyContrast,0.0,0.35)*w);
+}
+/* IRIS_26892_SCENE_ADAPTIVE_SDR_FINISH
+ * Same scalar luminance transfer in render.glsl and gainmap.glsl.
+ * No local edge masks, external color statistics, saturation or RAW-domain writes.
+ * The scene-wide coefficients are bounded from frozen PRE-TONE histogram percentiles.
+ * Backlit: restore underrepresented subject exposure below the upper body while
+ * preserving deep black, highlights and channel ratios. Low-contrast ordinary
+ * scenes: a strictly increasing display-oriented S-curve (no separate midtone lift).
+ * The UHDR SDR denominator mirrors this function exactly; original HDR target
+ * is retained through matched-intent delta correction.
+ */
+uniform float iris26892BacklitStrength;
+uniform float iris26892FlatContrastStrength;
+uniform float iris26893BacklitCoefficient;
+float iris26892SdrAdaptiveGuide(float oldGuide){
+    float y=max(oldGuide,0.0);
+    if(y<=0.0 || y>=1.0) return y;
+    /* IRIS_26893_REFERENCE_CALIBRATED_FOREGROUND_ONLY
+     * A bounded monotone scalar response, calibrated to the green/foliage
+     * brightness in 26891 shots 3/4; actual camera exposure is untouched.
+     * (1-y)^3 preserves the sky/highlight body and channel ratios.
+     * Deep black remains bounded to avoid exaggerating the noise floor.
+     */
+    float shadowGate=smoothstep(0.0015,0.010,y);
+    float t=max(1.0-y,0.0);
+    float backlitCoefficient=clamp(iris26893BacklitCoefficient,0.0,1.30);
+    float lifted=min(1.0,y+backlitCoefficient*y*t*t*t*shadowGate);
+    /* IRIS_26893_FLAT_CONTRAST_DARKEN_ONLY
+     * Only subtract nonnegative scalar luma from the darker/body range;
+     * brighter tones are EXACTLY untouched, with no extra saturation or
+     * independent midtone exposure increase. Both SDR and UHDR denominator
+     * must use the identical transfer for matched-intent gain maps.
+     */
+    /* A monotone darken-only transfer: denominator decreases toward 1
+     * as luminance increases, so no soft-shadow reversal or halo.  By 0.76
+     * light tones are byte-equivalent to the prior input, never brightened.
+     * Unlike a hard black clamp, every dark sample retains a positive slope.
+     */
+    float contrast=0.90*clamp(iris26892FlatContrastStrength,0.0,1.0);
+    float darkBodyGate=1.0-smoothstep(0.52,0.76,lifted);
+    float contrastDenominator=1.0+contrast*pow(1.0-lifted,3.0)*darkBodyGate;
+    return clamp(lifted/contrastDenominator,0.0,1.0);
+}
+
+/* IRIS_26906_B_VISUAL_TONE_POST_FINISH
+ * B Photo and B Night only. Display-linear SDR guide -> pointwise tone.
+ * The toe corresponds to approximately 20% lower PERCEIVED (sRGB-encoded)
+ * intensity near guide 0.025 versus the existing 26905 output; contrast is
+ * a 15% higher local midtone slope around guide 0.23, not a generic setting
+ * strength multiplier. Monotone, no black clipping, upper >=0.70 identical.
+ * Mirrors the gain-map SDR denominator and the B-only 50MP final shader.
+ */
+/* IRIS_26932_B_OFF_ONLY_SDR_BRIDGE
+ * Brighten the already-developed B/SR-OFF SDR body from the same extended
+ * HDR master, leaving near-black and high highlights on the proven curve.
+ * Compression-aware: stronger lift where the previous SDR compressed more.
+ * This exact function is mirrored in gainmap.glsl so the gain-map denominator
+ * recalibrates to the NEW SDR intent, preserving the old HDR target.
+ */
+float iris26932BOffSdrBridge(float oldSdrGuide,float sourceGuide){
+    float y=max(oldSdrGuide,0.0);
+    if(y<=0.0 || y>=0.95)return y;
+    float compression=clamp((max(sourceGuide,0.0)-y)/max(sourceGuide,0.01),0.0,1.0);
+    float body=smoothstep(0.005,0.065,y)*(1.0-smoothstep(0.28,0.95,y));
+    float uplift=body*(0.18+0.40*compression);
+    return min(y*(1.0+uplift),1.0);
+}
+
+/* IRIS_26941_B_OFF_HDRQ_MATCHED_SDR_PRIMARY
+ * The existing UHDR body was encoded as the missing portion of a shared
+ * linear HDR intent. For low-zoom Photo B HDR+, put that same linear intent
+ * directly in the SDR primary up to its usable headroom; reserve the smooth
+ * upper shoulder for actual HDR highlight expansion. Identical function in
+ * render.glsl and gainmap.glsl preserves the gainmap denominator exactly.
+ * This changes only presentation luminance, not RAW, CFA, WB or hue.
+ */
+float iris26941BOffMatchedSdrPrimary(float priorGuide,float sourceGuide){
+    float requested=max(displayGain,1.0e-6)*hdrExposureScale;
+    float linearIntent=max(sourceGuide,0.0)*requested;
+    float target=max(priorGuide,linearIntent);
+    if(target<=0.82)return target;
+    return 0.82+0.18*(1.0-exp(-(target-0.82)/0.18));
+}
+/* IRIS_26948_B_ONLY_SDR_UHDR_CHROMA_HEADROOM
+ * Preserve the 26947 0.82 start and the EXACT old smooth-white curve at
+ * genuine extreme headroom >=2.70. In between, use a gentler monotone rational
+ * shoulder, with a positive-slope merge into the existing white transition.
+ * This leaves the upstream clipped-neutral provenance and actual HDR target
+ * untouched. No halo/semantic detector, no spatial cross-pixel operation.
+ */
+float iris26948BHeadroomShoulder(float target){
+    if (target <= 0.82) return target;
+    float excess=target-0.82;
+    float former=0.82+0.18*(1.0-exp(-excess/0.18));
+    float separated=0.82+0.18*excess/(excess+0.18);
+    return mix(separated,former,smoothstep(1.50,2.70,target));
+}
+/* IRIS_26951_B_OFF_SDR_HIGHLIGHT_SEPARATION
+ * Restrict ONLY surplus HDR-to-SDR uplift, not completed SDR tone, RAW data,
+ * AMaZE, FCC, image detail, or actual HDR gain-map numerator. Above SDR's
+ * 0.82 shoulder entry, compress extra HDR intent relative to the existing
+ * mapped SDR guide. Exactly preserve all tones <= 0.82 and real extreme
+ * white headroom >= 2.70; no edge masks or cross-pixel sampling. */
+float iris26948BMatchedSdrPrimary(float priorGuide,float sourceGuide){
+    float prior=max(priorGuide,0.0);
+    float requested=max(displayGain,1.0e-6)*hdrExposureScale;
+    float target=max(prior,max(sourceGuide,0.0)*requested);
+    if(iris26951BOffHdrqSdrHighlightProtect==0 || target<=0.82)
+        return iris26948BHeadroomShoulder(target);
+    float anchor=max(prior,0.82);
+    float excess=max(target-anchor,0.0);
+    float restraint=0.75*(1.0-smoothstep(2.10,2.70,target));
+    float retained=anchor+excess/(1.0+restraint*excess);
+    return iris26948BHeadroomShoulder(retained);
+}
+
+/* IRIS_26961_B_OFF_WARM_HIGHLIGHT_LUMA_SEPARATION
+ * 26959 retains clean sky/borders. Its legacy 26940 SDR presentation can place
+ * real warm foliage very close to white after viewfinder gain. Preserve true
+ * neutral whites and blue sky as exact identity; do NOT add saturation.
+ * This is one monotone scalar guide shoulder with C1 slope at 0.82. It affects
+ * B/OFF low-zoom HDRQ ONLY. The exact SDR model is mirrored for UHDR delta
+ * accounting; the original HDR master and acquisition are untouched.
+ */
+uniform int iris26961BOffNeutralIndoor;
+uniform int iris26961BOffColorSpacingEnabled;
+float iris26961BOffWarmHighlightGuide(float oldGuide,vec3 sourceRgb){
+    float y=max(oldGuide,0.0);
+    if(iris26961BOffColorSpacingEnabled==0 || iris26961BOffNeutralIndoor!=0 || y<=0.82)return y;
+    vec3 c=max(sourceRgb,vec3(0.0));
+    float peak=max3(c);
+    if(peak<=1.0e-7)return y;
+    float small=min(c.r,min(c.g,c.b));
+    float warm=(max(c.r,c.g)-c.b)/peak;
+    float chroma=(peak-small)/peak;
+    float weight=smoothstep(0.08,0.28,warm)*smoothstep(0.08,0.24,chroma);
+    float excess=y-0.82;
+    float spaced=0.82+0.30*(1.0-exp(-excess/0.30));
+    return mix(y,spaced,weight);
+}
+
+float iris26906BVisualTone(float y) {
+    float x=max(y,0.0);
+    if(x>=0.70) return x;
+    float toeGate=1.0-smoothstep(0.015,0.145,x);
+    float toe=x*(1.0-0.330*toeGate);
+    float midLow=smoothstep(0.130,0.190,x);
+    float midHigh=1.0-smoothstep(0.500,0.700,x);
+    float mid=0.15*(x-0.230)*clamp(midLow*midHigh,0.0,1.0);
+    return max(toe+mid,0.0);
+}
+
+float iris26660SharedSdrGuide(float sourceGuide,vec2 masterSourcePixel,vec3 sourceRgb){
+    float sharedSdr=iris26640SharedSdrGuide(sourceGuide,masterSourcePixel);
+    sharedSdr=iris26824AdaptiveBodySGuide(sharedSdr);
+    float gammaSdr=iris26961BOffNeutralIndoor!=0
+            ? sharedSdr : iris26660ObjectColorGamma(sharedSdr);
+    float finalSdr=iris26892SdrAdaptiveGuide(
+            iris26770MidtonePresentationTrim(gammaSdr));
+    if(iris26906BVisualToneEnabled!=0) finalSdr=iris26906BVisualTone(finalSdr);
+    if(iris26954BOffNight26940Sdr!=0) {
+        // Identical 26940 SDR model: UHDR cannot reintroduce 26941+ source-driven SDR tone.
+        if(iris26932BOffSdrLiftEnabled!=0 && iris26961BOffNeutralIndoor==0) finalSdr=iris26932BOffSdrBridge(finalSdr,sourceGuide);
+    }
+    else if(iris26948BUniversalSdrEnabled!=0) finalSdr=iris26948BMatchedSdrPrimary(finalSdr,sourceGuide);
+    else if(iris26941BOffHdrqLowZoom!=0) finalSdr=iris26941BOffMatchedSdrPrimary(finalSdr,sourceGuide);
+    else if(iris26932BOffSdrLiftEnabled!=0 && iris26961BOffNeutralIndoor==0) finalSdr=iris26932BOffSdrBridge(finalSdr,sourceGuide);
+    return iris26961BOffWarmHighlightGuide(finalSdr,sourceRgb);
+}
+float srgbDecode(float x){x=clamp(x,0.0,1.0);return x<=0.04045?x/12.92:pow((x+0.055)/1.055,2.4);}
+vec3 srgbDecode(vec3 c){return vec3(srgbDecode(c.r),srgbDecode(c.g),srgbDecode(c.b));}
+
+
+vec3 iris26524BilinearHdr(vec2 sourcePixel){
+    ivec2 sz=textureSize(HdrBuffer,0);
+    vec2 hi=max(vec2(sz)-vec2(1.0),vec2(0.0));
+    vec2 q=clamp(sourcePixel,vec2(0.0),hi);
+    ivec2 p0=ivec2(floor(q));
+    ivec2 p1=min(p0+ivec2(1),sz-ivec2(1));
+    vec2 f=fract(q);
+    vec3 a=mix(texelFetch(HdrBuffer,ivec2(p0.x,p0.y),0).rgb,
+               texelFetch(HdrBuffer,ivec2(p1.x,p0.y),0).rgb,f.x);
+    vec3 b=mix(texelFetch(HdrBuffer,ivec2(p0.x,p1.y),0).rgb,
+               texelFetch(HdrBuffer,ivec2(p1.x,p1.y),0).rgb,f.x);
+    return mix(a,b,f.y);
+}
+/* IRIS_26550_GAINMAP_GENERAL_GEOMETRY
+ * Motion and Night may request detached lower-resolution gain maps. Map every gain pixel back to
+ * the corresponding full-resolution SDR/HDR pixel center instead of accidentally reading only a
+ * top-left fraction of the image. Motion adds 26641 linear-light matched pre-divide filtering.
+ */
+vec3 iris26550BilinearSdr(vec2 sourcePixel){
+    ivec2 sz=textureSize(SdrBuffer,0);
+    vec2 hi=max(vec2(sz)-vec2(1.0),vec2(0.0));
+    vec2 q=clamp(sourcePixel,vec2(0.0),hi);
+    ivec2 p0=ivec2(floor(q));
+    ivec2 p1=min(p0+ivec2(1),sz-ivec2(1));
+    vec2 f=fract(q);
+    vec3 a=mix(texelFetch(SdrBuffer,ivec2(p0.x,p0.y),0).rgb,
+               texelFetch(SdrBuffer,ivec2(p1.x,p0.y),0).rgb,f.x);
+    vec3 b=mix(texelFetch(SdrBuffer,ivec2(p0.x,p1.y),0).rgb,
+               texelFetch(SdrBuffer,ivec2(p1.x,p1.y),0).rgb,f.x);
+    return mix(a,b,f.y);
+}
+/* IRIS_26641_LINEAR_LIGHT_SDR_PREDIVIDE_DOWNSAMPLE
+ * Motion's half-resolution gain map averages decoded SDR radiance before dividing by the matched
+ * HDR intent. At an exact 2x reduction the bilinear center sample is a 2x2 linear-light box.
+ * Night deliberately keeps the pre-26641 encoded-bilinear/decode behavior. */
+vec3 iris26641BilinearSdrLinear(vec2 sourcePixel){
+    ivec2 sz=textureSize(SdrBuffer,0);
+    vec2 hi=max(vec2(sz)-vec2(1.0),vec2(0.0));
+    vec2 q=clamp(sourcePixel,vec2(0.0),hi);
+    ivec2 p0=ivec2(floor(q));
+    ivec2 p1=min(p0+ivec2(1),sz-ivec2(1));
+    vec2 f=fract(q);
+    vec3 a=mix(srgbDecode(texelFetch(SdrBuffer,ivec2(p0.x,p0.y),0).rgb),
+               srgbDecode(texelFetch(SdrBuffer,ivec2(p1.x,p0.y),0).rgb),f.x);
+    vec3 b=mix(srgbDecode(texelFetch(SdrBuffer,ivec2(p0.x,p1.y),0).rgb),
+               srgbDecode(texelFetch(SdrBuffer,ivec2(p1.x,p1.y),0).rgb),f.x);
+    return mix(a,b,f.y);
+}
+float iris26718HighZoomLogDetail(vec2 sourcePixel){
+    if(iris26718HighZoomDetailEnabled==0)return 0.0;
+    /* IRIS_26752_IPOL_PLAN_B_NONINTEGER_SAMPLE
+     * Preserve the paper's arbitrary continuous output lattice instead of snapping Plan B to
+     * the retired fixed true-2x direct-CFA lattice. */
+    vec2 local=sourcePixel*iris26752PlanBDetailScale-iris26752PlanBDetailOrigin;
+    ivec2 sz=textureSize(iris26718HighZoomDetail,0);
+    if(any(lessThan(local,vec2(0.0)))||any(greaterThan(local,vec2(sz)-vec2(1.0))))return 0.0;
+    /* IRIS_26834_UNIVERSAL_HIGH_ZOOM_VISIBLE_CROP_GUARD
+     * High-zoom detail is never trusted near its reconstruction boundary. The producer reserves
+     * a 32-texel target halo per side; keep the outer 16 texels at exact native Sabre/VGN and
+     * transition only from 16..24. Thus a visible 30x/120x crop cannot magnify edge uncertainty
+     * into barcode stripes. This rule is zoom-independent for every high-zoom detail route. */
+    vec2 edgeDistance=min(local,vec2(sz)-vec2(1.0)-local);
+    float minEdge=min(edgeDistance.x,edgeDistance.y);
+    if(minEdge<=16.0)return 0.0;
+    float trustedInterior=smoothstep(16.0,24.0,minEdge);
+    vec2 uv=(local+vec2(0.5))/vec2(sz);
+    return clamp(texture(iris26718HighZoomDetail,uv).r,-0.56,0.56)*trustedInterior;
+}
+
+void main(){
+    ivec2 p=ivec2(gl_FragCoord.xy);
+    if(any(greaterThanEqual(p,gainMapSize))){Output=0.0;return;}
+    float zoom=max(irisOutputZoom,1.0);
+    ivec2 sdrSize=textureSize(SdrBuffer,0);
+    vec2 sourcePixel=(vec2(p)+vec2(0.5))*vec2(sdrSize)/vec2(gainMapSize)-vec2(0.5);
+    vec2 masterSourcePixel=sourcePixel;
+    vec3 hdrRgb;
+    if(zoom<=1.00001){
+        hdrRgb=iris26524BilinearHdr(masterSourcePixel);
+    }else{
+        ivec2 hdrSize=textureSize(HdrBuffer,0);
+        vec2 center=(vec2(hdrSize)-vec2(1.0))*0.5;
+        masterSourcePixel=center+(sourcePixel-center)/zoom;
+        hdrRgb=iris26524BilinearHdr(masterSourcePixel);
+    }
+    if(iris26718HighZoomDetailEnabled!=0){
+        hdrRgb=max(hdrRgb*exp2(iris26718HighZoomLogDetail(masterSourcePixel)),vec3(0.0));
+    }
+    vec3 hdrPositive=max(hdrRgb,vec3(0.0));
+    float sdr=motionHdrHandoff!=0
+        ? max(luminance(iris26641BilinearSdrLinear(sourcePixel)),0.0)
+        : max(luminance(srgbDecode(iris26550BilinearSdr(sourcePixel))),0.0);
+    float safeMax=max(maxGainRatio,1.001);
+    float ratio;
+    if(motionHdrHandoff!=0){
+        /* IRIS_26641_TRUE_MATCHED_SDR_HDR_INTENT_QUOTIENT
+         * Both intents come from the same canonical extended-linear Motion master, same source
+         * sample, same 26623 global tone prerequisites, and the same Local-Laplacian structure.
+         * There is no luma eligibility threshold and no spatial gain dilation. The HDR intent
+         * departs from SDR only by the amount that the SDR rendition is actually compressing the
+         * shared linear-light target; weak body compression therefore collapses naturally to unity
+         * while broad real highlight compression participates coherently. */
+        float sourceY=max(luminance(hdrPositive),0.0);
+        float sourceGuide=max(sourceY,max3(hdrPositive));
+        if(sourceGuide<=1.0e-7 || sourceY<=1.0e-9){
+            ratio=1.0;
+        }else{
+            float globalSdrGuide=max(iris26653MapMotionSdrGuide(sourceGuide),0.0);
+            float sharedSdrGuide26658=max(iris26640SharedSdrGuide(sourceGuide,masterSourcePixel),0.0);
+            float sharedSdrGuide=max(iris26660SharedSdrGuide(sourceGuide,masterSourcePixel,hdrPositive),0.0);
+            /* IRIS_26660_UHDR_POP_TARGET_FROZEN_TO_26658
+             * Preserve the exact 26658 HDR target/local-structure scale. Only the SDR denominator
+             * uses the smooth object-color gamma, so the decoded HDR brightness target stays 26658. */
+            float localStructureScale=globalSdrGuide>1.0e-7
+                ? sharedSdrGuide26658/globalSdrGuide : 1.0;
+            float requested=max(displayGain,1.0e-6)*hdrExposureScale;
+            float sdrModelY=sourceY*(sharedSdrGuide/sourceGuide);
+            float linearTargetY=sourceY*requested*max(localStructureScale,0.0);
+            /* IRIS_26641_TRUE_MATCHED_INTENT_DELTA
+             * The HDR rendition differs from the completed SDR rendition by the full luminance
+             * that the matched SDR model compressed away. 26640 multiplied this delta by the
+             * compression fraction a second time, effectively squaring moderate compression and
+             * under-restoring scenes such as the plant shelf. Keep the actual completed SDR as
+             * the spatial/color base and restore the full matched-intent delta exactly once. */
+            float matchedIntentDelta=max(linearTargetY-sdrModelY,0.0);
+            /* IRIS_26954_V2_26940_UHDR_REBASE
+             * Keep the actual successful 26940 UHDR mathematical principle:
+             * restore matched HDR intent delta to the ACTUAL completed SDR
+             * luminance, now including 26954 V2 fixed-EV shoulder. The gain
+             * map denominator remains the real SDR texture, and bright areas
+             * still pop by the old 26940 matched-intent difference. Avoid
+             * the rejected 26954 V1 sdrModelY+delta absolute-target override.
+             * Nothing in this branch changes the B-ON/native HDR numerator.
+             */
+            float hdrIntentY=sdr+matchedIntentDelta;
+            ratio=clamp((hdrIntentY+UHDR_OFFSET)/(sdr+UHDR_OFFSET),1.0,safeMax);
+            if(iris26954BOffNight26940Sdr==0 && iris26941BOffHdrqLowZoom!=0){
+                // Bright scene information only. The SDR primary carries the
+                // body and shadow appearance; avoid broad body gain-map lift.
+                float brightIntent=sourceY*requested*max(localStructureScale,0.0);
+                float hdrHighlightGate=smoothstep(0.68,0.96,brightIntent);
+                ratio=1.0+(ratio-1.0)*hdrHighlightGate;
+            }
+        }
+    }else{
+        float hdrTargetScale=hdrExposureScale;
+        float hdr=max(luminance(hdrPositive*hdrTargetScale),0.0);
+        ratio=clamp((hdr+UHDR_OFFSET)/(sdr+UHDR_OFFSET),1.0,safeMax);
+    }
+    Output=clamp(log2(ratio)/max(log2(safeMax),1.0e-6),0.0,1.0);
+}
