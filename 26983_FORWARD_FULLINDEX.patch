+        ByteBuffer mapped = lockCpuNative(buffer, width, height);
+        if (mapped == null || mapped.capacity() != expectedBytes()) return null;
+        mapped.order(ByteOrder.nativeOrder());
+        mapped.position(0);
+        mapped.limit(mapped.capacity());
+        cpuLocked = true;
+        return mapped;
+    }
