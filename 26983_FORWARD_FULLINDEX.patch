+    mappedGuide=iris26704BodyToneGuide(mappedGuide);
+    if(iris26961BOffNeutralIndoor==0) mappedGuide=iris26660ObjectColorGamma(mappedGuide);
+    mappedGuide=iris26770MidtonePresentationTrim(mappedGuide);
+    mappedGuide=iris26892SdrAdaptiveGuide(mappedGuide);
+    if(iris26906BVisualToneEnabled!=0) mappedGuide=iris26906BVisualTone(mappedGuide);
