+        return ok;
+    }
+
+    /** Lazily recreates the exact 26825 CPU carrier only if the consumer-side GPU import fails. */
+    public ByteBuffer copyTo26825FallbackBuffer() {
+        ByteBuffer mapped = lockCpu();
