+        val linearRawFile = File.createTempFile("iris26562-sabre-linear-raw-", ".rgb16", directory)
+        val maximumBandHeight = minOf(SABRE_SUPER_RES_LINEAR_RAW_BAND_HEIGHT, superResHeight)
+        val bandTexture = createTexture(
+            superResWidth,
+            maximumBandHeight,
