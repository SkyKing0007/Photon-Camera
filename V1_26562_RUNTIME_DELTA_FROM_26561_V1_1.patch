+            vec2 packed1 = lumaAndSupportAt(blockOrigin + ivec2(1, 0));
+            vec2 packed2 = lumaAndSupportAt(blockOrigin + ivec2(0, 1));
+            vec2 packed3 = lumaAndSupportAt(blockOrigin + ivec2(1, 1));
