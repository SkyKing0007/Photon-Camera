+            return texelFetch(uAccumulatedDetail, clamp(p, ivec2(0), uOutputSize - ivec2(1)), 0).rg;
+        }
+
+        float resolvedLuma(vec2 packedValue) {
+            return packedValue.x / max(packedValue.y, 1.0e-6);
+        }
+
