--- a/app/src/main/java/com/hinnka/mycamera/processor/GlesMgcRawSpatialStacker.kt
+++ b/app/src/main/java/com/hinnka/mycamera/processor/GlesMgcRawSpatialStacker.kt
@@ -691,6 +691,8 @@ internal class GlesMgcRawSpatialStacker(
     private var iris26856B2xPackProgram = 0
     private var iris26856BLongLumaProgram = 0
     private var iris26857ApplyAmazeWbProgram = 0
+    // Never alias the native post-AMaZE shader with legacy B WB program cache.
