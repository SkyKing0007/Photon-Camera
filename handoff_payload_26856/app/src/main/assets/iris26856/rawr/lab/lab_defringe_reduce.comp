#version 310 es
precision highp float;
precision highp int;
#include "lab_defringe_common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 3) buffer Stats { float mean; float blocks[]; } stats;
shared float sums[256];
void main() {
    uint i = gl_LocalInvocationIndex, n = ((pc.width + 15u) / 16u) * ((pc.height + 15u) / 16u);
    float s = 0.;
    for (uint j = i; j < n; j += 256u) s += stats.blocks[j];
    sums[i] = s;
    barrier();
    for (uint k = 128u; k > 0u; k >>= 1u) {
        if (i < k) sums[i] += sums[i + k];
        barrier();
    }
    if (i == 0u) stats.mean = sums[0] / float(pc.width * pc.height);
}
