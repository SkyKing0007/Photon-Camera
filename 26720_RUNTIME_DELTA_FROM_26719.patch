+    private fun reconstructHighZoomRgb26720(
+        frames: List<RawStackFrame>,
+        images: List<SafeImage>,
+        evidence: List<True2xFrameEvidence>,
+        nativeVgnGuideTexture: Int,
+    ): HighZoomRgbResult {
+        require(enableHighZoomDetail && !enableSabreSuperRes)
+        val directory=checkNotNull(sabreSuperResTempDir); require(directory.exists()||directory.mkdirs())
+        val fullWidth=Math.multiplyExact(width,2); val fullHeight=Math.multiplyExact(height,2)
+        fun roundUp4(value:Int):Int=(value+3) and -4
+        val outputWidth=roundUp4((kotlin.math.ceil(fullWidth/highZoomSourceZoom.toDouble()).toInt()+4).coerceAtMost(fullWidth)).coerceAtLeast(4).coerceAtMost(fullWidth)
+        val outputHeight=roundUp4((kotlin.math.ceil(fullHeight/highZoomSourceZoom.toDouble()).toInt()+4).coerceAtMost(fullHeight)).coerceAtLeast(4).coerceAtMost(fullHeight)
+        val originX=(fullWidth-outputWidth)/2; val originY=(fullHeight-outputHeight)/2
+        require((originX and 1)==0 && (originY and 1)==0)
+        val output=File(directory,"iris26720_high_zoom_rgb_${System.nanoTime()}.rgb16f")
+        val start=System.nanoTime()
+        return try {
+            val stats=runHighZoomRgbGpu26720(frames,images,evidence,output,nativeVgnGuideTexture,outputWidth,outputHeight,originX,originY,fullWidth,fullHeight)
+            require(output.length()==outputWidth.toLong()*outputHeight*TRUE2X_RGB16F_BYTES_PER_PIXEL)
+            val refined=evidence.filter{it.frameIndex!=0}
+            val refinePct=if(refined.isEmpty())0f else refined.map{it.refineAcceptedPct}.average().toFloat()
+            HighZoomRgbResult(output.absolutePath,outputWidth,outputHeight,originX,originY,fullWidth,fullHeight,highZoomSourceZoom,stats.activePct,stats.fullColorPct,stats.phase.mean,stats.phase.p10,refinePct,evidence.size,elapsedMs(start))
+        } catch(error:Throwable) { runCatching{output.delete()}; throw error }
+    }
