+    /** IRIS_26700_SPEKTRA_MOTION_WATERMARK_PARITY
+     * Apply the same final-raster Iris watermark contract used by Motion to an already-oriented
+     * ARGB_8888 raster. This reuses Motion's exact adaptive five-point luma decision, 0.55
+     * threshold, Iris dark/white assets, 11.5% width, 2.5% inset, lower-right placement, and
+     * filtered alpha compositing. It does not alter exposure, color rendering, or JPEG settings.
+     */
+    public static boolean applyFinalRasterWatermark(Bitmap bitmap) {
+        if (bitmap == null || bitmap.isRecycled() || bitmap.getConfig() != Bitmap.Config.ARGB_8888
+                || !bitmap.isMutable() || bitmap.getWidth() <= 0 || bitmap.getHeight() <= 0) {
+            return false;
+        }
+        Bitmap watermark = null;
+        try {
+            final boolean useDark = useDarkWatermarkForBackground(bitmap);
+            watermark = loadTrue2xWatermark(useDark);
+            if (watermark == null || watermark.isRecycled()
+                    || watermark.getWidth() <= 0 || watermark.getHeight() <= 0) {
+                return false;
+            }
+            final float width = bitmap.getWidth();
+            final float height = bitmap.getHeight();
+            final float wmWidth = width * 0.115f;
+            final float wmHeight = wmWidth * ((float) watermark.getHeight() / (float) watermark.getWidth());
+            final float margin = Math.max(2.0f, Math.min(width, height) * 0.025f);
+            final float left = width - margin - wmWidth;
+            final float top = height - margin - wmHeight;
+            final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG);
+            paint.setAlpha(255);
+            new Canvas(bitmap).drawBitmap(watermark, null,
+                    new RectF(left, top, left + wmWidth, top + wmHeight), paint);
+            Log.i(TAG, "IRIS_26700_FINAL_RASTER_WATERMARK_PARITY variant="
+                    + (useDark ? "DARK_ON_BRIGHT" : "WHITE_ON_DARK")
+                    + " size=" + bitmap.getWidth() + "x" + bitmap.getHeight()
+                    + " widthFrac=0.115 marginFrac=0.025 threshold=0.55");
+            return true;
+        } catch (Throwable t) {
+            Log.e(TAG, "IRIS_26700_FINAL_RASTER_WATERMARK_FAILED", t);
+            return false;
+        } finally {
+            if (watermark != null && !watermark.isRecycled()) watermark.recycle();
+        }
+    }
+
