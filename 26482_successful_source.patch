+            double mean2 = sum2 / 9.0;
+            double var1 = Math.max(
+                    sq1 / 9.0 - mean1 * mean1, 0.0);
+            double var2 = Math.max(
+                    sq2 / 9.0 - mean2 * mean2, 0.0);
