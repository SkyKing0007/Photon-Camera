+precision highp float;
+precision highp sampler2D;
+uniform sampler2D InputBuffer;
+uniform float exposure;
+out vec4 Output;
+
+/* IRIS_26616_WRONSKI_EXACT_EXPOSURE_FUSION
+ * Bart Wronski 2022 WebGL demo math, main.js SHA 07417fe..., Three.js r138 ACES.
+ * Branch packing is exactly: highlights(-2 EV), midtones(0 EV), shadows(+1.5 EV).
+ * This shader computes the demo's first actually consumed fusion level (mip 2) directly from
+ * 4x4 source blocks. For ordinary dimensions divisible by four this is mathematically identical
+ * to two successive 2:1 linear-filter copies, while avoiding unused full/half-resolution LTM RTs.
+ */
+vec3 RRTAndODTFit(vec3 v){
+    vec3 a=v*(v+0.0245786)-0.000090537;
+    vec3 b=v*(0.983729*v+0.4329510)+0.238081;
+    return a/b;
+}
+vec3 ACESFilmicToneMapping(vec3 color){
+    const mat3 ACESInputMat=mat3(
+        vec3(0.59719,0.07600,0.02840),
+        vec3(0.35458,0.90834,0.13383),
+        vec3(0.04823,0.01566,0.83777));
+    const mat3 ACESOutputMat=mat3(
+        vec3(1.60475,-0.10208,-0.00327),
+        vec3(-0.53108,1.10813,-0.07276),
+        vec3(-0.07367,-0.00605,1.07602));
+    color*=1.0/0.6;
+    color=ACESInputMat*color;
+    color=RRTAndODTFit(color);
+    color=ACESOutputMat*color;
+    return clamp(color,vec3(0.0),vec3(1.0));
+}
+vec3 irisP3ToLinearSrgb(vec3 c){
+    return vec3(1.22494018*c.r-0.22494018*c.g,
+                -0.04205695*c.r+1.04205695*c.g,
+                -0.01963755*c.r-0.07863605*c.g+1.09827360*c.b);
+}
