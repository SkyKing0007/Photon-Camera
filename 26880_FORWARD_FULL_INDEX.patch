+                         (tw + kLocal - 1u) / kLocal, (th + kLocal - 1u) / kLocal);
+            }
+            if (tileBoundary_ && !(ty + tile >= height && tx + tile >= width)) tileBoundary_();
+        }
+    }
+    if (timingPool) vkCmdWriteTimestamp(command, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, timingPool,
+                                        11);
