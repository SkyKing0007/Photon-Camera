+                    uint32_t tileE, innerW, innerH, halo;
+                    uint32_t mult;
+                    float inv;
+                    uint32_t mode, scaleIdx, groupsX;
+                } pa{extent, tw, th, halo, mult, 1.0f / sb2, 0u, (uint32_t)scale, groupsX};
