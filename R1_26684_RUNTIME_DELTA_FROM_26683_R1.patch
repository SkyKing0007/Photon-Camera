+            * static_cast<double>(sourceSize) / static_cast<double>(outputSize) - 0.5;
+    int sourceCoordinate = static_cast<int>(std::floor(sourcePosition + 0.5));
+    sourceCoordinate = std::max(0, std::min(sourceSize - 1, sourceCoordinate));
