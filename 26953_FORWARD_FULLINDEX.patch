+    float globalEv=clamp(0.40*log2(max(requested,1.0)),0.0,0.72);
+    float exposure=exp2(globalEv);
+    float lifted=prior*exposure/(1.0+(exposure-1.0)*prior);
+    float whiteReturn=smoothstep(0.85,1.0,prior);
+    return mix(lifted,prior,whiteReturn);
