+            if(!Iris26972CGainmap.encodeIntermediateJpeg(gain,width,height,gainJpeg))
+                return false
+            if(!Iris26972CUltraHdr.publish(base,gainJpeg,plan.output,
+                    Iris26972CGainmap.jpegRMetadata())) return false
