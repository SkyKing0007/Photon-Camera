+            uniform1i(program,name,i)
+        }
+        uniforms()
+        GLES30.glViewport(0,0,width,height)
+        GLES30.glDrawArrays(GLES30.GL_TRIANGLES,0,3)
+        gpu.checkGl("donor ResolveSabre pass draw")
+    }
