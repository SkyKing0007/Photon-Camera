+                    }
+                }
+                meanResidual /= count;
+            }
+            vec2 target = vec2(0.0);
+            for (int y = 0; y < 64; ++y) {
+                if (y >= uTileSize) break;
+                for (int x = 0; x < 64; ++x) {
+                    if (x >= uTileSize) break;
