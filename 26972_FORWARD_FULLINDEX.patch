+# IRIS_26972_C_PINNED_DONOR_NATIVE_PROVENANCE
+# Both binaries are C-only, and the matching OpenMP runtime must not be silently
+# replaced with A/B's older libomp.so: bjzhou 1.29.0 requires a dispatch-deinit
