+        }
+
+        float kernelWeight(vec2 pixelOffset, vec3 covariance) {
+            float kernelDistance =
+                pixelOffset.x * pixelOffset.x * covariance.x +
+                pixelOffset.y * pixelOffset.y * covariance.y +
+                pixelOffset.x * pixelOffset.y * covariance.z * 2.0;
