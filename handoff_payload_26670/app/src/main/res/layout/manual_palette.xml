<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/manual_mode"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- IRIS_26670_EXACT_VALUE_MANUAL_SLIDER_ONLY
         The legacy circular KnobView is intentionally absent. This app-owned slider is the only
         manual touch/presentation surface for Focus, Shutter, ISO and Exposure Compensation. -->
    <FrameLayout
        android:id="@+id/irisManualSliderContainer"
        android:layout_width="match_parent"
        android:layout_height="66dp">


        <com.particlesdevs.photoncamera.ui.camera.views.IrisManualSliderView
            android:id="@+id/iris_manual_slider"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:background="@android:color/transparent"
            android:contentDescription="Manual parameter slider" />
    </FrameLayout>

    <!-- Existing IDs and click-listener ownership are preserved. Text is intentionally invisible:
         the exact selected numeric value now lives in the yellow slider readout. -->
    <LinearLayout
        android:id="@+id/buttons_container"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/irisManualSliderContainer"
        android:background="@android:color/transparent"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/focus_option_tv"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableTop="@drawable/manual_control_icon_focus"
            android:drawableTint="@color/manual_text_color"
            android:includeFontPadding="false"
            android:textColor="@android:color/transparent"
            android:textSize="0sp"
            tools:text="" />

        <TextView
            android:id="@+id/exposure_option_tv"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableTop="@drawable/manual_control_icon_exposure"
            android:drawableTint="@color/manual_text_color"
            android:includeFontPadding="false"
            android:textColor="@android:color/transparent"
            android:textSize="0sp"
            tools:text="" />

        <TextView
            android:id="@+id/iso_option_tv"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableTop="@drawable/manual_control_icon_iso"
            android:drawableTint="@color/manual_text_color"
            android:includeFontPadding="false"
            android:textColor="@android:color/transparent"
            android:textSize="0sp"
            tools:text="" />

        <TextView
            android:id="@+id/ev_option_tv"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableTop="@drawable/ic_exposure"
            android:drawableTint="@color/manual_text_color"
            android:includeFontPadding="false"
            android:textColor="@android:color/transparent"
            android:textSize="0sp"
            tools:text="" />
    </LinearLayout>
</RelativeLayout>
