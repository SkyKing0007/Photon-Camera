-    const auto& level0 = geometry_.align.levels.front();
-    VkMemoryBarrier toTransfer{VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr, VK_ACCESS_SHADER_WRITE_BIT,
-                               VK_ACCESS_TRANSFER_READ_BIT};
