-    // Align-once keeps every frame in the pass-0 padding; passOffset() maps.
-    const std::uint32_t prepared = config_.frequencyAlignOnce ? 0u : pass;
-    align_.setPads(geometry_.padLeft(prepared), geometry_.padTop(prepared));
