+    if (cfaPattern == 1) return q == 1 ? 0 : (q == 2 ? 2 : 1);
+    if (cfaPattern == 2) return q == 2 ? 0 : (q == 1 ? 2 : 1);
+    return q == 3 ? 0 : (q == 0 ? 2 : 1);
