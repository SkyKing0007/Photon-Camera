-    }
-    float rationalSlopeAtWhite=bodyGain/((1.0+ratio)*(1.0+ratio));
-    float bodySlopeAtWhite=0.5*(whiteAnchor+rationalSlopeAtWhite);
-    float reserve=max(1.0-whiteAnchor,0.0);
