+    private data class ShortBoundaryGeometry26600(
+        val texture: Int,
+        val gridWidth: Int,
+        val gridHeight: Int,
+        val passes: Int,
+        val seedGeometryCells: Int,
+        val seedBoundaryCells: Int,
+        val finalGeometryCells: Int,
+        val finalBoundaryCells: Int,
+    )
