+    /* IRIS_26971_HIGH_ZOOM_INDEPENDENT_TILE_RECONSTRUCTION_CONTRACT
+     * Read the two independent GPU reconstructions, verify their detail values and
+     * zero-DC block intent, and write only the verified optional scalar correction.
+     * The original native Sabre/VGN RGB carrier is never modified.
+     */
+    private fun reconcileHighZoomDetail26971(
+        primaryFile: File, shiftedFile: File, detailWidth: Int, detailHeight: Int,
+    ): Iris26971HighZoomDetailIntegrity.Result {
+        val pixels = Math.multiplyExact(detailWidth, detailHeight)
+        val bytes = Math.multiplyExact(pixels, Short.SIZE_BYTES)
+        require(primaryFile.length() == bytes.toLong() && shiftedFile.length() == bytes.toLong())
+        fun readValues(file: File): FloatArray {
+            val data = file.readBytes()
+            require(data.size == bytes)
+            val halves = ByteBuffer.wrap(data).order(ByteOrder.nativeOrder()).asShortBuffer()
+            return FloatArray(pixels) { i -> Half.toFloat(halves.get(i)) }
+        }
+        val original = readValues(primaryFile)
+        val result = Iris26971HighZoomDetailIntegrity.reconcile(
+            original, readValues(shiftedFile), detailWidth, detailHeight,
+        )
+        if (result.affectedPixels > 0) {
+            val data = ByteBuffer.allocate(bytes).order(ByteOrder.nativeOrder())
+            val halves = data.asShortBuffer()
+            for (i in 0 until pixels) halves.put(i, Half.toHalf(result.detail[i]))
+            FileOutputStream(primaryFile, false).use { out -> out.write(data.array()) }
+            require(primaryFile.length() == bytes.toLong())
+        }
+        return result
+    }
