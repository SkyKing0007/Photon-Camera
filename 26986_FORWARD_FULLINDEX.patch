+    private fun true2xFlowRefineAcceptance(
+        flowData: ByteBuffer,
+        flow: SabreConvertedAlignment,
+    ): Triple<Int, Int, Float> {
+        val spec = checkNotNull(textureSpecs[flow.texture])
+        val values = flowData.duplicate().order(ByteOrder.nativeOrder()).asShortBuffer()
+        val pixels = spec.width * spec.height
+        var accepted = 0
+        for (index in 0 until pixels) {
+            val confidence = Half.toFloat(values.get(index * 4 + 3))
+            if (confidence.isFinite() && confidence > 0.5f) accepted++
+        }
+        val pct = if (pixels > 0) 100f * accepted.toFloat() / pixels.toFloat() else 0f
+        return Triple(accepted, pixels, pct)
+    }
+
+    /* IRIS_26723_HIGH_ZOOM_SUBPIXEL_DIVERSITY
+     * Readback already exists for refinement persistence. Reuse it diagnostically to prove whether
+     * accepted high-zoom flow actually spans diverse quarter-pixel phase cells; no new GPU readback
+     * and no weighting decision is introduced here.
+     */
+    private fun highZoomSubpixelDiversity26723(
+        flowData: ByteBuffer,
+        flow: SabreConvertedAlignment,
+    ): String {
+        val spec = checkNotNull(textureSpecs[flow.texture])
+        val values = flowData.duplicate().order(ByteOrder.nativeOrder()).asShortBuffer()
+        val bins = IntArray(16)
+        var accepted = 0
+        for (index in 0 until spec.width * spec.height) {
+            val confidence = Half.toFloat(values.get(index * 4 + 3))
+            if (!confidence.isFinite() || confidence <= 0.5f) continue
+            val rawX = Half.toFloat(values.get(index * 4)) * width.toFloat()
+            val rawY = Half.toFloat(values.get(index * 4 + 1)) * height.toFloat()
+            if (!rawX.isFinite() || !rawY.isFinite()) continue
+            val fracX = (rawX - kotlin.math.floor(rawX.toDouble()).toFloat()).coerceIn(0f, 0.999999f)
+            val fracY = (rawY - kotlin.math.floor(rawY.toDouble()).toFloat()).coerceIn(0f, 0.999999f)
+            val bx = (fracX * 4f).toInt().coerceIn(0, 3)
+            val by = (fracY * 4f).toInt().coerceIn(0, 3)
+            bins[by * 4 + bx]++
+            accepted++
+        }
+        val occupied = bins.count { it > 0 }
+        val dominant = bins.maxOrNull() ?: 0
+        val dominantPct = if (accepted > 0) 100f * dominant.toFloat() / accepted.toFloat() else 0f
+        return "accepted=$accepted occupied4x4=$occupied dominantPct=$dominantPct bins4x4=${bins.joinToString(",")}"
+    }
