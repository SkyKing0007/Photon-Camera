+    private fun solveShortAffine3x326625(matrixIn: Array<DoubleArray>): DoubleArray? {
+        val matrix = Array(3) { row -> matrixIn[row].copyOf() }
+        for (column in 0 until 3) {
+            var pivot = column
+            var pivotAbs = kotlin.math.abs(matrix[column][column])
+            for (row in column + 1 until 3) {
+                val candidate = kotlin.math.abs(matrix[row][column])
+                if (candidate > pivotAbs) { pivot = row; pivotAbs = candidate }
+            }
+            if (!pivotAbs.isFinite() || pivotAbs < 1.0e-9) return null
+            if (pivot != column) {
+                val tmp = matrix[pivot]; matrix[pivot] = matrix[column]; matrix[column] = tmp
+            }
+            val scale = matrix[column][column]
+            for (k in column until 4) matrix[column][k] /= scale
+            for (row in 0 until 3) {
+                if (row == column) continue
+                val factor = matrix[row][column]
+                for (k in column until 4) matrix[row][k] -= factor * matrix[column][k]
+            }
+        }
+        return doubleArrayOf(matrix[0][3], matrix[1][3], matrix[2][3])
+    }
+
+    private fun fitShortAffine26625(
+        samples: List<ShortFlowSample26625>,
+        selectX: Boolean,
+    ): DoubleArray? {
+        if (samples.size < 3) return null
+        var sx = 0.0; var sy = 0.0; var sxx = 0.0; var sxy = 0.0; var syy = 0.0
+        var sb = 0.0; var sxb = 0.0; var syb = 0.0
+        for (sample in samples) {
+            val b = if (selectX) sample.flowX else sample.flowY
+            sx += sample.x; sy += sample.y
+            sxx += sample.x * sample.x; sxy += sample.x * sample.y; syy += sample.y * sample.y
+            sb += b; sxb += sample.x * b; syb += sample.y * b
+        }
+        return solveShortAffine3x326625(arrayOf(
+            doubleArrayOf(samples.size.toDouble(), sx, sy, sb),
+            doubleArrayOf(sx, sxx, sxy, sxb),
+            doubleArrayOf(sy, sxy, syy, syb),
+        ))
+    }
+
+    private fun fitShortAffineTriplet26625(
+        a: ShortFlowSample26625,
+        b: ShortFlowSample26625,
+        c: ShortFlowSample26625,
+    ): Pair<DoubleArray, DoubleArray>? {
+        val basis = arrayOf(
+            doubleArrayOf(1.0, a.x, a.y),
+            doubleArrayOf(1.0, b.x, b.y),
+            doubleArrayOf(1.0, c.x, c.y),
+        )
+        fun solve(values: DoubleArray): DoubleArray? = solveShortAffine3x326625(arrayOf(
+            doubleArrayOf(basis[0][0], basis[0][1], basis[0][2], values[0]),
+            doubleArrayOf(basis[1][0], basis[1][1], basis[1][2], values[1]),
+            doubleArrayOf(basis[2][0], basis[2][1], basis[2][2], values[2]),
+        ))
+        val x = solve(doubleArrayOf(a.flowX, b.flowX, c.flowX)) ?: return null
+        val y = solve(doubleArrayOf(a.flowY, b.flowY, c.flowY)) ?: return null
+        return x to y
+    }
+
+    private fun shortAffineResidual26625(
+        sample: ShortFlowSample26625,
+        x: DoubleArray,
+        y: DoubleArray,
+    ): Double {
+        val dx = (x[0] + x[1] * sample.x + x[2] * sample.y) - sample.flowX
+        val dy = (y[0] + y[1] * sample.x + y[2] * sample.y) - sample.flowY
+        return kotlin.math.sqrt(dx * dx + dy * dy)
+    }
+
+    private fun buildShortFallbackAffine26625(
+        candidates: List<ShortFlowSample26625>,
+        core: List<ShortFlowSample26625>,
+    ): ShortFallbackAffine26625 {
+        if (core.size < 12 || candidates.size < 12) {
+            return ShortFallbackAffine26625.invalid(candidates.size, core.size)
+        }
+        val ransac = if (core.size <= 24) core else List(24) { i ->
+            core[(i.toLong() * (core.size - 1).toLong() / 23L).toInt()]
+        }
+        var bestX: DoubleArray? = null
+        var bestY: DoubleArray? = null
+        var bestCount = -1
+        var bestError = Double.POSITIVE_INFINITY
+        val inlierLimit = 0.75
+        for (i in 0 until ransac.size - 2) {
+            for (j in i + 1 until ransac.size - 1) {
+                for (k in j + 1 until ransac.size) {
+                    val model = fitShortAffineTriplet26625(ransac[i], ransac[j], ransac[k]) ?: continue
+                    var count = 0
+                    var error = 0.0
+                    for (sample in candidates) {
+                        val residual = shortAffineResidual26625(sample, model.first, model.second)
+                        if (residual <= inlierLimit) { count++; error += residual }
+                    }
+                    if (count > bestCount || (count == bestCount && error < bestError)) {
+                        bestCount = count; bestError = error; bestX = model.first; bestY = model.second
+                    }
+                }
+            }
+        }
+        val initialX = bestX ?: return ShortFallbackAffine26625.invalid(candidates.size, core.size)
+        val initialY = bestY ?: return ShortFallbackAffine26625.invalid(candidates.size, core.size)
+        var inliers = candidates.filter { shortAffineResidual26625(it, initialX, initialY) <= inlierLimit }
+        val minimumInliers = max(12, kotlin.math.ceil(candidates.size * 0.30).toInt())
+        if (inliers.size < minimumInliers) {
+            return ShortFallbackAffine26625.invalid(candidates.size, core.size)
+        }
+        val refinedX = fitShortAffine26625(inliers, true)
+            ?: return ShortFallbackAffine26625.invalid(candidates.size, core.size)
+        val refinedY = fitShortAffine26625(inliers, false)
+            ?: return ShortFallbackAffine26625.invalid(candidates.size, core.size)
+        inliers = candidates.filter { shortAffineResidual26625(it, refinedX, refinedY) <= inlierLimit }
+        if (inliers.size < minimumInliers) {
+            return ShortFallbackAffine26625.invalid(candidates.size, core.size)
+        }
+        val finalX = fitShortAffine26625(inliers, true)
+            ?: return ShortFallbackAffine26625.invalid(candidates.size, core.size)
+        val finalY = fitShortAffine26625(inliers, false)
+            ?: return ShortFallbackAffine26625.invalid(candidates.size, core.size)
+        val residuals = inliers.map { shortAffineResidual26625(it, finalX, finalY) }.sorted()
+        fun percentile(fraction: Double): Float {
+            val index = ((residuals.size - 1) * fraction).toInt().coerceIn(0, residuals.size - 1)
+            return residuals[index].toFloat()
+        }
+        val minX = inliers.minOf { it.x }; val maxX = inliers.maxOf { it.x }
+        val minY = inliers.minOf { it.y }; val maxY = inliers.maxOf { it.y }
+        val coverageX = (maxX - minX).toFloat()
+        val coverageY = (maxY - minY).toFloat()
+        val fraction = inliers.size.toFloat() / candidates.size.toFloat()
+        val p50 = percentile(0.50); val p90 = percentile(0.90)
+        val valid = coverageX >= 0.30f && coverageY >= 0.30f && fraction >= 0.30f && p90 <= 0.75f &&
+            finalX.all { it.isFinite() } && finalY.all { it.isFinite() }
+        if (!valid) return ShortFallbackAffine26625(
+            false, FloatArray(3), FloatArray(3), candidates.size, core.size, inliers.size, fraction,
+            coverageX, coverageY, p50, p90,
+        )
+        return ShortFallbackAffine26625(
+            true,
+            floatArrayOf(finalX[0].toFloat(), finalX[1].toFloat(), finalX[2].toFloat()),
+            floatArrayOf(finalY[0].toFloat(), finalY[1].toFloat(), finalY[2].toFloat()),
+            candidates.size, core.size, inliers.size, fraction, coverageX, coverageY, p50, p90,
+        )
+    }
+
+    private fun analyzeSabreShortFallbackAffine26625(
+        flow: SabreConvertedAlignment,
+        frameIndex: Int,
+    ): ShortFallbackAffine26625 {
+        val spec = checkNotNull(textureSpecs[flow.texture]) {
+            "26625 SHORT flow texture is not owned"
+        }
+        val bytes = Math.multiplyExact(Math.multiplyExact(spec.width, spec.height), 8)
+        val readback = ByteBuffer.allocateDirect(bytes).order(ByteOrder.nativeOrder())
+        bindRenderTargets(intArrayOf(flow.texture), "26625 SHORT affine/fallback telemetry")
+        GLES30.glBindBuffer(GLES30.GL_PIXEL_PACK_BUFFER, 0)
+        GLES30.glPixelStorei(GLES30.GL_PACK_ALIGNMENT, 1)
+        GLES30.glReadPixels(
+            0, 0, spec.width, spec.height,
+            GLES30.GL_RGBA, GLES30.GL_HALF_FLOAT, readback,
+        )
+        GLES30.glBindFramebuffer(GLES30.GL_FRAMEBUFFER, 0)
+        checkGlError("26625 SHORT affine/fallback telemetry")
+        val half = readback.asShortBuffer()
+        val residualValues = ArrayList<Float>(spec.width * spec.height)
+        val candidates = ArrayList<ShortFlowSample26625>()
+        val core = ArrayList<ShortFlowSample26625>()
+        var ge050 = 0; var ge100 = 0; var ge200 = 0
+        for (index in 0 until spec.width * spec.height) {
+            val flowX = Half.toFloat(half.get(index * 4)) * width
+            val flowY = Half.toFloat(half.get(index * 4 + 1)) * height
+            val residual = max(0f, Half.toFloat(half.get(index * 4 + 3)))
+            if (!flowX.isFinite() || !flowY.isFinite() || !residual.isFinite()) continue
+            residualValues += residual
+            if (residual >= 0.50f) ge050++
+            if (residual >= 1.00f) ge100++
+            if (residual >= 2.00f) ge200++
+            if (residual <= 0.95f) {
+                val gx = index % spec.width
+                val gy = index / spec.width
+                val flowUvX = (gx + 0.5) / spec.width.toDouble()
+                val flowUvY = (gy + 0.5) / spec.height.toDouble()
+                val scaleX = kotlin.math.abs(flow.scaleX.toDouble()).coerceAtLeast(1.0e-7)
+                val scaleY = kotlin.math.abs(flow.scaleY.toDouble()).coerceAtLeast(1.0e-7)
+                val referenceX = ((flowUvX - flow.offsetX.toDouble()) / scaleX).coerceIn(0.0, 1.0)
+                val referenceY = ((flowUvY - flow.offsetY.toDouble()) / scaleY).coerceIn(0.0, 1.0)
+                val sample = ShortFlowSample26625(
+                    referenceX, referenceY,
+                    flowX.toDouble(), flowY.toDouble(), residual.toDouble(),
+                )
+                candidates += sample
+                if (residual <= 0.50f) core += sample
+            }
+        }
+        residualValues.sort()
+        fun residualPercentile(fraction: Float): Float {
+            if (residualValues.isEmpty()) return Float.NaN
+            val i = ((residualValues.size - 1) * fraction).toInt().coerceIn(0, residualValues.size - 1)
+            return residualValues[i]
+        }
+        val affine = buildShortFallbackAffine26625(candidates, core)
+        val residualDetails =
+            "frame=$frameIndex component=flow.w semantic=LOCAL_AFFINE_RESIDUAL domain=RAW_PIXELS " +
+                "samples=${residualValues.size} grid=${spec.width}x${spec.height} " +
+                "p50=${residualPercentile(0.50f)} p95=${residualPercentile(0.95f)} " +
+                "p99=${residualPercentile(0.99f)} max=${residualValues.lastOrNull() ?: Float.NaN} " +
+                "ge0p50=$ge050 ge1p00=$ge100 ge2p00=$ge200 " +
+                "thresholdsRawPixels=0.50,1.00,2.00 activeConfidenceConsumer=SHORT_RESCUE_ONLY"
+        PLog.i(SABRE_TAG, "IRIS_26606_SHORT_AFFINE_RESIDUAL_STATS $residualDetails")
+        MotionTrace.processingState("IRIS_26606_SHORT_AFFINE_RESIDUAL_STATS", residualDetails)
+        val fallbackDetails =
+            "frame=$frameIndex valid=${affine.valid} strictCells=${affine.strictCells} " +
+                "coreCells=${affine.coreCells} inlierCells=${affine.inlierCells} " +
+                "inlierFraction=${affine.inlierFraction} coverageX=${affine.coverageX} " +
+                "coverageY=${affine.coverageY} modelP50RawPx=${affine.p50Residual} " +
+                "modelP90RawPx=${affine.p90Residual} inlierLimitRawPx=0.75 " +
+                "sourceResidualLimitRawPx=0.95 boundaryRadiometryStillRequired=true " +
+                "geometryAloneCannotAuthorize=true"
+        PLog.i(SABRE_TAG, "IRIS_26625_SHORT_FALLBACK_AFFINE $fallbackDetails")
+        MotionTrace.processingState("IRIS_26625_SHORT_FALLBACK_AFFINE", fallbackDetails)
+        return affine
+    }
