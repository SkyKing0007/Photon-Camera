+        MgcSpatialRgbTilePlanner.DEFAULT_OUTPUT_TILE_SIZE,
+        768,
+        512,
+        384,
+        256,
+        192,
+        128,
+        64,
+        32,
+    ).filter { it in 1..outputHeight }
+        .distinct()
+        .sortedDescending()
+        .toIntArray()
