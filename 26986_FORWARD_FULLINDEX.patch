+    /** Exact bucket mapping used by MGC's Sabre accumulated R8 mask uniform. */
+    private fun maxSabreAccumulatedWeight(frameCount: Int): Float = when {
+        frameCount < 2 -> 1f
+        frameCount < 4 -> 3f
+        frameCount < 6 -> 5f
+        frameCount < 16 -> 15f
+        frameCount < 18 -> 17f
+        frameCount < 52 -> 51f
+        frameCount < 86 -> 85f
+        else -> 255f
