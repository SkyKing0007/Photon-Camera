+    private fun runEdgeFalseColorSuppressor26778(
+        sourceAndFinal: Int,
+        temporary: Int,
+        sabreWeightR: Int,
+        sabreWeightsGb: Int,
+        sabreValidWeights: Int,
+        sabreValidityWeightScale: Float,
+    ): IntArray {
+        check(edgeFalseColorSuppressor26778Program != 0) { "26778 edge false-color program unavailable" }
+        val ids = IntArray(1)
+        GLES31.glGenBuffers(1, ids, 0)
+        val statsBuffer = ids[0]
+        check(statsBuffer != 0) { "26778 edge false-color stats buffer allocation failed" }
+        buffers += statsBuffer
+        var mapped = false
+        try {
+            val zero = ByteBuffer.allocateDirect(Int.SIZE_BYTES * 5).order(ByteOrder.nativeOrder()).apply {
+                repeat(5) { putInt(0) }; rewind()
+            }
+            GLES31.glBindBuffer(GLES31.GL_SHADER_STORAGE_BUFFER, statsBuffer)
+            GLES31.glBufferData(GLES31.GL_SHADER_STORAGE_BUFFER, Int.SIZE_BYTES * 5, zero, GLES31.GL_STREAM_READ)
+            GLES31.glBindBufferBase(GLES31.GL_SHADER_STORAGE_BUFFER, 0, statsBuffer)
+            fun dispatch26778(source: Int, destination: Int, statsPass: Int) {
+                check(source != destination) { "26778 ping-pong source/destination alias" }
+                GLES31.glUseProgram(edgeFalseColorSuppressor26778Program)
+                bindTexture(edgeFalseColorSuppressor26778Program, "uSrc", 0, source)
+                bindTexture(edgeFalseColorSuppressor26778Program, "uSabreWeightR", 2, sabreWeightR)
+                bindTexture(edgeFalseColorSuppressor26778Program, "uSabreWeightsGb", 3, sabreWeightsGb)
+                bindTexture(edgeFalseColorSuppressor26778Program, "uSabreValidWeights", 4, sabreValidWeights)
+                uniform1f(edgeFalseColorSuppressor26778Program, "uSabreValidityWeightScale", sabreValidityWeightScale.coerceAtLeast(1f))
+                GLES31.glBindImageTexture(1, destination, 0, false, 0, GLES31.GL_WRITE_ONLY, GLES30.GL_RGBA16F)
+                uniform1f(edgeFalseColorSuppressor26778Program, "uNoiseFloor", edgeFalseColor26778.noiseFloor)
+                uniform1f(edgeFalseColorSuppressor26778Program, "uContrastLo", edgeFalseColor26778.contrastLo)
+                uniform1f(edgeFalseColorSuppressor26778Program, "uContrastHi", edgeFalseColor26778.contrastHi)
+                uniform1f(edgeFalseColorSuppressor26778Program, "uOutlierLo", edgeFalseColor26778.outlierLo)
+                uniform1f(edgeFalseColorSuppressor26778Program, "uOutlierHi", edgeFalseColor26778.outlierHi)
+                uniform1i(edgeFalseColorSuppressor26778Program, "uStatsPass", statsPass)
+                GLES31.glDispatchCompute(GlesComputeWorkGroup.imageGroupCount(width), GlesComputeWorkGroup.imageGroupCount(height), 1)
+                GlesGpuScheduler.memoryBarrier()
+            }
+            dispatch26778(sourceAndFinal, temporary, statsPass = 1)
+            dispatch26778(temporary, sourceAndFinal, statsPass = 2)
+            GLES31.glBindImageTexture(1, 0, 0, false, 0, GLES31.GL_WRITE_ONLY, GLES30.GL_RGBA16F)
+            for (unit in 4 downTo 2) {
+                GLES30.glActiveTexture(GLES30.GL_TEXTURE0 + unit)
+                GLES30.glBindTexture(GLES30.GL_TEXTURE_2D, 0)
+            }
+            GLES30.glActiveTexture(GLES30.GL_TEXTURE0)
+            GLES30.glBindTexture(GLES30.GL_TEXTURE_2D, 0)
+            GLES31.glUseProgram(0)
+            checkGlError("26778 edge false-color two-pass submit")
+            GlesGpuCompletion.awaitSubmittedWork(label = "26778 edge false-color two-pass", checkGlError = ::checkGlError)
+            GLES31.glBindBuffer(GLES31.GL_SHADER_STORAGE_BUFFER, statsBuffer)
+            val bb = GLES31.glMapBufferRange(GLES31.GL_SHADER_STORAGE_BUFFER, 0, Int.SIZE_BYTES * 5, GLES31.GL_MAP_READ_BIT) as? ByteBuffer
+                ?: error("Unable to map 26778/26782 edge false-color stats")
+            mapped = true
+            val native = bb.order(ByteOrder.nativeOrder())
+            val gate = native.getInt(0)
+            val blendPass1 = native.getInt(Int.SIZE_BYTES)
+            val blendPass2 = native.getInt(Int.SIZE_BYTES * 2)
+            val coherent = native.getInt(Int.SIZE_BYTES * 3)
+            val clippedNeutral = native.getInt(Int.SIZE_BYTES * 4)
+            check(GLES31.glUnmapBuffer(GLES31.GL_SHADER_STORAGE_BUFFER)) { "26778/26782 edge false-color stats buffer invalid" }
+            mapped = false
+            GLES31.glBindBuffer(GLES31.GL_SHADER_STORAGE_BUFFER, 0)
+            val pixels = Math.multiplyExact(width, height)
+            check(
+                gate in 0..pixels && blendPass1 in 0..pixels && blendPass2 in 0..pixels &&
+                    coherent in 0..pixels && clippedNeutral in 0..pixels
+            ) { "26778/26782 edge false-color stats out of range gate=$gate blendPass1=$blendPass1 blendPass2=$blendPass2 coherent=$coherent clippedNeutral=$clippedNeutral pixels=$pixels" }
+            return intArrayOf(gate, blendPass1, blendPass2, coherent, clippedNeutral)
+        } finally {
+            if (mapped) {
+                GLES31.glBindBuffer(GLES31.GL_SHADER_STORAGE_BUFFER, statsBuffer)
+                GLES31.glUnmapBuffer(GLES31.GL_SHADER_STORAGE_BUFFER)
+            }
+            GLES31.glBindBufferBase(GLES31.GL_SHADER_STORAGE_BUFFER, 0, 0)
+            GLES31.glBindBuffer(GLES31.GL_SHADER_STORAGE_BUFFER, 0)
+            if (buffers.remove(statsBuffer)) GLES31.glDeleteBuffers(1, intArrayOf(statsBuffer), 0)
+        }
+    }
