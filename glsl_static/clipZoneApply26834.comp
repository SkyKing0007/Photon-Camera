#version 310 es
precision highp float;
precision highp int;
layout(local_size_x=8,local_size_y=8) in;
uniform sampler2D uRgb;
uniform sampler2D uMask;
uniform sampler2D uSmall;
uniform sampler2D uBigQuarter;
uniform ivec2 uSize;
uniform ivec2 uQuarterSize;
uniform float uYFloor;
uniform float uAThreshold;
uniform vec3 uCalculationWb;
layout(rgba16f,binding=0) writeonly uniform highp image2D uOut;
layout(std430,binding=0) buffer Stats26836 { uint zone; uint changed; uint sampled; uint sumDeltaMilli; uint maxDeltaMilli; uint maxCoord; } stats;
vec2 safeFill(vec4 v){ return v.b>1.0e-3 ? v.rg/v.b : vec2(0.0); }
void main(){
    ivec2 p=ivec2(gl_GlobalInvocationID.xy); if(any(greaterThanEqual(p,uSize))) return;
    float m=texelFetch(uMask,p,0).r;
    /* Exact no-op path: uOut was bit-copied from uRgb before dispatch. */
    if(m<=0.0) return;
    vec4 src=texelFetch(uRgb,p,0); vec3 rgb=src.rgb*uCalculationWb;
    float y=(rgb.r+2.0*rgb.g+rgb.b)*0.25; float yc=max(y,uYFloor);
    vec2 c=vec2(rgb.r-rgb.g,rgb.b-rgb.g)/yc;
    vec4 sm=texelFetch(uSmall,p,0);
    vec2 uv=(vec2(p)+vec2(0.5))/vec2(uSize);
    vec4 bg=texture(uBigQuarter,uv);
    float a=clamp(sm.b/max(uAThreshold,1.0e-4),0.0,1.0);
    vec2 fill=mix(safeFill(bg),safeFill(sm),a);
    vec2 cp=mix(c,fill,m);
    float dR=cp.x*yc, dB=cp.y*yc;
    float g=y-0.25*(dR+dB); vec3 wbDst=vec3(g+dR,g,g+dB);
    vec3 cameraDst=wbDst/max(uCalculationWb,vec3(1.0e-6));
    imageStore(uOut,p,vec4(cameraDst,src.a));
    float delta=0.5*(abs(cp.x-c.x)+abs(cp.y-c.y));
    if(m>0.3) atomicAdd(stats.zone,1u);
    if(delta>1.0e-7) atomicAdd(stats.changed,1u);
    uint dm=uint(clamp(delta*1000.0,0.0,4294967.0));
    if(((p.x&3)==0)&&((p.y&3)==0)){ atomicAdd(stats.sampled,1u); atomicAdd(stats.sumDeltaMilli,dm); }
    uint old=atomicMax(stats.maxDeltaMilli,dm); if(dm>old) stats.maxCoord=uint(p.y)*uint(uSize.x)+uint(p.x);
}
