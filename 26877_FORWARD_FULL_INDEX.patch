+    /* IRIS_26877_SPEKTRA_INDEPENDENT_VIEWPORT_BOUNDS
+     * The dedicated Unspektrawesome Vulkan SurfaceView must have the same
+     * camera-reference geometry as Photo. Constraining it to GLPreview's
+     * WRAP_CONTENT layout made the image 3/4-sized in both axes. Keep the
+     * actual RAW/Vulkan processing, quality and native renderer untouched.
+     * Use the available viewfinder container and its 4:3 camera aspect,
+     * changing only this surface's screen bounds. This also supports landscape.
+     */
+    private void updateSpektraViewportBounds26877() {
+        if (spektraSurfaceView == null || !(spektraSurfaceView.getParent() instanceof ViewGroup)) return;
+        ViewGroup parent = (ViewGroup) spektraSurfaceView.getParent();
+        final int availableW = parent.getWidth();
+        final int availableH = parent.getHeight();
+        if (availableW <= 0 || availableH <= 0) return;
+        boolean landscape = getResources().getConfiguration().orientation ==
+                android.content.res.Configuration.ORIENTATION_LANDSCAPE;
+        final int targetW;
+        final int targetH;
+        if (landscape) {
+            targetH = (int) Math.min((long) availableH, (long) availableW * 3L / 4L);
+            targetW = (int) ((long) targetH * 4L / 3L);
+        } else {
+            targetW = (int) Math.min((long) availableW, (long) availableH * 3L / 4L);
+            targetH = (int) ((long) targetW * 4L / 3L);
+        }
+        if (targetW <= 0 || targetH <= 0) return;
+        ConstraintLayout.LayoutParams lp = (ConstraintLayout.LayoutParams)
+                spektraSurfaceView.getLayoutParams();
+        if (lp.width == targetW && lp.height == targetH) return;
+        lp.width = targetW;
+        lp.height = targetH;
+        spektraSurfaceView.setLayoutParams(lp);
+        Log.i(TAG, "IRIS_26877_SPEKTRA_VIEWPORT " +
+                "parent=" + availableW + "x" + availableH +
+                " surface=" + targetW + "x" + targetH +
+                " orientation=" + (landscape ? "landscape" : "portrait") +
+                " cpuOrGpuProcessingUnchanged=true");
+    }
