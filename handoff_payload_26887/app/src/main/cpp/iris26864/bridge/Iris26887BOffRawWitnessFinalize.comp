#version 450
// DEVELOPMENT ONLY. Runs after ALL distinct NORMAL witness accumulation
// dispatches and their compute-write/read barriers have completed.
// The same R32UI image changes from accumulation ABI to read-only RGB10A2
// color-witness ABI. Zero means abstain. Marker 3 requires independently
// verified TWO physical RAW observations of EACH of R, G and B.
layout(local_size_x=16,local_size_y=16) in;
layout(set=0,binding=0,r32ui) uniform uimage2D witness;
layout(push_constant) uniform P {uvec2 size;} p;
void main(){
    ivec2 q=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(q,ivec2(p.size))))return;
    uint state=imageLoad(witness,q).r;
    uint seen=(state>>24u)&7u,repeated=(state>>27u)&7u;
    uint done=((state&(1u<<30u))==0u && seen==7u && repeated==7u)?3u:0u;
    uint result=0u;
    if(done==3u){
        for(uint c=0u;c<3u;++c){
            uint v=(state>>(c*8u))&255u;
            uint ten=(v*1023u+127u)/255u;
            result|=(ten&1023u)<<(c*10u);
        }
        result|=3u<<30u;
    }
    imageStore(witness,q,uvec4(result,0u,0u,0u));
}
