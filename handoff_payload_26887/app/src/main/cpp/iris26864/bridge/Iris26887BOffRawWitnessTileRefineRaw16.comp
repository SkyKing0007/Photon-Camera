#version 450
// DEVELOPMENT ONLY; B-SR-OFF sensor RAW16 local registration (not full S-R).
// The CPU's sparse whole-frame RAW registration supplies ONLY a coarse seed.
// This GPU search independently checks that same-scene ORIGINAL physical RAW
// green structure has a unique local shift, including odd CFA site offsets.
// Green estimates are used ONLY to authorize geometric alignment, never as
// fabricated true-color evidence. Frame-chroma agreement is checked later.
layout(local_size_x=16,local_size_y=16) in;
layout(set=0,binding=0,r16ui) readonly uniform uimage2D rawReference;
layout(set=0,binding=1,r16ui) readonly uniform uimage2D rawCompanion;
layout(set=0,binding=2,rgba32i) writeonly uniform iimage2D shiftsOut;
layout(push_constant) uniform P {
    uvec4 extent;         // rawW, rawH, shiftTileSize, local CFA pattern
    ivec4 initial;        // coarse integer sensor shiftX/shiftY, others reserved
    vec4 referenceBlack;
    vec4 companionBlack;
    vec4 values;         // referenceWhite, companionWhite, refExposure, cmpExposure
} p;
const int codes[16]=int[16](0,1,1,2,1,0,2,1,1,2,0,1,2,1,1,0);
int channel(ivec2 q){return codes[int(p.extent.w)*4+(q.x&1)+2*(q.y&1)];}
float measured(ivec2 q,bool reference){
    if(any(lessThan(q,ivec2(0)))||any(greaterThanEqual(q,ivec2(p.extent.xy))))return -1.0;
    int phase=(q.x&1)+2*(q.y&1);
    vec4 black=reference?p.referenceBlack:p.companionBlack;
    float white=reference?p.values.x:p.values.y;
    float raw=float(reference?imageLoad(rawReference,q).r:imageLoad(rawCompanion,q).r);
    // Registration evidence must also reject near-saturated ORIGINAL sites,
    // not merely values that become smaller after exposure normalization.
    float native=(raw-black[phase])/max(white-black[phase],1.0);
    if(isnan(native)||isinf(native)||native<=0.025||native>=0.95)return -1.0;
    return reference?native:native*(p.values.z/max(p.values.w,1.0e-9));
}
float greenGuide(ivec2 q,bool reference){
    if(any(lessThan(q,ivec2(0)))||any(greaterThanEqual(q,ivec2(p.extent.xy))))return -1.0;
    if(channel(q)==1)return measured(q,reference);
    const ivec2 d[4]=ivec2[4](ivec2(-1,0),ivec2(1,0),ivec2(0,-1),ivec2(0,1));
    float sum=0.0;int count=0;
    for(int k=0;k<4;++k){
        ivec2 t=q+d[k];
        if(any(lessThan(t,ivec2(0)))||any(greaterThanEqual(t,ivec2(p.extent.xy))))continue;
        if(channel(t)!=1)continue;
        float v=measured(t,reference);
        if(v<.025||v>.95)return -1.0;
        sum+=v;++count;
    }
    return count>=2?sum/float(count):-1.0;
}
void main(){
    ivec2 tile=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(tile,imageSize(shiftsOut))))return;
    imageStore(shiftsOut,tile,ivec4(0));
    if(p.extent.x<32u||p.extent.y<32u||p.extent.z!=32u||p.extent.w>3u||
       any(notEqual(imageSize(rawReference),ivec2(p.extent.xy)))||
       any(notEqual(imageSize(rawCompanion),ivec2(p.extent.xy)))||
       p.values.x<=1.0||p.values.y<=1.0||p.values.z<=0.0||p.values.w<=0.0||
       abs(p.values.z-p.values.w)/p.values.z>.025)return;
    ivec2 center=tile*int(p.extent.z)+ivec2(int(p.extent.z)/2);
    if(any(greaterThanEqual(center,ivec2(p.extent.xy))))return;
    float best=1e30,second=1e30,variation=0.0;
    ivec2 chosen=ivec2(0);
    // Retain the 3x3 local cost surface. Integer RAW-site registration
    // cannot certify per-pixel COLOR at an appreciably fractional shift:
    // separate Bayer sites then observe different physical scene positions.
    float neighborhood[9];
    for(int i=0;i<9;++i)neighborhood[i]=1e30;
    for(int dy=-1;dy<=1;++dy)for(int dx=-1;dx<=1;++dx){
        ivec2 offset=p.initial.xy+ivec2(dx,dy);
        int count=0;float total=0.0,totalSquare=0.0,error=0.0;
        for(int sy=-4;sy<=4;sy+=2)for(int sx=-4;sx<=4;sx+=2){
            ivec2 pRef=center+ivec2(sx,sy);
            float a=greenGuide(pRef,true),b=greenGuide(pRef+offset,false);
            if(a<.025||a>.95||b<.025||b>.95)continue;
            float residual=a-b;
            error+=min(residual*residual,.0064);
            total+=a;totalSquare+=a*a;++count;
        }
        if(count<18)continue;
        float score=error/float(count);
        neighborhood[(dy+1)*3+(dx+1)]=score;
        float variance=max(0.0,totalSquare/float(count)-pow(total/float(count),2.0));
        // Every actually measured candidate competes, even if that candidate
        // has weak texture. Filtering weak candidates BEFORE choosing the
        // winner can manufacture a "unique" match at the wrong RAW offset.
        // Check the winner's independent texture confidence ONLY below.
        if(score<best){second=best;best=score;chosen=offset;variation=variance;}
        else second=min(second,score);
    }
    // A unique winner is meaningful only when the competing fits are real.
    // An unmeasured neighbor keeps the 1e30 sentinel, which previously made
    // second-best arbitrarily large and could certify an unverified RAW shift.
    // Require a complete finite 3x3 cost surface; insufficient evidence
    // MUST abstain rather than authorize physical R/G/B color votes.
    for(int i=0;i<9;++i){
        if(isnan(neighborhood[i])||isinf(neighborhood[i])||
           neighborhood[i]>=1e20)return;
    }
    // The coarse CPU seed must be within the one-site refinement window.
    // Reject boundary minima, where a complete symmetric subpixel fit is
    // unavailable: no invented fractional color registration is permitted.
    ivec2 delta=chosen-p.initial.xy;
    if(any(notEqual(delta,ivec2(0))))return;
    float left=neighborhood[3],right=neighborhood[5];
    float up=neighborhood[1],down=neighborhood[7];
    float cx=left+right-2.0*best,cy=up+down-2.0*best;
    if(cx<=1e-8||cy<=1e-8)return;
    float fx=0.5*(left-right)/cx,fy=0.5*(up-down)/cy;
    // Strict physical-site confidence, not a subpixel-interpolated RGB vote.
    // Mid-phase shifts are useful for SR but UNSAFE for the packed color
    // witness until a full fractional sensor integration model exists.
    if(abs(fx)>0.15||abs(fy)>0.15)return;
    if(best<.00015&&second-best>.00006&&variation>=.00004)
        imageStore(shiftsOut,tile,ivec4(chosen,1,0));
}
