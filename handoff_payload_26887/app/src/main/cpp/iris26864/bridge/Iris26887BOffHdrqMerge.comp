#version 450
// Port of hdr-plus-swift merge_frequency_domain: per tile,
// pick the best of 7x7 sub-pixel Fourier shifts of the aligned tile, then
// merge each frequency bin with a Wiener-shrinkage weight (Hasinoff 2016,
// Liba 2019 motion norm, Delbracio 2015 magnitude norm). One 8x8 workgroup
// per tile, then every lane merges its own bin.
// Shift search: upstream minimizes sum_k |ref_k - e^{i theta}·al_k|^2 over
// channels. Rotation preserves |al_k|, so this equals a shift-independent
// constant minus 2 * sum_k (cos·A_k + sin·B_k) with per-bin cross terms
// A_k = sum_ch(refRe·alRe + refIm·alIm), B_k = sum_ch(refIm·alRe - refRe·alIm):
// the same argmin from 2 floats per bin instead of 16 (shared-memory bound on
// mobile GPUs); first maximum wins like upstream's first minimum.
// Bracketed bursts (Rawr): instead of upstream's equal-weight mean of
// (1-w)*aligned + w*ref, each frame adds frameWeight*(1-w)*aligned and its
// weight to a per-bin sum seeded with the reference at weight 1
// (hdrq_normalize divides). frameWeight is the exposure factor, the inverse
// shot-noise variance of a frame scaled to the reference exposure, so the
// brighter frames carry the shadows and rejected bins add nothing.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba32f) readonly uniform image2D refFt;
layout(set = 0, binding = 1, rgba32f) readonly uniform image2D alignedFt;
layout(set = 0, binding = 2, rgba32f) uniform image2D outFt;
layout(set = 0, binding = 3, rgba32f) readonly uniform image2D rms;
layout(set = 0, binding = 4, r32f) readonly uniform image2D mismatch;
// (cos, sin) per shift and bin, index shift * 64 + n * 8 + m (hdrq_shift_table).
layout(std430, set = 0, binding = 5) readonly buffer ShiftTable { vec2 v[]; } shiftTable;
// Per-tile clipped-highlights factor (hdrq_highlights_norm; 1 when uniform).
layout(set = 0, binding = 6, r32f) readonly uniform image2D highlights;
// Per-bin weight sum (bracketed only), one texel per bin at (t*8 + (dm, dn)).
layout(set = 0, binding = 7, r32f) uniform image2D weightSum;
layout(push_constant) uniform P {
    ivec2 tiles;
    float robustnessNorm;
    float readNoise;
    float maxMotionNorm;
    int uniformExposure;
    float frameWeight;
} p;

shared vec4 sRefRe[64], sRefIm[64], sAlRe[64], sAlIm[64];  // index dn*8 + dm
shared float sDiff[49];
shared float sA[64], sB[64];
shared int sBest;

void main() {
    ivec2 t = ivec2(gl_WorkGroupID.xy);
    if (any(greaterThanEqual(t, p.tiles))) return;
    int dm = int(gl_LocalInvocationID.x), dn = int(gl_LocalInvocationID.y);
    int lane = dn * 8 + dm;
    const int ts = 8;
    ivec2 t0 = t * ts;
    ivec2 o = ivec2(2 * (t0.x + dm), t0.y + dn);
    sRefRe[lane] = imageLoad(refFt, o);
    sRefIm[lane] = imageLoad(refFt, o + ivec2(1, 0));
    sAlRe[lane] = imageLoad(alignedFt, o);
    sAlIm[lane] = imageLoad(alignedFt, o + ivec2(1, 0));
    {
        vec4 a = sRefRe[lane] * sAlRe[lane] + sRefIm[lane] * sAlIm[lane];
        vec4 b = sRefIm[lane] * sAlRe[lane] - sRefRe[lane] * sAlIm[lane];
        sA[lane] = a.x + a.y + a.z + a.w;
        sB[lane] = b.x + b.y + b.z + b.w;
    }
    barrier();
    if (lane < 49) {
        float total = 0.0;
        for (int k = 0; k < 64; ++k) {
            vec2 cs = shiftTable.v[lane * 64 + k];
            total += cs.x * sA[k] + cs.y * sB[k];
        }
        sDiff[lane] = total;
    }
    barrier();
    if (lane == 0) {
        float best = -1e30;
        int bi = 0;
        for (int i = 0; i < 49; ++i)
            if (sDiff[i] > best) {
                best = sDiff[i];
                bi = i;
            }
        sBest = bi;
    }
    barrier();
    float mm = imageLoad(mismatch, t).x;
    // IRIS_26887_B_OFF_MOTION_LOCAL: original RAWR vendor is unchanged.
    // This modified shader is only compiled into Iris's B-only mirrored build.
    // Uniform exposures: retain the configured 13 strength in static tiles,
    // transition to strength-8-equivalent for noise-inconsistent tiles.
    // Bracketed-exposure path remains byte/mathematically unchanged below.
    float localMotion = p.uniformExposure != 0 ? smoothstep(0.10, 0.38, mm) : 0.0;
    const float strength8Robustness = 0.29730178;
    const float strength8ReadNoise = 2.29739671;
    const float strength8MaxMotion = 1.58270825;
    float adaptiveRobustness = mix(p.robustnessNorm,
          min(p.robustnessNorm, strength8Robustness), localMotion);
    float adaptiveReadNoise = mix(p.readNoise,
          min(p.readNoise, strength8ReadNoise), localMotion);
    float adaptiveMaxMotion = mix(p.maxMotionNorm,
          min(p.maxMotionNorm, strength8MaxMotion), localMotion);
    vec4 noiseNorm = (imageLoad(rms, t) + adaptiveReadNoise) * float(ts * ts) * adaptiveRobustness;
    float mismatchWeight = clamp(1.0 - 10.0 * (mm - 0.2), 0.0, 1.0);
    float motionNorm = clamp(adaptiveMaxMotion - (mm - 0.02) *
          (adaptiveMaxMotion - 1.0) / 0.15, 1.0, adaptiveMaxMotion);
    vec2 cs = shiftTable.v[sBest * 64 + lane];
    float c = cs.x, s = cs.y;
    vec4 refRe = sRefRe[lane], refIm = sRefIm[lane];
    vec4 alRe = c * sAlRe[lane] - s * sAlIm[lane];
    vec4 alIm = s * sAlRe[lane] + c * sAlIm[lane];
    float magnitudeNorm = 1.0;
    // Magnitude norm only for uniform exposure (brighter frames have larger magnitudes).
    if (dm + dn > 0 && mm < 0.3 && p.uniformExposure != 0) {
        vec4 refMag = sqrt(refRe * refRe + refIm * refIm);
        vec4 alMag = sqrt(alRe * alRe + alIm * alIm);
        float refEnergy = refMag.x + refMag.y + refMag.z + refMag.w;
        // A completely dark/empty reference frequency tile cannot define an
        // aligned/reference magnitude ratio. Never divide by zero and feed
        // NaN to Wiener weights; retain the neutral magnitude prior instead.
        if (refEnergy > 1.0e-12) {
            float ratio = (alMag.x + alMag.y + alMag.z + alMag.w) / refEnergy;
            magnitudeNorm = mismatchWeight * clamp(ratio * ratio * ratio * ratio, 0.5, 3.0);
        }
    }
    vec4 w4 = (refRe - alRe) * (refRe - alRe) + (refIm - alIm) * (refIm - alIm);
    w4 = w4 / (w4 + magnitudeNorm * motionNorm * noiseNorm * imageLoad(highlights, t).x);
    float lo = min(w4.x, min(w4.y, min(w4.z, w4.w))), hi = max(w4.x, max(w4.y, max(w4.z, w4.w)));
    // Mean of the two central channel weights (upstream's robust variant of Liba's max).
    float weight = clamp(0.5 * (w4.x + w4.y + w4.z + w4.w - lo - hi), 0.0, 1.0);
    if (p.uniformExposure != 0) {
        // Do not omit a rejected companion from the fixed-count uniform
        // denominator: substitute reference frequencies to preserve energy.
        float reject = smoothstep(0.24, 0.60, mm);
        weight = mix(weight, 1.0, reject);
        imageStore(outFt, o, imageLoad(outFt, o) + (1.0 - weight) * alRe + weight * refRe);
        imageStore(outFt, o + ivec2(1, 0), imageLoad(outFt, o + ivec2(1, 0)) + (1.0 - weight) * alIm + weight * refIm);
    } else {
        float w = p.frameWeight * (1.0 - weight);
        ivec2 bin = t0 + ivec2(dm, dn);
        imageStore(outFt, o, imageLoad(outFt, o) + w * alRe);
        imageStore(outFt, o + ivec2(1, 0), imageLoad(outFt, o + ivec2(1, 0)) + w * alIm);
        imageStore(weightSum, bin, imageLoad(weightSum, bin) + w);
    }
}
