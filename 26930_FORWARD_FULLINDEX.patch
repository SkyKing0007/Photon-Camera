+    vec3 revised=(center+correction*adjustment+vec3(restoreY))/p.wb.rgb;
+    if(!finite3(revised)||any(lessThan(revised,vec3(-0.00001))))revised=denoised;
+    imageStore(irisRgb,q,vec4(max(revised,vec3(0.0)),confidence));
 }
