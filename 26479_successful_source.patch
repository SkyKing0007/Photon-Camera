+                            + " xNormB=" + bx / (float)Math.max(1, width - 1)
+                            + " yNormB=" + by / (float)Math.max(1, height - 1)
+                            + " directA="
+                            + directA[0] + "," + directA[1] + "," + directA[2]
+                            + " directB="
