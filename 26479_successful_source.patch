+    private static int iris26478GridCenterToPixel(
+            int cell,
+            int gridExtent,
+            int imageExtent) {
+        return Math.max(
+                0,
+                Math.min(
+                        imageExtent - 1,
+                        Math.round(
+                                (cell + 0.5f)
+                                        * imageExtent
+                                        / gridExtent
+                                        - 0.5f)));
+    }
