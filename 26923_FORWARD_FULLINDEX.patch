+// IRIS_26923_B_SR_ON_BURST_ONLY_LOW_INFORMATION_ESTIMATOR.
+// The strict 24-bin fit cannot describe a nearly-flat/underexposed RAW scene.
+// Retain empirical RAW-pair noise rather than the configured Camera2 profile.
+// The extra floor is numerical stability, NOT a replacement noise source.
+std::optional<BurstNoiseFit> iris26923MeasuredMoments(const float* data, std::uint32_t blocks) {
+    if (!data || blocks == 0u) return std::nullopt;
+    BurstNoiseFit out{};
+    for (std::uint32_t site = 0u; site < 4u; ++site) {
+        struct Point { double level, variance; };
+        std::vector<Point> points;
+        points.reserve(blocks);
+        for (std::uint32_t i = 0u; i < blocks; ++i) {
+            const float* s = data + std::size_t(i) * kNoiseBlockFloats + 4u * site;
+            const double n = s[0];
+            if (!(std::isfinite(n) && n >= 2.0)) continue;
+            const double level = s[1] / n;
+            const double dv = (double(s[3]) - double(s[2]) * double(s[2]) / n) / (n - 1.0);
+            if (!std::isfinite(level) || !std::isfinite(dv) || level < 0.0) continue;
+            points.push_back({level, std::max(dv * 0.5, 0.0)});
+        }
+        if (points.empty()) return std::nullopt; // no valid RAW evidence: clean failure
+        if (site == 0u) out.usableBlocks = std::uint32_t(points.size());
+        std::sort(points.begin(), points.end(), [](const Point& a, const Point& b){ return a.level < b.level; });
+        auto lowerMoment = [&](std::size_t lo, std::size_t hi) {
+            std::vector<double> v;
+            v.reserve(hi - lo);
+            for (std::size_t i = lo; i < hi; ++i) v.push_back(points[i].variance);
+            const std::size_t k = v.size() / 5u;
+            std::nth_element(v.begin(), v.begin() + k, v.end());
+            return v[k];
+        };
+        const std::size_t half = std::max<std::size_t>(1u, points.size() / 2u);
+        const double lo = lowerMoment(0u, half);
+        const double hi = lowerMoment(std::min(half, points.size()-1u), points.size());
+        const double x0 = points[half / 2u].level;
+        const double x1 = points[std::min(points.size()-1u, half + (points.size() - half) / 2u)].level;
