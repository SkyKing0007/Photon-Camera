+extern "C" JNIEXPORT jboolean JNICALL
+Java_com_particlesdevs_photoncamera_processing_processor_MotionV2SharedRgba16fCarrier_writeFinal1xGuideNative(
+    JNIEnv* env, jclass, jobject hardwareBuffer, jobject rgbaBuffer,
+    jobject maskBuffer, jint width, jint height) {
+    AHardwareBuffer* buffer=nullptr;
