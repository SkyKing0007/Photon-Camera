+/* IRIS_26900_B_FROZEN_OFF_BICUBIC_LUMA_RESAMPLE
+ * The baseline fused RGB/chroma owner is unchanged. At actual output enlargement,
+ * reconstruct the luminance with a separable Catmull-Rom (a=-0.5) bicubic kernel;
+ * preserve the bilinear color direction with a single nonnegative RGB scalar.
+ * Clamp bicubic Y to the original four center sample extrema: no invented color,
+ * no negative luma, and no cubic overshoot beyond the supplied RAW RGB values.
+ * This shader branch is enabled ONLY by shutter-frozen B + Super Res OFF.
+ */
+uniform int iris26900BOffBicubic;
+vec4 iris26900CubicWeights(float t) {
+    float t2=t*t;
+    float t3=t2*t;
+    return vec4(-0.5*t+t2-0.5*t3,
+                1.0-2.5*t2+1.5*t3,
+                0.5*t+2.0*t2-1.5*t3,
+                -0.5*t2+0.5*t3);
+}
+vec3 iris26900BicubicLumaPreserveChroma(vec2 sourcePixel) {
+    ivec2 size=textureSize(InputBuffer,0);
+    vec2 p=clamp(sourcePixel,vec2(0.0),vec2(size-ivec2(1)));
+    ivec2 origin=ivec2(floor(p));
+    vec2 t=fract(p);
+    vec4 wx=iris26900CubicWeights(t.x);
+    vec4 wy=iris26900CubicWeights(t.y);
+    float cubicY=0.0;
+    float localMin=1.0e20;
+    float localMax=-1.0e20;
+    for(int iy=0;iy<4;iy++) {
+        int sy=clamp(origin.y+iy-1,0,size.y-1);
+        for(int ix=0;ix<4;ix++) {
+            int sx=clamp(origin.x+ix-1,0,size.x-1);
+            vec3 rgb=max(texelFetch(InputBuffer,ivec2(sx,sy),0).rgb,vec3(0.0));
+            float y=luminance(rgb);
+            cubicY+=wx[ix]*wy[iy]*y;
+            if(ix>=1 && ix<=2 && iy>=1 && iy<=2) {
+                localMin=min(localMin,y);
+                localMax=max(localMax,y);
+            }
+        }
+    }
+    vec3 bilinear=max(iris26524BilinearInput(p),vec3(0.0));
+    float baseY=max(luminance(bilinear),0.0);
+    if(baseY<=1.0e-7)return bilinear;
+    float targetY=clamp(cubicY,localMin,localMax);
+    return bilinear*(max(targetY,0.0)/baseY);
+}
