+bool SpektraRawVulkanOwner::warmUp(std::string* error) {
+    // A healthy owner has already passed a real dispatch self-test, so rapid re-entry never waits
+    // behind a saved job just to prove the Vulkan objects still exist.
+    if (impl_->initialized.load(std::memory_order_acquire)
+            && !impl_->poisoned.load(std::memory_order_acquire)) return true;
+    std::unique_lock<std::mutex> lock(impl_->workMutex, std::defer_lock);
+    if (!lock.try_lock()) {
+        if (impl_->initialized.load(std::memory_order_acquire)
+                && !impl_->poisoned.load(std::memory_order_acquire)) return true;
+        if (error) *error = "Spektra RAW owner warm-up already in progress";
+        return false;
+    }
+    if (!impl_->recoverTimedOutFence(error)) return false;
+    SPEKTRA_RAW_LOGI("IRIS_26687_RAW_VK_STAGE stage=warmup_begin");
+    if (!impl_->initialize(error)) return false;
+
+    // Execute the exact production shader/descriptor/queue/fence path before Camera2 is opened.
+    // This is intentionally tiny: it catches a driver/pipeline dispatch failure without holding a
+    // Camera2 Image or physical-camera lifecycle hostage.
+    uint16_t raw16[16] = {
+            256, 512, 256, 512,
+            512, 768, 512, 768,
+            256, 512, 256, 512,
+            512, 768, 512, 768};
+    RawDevelopRequest selfTest{};
+    selfTest.source = reinterpret_cast<const uint8_t*>(raw16);
+    selfTest.sourceBytes = sizeof(raw16);
+    selfTest.sourceWidth = 4;
+    selfTest.sourceHeight = 4;
+    selfTest.rowStride = 8;
+    selfTest.pixelStride = 2;
+    selfTest.format = 32; // ImageFormat.RAW_SENSOR
+    const int domain[4] = {0, 0, 4, 4};
+    std::memcpy(selfTest.rawBounds, domain, sizeof(domain));
+    std::memcpy(selfTest.sourceCrop, domain, sizeof(domain));
+    std::memcpy(selfTest.activeRawDomain, domain, sizeof(domain));
+    selfTest.cfaArrangement = 0;
+    selfTest.bayerOffset = 0;
+    selfTest.whiteLevel = 1023;
+    const float identity[9] = {1.f,0.f,0.f, 0.f,1.f,0.f, 0.f,0.f,1.f};
+    std::memcpy(selfTest.sensorToLinearSrgb, identity, sizeof(identity));
+    selfTest.outputWidth = 2;
+    selfTest.outputHeight = 2;
+    selfTest.savedPhoto = false;
+    selfTest.chromaDenoiseStrength = 0.0f;
+    selfTest.sensorClipThreshold = 0.985f;
+
+    std::vector<uint8_t> output;
+    const bool priorTrace = impl_->firstPreviewTrace;
+    impl_->firstPreviewTrace = false;
+    const bool ok = impl_->run(selfTest, &output, error);
+    impl_->firstPreviewTrace = priorTrace;
+    if (!ok) {
+        SPEKTRA_RAW_LOGE("IRIS_26687_RAW_VK_WARMUP_SELFTEST_FAIL");
+        return false;
+    }
+    if (output.size() != 2u * 2u * 8u) {
+        if (error) *error = "Spektra RAW warm-up self-test output size mismatch";
+        SPEKTRA_RAW_LOGE("IRIS_26687_RAW_VK_WARMUP_SELFTEST_FAIL size=%zu", output.size());
+        return false;
+    }
+    SPEKTRA_RAW_LOGI("IRIS_26687_RAW_VK_WARMUP_SELFTEST_PASS bytes=%zu", output.size());
+    return true;
+}
