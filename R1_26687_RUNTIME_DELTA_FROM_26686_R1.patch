+        SPEKTRA_RAW_LOGW("IRIS_26687_RAW_VK_RELEASE_DEFERRED reason=work_in_flight");
+        return;
+    }
+    std::string recoveryError;
+    if (!impl_->recoverTimedOutFence(&recoveryError)) {
+        SPEKTRA_RAW_LOGW("IRIS_26687_RAW_VK_RELEASE_DEFERRED reason=poisoned_in_flight");
+        return;
+    }
     impl_->destroy();
 }
 
