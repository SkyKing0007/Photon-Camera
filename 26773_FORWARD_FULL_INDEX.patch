+        // IRIS_26773_DOWNLOADS_DIRECTORY_MATERIALIZATION_OWNER
+        // A MediaStore row alone is not proof that RELATIVE_PATH was physically materialized.
+        // Write and read back the hidden app-owned marker so a fresh install cannot report success
+        // before Download/Iris Camera/<child>/ actually exists through the Downloads provider.
+        final String markerPath = child + "/.iris";
+        Uri marker = getOrCreateDownloadsUri(
+                context, markerPath, "application/octet-stream", false);
+        if (marker == null) return false;
+        try (OutputStream os = context.getContentResolver().openOutputStream(marker, "w")) {
+            if (os == null) return false;
+            os.write(new byte[]{'I', 'R', 'I', 'S', '\n'});
+            os.flush();
+        } catch (Throwable t) {
+            Log.e(TAG, "ensureDownloadsDirectory write " + child + ": " + t.getMessage());
+            return false;
+        }
+        Uri verified = findDownloadsUri(context, markerPath);
+        if (verified == null) return false;
+        try (InputStream is = context.getContentResolver().openInputStream(verified)) {
+            boolean readable = is != null && is.read() >= 0;
+            if (!readable) Log.e(TAG, "ensureDownloadsDirectory unreadable marker: " + child);
+            return readable;
+        } catch (Throwable t) {
+            Log.e(TAG, "ensureDownloadsDirectory verify " + child + ": " + t.getMessage());
+            return false;
+        }
