+            float midSat=smoothstep(0.07,0.18,warmHsv.y)
+                    *(1.0-smoothstep(0.72,0.92,warmHsv.y));
+            float midValue=smoothstep(0.08,0.22,warmHsv.z)
+                    *(1.0-smoothstep(0.74,0.94,warmHsv.z));
+            float warmMidtone=clamp(warmHue*midSat*midValue,0.0,1.0);
+            linearDisplay=mix(linearDisplay,linearDisplayOriginal,0.28*warmMidtone);
+#endif
         }
     }
