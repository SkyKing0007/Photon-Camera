+            /* IRIS_26841_WARM_MIDTONE_ACR3_RESTRAINT
+             * Runtime 26840 proves DCP HueSat/Look are absent on the Xiaomi path, so the active
+             * warm-channel appearance owner is ACR3. Keep its exact luminance and all highlight,
+             * cool-color and highly saturated behavior; only move ordinary red/orange midtones
+             * 28% back toward the calibrated pre-ACR3 Display-P3 relationship. This targets the
+             * carrot-orange face/red-furniture shift without changing gamma/exposure/tone. */
+#if USE_IRIS_26720_HIGH_ZOOM_RGB == 0
+            vec3 warmHsv=iris26628RgbToHsv(max(linearDisplayOriginal,vec3(0.0)));
