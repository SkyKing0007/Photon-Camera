+            val tileHeight = minOf(tileMaxHeight, cropHeight - top)
+            var left = 0
+            while (left < cropWidth) {
+                val tileWidth = minOf(tileMaxWidth, cropWidth - left)
+                val globalLeft = cropX + left
+                val globalTop = cropY + top
+                val rawLeft = (globalLeft - 2).coerceAtLeast(0)
+                val rawTop = (globalTop - 2).coerceAtLeast(0)
+                val rawRight = (globalLeft + tileWidth + 2).coerceAtMost(width)
+                val rawBottom = (globalTop + tileHeight + 2).coerceAtMost(height)
+                val rawWidth = rawRight - rawLeft
+                val rawHeight = rawBottom - rawTop
+                val rawRect = intArrayOf(rawLeft, rawTop, rawRight, rawBottom)
+                val covRect = true2xRawScaledRegion(
+                    rawRect, ev.covarianceWidth, ev.covarianceHeight, TRUE2X_EVIDENCE_HALO,
+                )
+                val covLeft = covRect[0]
+                val covTop = covRect[1]
+                val covWidth = covRect[2] - covLeft
+                val covHeight = covRect[3] - covTop
+                readTrue2xRawRegion(image, rawLeft, rawTop, rawWidth, rawHeight).use { raw ->
+                    val covariance = readTrue2xFileRegion(
+                        ev.covarianceFile, ev.covarianceWidth, 4,
+                        covLeft, covTop, covWidth, covHeight, "IRIS26752 Plan-B covariance",
+                    )
+                    try {
+                        check(
+                            IrisTrue2xSrNative.writePlanBLumaTile(
+                                output.absolutePath, cropWidth, cropHeight,
+                                left, top, tileWidth, tileHeight,
+                                cropX, cropY,
+                                raw.buffer, rawLeft, rawTop, rawWidth, rawHeight, raw.rowStrideSamples,
+                                covariance, covLeft, covTop, covWidth, covHeight,
+                                ev.covarianceWidth, ev.covarianceHeight,
+                                width, height, cfaPattern,
+                                ev.calibration.gains, ev.calibration.blackTerms,
+                                floatArrayOf(
+                                    COV_MIN_R, COV_MAX_R - COV_MIN_R,
+                                    COV_MIN_G, COV_MAX_G - COV_MIN_G,
+                                ),
+                                floatArrayOf(COV_MIN_B, COV_MAX_B - COV_MIN_B),
+                                cameraDomainScale, lensShading, lensShadingWidth, lensShadingHeight,
+                            )
+                        ) { "26752 Plan-B luma tile failed frame=${ev.frameIndex} tile=$left,$top" }
+                    } finally {
+                        LargeDirectBuffer.free(covariance)
+                    }
