+    private fun writePlanBLumaFrame26752(
+        image: SafeImage,
+        ev: True2xFrameEvidence,
+        cropX: Int,
+        cropY: Int,
+        cropWidth: Int,
+        cropHeight: Int,
+        output: File,
+    ) {
+        RandomAccessFile(output, "rw").use { it.setLength(cropWidth.toLong() * cropHeight * Float.SIZE_BYTES) }
+        val tileMaxWidth = 512
+        val tileMaxHeight = 128
