+    /* IRIS_26752_IPOL_PLAN_B_GLOBAL_TRANSLATION
+     * The paper's observation model is translation-only. Reduce Iris's persisted flow field to one
+     * robust frame translation and never feed local/non-rigid flow into the Plan-B solver. Flow is
+     * reference->current sampling displacement, hence the paper's Aj translation has opposite sign.
+     */
+    private fun planBGlobalTranslation26752(ev: True2xFrameEvidence): Pair<Float, Float>? {
+        if (ev.frameIndex == 0) return 0f to 0f
+        val values = ev.flowData.duplicate().order(ByteOrder.nativeOrder()).asShortBuffer()
+        val xs = ArrayList<Float>()
+        val ys = ArrayList<Float>()
+        for (index in 0 until ev.flowWidth * ev.flowHeight) {
+            val confidence = Half.toFloat(values.get(index * 4 + 3))
+            if (!confidence.isFinite() || confidence <= 0.5f) continue
+            val fx = Half.toFloat(values.get(index * 4)) * width.toFloat()
+            val fy = Half.toFloat(values.get(index * 4 + 1)) * height.toFloat()
+            if (fx.isFinite() && fy.isFinite()) {
+                xs += fx
+                ys += fy
+            }
+        }
+        if (xs.size < 16) return null
+        xs.sort(); ys.sort()
+        fun median(v: List<Float>): Float {
+            val n = v.size
+            return if ((n and 1) != 0) v[n / 2] else 0.5f * (v[n / 2 - 1] + v[n / 2])
+        }
+        return -median(xs) to -median(ys)
+    }
