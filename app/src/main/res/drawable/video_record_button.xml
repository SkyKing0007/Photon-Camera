<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Idle and finished: one clean red disc, no extra stroke -->
    <item
            android:state_activated="true"
            android:state_pressed="false">
        <shape android:shape="oval">
            <solid android:color="#FFFF3030"/>
        </shape>
    </item>

    <!-- Recording: transparent circular interior with centered stop square -->
    <item
            android:state_activated="false"
            android:state_pressed="false">
        <layer-list>

            <!-- Transparent liquid-glass interior, deliberately no ring -->
            <item>
                <shape android:shape="oval">
                    <gradient
                            android:angle="315"
                            android:startColor="#22FFFFFF"
                            android:centerColor="#08000000"
                            android:endColor="#22000000"/>
                </shape>
            </item>

            <!-- Large centered stop square, contained inside outer ring -->
            <item
                    android:left="14dp"
                    android:top="14dp"
                    android:right="14dp"
                    android:bottom="14dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFF3030"/>
                    <corners android:radius="9dp"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Press feedback -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#FFE82323"/>
        </shape>
    </item>

    <!-- Fallback matches idle/finished exactly -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFF3030"/>
        </shape>
    </item>
</selector>