-        s01 += w * p.level;
-        s11 += w;
-        t0 += w * p.level * p.variance;
-        t1 += w * p.variance;
-    }
-    const double det = s00 * s11 - s01 * s01;
-    if (!(std::abs(det) > 0.0)) return false;
