+    /**
+     * IRIS_26771_HISTOGRAM_SAFE_PIVOT_OWNER
+     * Keep the top-right histogram below the timer/flash/settings pill while the portrait Activity
+     * is physically held in landscape. Quarter turns hang downward from the lower corner instead
+     * of center-rotating upward into the top controls.
+     */
+    @BindingAdapter("bindHistogramRotate")
+    public static void rotateHistogram(View view, CameraFragmentModel model) {
+        if (view == null || model == null) return;
+        view.post(() -> {
+            final int orientation = model.getOrientation();
+            final float width = view.getWidth();
+            final float height = view.getHeight();
+            view.animate().cancel();
+            view.setTranslationX(0f);
+            view.setTranslationY(0f);
+            if (orientation == -90) {
+                view.setPivotX(width);
+                view.setPivotY(height);
+            } else if (orientation == 90) {
+                view.setPivotX(0f);
+                view.setPivotY(height);
+            } else {
+                view.setPivotX(width * 0.5f);
+                view.setPivotY(height * 0.5f);
+            }
+            view.animate().rotation(orientation).setDuration(model.getDuration()).start();
+        });
+    }
