-        if (abs(srcRatio - targetRatio) < 0.01f) {
-            return bitmap
-        }
-
-        val cropWidth: Int
-        val cropHeight: Int
-        val cropX: Int
-        val cropY: Int
-
-        if (srcRatio > targetRatio) {
-            // 原图更宽，裁切左右
-            cropHeight = srcHeight
