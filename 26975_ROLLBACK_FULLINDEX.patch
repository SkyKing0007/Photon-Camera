-    fun solve(baseCurve: FloatArray): CurveExtension {
-        require(baseCurve.size >= 4) { "HDR base curve needs at least four samples" }
-        val curve = sanitizeCurve(baseCurve)
-        val lastIndex = curve.lastIndex
