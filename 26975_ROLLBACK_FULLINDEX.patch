-            vec4 color = texelFetch(uAccumulated, source, 0);
-            int cfaColor = (virtualSite.x & 1) + (virtualSite.y & 1);
-            float sampleValue = cfaColor == 0 ? color.r : (cfaColor == 1 ? color.g : color.b);
-            float scaled = sampleValue * uQuantizationScale;
