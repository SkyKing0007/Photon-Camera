-    internal fun sampleCurve(curve: FloatArray, input: Float): Float {
-        require(curve.isNotEmpty()) { "Curve must not be empty" }
-        if (curve.size == 1) return curve[0].finiteOr(0f).coerceAtLeast(0f)
