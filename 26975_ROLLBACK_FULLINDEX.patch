-        }
-        val configuration = frame.configuration
-        val noise = scope.acquire(w, h)
-        val mottleNoise = if (flags.mottle) scope.acquire(w, h) else 0
-        use(compute("grainNoise", FotufilmShaders.GRAIN_NOISE))
-        bindConfig()
-        uniform2i("uSize", w, h)
