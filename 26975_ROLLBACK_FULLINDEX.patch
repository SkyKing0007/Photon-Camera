-            out.write(ushortBytes(rawEntries.size))
-            for (encoded in encodedRawEntries) {
-                out.write(ushortBytes(encoded.entry.tag))
-                out.write(ushortBytes(encoded.entry.type))
-                out.write(uintBytes(encoded.entry.count))
