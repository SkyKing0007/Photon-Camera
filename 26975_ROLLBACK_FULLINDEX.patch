-        val clamped = input.coerceIn(0f, 1f)
-        return if (clamped <= sourceMiddleGray) {
-            clamped * targetMiddleGray / sourceMiddleGray
-        } else {
-            targetMiddleGray +
-                (clamped - sourceMiddleGray) *
-                (1f - targetMiddleGray) /
-                (1f - sourceMiddleGray)
