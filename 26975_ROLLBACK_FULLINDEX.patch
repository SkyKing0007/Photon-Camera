-                GLES30.GL_TIMEOUT_EXPIRED -> Unit
-                GLES30.GL_WAIT_FAILED -> error("GPU completion wait failed for $label")
-                else -> error("Unexpected GPU completion wait result for $label")
-            }
-        }
-        return (System.nanoTime() - startNs) / 1_000_000L
-    }
-}
