-    private fun renderRawLumaResidualPass(
-        target: RenderTarget,
-        lutLuminanceGainTexture: Int,
-        sdrTexture: Int,
-        hdrTexture: Int,
-        minGainRatio: Float,
-        maxGainRatio: Float,
-        strength: Float,
