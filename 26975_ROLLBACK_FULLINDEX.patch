-        }
-
-        void main() {
-            ivec2 packedCoord = ivec2(gl_GlobalInvocationID.xy);
-            int packedWidth = (uImageSize.x + 3) / 4;
-            if (packedCoord.x >= packedWidth || packedCoord.y >= uImageSize.y) return;
