-                TAG,
-                "MGC Spatial strength PBO submit label=$label mode=${queued.mode} " +
-                    "bytes=${storage.byteCount} setup=${queued.targetBindMs}ms " +
-                    "submit=${queued.readSubmitMs}ms total=${queued.totalSubmitMs}ms",
