-            coreEnd = core.bottom,
-            sourceSize = sourceHeight,
-            workLength = workHeight,
-            support = support,
-            phase = phase,
-        )
-        return RawTileRect(left, top, left + workWidth, top + workHeight).also { working ->
-            check(working.contains(core)) {
