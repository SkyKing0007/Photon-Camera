-            algorithm = manifest.algorithm,
-            upstreamCommit = manifest.upstreamCommit,
-            size = manifest.size,
-            inputScale = manifest.inputScale,
-            printInputScale = manifest.printInputScale,
-            shared = manifest.shared,
