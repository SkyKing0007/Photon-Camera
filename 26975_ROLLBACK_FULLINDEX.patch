-            if (cachedPrint?.sourceKey != request.printKey) cachedPrint = null
-            val stages = SpektrafilmRuntime.load(context, request, cachedFilm, cachedPrint)
-            cachedFilm = stages.first
-            cachedPrint = stages.second
-            SpectralFilmLut(
