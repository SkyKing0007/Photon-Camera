-            viewportWidth = programSize.width,
-            viewportHeight = programSize.height,
-        )
-        val srgbInputTextureId = if (warmupColorEngine.isLumix || warmupColorEngine.isCanon) {
-            inputTextureId
-        } else if (engineToneReady && warmupColorEngine.isHncs) {
