-void main() {
-    int index = int(gl_GlobalInvocationID.x);
-    if (index > 2 * uExtent) return;
-    int k = index - uExtent;
-    imageStore(uOut, ivec2(index, 0),
-        vec4(kernel_value(k, 0), kernel_value(k, 1), kernel_value(k, 2), kernel_value(k, 3)));
-}
-""")
