-    private fun buildGainMapOpcode(
-        gains: FloatArray,
-        mapWidth: Int,
-        mapHeight: Int,
-        channel: Int,
-        top: Int,
-        left: Int,
-        rowPitch: Int,
-        colPitch: Int,
-        width: Int,
-        height: Int,
