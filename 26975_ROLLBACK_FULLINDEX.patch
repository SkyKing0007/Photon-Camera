-    private fun ensureHdrBaseCurveTarget(): Boolean {
-        if (hdrBaseCurveTextureId != 0 && hdrBaseCurveFramebufferId != 0) return true
-
-        val textures = IntArray(1)
-        GLES30.glGenTextures(1, textures, 0)
