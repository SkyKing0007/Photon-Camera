-            GLES31.glGetUniformLocation(program, "uPlaneSize"),
-            planeWidth,
-            planeHeight,
-        )
-        GLES31.glUniform1i(
-            GLES31.glGetUniformLocation(program, "uPlaneCount"),
-            planeCount,
-        )
-        GLES31.glUniform1i(
-            GLES31.glGetUniformLocation(program, "uAtlasColumns"),
