-            (planeWidth - 1).toLong() * pixelStride +
-            sampleBytes.toLong()
-        val availableBytes = plane.buffer.duplicate().apply { position(0) }.limit().toLong()
-        if (requiredBytes > availableBytes) {
-            PLog.w(
-                TAG,
