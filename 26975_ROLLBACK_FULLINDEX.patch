-
-            uniform int uCfaPattern;
-            uniform vec3 uCalculationWb;
-            uniform vec3 uInputRead;
-            uniform vec3 uInputShot;
-            uniform vec4 uReferenceSignals;
-            uniform int uReadOnlySlot;
-            uniform int uSampleSize;
-
-            uint hashBits(uint value) {
-                value ^= value >> 16;
-                value *= 0x7feb352du;
-                value ^= value >> 15;
-                value *= 0x846ca68bu;
-                value ^= value >> 16;
