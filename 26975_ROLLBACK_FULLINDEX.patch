-    }
-
-    private fun fixedWorkingOrigin(
-        coreStart: Int,
-        coreEnd: Int,
-        sourceSize: Int,
-        workLength: Int,
-        support: Int,
-        phase: Int,
-    ): Int {
-        if (workLength == sourceSize) return 0
-        val maximumOrigin = sourceSize - workLength
-        check(maximumOrigin % phase == 0)
