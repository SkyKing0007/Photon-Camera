-                    }
-
-                    DATA_TYPE_UINT16 -> {
-                        val value = buffer.short.toInt() and 0xFFFF
-                        gainMin + value.toFloat() / 65535f * (gainMax - gainMin)
-                    }
-
-                    DATA_TYPE_FLOAT16 -> Half.toFloat(buffer.short)
-                    else -> buffer.float
-                }.takeIf { value ->
-                    value.isFinite() &&
