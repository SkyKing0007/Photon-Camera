-    /** `grain_selected`: clump grain (`grained`) or the film grain model (`filmed`). */
-    private fun grain(
-        scope: Scope,
-        frame: FotufilmFrame,
-        params: FotufilmFrameParams,
-        flags: Flags,
-        region: Region,
-        density: Int,
-    ): Int {
-        if (!flags.grain) return density
