-    private val MASK_RESOLUTION = """
-        const int RESOLVE_CLEAN_NEIGHBORHOOD = 0;
-        const int RESOLVE_NOT_HOT = 1;
-        const int RESOLVE_HOT = 2;
-
-        bool maskedAt(ivec2 coord) {
-            ivec2 safe = safeCoord(coord);
