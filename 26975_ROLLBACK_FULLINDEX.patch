-            if (field != 1 || wire != 2) {
-                root.skip(wire)
-                continue
-            }
-            val point = root.readMessage()
-            val strength = ArrayList<Float>(5)
-            val revert = ArrayList<Float>(5)
-            val outlier = ArrayList<Float>(5)
-            var snr: Float? = null
