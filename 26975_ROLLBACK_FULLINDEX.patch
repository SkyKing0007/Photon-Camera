-                rawBuffer = rawBuffer,
-                rawWidth = rawWidth,
-                rawHeight = rawHeight,
-                imageLayout = imageLayout,
-                rowStepSamples = rowStepSamples,
-                colStepSamples = colStepSamples,
-                blackLevel = blackLevel,
-                whiteLevel = whiteLevel,
