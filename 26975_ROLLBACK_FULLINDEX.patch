-                        "join=${curve.joinInput}/${curve.joinOutput} " +
-                        "joinSlope=${curve.joinSlope} white=${curve.whiteOutput} " +
-                        "whiteSlope=${curve.whiteSlope} extendsBase=${curve.extendsBaseCurve}",
