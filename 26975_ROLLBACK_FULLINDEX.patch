-    /** Prepares the persistent RAW renderer and first-use capture passes during camera idle time. */
-    suspend fun prewarmCapturePipeline(
-        context: Context,
-        colorEngine: RawRenderingEngine,
-        captureWidth: Int,
-        captureHeight: Int,
