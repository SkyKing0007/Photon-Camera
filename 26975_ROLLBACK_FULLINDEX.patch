-    data class CurveExtension(
-        val joinInput: Float,
-        val joinOutput: Float,
-        val joinSlope: Float,
-        val quadraticCoefficient: Float,
-        val whiteOutput: Float,
-        val whiteSlope: Float,
-        val extendsBaseCurve: Boolean = false,
