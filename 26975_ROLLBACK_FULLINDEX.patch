-        fun evaluate(input: Float, baseCurve: FloatArray): Float {
-            val x = input.finiteOr(0f).coerceAtLeast(0f)
-            if (x <= joinInput) return sampleCurve(baseCurve, x)
-            if (x <= SCENE_WHITE) {
-                val distance = x - joinInput
