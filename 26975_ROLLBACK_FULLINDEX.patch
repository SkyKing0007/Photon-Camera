-            // RGGB: (0,0)=R,  (1,0)=Gr, (0,1)=Gb, (1,1)=B
-            // GRBG: (0,0)=Gr, (1,0)=R,  (0,1)=B,  (1,1)=Gb
-            // GBRG: (0,0)=Gb, (1,0)=B,  (0,1)=R,  (1,1)=Gr
