-                    0.0
-                );
-                float targetHdrLuma = max(
-                    (hdrLuma + uOffset) * lutLumaGain - uOffset,
-                    0.0
-                );
-                float candidateRatio = clamp(
-                    (targetHdrLuma + uOffset) / (sdrLuma + uOffset),
-                    uMinGainRatio,
-                    uMaxGainRatio
