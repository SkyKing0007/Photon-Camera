-    fun measure(
-        metadata: RawMetadata,
-        calculationWb4: FloatArray,
-    ): DemosaicNoiseTransfer? {
-        val inputRead = metadata.mgcDenoiseReadNoise
-        val inputShot = metadata.mgcDenoiseShotNoise
