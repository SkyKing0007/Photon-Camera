-
-        try {
-            val atlas = gl.target(ATLAS_TARGET, atlasWidth, atlasHeight)
-            try {
-                for (y in 0 until rows.lastIndex) for (x in 0 until columns.lastIndex) {
-                    val seed = RawTileRect(columns[x], rows[y], columns[x + 1], rows[y + 1])
