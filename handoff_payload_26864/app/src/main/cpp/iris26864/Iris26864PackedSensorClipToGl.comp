#version 450
// IRIS_26864_SENSOR_CLIP_FULL_RES_R_CHANNEL_OWNER
// One source texel stores four ORIGINAL sensor CFA clip bits in canonical
// R/G1/G2/B order. The output is full-resolution RGBA16F because Iris's
// *successful 26863* AHardwareBuffer GL/Vulkan carrier is RGBA16F. Only .r
// is meaningful: 1.0 means clipped/invalid; 0.0 means valid. On the GLES
// side blit that red channel to an R16F clip-zone texture, never interpret
// alpha or the synthetic AMaZE RGB output as the original sensor signal.
// No post-LSC inference or Camera2 noise map is allowed in this pass.
layout(local_size_x=16,local_size_y=16,local_size_z=1) in;
layout(set=0,binding=0,r16ui) readonly uniform uimage2D packedSensorClip;
layout(set=0,binding=1,rgba16f) writeonly uniform image2D glClipField;
layout(push_constant) uniform ClipArgs {
    uint width,height,cfa,strict;
} p;
uint canonicalBitForPhysicalSite(uvec2 pixel) {
    uint phase=((pixel.y&1u)<<1u)|(pixel.x&1u);
    // Exact 26863/26864 physical Bayer order: RGGB,GRBG,GBRG,BGGR.
    // Each row maps physical 2x2 row-major site to canonical R/G1/G2/B.
    const uint bits[16]=uint[16](0u,1u,2u,3u,
                                  1u,0u,3u,2u,
                                  2u,3u,0u,1u,
                                  3u,2u,1u,0u);
    return bits[p.cfa*4u+phase];
}
void main() {
    uvec2 pixel=gl_GlobalInvocationID.xy;
    if (p.strict!=1u || p.cfa>=4u || p.width<32u || p.height<32u ||
        (p.width&1u)!=0u || (p.height&1u)!=0u ||
        pixel.x>=p.width || pixel.y>=p.height ||
        any(notEqual(imageSize(packedSensorClip),ivec2(p.width/2u,p.height/2u))) ||
        any(notEqual(imageSize(glClipField),ivec2(p.width,p.height)))) return;
    uint packedClipBits=imageLoad(packedSensorClip,ivec2(pixel/2u)).r;
    uint bit=canonicalBitForPhysicalSite(pixel);
    float clipped=((packedClipBits&(1u<<bit))!=0u)?1.0:0.0;
    imageStore(glClipField,ivec2(pixel),vec4(clipped,0.0,0.0,1.0));
}
