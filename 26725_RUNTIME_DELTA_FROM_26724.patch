+    private boolean motion26725ValidateGoogleRawImageForCpuCopy(
+            Image image, @NonNull String role) {
+        if (!isMotion26725GooglePixelCompatibilityRoute()) return true;
+        try {
+            if (image == null) throw new IllegalStateException("null_image");
+            Image.Plane[] planes = image.getPlanes();
+            if (planes == null || planes.length < 1 || planes[0] == null)
+                throw new IllegalStateException("missing_plane0");
+            Image.Plane plane = planes[0];
+            java.nio.ByteBuffer buffer = plane.getBuffer();
+            if (buffer == null) throw new IllegalStateException("null_plane_buffer");
+            int rowStride = plane.getRowStride();
+            int pixelStride = plane.getPixelStride();
+            int width = image.getWidth();
+            int height = image.getHeight();
+            int capacity = buffer.capacity();
+            if (width <= 0 || height <= 0 || rowStride <= 0 || capacity <= 0)
+                throw new IllegalStateException("invalid_plane_geometry");
+            if (!buffer.isDirect()) throw new IllegalStateException("non_direct_plane_buffer");
+            long minRowBytes;
+            if (image.getFormat() == ImageFormat.RAW10) {
+                minRowBytes = ((long) width * 10L + 7L) / 8L;
+            } else if (image.getFormat() == ImageFormat.RAW12) {
+                minRowBytes = ((long) width * 12L + 7L) / 8L;
+            } else {
+                if (pixelStride <= 0) throw new IllegalStateException("invalid_pixel_stride");
+                minRowBytes = (long) width * (long) pixelStride;
+            }
+            long minSpan = (long) (height - 1) * (long) rowStride + minRowBytes;
+            if (minRowBytes <= 0L || minRowBytes > rowStride || minSpan > capacity)
+                throw new IllegalStateException("plane_capacity_too_small");
+            return true;
