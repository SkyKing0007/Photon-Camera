new file mode 100644
index 0000000000000000000000000000000000000000..1884e04346511e54d1aea1fe87e2094959aede0c
--- /dev/null
+++ b/app/src/main/res/layout/manual_palette.xml
@@ -0,0 +1,98 @@
+<?xml version="1.0" encoding="utf-8"?>
+<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:tools="http://schemas.android.com/tools"
+    android:id="@+id/manual_mode"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:orientation="vertical"
+    android:visibility="gone"
+    tools:visibility="visible">
+
+    <!-- IRIS_26668_EXACT_VALUE_MANUAL_SLIDER
+         Keep the legacy KnobView as a 1dp compatibility endpoint because the proven console/model
+         binding still publishes the selected ManualModel through it. The visible control is the
+         app-owned exact-value horizontal slider below; no circular wheel pixels are displayed. -->
+    <FrameLayout
+        android:id="@+id/knobViewContainer"
+        android:layout_width="match_parent"
+        android:layout_height="66dp">
+
+        <com.particlesdevs.photoncamera.circularbarlib.ui.views.knobview.KnobView
+            android:id="@+id/knobView"
