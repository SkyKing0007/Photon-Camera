-    st = TINYDNG_E_BOUNDS;
-    goto cleanup;
-  }
-  if (!w->bigtiff && ifd_off > (uint64_t)UINT32_MAX) {
-    td_set_error(err, TINYDNG_E_BOUNDS, TINYDNG_STAGE_WRITE, 0, 0, ifd_off,
-                 "classic TIFF offset limit exceeded");
-    st = TINYDNG_E_BOUNDS;
-    goto cleanup;
-  }
