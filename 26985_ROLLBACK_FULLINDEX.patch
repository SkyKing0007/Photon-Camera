-    }
-#endif
-#endif
-    default:
-      if (!st_re) {
-        td_ctx_free(ctx, stored);
-      }
-      td_set_error(err, TINYDNG_E_UNSUPPORTED, TINYDNG_STAGE_DECODE, 0, 0, 0,
