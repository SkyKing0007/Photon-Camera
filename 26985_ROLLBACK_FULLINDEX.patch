-// Decision kernel K (colour_demosaicing menon2007.py literal, float32).
-constexpr float kDemoK[25] = {
-    0, 0, 1, 0, 1,  //
-    0, 0, 0, 1, 0,  //
-    0, 0, 3, 0, 3,  //
-    0, 0, 0, 1, 0,  //
-    0, 0, 1, 0, 1,  //
-};
