-    if (noncoherent_[i].buf == b.buf) { noncoherent_.erase(noncoherent_.begin() + long(i)); break; }
-  vkUnmapMemory(dev_, b.mem);
-  vkDestroyBuffer(dev_, b.buf, nullptr);
-  vkFreeMemory(dev_, b.mem, nullptr);
-  b = Buffer{};
-}
