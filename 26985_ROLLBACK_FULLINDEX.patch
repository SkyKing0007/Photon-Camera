-typedef struct lj92_arith_scan_state {
-  struct {
-    u8 sign_zero[5][5][4]; /* S0, SS, SP, SN */
-    u8 mag_low[2][15];     /* X, M */
-    u8 mag_high[2][15];
-  } table[4];
-  int16_t* above[LJ92_MAX_COMPONENTS];
-  int left[LJ92_MAX_COMPONENTS];
-  lj92_arith_decoder coder;
