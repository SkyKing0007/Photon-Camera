-  out->size = total;
-  out->width = w;
-  out->height = h;
-  out->samples_per_pixel = 1u;
-  out->bits_per_sample = out_bps;
-  out->sample_format = (psd->depth == 32u) ? TINYDNG_SAMPLEFORMAT_IEEEFP
-                                           : TINYDNG_SAMPLEFORMAT_UINT;
