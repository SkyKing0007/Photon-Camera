-static inline double tap(const double* a, size_t o, int w, double ax, double ay) {
-  return (a[o] * (1 - ax) + a[o + 1] * ax) * (1 - ay) + (a[o + w] * (1 - ax) + a[o + w + 1] * ax) * ay;
-}
