-inline bool valid(const Sample& s) {
-    return std::isfinite(s.iso) && s.iso > 0 && std::isfinite(s.a) && s.a >= 0 &&
-           std::isfinite(s.b) && s.b >= 0 && (s.a > 0 || s.b > 0) &&
-           s.bins >= kMinBins && std::isfinite(s.analogIso) && s.analogIso >= 0;
-}
