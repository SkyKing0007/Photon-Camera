-  void* map = nullptr;
-  size_t bytes = 0;
-  bool cached = false;      // host-cached memory (CPU reads fast); may be non-coherent
-  bool coherent = true;
-  template <class T> T* as() const { return static_cast<T*>(map); }
-};
