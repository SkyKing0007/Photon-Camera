-    int cur = col * NC;
-    int prv = cur - NC;
-    for (int c = 0; c < NC; c++) {
-      bitio_refill(bio);
-      int Px = rowbuf[prv + c];
-      int d = bitio_decode_diff(bio, hl[c], hb[c]);
-      int raw = (int)(uint16_t)(Px + d);
-      rowbuf[cur + c] = (u16)raw;
-      if (has_lin) {
-        if ((unsigned)raw >= (unsigned)linlen) return TDNG_LJ92_ERROR_CORRUPT;
