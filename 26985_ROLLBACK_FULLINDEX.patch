-int tdng_lj92_open(tdng_lj92* lj, const uint8_t* data, int datalen, int* width,
-                   int* height, int* bitdepth, int* components) {
-  return tdng_lj92_open_ex(lj, data, datalen, NULL, width, height, bitdepth,
-                           components);
-}
