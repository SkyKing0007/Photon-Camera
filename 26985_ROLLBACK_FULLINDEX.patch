-      *out_len = (size_t)sc.written;
-      return TINYDNG_OK;
-    }
-
-    default:
-      td_set_error(err, TINYDNG_E_UNSUPPORTED, TINYDNG_STAGE_WRITE, 0, 0, 0,
-                   "unsupported writer compression %u",
-                   (unsigned)w->compression);
-      return TINYDNG_E_UNSUPPORTED;
-  }
-}
