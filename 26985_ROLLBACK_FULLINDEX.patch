-  for (auto it = arena_.begin(); it != arena_.end();) {
-    bool kept = SameBuf(*it, dummy_);
-    if (!kept) {
-      for (const FftBuf& k : keep) {
-        if (SameBuf(*it, k)) {
-          kept = true;
-          break;
-        }
-      }
-    }
-    if (kept) {
-      ++it;
-    } else {
-      SrpReleaseBuffer(ctx_, it->buf, it->mem, it->nfloats);
