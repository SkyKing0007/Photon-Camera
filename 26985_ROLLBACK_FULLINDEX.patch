-        scans[s].point_transform >= frame->precision) {
-      return TDNG_LJ92_ERROR_INVALID_ARGUMENT;
-    }
-    for (int j = 0; j < scans[s].component_count; j++) {
-      int c = scans[s].component_index[j];
