-layout(set = 0, binding = 0) readonly buffer InBuf {
-  float data[];
-} inBuf;
-
-layout(set = 0, binding = 1) buffer AccBuf {
-  float data[];
-} accBuf;
-
-layout(push_constant) uniform Params {
-  uint count;
-  uint width;
-  uint height;
-  float gain;
-} params;
-
-void main() {
-  uint gid = gl_GlobalInvocationID.x;
-  if (gid >= params.count) {
-    return;
-  }
