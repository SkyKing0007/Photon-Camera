-      break;
-#endif
-#ifndef TINYDNG_NO_ZIP
-    case TINYDNG_COMPRESSION_ZIP: {
-      mz_ulong dlen = (mz_ulong)need;
-      int mzr = mz_uncompress(stored, &dlen, src, (mz_ulong)seg->byte_count);
