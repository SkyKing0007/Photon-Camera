-static int lj92_arith_classify(int diff, int l, int u) {
-  unsigned int magnitude = (unsigned int)(diff < 0 ? -diff : diff);
-  if (magnitude <= ((1u << l) >> 1)) return 0;
-  if (magnitude <= (1u << u)) return diff < 0 ? -1 : 1;
-  return diff < 0 ? -2 : 2;
