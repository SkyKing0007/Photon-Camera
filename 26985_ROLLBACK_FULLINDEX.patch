-          out[w--] = suffix[c];
-          c = prefix[c];
-        }
-        out[out_pos] = (uint8_t)c; /* leading literal / first char */
-        out_pos += len;
-        /* Add new entry prev + firstchar(this string). */
-        if (next_code < 4096) {
-          prefix[next_code] = (uint16_t)prev;
-          suffix[next_code] = (uint8_t)c;
-          next_code++;
