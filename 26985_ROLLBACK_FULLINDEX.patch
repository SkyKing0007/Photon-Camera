-    goto cleanup;
-  }
-  st = td_writer_relayout_extras(w, err);
-  if (st != TINYDNG_OK) {
-    goto cleanup;
-  }
-
-  extras_base = w->data_pos; /* already even-aligned */
-  st = tdw_serialize_subs(w, extras_base, err);
-  if (st != TINYDNG_OK) {
-    goto cleanup;
-  }
-  if (w->w.extras_len > 0u) {
