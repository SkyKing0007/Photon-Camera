-  td_lzw_table lzw_tbl;
-  /* Scratch buffers reused across tiles (grown on demand):
-     swap: byte-swapped payload copy; enc: compressed output staging. */
-  uint8_t* scratch_swap;
-  size_t scratch_swap_cap;
