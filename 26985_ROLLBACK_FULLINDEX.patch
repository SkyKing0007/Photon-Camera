-                  static_cast<VkDeviceSize>(v.size()) * 4, 0, &mapped) !=
-      VK_SUCCESS) {
-    return FftBuf{};
-  }
-  std::memcpy(mapped, v.data(), v.size() * 4);
-  flushWritten(b.mem, static_cast<VkDeviceSize>(v.size()) * 4);
-  vkUnmapMemory(device_, b.mem);
-  return b;
-}
