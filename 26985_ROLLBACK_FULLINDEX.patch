-typedef struct td_io_mmap {
-  tinydng_context *ctx;
-  const uint8_t *base;
-  size_t size;
-#if defined(_WIN32)
-  HANDLE file;
-  HANDLE mapping;
-#else
-  int fd;
-#endif
