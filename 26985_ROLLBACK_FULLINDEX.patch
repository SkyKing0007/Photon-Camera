-/* store one already-compressed strip verbatim (JPEG XL
-   codestream). Mirrors the non-header-first tail of td_writer_put_segment,
-   minus geometry-derived sizing: the caller owns the byte count. */
-tinydng_status tinydng_writer_write_compressed_strip(tinydng_writer *w,
-                                                     uint32_t strip_index,
-                                                     const void *data,
-                                                     size_t len,
-                                                     tinydng_error *err) {
-  uint64_t at;
-  if (!w || !data) {
-    td_set_error(err, TINYDNG_E_INVALID_ARG, TINYDNG_STAGE_WRITE, 0, 0, 0,
-                 "null argument to compressed strip write");
-    return TINYDNG_E_INVALID_ARG;
-  }
-  if (w->tiled) {
-    td_set_error(err, TINYDNG_E_INVALID_ARG, TINYDNG_STAGE_WRITE, 0, 0, 0,
-                 "writer is tiled (compressed strips need striped layout)");
-    return TINYDNG_E_INVALID_ARG;
-  }
-  if (!w->precompressed || w->compression != TINYDNG_COMPRESSION_JPEG_XL) {
-    td_set_error(err, TINYDNG_E_INVALID_ARG, TINYDNG_STAGE_WRITE, 0, 0, 0,
-                 "compressed strips need a precompressed JPEG XL writer");
-    return TINYDNG_E_INVALID_ARG;
-  }
-  if (w->finished) {
-    td_set_error(err, TINYDNG_E_INVALID_ARG, TINYDNG_STAGE_WRITE, 0, 0, 0,
-                 "writer already finished");
-    return TINYDNG_E_INVALID_ARG;
-  }
-  if (w->header_first) {
-    td_set_error(err, TINYDNG_E_UNSUPPORTED, TINYDNG_STAGE_WRITE, 0, 0, 0,
-                 "header-first offsets are precomputed from raster geometry");
-    return TINYDNG_E_UNSUPPORTED;
-  }
-  if (strip_index >= w->seg_count) {
-    td_set_error(err, TINYDNG_E_INVALID_ARG, TINYDNG_STAGE_WRITE, 0, 0, 0,
-                 "segment index %u out of range (count %u)", strip_index,
-                 w->seg_count);
-    return TINYDNG_E_INVALID_ARG;
-  }
-  if (len == 0u || len > (size_t)UINT32_MAX) {
-    td_set_error(err, TINYDNG_E_BOUNDS, TINYDNG_STAGE_WRITE, 0, 0, 0,
-                 "compressed strip size out of classic TIFF range");
-    return TINYDNG_E_BOUNDS;
-  }
-  at = w->data_pos;
-  if (w->segs[strip_index].offset != 0u) {
-    td_set_error(err, TINYDNG_E_INVALID_ARG, TINYDNG_STAGE_WRITE, 0, 0, at,
-                 "segment %u written twice", strip_index);
-    return TINYDNG_E_INVALID_ARG;
