-static int lj92_arith_decode_bit(lj92_arith_decoder* d, u8* st) {
-  uint32_t packed, qe, temp;
-  int sv;
-  while (d->a < 0x8000u) {
-    if (--d->ct < 0) {
-      uint32_t data = 0;
-      if (d->p < d->end)
-        data = *d->p++;
-      else
-        d->synthetic_bytes++;
-      d->c = (d->c << 8) | data;
-      d->ct += 8;
-      if (d->ct < 0 && ++d->ct == 0) d->a = 0x8000u;
-    }
-    d->a <<= 1;
-  }
-  sv = *st;
-  packed = lj92_aritab[sv & 0x7f];
-  qe = packed >> 16;
-  temp = d->a - qe;
-  d->a = temp;
-  temp <<= d->ct;
-  if (d->c >= temp) {
-    d->c -= temp;
-    if (d->a < qe) {
-      d->a = qe;
-      *st = (u8)((sv & 0x80) ^ ((packed >> 8) & 0xff));
-    } else {
-      d->a = qe;
-      *st = (u8)((sv & 0x80) ^ (packed & 0xff));
-      sv ^= 0x80;
-    }
-  } else if (d->a < 0x8000u) {
-    if (d->a < qe) {
-      *st = (u8)((sv & 0x80) ^ (packed & 0xff));
-      sv ^= 0x80;
-    } else {
-      *st = (u8)((sv & 0x80) ^ ((packed >> 8) & 0xff));
-    }
-  }
-  return sv >> 7;
-}
