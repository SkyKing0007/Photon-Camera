-typedef struct _ljp {
-  tdng_lj92_allocator allocator;
-  u8* data;
-  int datalen;
-  int scanstart;
-  int ix;
-  int x;           // Width
-  int y;           // Height
-  int bits;        // Bit depth
-  int components;  // Number of components (Nf)
-  int sof_marker;  // The SOF marker found (0xC0..0xC3, or 0 if none)
