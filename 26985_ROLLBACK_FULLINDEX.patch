-Status SrpRobustComputeGpu(Context* ctx, uint32_t width, uint32_t height,
-                           VkBuffer comp_buffer, VkBuffer means_buffer,
-                           VkBuffer vars_buffer, VkBuffer flow_buffer,
-                           VkBuffer lut_buffer, VkBuffer s_buffer,
-                           VkBuffer out_buffer, uint32_t tile_size,
-                           uint32_t lut_n, uint32_t noise_correction,
-                           uint32_t t_bits, uint32_t ftx, uint32_t fty,
-                           VkShaderModule shader_module, VkBuffer hf_buffer,
-                           uint32_t s1_bits, uint32_t ghost_a_bits,
-                           uint32_t ghost_b_bits) {
-  if (ctx == nullptr || width < 2 || height < 2 || tile_size < 2 ||
-      lut_n == 0 || ftx == 0 || fty == 0 || comp_buffer == VK_NULL_HANDLE ||
-      means_buffer == VK_NULL_HANDLE || vars_buffer == VK_NULL_HANDLE ||
-      flow_buffer == VK_NULL_HANDLE || lut_buffer == VK_NULL_HANDLE ||
-      s_buffer == VK_NULL_HANDLE || out_buffer == VK_NULL_HANDLE ||
-      shader_module == VK_NULL_HANDLE) {
-    return Status::kInitFailed;
-  }
-  const uint32_t gw = width / 2, gh = height / 2;
-  const uint64_t n64 = static_cast<uint64_t>(gw) * gh;
-  if (n64 == 0 || n64 > 0x0FFFFFFFULL) return Status::kInitFailed;
-  const uint32_t n = static_cast<uint32_t>(n64);
-  const uint32_t tile_half = tile_size / 2;
-  const uint32_t continuous_flow = (noise_correction >> 1u) & 1u;
-
-  DemoArena arena;
-  arena.ctx = ctx;
-  arena.device = NativeDevice(ctx);
-  if (arena.device == VK_NULL_HANDLE) return Status::kNoDevice;
-  VkBuffer guide = arena.alloc(3 * n, nullptr);
-  VkBuffer cmeans = arena.alloc(3 * n, nullptr);
-  VkBuffer cvars = arena.alloc(3 * n, nullptr);
-  VkBuffer warped = arena.alloc(3 * n, nullptr);
-  VkBuffer d = arena.alloc(n, nullptr);
-  VkBuffer sg = arena.alloc(n, nullptr);
-  VkBuffer r = arena.alloc(n, nullptr);
-  VkBuffer dummy = arena.alloc(1, nullptr);
-  if (!arena.ok) {
-    arena.freeAll();
-    return Status::kDispatchFailed;
-  }
-
-  uint32_t ex[15] = {};
-  Status status = Status::kOk;
-  // op 0 guide on the compared frame.
-  ex[0] = 0;
-  ex[12] = width;
-  status = RobDispatch(ctx, ex, gw, gh, n, comp_buffer, dummy, dummy, guide,
-                       dummy, dummy, dummy, shader_module);
-  // op 1 stats of the compared guide.
-  if (status == Status::kOk) {
-    ex[0] = 1;
-    ex[3] = 3;
-    ex[12] = 0;
-    status = RobDispatch(ctx, ex, gw, gh, 3 * n, guide, dummy, dummy, cmeans,
-                         cvars, dummy, dummy, shader_module);
-  }
-  // op 2 warp vs the raw-basis flow.
-  if (status == Status::kOk) {
-    ex[0] = 2;
-    ex[3] = 3;
-    ex[4] = tile_half;
-    ex[11] = ftx;
-    status = RobDispatch(ctx, ex, gw, gh, n, cmeans, flow_buffer, dummy,
-                         warped, dummy, dummy, dummy, shader_module, continuous_flow);
-  }
-  // op 3 d/sigma (ref means vs warped means, ref vars, LUT).
-  if (status == Status::kOk) {
-    ex[0] = 3;
-    ex[3] = 3;
-    ex[4] = 0;
-    ex[5] = lut_n;
-    ex[10] = noise_correction & 1u;
-    ex[11] = 0;
-    status = RobDispatch(ctx, ex, gw, gh, n, means_buffer, warped,
-                         vars_buffer, d, sg, dummy, lut_buffer,
-                         shader_module);
-  }
-  // op 4 threshold (S gathered per tileHalf block).
-  if (status == Status::kOk) {
-    ex[0] = 4;
-    ex[3] = 0;
-    ex[4] = tile_half;
-    ex[5] = 0;
-    ex[6] = t_bits;
-    ex[7] = hf_buffer != VK_NULL_HANDLE ? 1 : 0;   // S.3 rejection on
-    ex[8] = s1_bits;
-    ex[10] = 0;
-    ex[11] = ftx;
-    status = RobDispatch(ctx, ex, gw, gh, n, d, sg,
-                         hf_buffer != VK_NULL_HANDLE ? hf_buffer : dummy, r,
-                         dummy, s_buffer, dummy, shader_module, continuous_flow);
-    ex[7] = 0;
-    ex[8] = 0;
-  }
-  // Ghost mask (noise_correction bit 2) on s = 1 - r inside motion tiles:
-  // a 7x7 box mean seeds coherent blobs (speckles average away, holes in
-  // real motion do not),
-  // then a max dilation by the seed half width plus half a flow tile grows
-  // them past the continuous-motion smoothing. d/sg are free after op 4.
-  const bool ghost_grow = ((noise_correction >> 2u) & 1u) != 0u;
-  if (status == Status::kOk && ghost_grow) {
-    constexpr uint32_t kGhostErode = 3;  // 7x7 seed window (guide px)
-    const uint32_t dilate = kGhostErode + (tile_size / 2u > 0u ? tile_size / 2u : 1u);
-    struct Pass { uint32_t axis, hw, isMax, fromR; VkBuffer in, out; };
-    // Pass 1 reads op 3's d (frame-vs-ref squared difference of local
-    // means) for the visibility weight, so it writes sg; the result ends in d.
-    const Pass passes[4] = {{0, kGhostErode, 0, 1, r, sg}, {1, kGhostErode, 0, 0, sg, d},
-                            {0, dilate, 1, 2, d, sg}, {1, dilate, 1, 0, sg, d}};
-    for (const Pass& ps : passes) {
-      if (status != Status::kOk) break;
-      uint32_t gx[15] = {};
-      gx[0] = 10; gx[3] = ps.axis; gx[4] = ps.hw; gx[5] = ps.isMax; gx[6] = ps.fromR;
-      // Seed only inside motion tiles (S == s1): see robustness.comp op 10.
-      const bool first = ps.fromR == 1u;
-      if (first) {
-        gx[7] = 1; gx[8] = s1_bits; gx[9] = ghost_a_bits; gx[10] = ghost_b_bits;
-        gx[11] = ftx; gx[12] = tile_half;
-      }
-      status = RobDispatch(ctx, gx, gw, gh, n, ps.in, first ? d : dummy,
-                           first ? means_buffer : dummy, ps.out,
-                           dummy, s_buffer, dummy, shader_module);
-    }
-  }
-  // op 5 local min into the caller buffer (capped by the ghost mask).
-  if (status == Status::kOk) {
-    ex[0] = 5;
-    ex[4] = 0;
-    ex[6] = 0;
-    ex[11] = 0;
-    ex[14] = ghost_grow ? 1u : 0u;
-    status = RobDispatch(ctx, ex, gw, gh, n, r, ghost_grow ? d : dummy, dummy, out_buffer,
-                         dummy, dummy, dummy, shader_module);
-  }
-  arena.freeAll();
-  return status;
-}
