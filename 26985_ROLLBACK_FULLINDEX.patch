-  out += out_stride;
-
-  // Rows 1..H-1
-  for (int row = 1; row < H; row++) {
-    u16* tmp = lastraw; lastraw = rowbuf; rowbuf = tmp;
-
-    // col 0: predictor = above
-    for (int c = 0; c < NC; c++) {
-      bitio_refill(bio);
-      int d = bitio_decode_diff(bio, hl[c], hb[c]);
-      int raw = (int)(uint16_t)(lastraw[c] + d);
