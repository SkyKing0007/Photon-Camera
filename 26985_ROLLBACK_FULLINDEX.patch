-        w->w.extras_len) {
-      st = td_wio_err(&w->sink, extras_base, err);
-      goto cleanup;
-    }
-  }
-  if (!td_safe_add_u64(extras_base, (uint64_t)w->w.extras_len, &ifd_off)) {
-    td_set_error(err, TINYDNG_E_BOUNDS, TINYDNG_STAGE_WRITE, 0, 0,
