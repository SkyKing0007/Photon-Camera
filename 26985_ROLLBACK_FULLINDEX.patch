-        } else if ((y & 1) == 0) {
-          plane = black[1];
-        } else if ((x & 1) == 0) {
-          plane = black[3];
-        } else {
-          plane = black[2];
-        }
-        const double v = (u - static_cast<double>(plane)) /
-                         static_cast<double>(white - plane);
-        out[static_cast<size_t>(y) * w + x] = static_cast<float>(v);
