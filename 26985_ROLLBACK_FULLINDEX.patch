-#pragma once
-// Minimal row-range parallel-for for the CPU stages around the GPU work
-// (prior GAT/pack/unpack, look finishing). Deterministic: each index range is
-// written by exactly one thread, no reductions.
-#include <algorithm>
-#include <cstdlib>
-#include <thread>
-#include <vector>
