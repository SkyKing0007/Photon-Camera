-static int lj92_allocator_resolve(const tdng_lj92_allocator* src,
-                                  tdng_lj92_allocator* dst) {
-  memset(dst, 0, sizeof(*dst));
-  if (!src) return 1;
-  if (!src->alloc || !src->free) return 0;
-  *dst = *src;
-  return 1;
-}
