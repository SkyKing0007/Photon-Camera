-    if ((segment[4 + 2 * s] & 15) != 0 || td > 3 ||
-        (self->sof_marker == 0xC3 && !self->huff_defined[td])) {
-      return TDNG_LJ92_ERROR_CORRUPT;
-    }
-    for (int c = 0; c < self->components; c++) {
-      if (self->component_id[c] == segment[3 + 2 * s]) frame_c = c;
-    }
