-  }
-  task.ctx = ctx;
-  task.doc = doc;
-  task.ch = ch;
-  task.w = w;
-  task.h = h;
-  task.depth = psd->depth;
-  task.is_psb = psd->is_psb;
-  task.dst = dst;
-  task.pixel_stride = out_bytes;
-  task.out_bytes = out_bytes;
