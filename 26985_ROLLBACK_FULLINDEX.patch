-    const double ang = -2.0 * kPi * static_cast<double>(q) / n;
-    tw[2 * q] = static_cast<float>(std::cos(ang));
-    tw[2 * q + 1] = static_cast<float>(std::sin(ang));
-  }
-  return tw;
-}
