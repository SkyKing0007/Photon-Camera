-  task.ok = 0;
-  td_psd_chan_worker(&task);
-  if (!task.ok) {
-    if (owns) {
-      td_ctx_free(ctx, dst);
-    }
-    if (err) {
-      *err = task.err;
-    }
-    return task.err.status != TINYDNG_OK ? task.err.status : TINYDNG_E_DECODE;
