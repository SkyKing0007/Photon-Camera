-  vec2 d10 = dloc[(b + y1) * nbx + x0], d11 = dloc[(b + y1) * nbx + x1];
-  return mix(mix(d00, d01, f.x), mix(d10, d11, f.x), f.y);
-}
-vec2 localD(int k, vec2 u) {
-  if (pc.kOff <= 0) return vec2(0.0);
