-        const uint32_t sy = (y + shy) % h;
-        const uint32_t sx = (x + shx) % w;
-        const size_t si = ((static_cast<size_t>(b) * h + y) * w + x) * 2;
-        const size_t di = ((static_cast<size_t>(b) * h + sy) * w + sx) * 2;
