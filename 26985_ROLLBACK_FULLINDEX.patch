-static void* lj92_realloc_copy(const tdng_lj92_allocator* a, void* old_ptr,
-                               size_t old_size, size_t new_size) {
-  void* p = lj92_alloc(a, new_size);
-  if (!p) return NULL;
-  if (old_ptr && old_size) {
-    memcpy(p, old_ptr, old_size < new_size ? old_size : new_size);
-  }
-  lj92_free(a, old_ptr);
-  return p;
