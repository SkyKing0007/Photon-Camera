-      for (int col = 0; col < W; col++) {
-        bitio_refill(bio);
-        diffs[col] = (u16)bitio_decode_diff(bio, hl, hb);
-      }
-      tdng_prefix_sum_u16(out, diffs, W, (u16)first_px);
-      out += W;
