-static void tdng_prefix_sum_u16_scalar(u16* dst, const u16* diff, int count,
-                                       u16 seed) {
-  u16 acc = seed;
-  for (int i = 0; i < count; i++) {
-    acc = (u16)(acc + diff[i]);
-    dst[i] = acc;
-  }
-}
