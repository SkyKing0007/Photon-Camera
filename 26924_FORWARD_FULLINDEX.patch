+    // IRIS_26924_B_ON_TRUE_3X3_ORIGINAL_BAYER_REPROJECTION, B ON only.
+    // Three OUTER solves; each performs three distinct image steps, with a
+    // fresh U(z)-y RAW16 Bayer residual and matched U^T for EVERY image step.
+    // Nine updates are NOT nine repeats of one stale error buffer. The
+    // reference-view CFA predictor / LK alignment refreshes BETWEEN outers.
+    // Each frame's tile_flow scratch and two-slot RAW ownership are shared,
+    // so we must reprepare/realign EVERY companion for EACH image step rather
+    // than accidentally reuse the final companion's flow for other frames.
+    // No change to OFF HDR+, original frozen capture frames, or vendor code.
+    if (merge_.outputScale >= 1.99f && frames.size() >= 2u) {
+        if (!merge_.sensorNoiseProfile ||
+            !rawr::raw_merge_wronski_gpu::valid(*merge_.sensorNoiseProfile))
+            throw std::runtime_error("26924 original-RAW 3x3 solver lacks burst-derived variance");
+        constexpr std::uint32_t kOuterIterations=3u;
+        constexpr std::uint32_t kImageUpdatesPerOuter=3u;
+        for (std::uint32_t outer=0; outer<kOuterIterations; ++outer) {
+            if (outer>0u) {
+                // Refinement is coupled to the CURRENT HR estimate, but the
+                // physical reference RAW16 remains frozen and is read again.
+                executeChunk(24u,ref,1u,[&] { recorder.record26924ReferenceModel(command_); });
+            }
+            for (std::uint32_t imageStep=0; imageStep<kImageUpdatesPerOuter; ++imageStep) {
+                // Exact reset => no stale gradient/coverage from the preceding
+                // image step. Every shader dispatch is fenced by executeChunk.
+                executeChunk(24u,ref,1u,[&] { recorder.record26924ClearGradient(command_); });
+                executeChunk(24u,ref,1u,[&] {
+                    recorder.record26924Residual(command_,frames[ref].raw.view,frames[ref].parameters,true);
+                    recorder.record26924Adjoint(command_,true);
+                });
+                for (std::uint32_t i=0;i<frames.size();++i) {
+                    if (i==ref) continue;
+                    if (framePrepared) framePrepared(i);  // fence-complete immutable RAW16 re-upload
+                    executeChunk(24u,i,1u,[&] {
+                        recorder.recordCompanionPrepare(command_,frames[i].raw.view,frames[i].parameters);
+                    });
+                    for (std::uint32_t level=0;level<4u;++level)
+                        executeChunk(24u,i,1u,[&] {
+                            recorder.recordCompanionAlignmentLevel(command_,level);
+                        });
+                    executeChunk(24u,i,1u,[&] {
+                        recorder.record26924Residual(command_,frames[i].raw.view,frames[i].parameters,false);
+                        recorder.record26924Adjoint(command_,false);
+                    });
+                }
+                executeChunk(24u,ref,1u,[&] {
+                    recorder.record26924Update(command_,std::uint32_t(frames.size()),outer,imageStep);
+                });
+            }
+        }
+    }
