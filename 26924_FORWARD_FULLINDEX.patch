+    uint writeCount;
+    uint droppedCount;
+    uint _tracePad0;
+    uint _tracePad1;
+    uvec4 cfg0;
+    ivec4 cfg1;
+    uvec4 meta[];
+}
+rawrTrace;
+const uint RAWR_TRACE_STAGE = 7u;
