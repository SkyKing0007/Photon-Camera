+    ivec2 b=ivec2(floor(h));vec2 t=fract(h);ivec2 extent=imageSize(hrEstimate);
+    if(any(lessThan(b,ivec2(0)))||any(greaterThanEqual(b+ivec2(1),extent)))return 0.0;
