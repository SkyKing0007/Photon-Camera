+        alpha = Math.max(alpha, 1.0e-9f);
+        beta = Math.max(beta, 0.0f);
+        final long key = ((long)Float.floatToIntBits(alpha) << 32)
+                ^ (Float.floatToIntBits(beta) & 0xffffffffL);
