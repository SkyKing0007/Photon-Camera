+        Log.d(Name, line);
+        try {
+            com.particlesdevs.photoncamera.util.MotionTrace.processingState(
+                    "IRIS_26500_JOINT_WRONSKI_RGB_OWNER", line);
+        } catch (Throwable ignored) {}
+    }
+}
