+int colorAt(ivec2 p) {
+    int q = phaseAt(p);
+    if (cfaPattern == 0) return q == 0 ? 0 : (q == 3 ? 2 : 1);
+    if (cfaPattern == 1) return q == 1 ? 0 : (q == 2 ? 2 : 1);
+    if (cfaPattern == 2) return q == 2 ? 0 : (q == 1 ? 2 : 1);
+    return q == 3 ? 0 : (q == 0 ? 2 : 1);
+}
+float phaseComponent(vec4 v, int q) {
+    return q == 0 ? v.r : (q == 1 ? v.g : (q == 2 ? v.b : v.a));
+}
+float phaseDivisor(int q) {
+    return q == 0 ? 1.0 : (q == 1 ? 3.0 : (q == 2 ? 9.0 : 27.0));
+}
+float provenanceAt(ivec2 p) {
+    p = mirrorRaw(p);
+    float code = texelFetch(HighlightProvenance, p >> 1, 0).r;
+    float digit = floor(code / phaseDivisor(phaseAt(p)));
+    return mod(digit, 3.0);
+}
+bool trustedAt(ivec2 p) {
+    return abs(provenanceAt(p) - PROVENANCE_CENSORED) >= 0.25;
+}
+float fusedAt(ivec2 p) {
+    p = mirrorRaw(p);
+    vec4 v = texelFetch(InputBayer, p >> 1, 0);
+    return phaseComponent(v, phaseAt(p));
+}
+vec3 shadingRgb(ivec2 p) {
+    if (useLensShading == 0) return vec3(1.0);
+    p = mirrorRaw(p);
+    vec2 uv = (vec2(p) + vec2(0.5)) / vec2(rawSize);
+    vec4 g = texture(LensShadingMap, clamp(uv, vec2(0.0), vec2(1.0)));
+    return max(vec3(g.r, 0.5 * (g.g + g.b), g.a), vec3(0.0));
+}
+float calculationSample(ivec2 p) {
+    p = mirrorRaw(p);
+    int c = colorAt(p);
+    vec3 lsc = shadingRgb(p);
+    float wb = c == 0 ? calculationWb.r : (c == 2 ? calculationWb.b : calculationWb.g);
+    return min(max(fusedAt(p) * lsc[c] * max(wb, 1.0e-6), 0.0), highlightCeiling);
+}
+float neutralLowerBound(ivec2 p) {
+    p = mirrorRaw(p);
+    ivec2 o = (p >> 1) << 1;
+    float lower = 0.0;
+    for (int y = 0; y < 2; ++y) {
+        for (int x = 0; x < 2; ++x) {
+            lower = max(lower, calculationSample(o + ivec2(x, y)));
+        }
+    }
+    return lower;
+}
+bool trustedGreen(ivec2 p, out float v) {
+    p = mirrorRaw(p);
+    if (colorAt(p) != 1 || !trustedAt(p)) { v = 0.0; return false; }
+    v = calculationSample(p);
+    return true;
+}
+
+uniform highp sampler2D GreenGuide;
+uniform float noiseS;
+uniform float noiseO;
+out vec3 Output;
+
+/* IRIS_26500_EVIDENCE_COMPLETE_JOINT_RGB
+ * Native-resolution G/(R-G)/(B-G) reconstruction after Wronski and Short-A.
+ * The rejected historical direct_rgb_* accumulation path remains inactive.
+ */
+float greenAt(ivec2 p) {
+    p = mirrorRaw(p);
+    return texelFetch(GreenGuide, p, 0).r;
+}
+float greenLscAt(ivec2 p) { return max(shadingRgb(p).g, 1.0e-4); }
+float chromaNoiseSigma(float green, ivec2 p) {
+    float lsc = greenLscAt(p);
+    float variance = max(lsc * max(noiseS, 0.0) * max(green, 0.0)
+            + lsc * lsc * max(noiseO, 0.0), 1.0e-10);
+    return max(1.8 * sqrt(variance), 1.0 / 2048.0);
+}
+float localCensoredFraction(ivec2 p) {
+    p = mirrorRaw(p);
+    ivec2 o = (p >> 1) << 1;
+    float count = 0.0;
+    for (int y = 0; y < 2; ++y) {
+        for (int x = 0; x < 2; ++x) {
+            count += abs(provenanceAt(o + ivec2(x, y)) - PROVENANCE_CENSORED) < 0.25 ? 1.0 : 0.0;
+        }
+    }
+    return 0.25 * count;
+}
+float reconstructOpponent(ivec2 p, int wantedColor, float targetGreen,
+                          out float confidence) {
+    float sum = 0.0;
+    float weight = 0.0;
+    float sigma = chromaNoiseSigma(targetGreen, p);
+    for (int y = -2; y <= 2; ++y) {
+        for (int x = -2; x <= 2; ++x) {
+            ivec2 q = mirrorRaw(p + ivec2(x, y));
+            if (colorAt(q) != wantedColor || !trustedAt(q)) continue;
+            float localGreen = greenAt(q);
+            float spatial = exp2(-0.30 * float(x * x + y * y));
+            float nd = (localGreen - targetGreen) / sigma;
+            float guide = exp(-0.5 * nd * nd);
+            float w = spatial * guide;
+            sum += (calculationSample(q) - localGreen) * w;
+            weight += w;
+        }
+    }
+    if (weight <= 1.0e-7) { confidence = 0.0; return 0.0; }
+    float opponent = sum / weight;
+    float support = smoothstep(0.08, 0.35, weight);
+    /* IRIS_26500_NOISE_SIGNIFICANCE_SHADOW_CHROMA */
+    float snr = abs(opponent) / max(sigma, 1.0e-7);
+    float statistical = smoothstep(1.25, 3.5, snr);
+    confidence = support * statistical;
+    return opponent * confidence;
+}
+void main() {
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    if (any(greaterThanEqual(p, rawSize))) { Output = vec3(0.0); return; }
+
+    float green = greenAt(p);
+    float rConfidence;
+    float bConfidence;
+    float rg = reconstructOpponent(p, 0, green, rConfidence);
+    float bg = reconstructOpponent(p, 2, green, bConfidence);
+
+    /* CENSORED is brightness-only. Short-A state 2 is trusted automatically.
+     * The two chroma axes lose authority together as unresolved physical phases
+     * increase, so a fully unresolved cell becomes neutral rather than invented opponent colour. */
+    float censoredFraction = localCensoredFraction(p);
+    float physicalChroma = 1.0 - smoothstep(0.0, 1.0, censoredFraction);
+    float pairedEvidence = min(rConfidence, bConfidence);
+    float highlightPair = mix(1.0, pairedEvidence, censoredFraction);
+    float chromaAuthority = physicalChroma * highlightPair;
+    rg *= chromaAuthority;
+    bg *= chromaAuthority;
+
+    vec3 calculationRgb = max(vec3(green + rg, green, green + bg), vec3(0.0));
+    /* Exact calculation-domain round trip: temporary WB cannot leak downstream. */
+    Output = calculationRgb / max(calculationWb, vec3(1.0e-6));
+}
