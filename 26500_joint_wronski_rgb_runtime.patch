+ *
+ * Converts the final Wronski/Short-A packed CFA + per-phase provenance directly
+ * into native-resolution camera-linear RGB using one G/(R-G)/(B-G) reconstruction.
+ * The rejected historical direct_rgb_* accumulator remains inactive.
+ */
+public final class MotionV2JointRgbReconstruct extends Node {
+    public MotionV2JointRgbReconstruct() {
+        super("", "MotionV2JointRgbReconstruct");
+    }
+
+    @Override public void Compile() {}
+
+    @Override
+    public void Run() {
+        if (!basePipeline.mParameters.motionV2Active) {
+            throw new IllegalStateException("26500 joint RGB used outside Motion V2");
+        }
+        if (previousNode == null || previousNode.WorkingTexture == null) {
+            throw new IllegalStateException("26500 packed Wronski CFA input is missing");
+        }
+
+        Point raw = basePipeline.mParameters.rawSize;
+        Point packed = new Point(raw.x / 2, raw.y / 2);
+        if (raw.x <= 0 || raw.y <= 0 || (raw.x & 1) != 0 || (raw.y & 1) != 0
+                || !previousNode.WorkingTexture.mSize.equals(packed)) {
+            throw new IllegalStateException("26500 joint RGB requires exact even standard Bayer geometry");
+        }
+
+        PostPipeline pipeline = (PostPipeline) basePipeline;
+        if (pipeline.motionV2HighlightProvenanceTexture == null) {
+            throw new IllegalStateException("26500 joint RGB requires per-phase highlight provenance");
+        }
+        float[] gains = basePipeline.mParameters.motionV2ColorGains;
+        if (!basePipeline.mParameters.motionV2DirectColorValid
+                || gains == null || gains.length != 4) {
+            throw new IllegalStateException("26500 joint RGB requires timestamp-owned HAL color gains");
+        }
+        if (!basePipeline.mParameters.motionV2StrictWronskiSensorValid
+                || !Float.isFinite(basePipeline.mParameters.motionV2WronskiNoiseS)
+                || !Float.isFinite(basePipeline.mParameters.motionV2WronskiNoiseO)) {
+            throw new IllegalStateException("26500 joint RGB requires strict Camera2 Wronski noise authority");
+        }
+
+        float greenGain = Math.max(0.5f * (gains[1] + gains[2]), 1.0e-6f);
+        float wbR = Math.max(gains[0] / greenGain, 1.0e-6f);
+        float wbB = Math.max(gains[3] / greenGain, 1.0e-6f);
+        float noiseS = Math.max(basePipeline.mParameters.motionV2WronskiNoiseS, 0.0f);
+        float noiseO = Math.max(basePipeline.mParameters.motionV2WronskiNoiseO, 0.0f);
+
+        boolean hasLsc = basePipeline.mParameters.hasGainMap
+                && basePipeline.mParameters.mapSize != null
+                && basePipeline.mParameters.mapSize.x > 0
