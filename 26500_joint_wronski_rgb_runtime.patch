--- /dev/null
+++ b/app/src/main/assets/shaders/motionv2/joint_green_26500.glsl
@@ -0,0 +1,133 @@
+precision highp float;
+precision highp int;
+precision highp sampler2D;
+
+uniform highp sampler2D InputBayer;
+uniform highp sampler2D HighlightProvenance;
+uniform highp sampler2D LensShadingMap;
+uniform ivec2 rawSize;
+uniform int cfaPattern;
+uniform vec3 calculationWb;
+uniform float highlightCeiling;
+uniform int useLensShading;
+
+const float PROVENANCE_CENSORED = 1.0;
+
+int mirrorIndex(int value, int size) {
+    if (size <= 1) return 0;
+    int period = 2 * (size - 1);
+    int wrapped = value % period;
+    if (wrapped < 0) wrapped += period;
+    return wrapped < size ? wrapped : period - wrapped;
+}
+ivec2 mirrorRaw(ivec2 p) {
+    return ivec2(mirrorIndex(p.x, rawSize.x), mirrorIndex(p.y, rawSize.y));
+}
+int phaseAt(ivec2 p) { return (p.x & 1) | ((p.y & 1) << 1); }
+int colorAt(ivec2 p) {
+    int q = phaseAt(p);
+    if (cfaPattern == 0) return q == 0 ? 0 : (q == 3 ? 2 : 1);
+    if (cfaPattern == 1) return q == 1 ? 0 : (q == 2 ? 2 : 1);
+    if (cfaPattern == 2) return q == 2 ? 0 : (q == 1 ? 2 : 1);
+    return q == 3 ? 0 : (q == 0 ? 2 : 1);
+}
+float phaseComponent(vec4 v, int q) {
+    return q == 0 ? v.r : (q == 1 ? v.g : (q == 2 ? v.b : v.a));
+}
+float phaseDivisor(int q) {
+    return q == 0 ? 1.0 : (q == 1 ? 3.0 : (q == 2 ? 9.0 : 27.0));
+}
+float provenanceAt(ivec2 p) {
+    p = mirrorRaw(p);
+    float code = texelFetch(HighlightProvenance, p >> 1, 0).r;
+    float digit = floor(code / phaseDivisor(phaseAt(p)));
+    return mod(digit, 3.0);
+}
+bool trustedAt(ivec2 p) {
+    return abs(provenanceAt(p) - PROVENANCE_CENSORED) >= 0.25;
+}
+float fusedAt(ivec2 p) {
+    p = mirrorRaw(p);
+    vec4 v = texelFetch(InputBayer, p >> 1, 0);
+    return phaseComponent(v, phaseAt(p));
+}
+vec3 shadingRgb(ivec2 p) {
+    if (useLensShading == 0) return vec3(1.0);
+    p = mirrorRaw(p);
+    vec2 uv = (vec2(p) + vec2(0.5)) / vec2(rawSize);
+    vec4 g = texture(LensShadingMap, clamp(uv, vec2(0.0), vec2(1.0)));
+    return max(vec3(g.r, 0.5 * (g.g + g.b), g.a), vec3(0.0));
+}
+float calculationSample(ivec2 p) {
+    p = mirrorRaw(p);
+    int c = colorAt(p);
+    vec3 lsc = shadingRgb(p);
+    float wb = c == 0 ? calculationWb.r : (c == 2 ? calculationWb.b : calculationWb.g);
+    return min(max(fusedAt(p) * lsc[c] * max(wb, 1.0e-6), 0.0), highlightCeiling);
+}
+float neutralLowerBound(ivec2 p) {
+    p = mirrorRaw(p);
+    ivec2 o = (p >> 1) << 1;
+    float lower = 0.0;
+    for (int y = 0; y < 2; ++y) {
+        for (int x = 0; x < 2; ++x) {
+            lower = max(lower, calculationSample(o + ivec2(x, y)));
+        }
+    }
+    return lower;
+}
+bool trustedGreen(ivec2 p, out float v) {
+    p = mirrorRaw(p);
+    if (colorAt(p) != 1 || !trustedAt(p)) { v = 0.0; return false; }
+    v = calculationSample(p);
+    return true;
+}
+
+out float Output;
+
+/* IRIS_26500_PHYSICAL_GREEN_STRUCTURE_GUIDE
+ * CENSORED green never becomes structural authority. NORMAL and SHORT_VALIDATED
+ * are the only physical green observations. The neutral lower bound is used only
+ * when actual green evidence disappears, never as chroma evidence.
+ */
+void main() {
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    if (any(greaterThanEqual(p, rawSize))) { Output = 0.0; return; }
+
+    float direct;
+    if (trustedGreen(p, direct)) { Output = direct; return; }
+
+    float l, r, u, d;
+    bool h = trustedGreen(p + ivec2(-1, 0), l) && trustedGreen(p + ivec2(1, 0), r);
+    bool v = trustedGreen(p + ivec2(0, -1), u) && trustedGreen(p + ivec2(0, 1), d);
+    float green = neutralLowerBound(p);
+    if (h || v) {
+        float hm = h ? 0.5 * (l + r) : 0.0;
+        float vm = v ? 0.5 * (u + d) : 0.0;
+        if (h && v) {
+            float hc = abs(l - r);
+            float vc = abs(u - d);
+            float wh = 1.0 / max(hc, 1.0e-5);
+            float wv = 1.0 / max(vc, 1.0e-5);
+            green = max((hm * wh + vm * wv) / (wh + wv), green);
+        } else {
+            green = max(h ? hm : vm, green);
+        }
+        Output = green;
+        return;
+    }
+
+    float sum = 0.0;
+    float weight = 0.0;
+    for (int y = -2; y <= 2; ++y) {
+        for (int x = -2; x <= 2; ++x) {
+            float g;
+            if (!trustedGreen(p + ivec2(x, y), g)) continue;
+            float w = exp2(-0.45 * float(x * x + y * y));
+            sum += g * w;
+            weight += w;
+        }
+    }
+    if (weight > 1.0e-6) green = max(sum / weight, green);
+    Output = green;
+}
