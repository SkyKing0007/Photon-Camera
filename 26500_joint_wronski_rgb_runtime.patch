+                glProg.setTexture("InputBayer", previousNode.WorkingTexture);
+                glProg.setTexture("HighlightProvenance", pipeline.motionV2HighlightProvenanceTexture);
+                glProg.setTexture("LensShadingMap", lsc);
+                glProg.setTexture("GreenGuide", greenGuide);
