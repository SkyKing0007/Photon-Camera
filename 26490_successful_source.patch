+}
+
+float greenAt(ivec2 p) {
+    return texelFetch(chromaGuide, clampCoord(p), 0).r;
+}
+
+float chromaWeight(float sampleGreen, float targetGreen) {
+    float signal = max(max(sampleGreen, targetGreen), 0.0);
