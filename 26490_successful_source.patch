index 00000000..08e11713
--- /dev/null
+++ b/app/src/main/assets/shaders/motionv2/rcd26489_populate.glsl
@@ -0,0 +1,100 @@
+#define LAYOUT //
+LAYOUT
+precision highp float;
+precision highp int;
+precision highp sampler2D;
+
+uniform highp sampler2D InputBayer;
+uniform highp sampler2D LensShadingMap;
+layout(std430, binding = 0) buffer CfaBuf {
+    float cfa[];
+};
+layout(std430, binding = 1) buffer RedBuf {
+    float red[];
+};
+layout(std430, binding = 2) buffer GreenBuf {
+    float green[];
+};
+layout(std430, binding = 3) buffer BlueBuf {
+    float blue[];
+};
+uniform ivec2 rawSize;
+uniform ivec2 bandSize;
+uniform int bandOriginY;
+uniform int cfaPattern;
+uniform vec3 calculationWb;
+uniform float sensorClipLevel;
+uniform float highlightThreshold;
+uniform float highlightCeiling;
+uniform int useLensShading;
+
+int phaseAt(ivec2 p) { return (p.x & 1) | ((p.y & 1) << 1); }
+int colorAt(ivec2 p) {
+    int q = phaseAt(p);
+    if (cfaPattern == 0) return q == 0 ? 0 : (q == 3 ? 2 : 1);
+    if (cfaPattern == 1) return q == 1 ? 0 : (q == 2 ? 2 : 1);
+    if (cfaPattern == 2) return q == 2 ? 0 : (q == 1 ? 2 : 1);
+    return q == 3 ? 0 : (q == 0 ? 2 : 1);
+}
+ivec2 clampGlobal(ivec2 p) { return clamp(p, ivec2(0), rawSize - ivec2(1)); }
+float fusedAt(ivec2 p) {
+    p = clampGlobal(p);
+    vec4 v = texelFetch(InputBayer, p >> 1, 0);
+    int q = phaseAt(p);
+    return q == 0 ? v.r : (q == 1 ? v.g : (q == 2 ? v.b : v.a));
+}
+vec3 shadingRgb(ivec2 p) {
+    if (useLensShading == 0) return vec3(1.0);
+    vec2 uv = (vec2(clampGlobal(p)) + vec2(0.5)) / vec2(rawSize);
+    vec4 g = texture(LensShadingMap, clamp(uv, vec2(0.0), vec2(1.0)));
+    return max(vec3(g.r, 0.5 * (g.g + g.b), g.a), vec3(0.0));
+}
+float calculationAt(ivec2 p) {
+    p = clampGlobal(p);
+    int col = colorAt(p);
+    vec3 lsc = shadingRgb(p);
+    float wb = col == 0 ? calculationWb.r : (col == 2 ? calculationWb.b : calculationWb.g);
+    return clamp(fusedAt(p) * lsc[col] * max(wb, 1.0e-6), 0.0, highlightCeiling);
+}
+float opposedEstimate(ivec2 p, int ownColor, float base) {
+    vec3 sums = vec3(0.0);
+    vec3 counts = vec3(0.0);
+    for (int dy = -1; dy <= 1; ++dy) {
+        for (int dx = -1; dx <= 1; ++dx) {
+            ivec2 q = clampGlobal(p + ivec2(dx, dy));
+            int c = colorAt(q);
+            sums[c] += calculationAt(q);
+            counts[c] += 1.0;
+        }
+    }
+    const float invPower = 1.0 / 3.0;
+    vec3 roots = pow(max(sums / max(counts, vec3(1.0)), vec3(0.0)), vec3(invPower));
+    float opposed = ownColor == 0 ? 0.5 * (roots.g + roots.b)
+            : (ownColor == 1 ? 0.5 * (roots.r + roots.b) : 0.5 * (roots.r + roots.g));
+    return max(base, opposed * opposed * opposed);
+}
+void main() {
+    ivec2 lp = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(lp, bandSize))) return;
+    ivec2 gp = ivec2(lp.x, bandOriginY + lp.y);
+    int idx = lp.y * bandSize.x + lp.x;
+    int col = colorAt(gp);
+    float base = calculationAt(gp);
+    float fusedPhysical = fusedAt(gp);
+    float physical = fusedPhysical / max(sensorClipLevel, 1.0e-6);
+    /* IRIS_26490_PHYSICAL_CENSORING_WITH_LOWER_BOUND
+     * Clip classification is always physical sensor-domain math. Bracket-recovered values may
+     * exceed 1.0 in the normal-exposure radiance domain; opposedEstimate() is constrained with
+     * max(base, estimate), so RCD can never reduce that measured lower bound. This avoids a
+     * coarse global short-frame flag changing unrelated pixels while retaining bjzhou-style
+     * censored-site reconstruction for unresolved normal highlights.
+     */
+    float clipMix = smoothstep(highlightThreshold, 1.0, physical);
+    float value = clipMix > 0.0
+            ? mix(base, min(opposedEstimate(gp, col, base), highlightCeiling), clipMix)
+            : base;
+    cfa[idx] = value;
+    red[idx] = col == 0 ? value : 0.0;
+    green[idx] = col == 1 ? value : 0.0;
+    blue[idx] = col == 2 ? value : 0.0;
+}
diff --git a/app/src/main/assets/shaders/motionv2/rcd26489_vh_direction.glsl b/app/src/main/assets/shaders/motionv2/rcd26489_vh_direction.glsl
new file mode 100644
index 00000000..d4a1de87
--- /dev/null
+++ b/app/src/main/assets/shaders/motionv2/rcd26489_vh_direction.glsl
@@ -0,0 +1,40 @@
+#define LAYOUT //
+LAYOUT
+precision highp float;
+precision highp int;
+layout(std430, binding = 0) readonly buffer CfaBuf {
+    float cfa[];
+};
+layout(std430, binding = 4) buffer VhBuf {
+    float vh[];
+};
+uniform ivec2 bandSize;
+
+int idxAt(ivec2 p) {
+    p = clamp(p, ivec2(0), bandSize - ivec2(1));
+    return p.y * bandSize.x + p.x;
+}
+float raw(ivec2 p) { return cfa[idxAt(p)]; }
+float sq(float v) { return v * v; }
+float axisResidual(ivec2 p, ivec2 d) {
+    return sq(raw(p - 3*d) - raw(p - d) - raw(p + d) + raw(p + 3*d)
+            - 3.0 * (raw(p - 2*d) + raw(p + 2*d)) + 6.0 * raw(p));
+}
+void main() {
+    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(p, bandSize))) return;
+    int i = idxAt(p);
+    if (p.x < 4 || p.y < 4 || p.x + 4 >= bandSize.x || p.y + 4 >= bandSize.y) {
+        vh[i] = 0.5;
+        return;
+    }
+    float vertical = axisResidual(p + ivec2(0,-1), ivec2(0,1))
+            + axisResidual(p, ivec2(0,1))
+            + axisResidual(p + ivec2(0,1), ivec2(0,1));
+    float horizontal = axisResidual(p + ivec2(-1,0), ivec2(1,0))
+            + axisResidual(p, ivec2(1,0))
+            + axisResidual(p + ivec2(1,0), ivec2(1,0));
+    vertical = max(vertical, 1.0e-10);
+    horizontal = max(horizontal, 1.0e-10);
+    vh[i] = vertical / (vertical + horizontal);
+}
diff --git a/app/src/main/assets/shaders/motionv2/rcd26489_write.glsl b/app/src/main/assets/shaders/motionv2/rcd26489_write.glsl
new file mode 100644
index 00000000..c364e00d
--- /dev/null
+++ b/app/src/main/assets/shaders/motionv2/rcd26489_write.glsl
@@ -0,0 +1,95 @@
+#define LAYOUT //
+LAYOUT
+precision highp float;
+precision highp int;
+precision highp image2D;
+layout(std430, binding = 0) readonly buffer CfaBuf {
+    float cfa[];
+};
+layout(std430, binding = 1) readonly buffer RedBuf {
+    float red[];
+};
+layout(std430, binding = 2) readonly buffer GreenBuf {
+    float green[];
+};
+layout(std430, binding = 3) readonly buffer BlueBuf {
+    float blue[];
+};
+layout(rgba16f, binding = 9) writeonly uniform highp image2D OutputRgb;
+uniform ivec2 rawSize;
+uniform ivec2 bandSize;
+uniform int bandOriginY;
+uniform int coreLocalY;
+uniform int coreRows;
+uniform int cfaPattern;
+uniform vec3 calculationWb;
+
+/* IRIS_26490_BJZHOU_RCD_PHOTO_BORDER_MIRROR_1TO1
+ * Preserve the virtual PPG coordinate. Each sample is reflected in full-photo coordinates,
+ * then mapped back into this band's halo. Clamping the virtual center changes Bayer parity and
+ * is not equivalent to the reference PPG border semantics.
+ */
+int mirrorIndex(int value,int size){
+    if(size<=1)return 0;
+    int period=2*(size-1);
+    int wrapped=value%period;
+    if(wrapped<0)wrapped+=period;
+    return wrapped<size?wrapped:period-wrapped;
+}
+ivec2 mirrorLocal(ivec2 p){
+    ivec2 gp=ivec2(p.x,bandOriginY+p.y);
+    ivec2 safeGlobal=ivec2(mirrorIndex(gp.x,rawSize.x),mirrorIndex(gp.y,rawSize.y));
+    return ivec2(safeGlobal.x,safeGlobal.y-bandOriginY);
+}
+int idxAt(ivec2 p){ivec2 safe=mirrorLocal(p);return safe.y*bandSize.x+safe.x;}
+int phaseAtSafeLocal(ivec2 p){ivec2 gp=ivec2(p.x,bandOriginY+p.y);return (gp.x&1)|((gp.y&1)<<1);}
+int colorAt(ivec2 p){ivec2 safe=mirrorLocal(p);int q=phaseAtSafeLocal(safe);if(cfaPattern==0)return q==0?0:(q==3?2:1);if(cfaPattern==1)return q==1?0:(q==2?2:1);if(cfaPattern==2)return q==2?0:(q==1?2:1);return q==3?0:(q==0?2:1);}
+float raw(ivec2 p){return cfa[idxAt(p)];}
+float ppgGreen(ivec2 p){
+    if(colorAt(p)==1) return max(raw(p),0.0);
+    float c=raw(p);
+    float xm=raw(p+ivec2(-1,0)), xp=raw(p+ivec2(1,0));
+    float xm2=raw(p+ivec2(-2,0)), xp2=raw(p+ivec2(2,0));
+    float xm3=raw(p+ivec2(-3,0)), xp3=raw(p+ivec2(3,0));
+    float ym=raw(p+ivec2(0,-1)), yp=raw(p+ivec2(0,1));
+    float ym2=raw(p+ivec2(0,-2)), yp2=raw(p+ivec2(0,2));
+    float ym3=raw(p+ivec2(0,-3)), yp3=raw(p+ivec2(0,3));
+    float gx=2.0*(xm+c+xp)-xm2-xp2;
+    float gy=2.0*(ym+c+yp)-ym2-yp2;
+    float dx=3.0*(abs(xm2-c)+abs(xp2-c)+abs(xm-xp))
+        +2.0*(abs(xp3-xp)+abs(xm3-xm));
+    float dy=3.0*(abs(ym2-c)+abs(yp2-c)+abs(ym-yp))
+        +2.0*(abs(yp3-yp)+abs(ym3-ym));
+    float outg=dx>dy?clamp(0.25*gy,min(ym,yp),max(ym,yp))
+                    :clamp(0.25*gx,min(xm,xp),max(xm,xp));
+    return max(outg,0.0);
+}
+vec3 ppg(ivec2 p){
+    int own=colorAt(p); float c=max(raw(p),0.0),gg=ppgGreen(p); vec3 outc=vec3(0.0,gg,0.0);
+    if(own==0||own==2){
+        if(own==0) outc.r=c; else outc.b=c;
+        ivec2 a=ivec2(-1,-1),bb=ivec2(1,-1),cc=ivec2(-1,1),d=ivec2(1,1);
+        float e1=abs(raw(p+a)-raw(p+d))+abs(ppgGreen(p+a)-gg)+abs(ppgGreen(p+d)-gg);
+        float e2=abs(raw(p+bb)-raw(p+cc))+abs(ppgGreen(p+bb)-gg)+abs(ppgGreen(p+cc)-gg);
+        float v1=0.5*(raw(p+a)+raw(p+d)+2.0*gg-ppgGreen(p+a)-ppgGreen(p+d));
+        float v2=0.5*(raw(p+bb)+raw(p+cc)+2.0*gg-ppgGreen(p+bb)-ppgGreen(p+cc));
+        float v=e1<e2?v1:(e2<e1?v2:0.5*(v1+v2)); if(own==0) outc.b=v; else outc.r=v;
