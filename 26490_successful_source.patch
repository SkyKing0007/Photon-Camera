+    private MotionV2IpolNoiseCurve() {}
+
+    private static final class Table {
+        final float[] sigma;
+        final float[] diff;
+        final int imin;
+        final int imax;
+        Table(float[] sigma, float[] diff, int imin, int imax) {
+            this.sigma = sigma;
