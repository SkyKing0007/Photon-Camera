+                + " staged=" + ticket.stagedCount()
+                + " expectedTimestamp=" + expectedAfterStage
+                + " deltaNs=" + (expectedAfterStage > 0L ? ts - expectedAfterStage : Long.MIN_VALUE)
+                + " identityKnown=" + (expectedAfterStage > 0L)
