+                    "IRIS_26489_POSTMERGE_RCD_DOMAIN",
+                    "implementation=bandedDirectionalRcd"
+                            + " bands=" + bands
+                            + " halo=" + RCD_HALO_ROWS
+                            + " maxScratchMiB=" + (maxScratchBytes / (1024L * 1024L))
+                            + " ppgBorderOnly=true");
+        } catch (Throwable ignored) {}
+    }
