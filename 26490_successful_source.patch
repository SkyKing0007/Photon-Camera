+                }
+            }
+            if(v instanceof double[]){
+                double[] a=(double[])v;
+                if(a.length>=9){
+                    float[] r=new float[9];
+                    for(int i=0;i<9;i++)r[i]=(float)a[i];
+                    return r;
+                }
+            }
+            if(v.getClass().isArray()&&Array.getLength(v)>=9){
