+
+float grayAt(ivec2 q) {
+    return dot(phaseQuad(q), vec4(0.25));
+}
+
+/* IRIS_26488_BJZHOU_RAW16_TO_GRAY_HALIDE_CONTRACT */
+void main() {
+    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
