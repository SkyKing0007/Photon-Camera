+     */
+    private static final LinkedHashMap<Long, Table> TABLE_CACHE =
+            new LinkedHashMap<Long, Table>(CACHE_SIZE, 0.75f, true) {
+                @Override
+                protected boolean removeEldestEntry(Map.Entry<Long, Table> e) {
+                    return size() > CACHE_SIZE;
+                }
