+    float sumRed = 0.0;
+    float sumGreen = 0.0;
+    float sumBlue = 0.0;
+    float countRed = 0.0;
+    float countGreen = 0.0;
+    float countBlue = 0.0;
+    for (int dy = -1; dy <= 1; ++dy) {
+        for (int dx = -1; dx <= 1; ++dx) {
+            ivec2 q = clampCoord(p + ivec2(dx, dy));
+            int sampleColor = colorFromPhase(phaseIndex(q));
+            float balanced = calculationSampleAt(q);
+            if (sampleColor == 0) {
+                sumRed += balanced;
+                countRed += 1.0;
+            } else if (sampleColor == 1) {
+                sumGreen += balanced;
+                countGreen += 1.0;
+            } else {
+                sumBlue += balanced;
+                countBlue += 1.0;
+            }
